#!/bin/bash
# Refuses local ref rewrites/deletions -- reset --hard, branch -D, branch -f
# backward, commit --amend, filter-branch, etc. -- at the layer git itself
# always consults, no matter what process or language asked git to do it.
#
# WHY THIS EXISTS ON TOP OF deny-destructive.sh: that hook pattern-matches the
# literal Bash command STRING. Its own header already says what that is not
# good for: `python3 -c "import subprocess; subprocess.run(['git','reset',
# '--hard','HEAD~3'])"` never contains the substring "git reset --hard" (it's
# split across a Python list), so a string scanner cannot and does not catch
# it -- verified empirically, see verify-reference-transaction.sh. This file
# is NOT a second string scanner with a different regex; it does not look at
# the command that invoked git at all. It is installed as git's own
# `reference-transaction` hook (git >= 2.28), which git fires for essentially
# every local ref create/update/delete -- from bash, from a Python
# subprocess, from a shell alias, from another program entirely -- because it
# is git's own C code running the transaction, not a shell parsing a string.
# There is no command string here to lose to quoting tricks.
#
# COVERAGE (2026-09-16 extended from refs/heads/* only -- F46 falsify pass):
# refs/heads/*, refs/tags/*, and refs/wip/* (this project's anchor namespace,
# see docs/LOOP_CONTRACT.md) all get the SAME policy below (deletion refused,
# non-fast-forward rewrite refused). refs/stash gets a DIFFERENT, narrower
# policy -- see the dedicated comment above the stash branch in the loop
# below for exactly why the heads policy cannot simply be reused there.
#
# WHAT THIS IS NOT (read this before trusting it further than it goes):
#   - It only fires on REF updates. `git checkout -f` on the SAME branch and
#     `git clean -fdx` and `git restore .` discard working-tree/index content
#     without moving any ref, so this hook never sees them. That destruction
#     mode is still only covered by deny-destructive.sh's string match, which
#     a python-subprocess call defeats the same way it defeats "git reset
#     --hard". This is a known, intentional, and currently OPEN gap -- see
#     the negative-control notes for what was and was not exercised.
#   - `git reset --hard` while HEAD is DETACHED is a separate, DELIBERATE,
#     VERIFIED-OPEN gap, not an oversight. Empirically (2026-09-16, scratch
#     repo): while detached, git fires a reference-transaction update for the
#     literal ref name `HEAD` (old detached OID -> new OID) on BOTH a hard
#     reset AND on plain navigation via checkout to an older commit -- the
#     two produce the byte-for-byte identical transaction shape, because
#     browsing history backward while detached is exactly as "non-descendant"
#     as discarding it. Blocking non-fast-forward updates to `HEAD` the way
#     refs/heads/* is blocked below would refuse ordinary detached-HEAD
#     history browsing as a false positive -- ruled out by this project's own
#     standard (deny-destructive.sh's header: false positives cost as much as
#     false negatives). No git-native hook can tell these two apart, because
#     git itself cannot: the difference is operator intent, not ref state.
#     deny-destructive.sh denies the literal string "git reset --hard"
#     regardless of HEAD state, which covers the bash-invoked spelling; the
#     python-subprocess bypass of THAT (this hook was never going to catch
#     it, for the reason above, so there is nothing here for a subprocess
#     call to bypass) remains open, same limitation as every string-scan
#     case in that file.
#   - `git stash drop` / `git stash pop` of anything OTHER than the very last
#     remaining stash entry NEVER reaches this hook at all. Empirically
#     verified (2026-09-16, scratch repo, 2-entry stash): dropping stash@{0}
#     out of 2 produces ZERO reference-transaction events for refs/stash --
#     git implements that as reflog surgery (the same underlying mechanism
#     `git reflog expire` uses), not a ref-update transaction. Only two
#     shapes touch refs/stash through this hook: creating it from nothing
#     (first `stash push`) and deleting it entirely (`stash clear`, or
#     dropping the LAST remaining entry) -- both handled below. The
#     multi-entry-drop shape is NOT closeable by this mechanism; it is
#     covered, bash-invocation only, by deny-destructive.sh's string match on
#     "git stash drop" / "git stash pop" / "git stash clear" (same
#     python-subprocess limitation as everywhere else in that file).
#   - It is local-repo-scoped. It cannot stop a force-push landing on a
#     remote; that is `pre-push`'s job (tools/loop/hooks/pre-push), which is
#     itself invocation-shape-independent for the same reason (git runs it
#     for `git push` regardless of invoker) and already gates on
#     FHP_ALLOW_PUSH rather than on command text.
#   - `core.hooksPath` and the hooks directory itself are ordinary git config
#     and ordinary files. A round that thinks to run
#     `git config core.hooksPath ""` or delete this file unsets this
#     protection, and reference-transaction cannot catch that (git isn't
#     doing a ref update when you edit its config). This is not a security
#     boundary against an adversary with full filesystem access to the
#     repo -- it is a blast-radius limiter against an unattended round
#     confidently doing the thing it always does (calling git), the same
#     framing as deny-destructive.sh.
#   - A raw filesystem write to `.git/refs/heads/<branch>` (or a packed-refs
#     edit) that never invokes a `git` process at all bypasses this hook
#     completely and silently -- no refusal is printed, no config is
#     touched, the hook file itself is untouched and still looks fully
#     installed. Empirically verified (F46 falsify pass, 2026-09-20, scratch
#     repo): `open('.git/refs/heads/master', 'w').write(old_oid)` from Python
#     rewound the branch pointer with zero reference-transaction events. This
#     is a DIFFERENT and MORE SILENT mechanism than the hooksPath gap above
#     (that one at least requires a detectable config/file change; this one
#     requires neither) and a different mechanism than the working-tree
#     gap two paragraphs up (that one discards content without touching
#     refs at all; this one rewrites a ref directly on disk). The result
#     lands in the same "reflog-only" state this file already discloses for
#     `stash drop` above: `git reflog show <branch>` still lists the
#     discarded commit, so the object is not unreachable, but no refusal
#     fires and the destructive write itself succeeds.
#
# HOW IT DECIDES: for the "prepared" state of every transaction (the point at
# which refusing still aborts cleanly -- see `man githooks`), for each queued
# update to a `refs/heads/*`, `refs/tags/*`, or `refs/wip/*` ref:
#   - resolve the ref's value ON DISK right now via `git rev-parse --verify`.
#     This is deliberate: git's own force-update code path (`branch -f`,
#     `branch -D`) reports the transaction's own <old-value> field as all-
#     zeroes even when a real prior value existed and is being discarded --
#     verified empirically below, and trusting that field would have let
#     exactly the two operations this hook exists for slip through under
#     their most common forced spelling.
#   - if the ref did not exist before (resolve fails): a brand new branch,
#     allow.
#   - if the new value is the all-zeroes object id: a deletion, refuse.
#   - if old == new: no-op, allow.
#   - otherwise require old to be an ancestor of new (`git merge-base
#     --is-ancestor`). Fast-forward commits and merge commits always satisfy
#     this (old is a parent of new). `reset --hard` to an earlier commit,
#     `branch -f` to anything not a descendant, and `commit --amend` (whose
#     result shares amend's parent, not the amended commit, so it is never a
#     descendant of what it replaces) all fail this check by construction --
#     which also happens to match this project's existing rule against
#     amending and rebasing rounds' commits.
#
# `refs/stash` GETS A DIFFERENT RULE, not the one above, because the one
# above would break ordinary stash use. Stash entries are not an ancestor
# chain -- each `git stash push` builds its commit from the CURRENT HEAD, not
# from the previous stash entry, so successive stash values routinely have no
# ancestor relationship at all even in completely legitimate use (verified
# 2026-09-16: two ordinary `stash push` calls in a row are NOT
# ancestor-related; requiring one anyway would refuse the second `stash push`
# on the very first legitimate use). So for `refs/stash` specifically:
#   - if the ref did not exist before: creation (`stash push` into an empty
#     stash), allow.
#   - if the new value is all-zeroes: deletion of the WHOLE stash (`stash
#     clear`, or dropping the last remaining entry -- verified these are the
#     only two shapes that reach this ref through a transaction at all,
#     see the header), refuse.
#   - otherwise (old and new both non-zero, old != new): allow, unconditionally,
#     with no ancestor check. This is deliberately permissive: it is exactly
#     the shape produced by `stash push`, and by dropping/popping a non-last
#     entry when that path DOES reach this hook (it usually does not, per the
#     header -- but if some other git version or code path ever changes that,
#     this rule must not start blocking ordinary stash use as a side effect).
#     The actual protection against a wrongful `stash drop`/`pop` of a
#     non-last entry lives in deny-destructive.sh's string match, not here --
#     see the header's "WHAT THIS IS NOT" for why this hook structurally
#     cannot do better.
#
# SAME-TRANSACTION RENAME, ATTEMPT 1 (F46 falsify pass, 2026-09-16 -- `git
# branch -m`/-M): the falsify pass's own hypothesis was that a rename is two
# lines in the SAME transaction -- one deleting the old name (new=all-zeroes),
# one creating the new name (old=all-zeroes, new=<the delete line's OLD
# value>) -- and that refusing the delete line the instant it is read, before
# the create line has been seen, is what produces the false positive.
#
# THAT HYPOTHESIS IS EMPIRICALLY FALSE for this host's git (2.53.0, files ref
# backend), and this project's own rule (`CLAUDE.md` root rule, "断言的保鲜期
# 规则": verify by running, a reasonable-sounding root cause is not evidence)
# applies to a bug report as much as to anything else in this repo. Traced
# 2026-09-16 with a logging stub in place of this hook plus
# `GIT_TRACE2_EVENT`: `git branch -m master renamed` fires the hook exactly
# THREE times (aborted, prepared, committed) for the WHOLE command, and EVERY
# one of those three calls carries exactly ONE line -- deleting
# refs/heads/master. `refs/heads/renamed` never appears on this hook's stdin
# at all, in any state, for this command. Polling `refs/heads/*` from inside
# the hook confirms why: at "prepared" (the only point a refusal is even
# possible) the new ref does not exist anywhere on disk yet; it is written
# directly, with no reference-transaction event of its own, only AFTER the
# hook for the delete has already returned and the delete has committed. So
# the two-line-same-transaction shape below is real (verified independently
# with `git update-ref --stdin` combining a delete and a create in one
# transaction -- that genuinely does produce two lines in one "prepared"
# call) but it is NOT the shape `git branch -m`/-M produces, so keeping only
# this check would still refuse the exact repro this fix exists for. See the
# SECOND, separate mechanism below ("PARENT-PROCESS FALLBACK") that actually
# closes that repro; this one is kept because it is independently correct for
# the shape it does cover, not because it fixes the reported bug by itself.
#
# THE MATCH RULE, stated precisely because it is also the thing an adversarial
# round could try to abuse: a `refs/heads/X` deletion (new=zero) is allowed as
# a rename IFF some OTHER line in the SAME transaction is a `refs/heads/Y`
# (Y != X) whose NEW value is exactly equal to X's OLD value (X's on-disk oid
# right before this transaction, i.e. what `git rev-parse --verify refs/heads/X`
# resolves to). That is deliberately narrow:
#   - It requires the SAME oid to reappear under a new name, not merely "some
#     other ref changed in this transaction" -- a round cannot smuggle a real
#     `update-ref -d refs/heads/victim` past this by pairing it with an
#     unrelated create of `refs/heads/decoy` at a DIFFERENT oid; the oid
#     equality check fails and the deletion is still refused. Tested below
#     (verify-reference-transaction.sh's "adversarial" section) by deleting a
#     ref while creating a same-transaction decoy at an unrelated commit.
#   - It is scoped to refs/heads/* on BOTH sides on purpose, not to
#     refs/tags/* or refs/wip/*. Renaming a branch to a name that collides
#     with an existing tag or wip ref does not take this path at all:
#     `git branch -m master v1` where `v1` is already a tag does not delete
#     refs/tags/v1, it creates/updates refs/heads/v1 alongside it (branches
#     and tags are different ref namespaces; git never conflates them) --
#     confirmed empirically below.
#   - WHAT THIS IS NOT: `git branch -c old new` (copy, not move) never deletes
#     `old` in the first place -- there is no zero-new line for it to pair
#     with, so it never enters this code path at all (empirically confirmed,
#     2026-09-16 scratch repo: a `branch -c` transaction contains exactly one
#     refs/heads line, the creation of `new`; `old` does not appear). Nothing
#     here treats a copy as a rename or vice versa.
#   - The paired create/update line for Y still goes through its OWN normal
#     decision below (ancestor check if Y already existed at a different
#     value) -- this rule only ever changes whether X's DELETION is refused,
#     never whether Y's own write is allowed.
#
# PARENT-PROCESS FALLBACK (the mechanism that actually closes the reported
# repro): reference-transaction structurally cannot see `refs/heads/Y` being
# created, because on this git it never happens through a transaction at all.
# The signal that IS available at "prepared" time: this hook's own PPID is
# always the `git` process running the exact command performing this
# transaction -- git invokes hooks directly (no intermediate shell), and this
# holds whether that `git` was launched from bash, from a python
# `subprocess.run(["git", ...])`, or anything else, because the hook's parent
# is never the launcher, it is always git itself (verified 2026-09-16: `ps -p
# $PPID` during all three aborted/prepared/committed calls of a rename shows
# the literal command `git branch -m tbX tbY`, stable across the whole
# transaction). This is not a string the invoker gets to choose the spelling
# of the way a wrapping shell command can be obfuscated -- it is git's own
# argv, and there is no channel for a round to make git's own C code delete
# some OTHER ref while its own argv says `branch -m`: the verb is what
# decides which ref gets deleted. So: for a `refs/heads/X` deletion not
# already matched by the same-transaction rule above, additionally allow it
# if the parent process's argv contains `branch` followed later by `-m`,
# `-M`, or `--move` (git branch's actual rename flags, confirmed via
# `git branch -h`; there is no separate `--move-force` spelling, `-M` is
# `--move --force` bundled). Consequence, and it is intentional: an
# alias-based rename (`git -c alias.rn='branch -m' rn X Y`) is NOT recognised
# here, because alias expansion happens inside git's C code and `ps` shows
# the pre-expansion argv (`git rn X Y`) -- that is a false NEGATIVE (still
# refused, run it yourself), never a false positive, so it is safe to leave
# open rather than trying to out-guess every alias shape.
#
# RENAME RECOVERY ANCHOR (F85 fix, 2026-09-17): the PARENT-PROCESS FALLBACK
# above closes the false-positive (a legitimate `branch -m`/-M is no longer
# refused). It does NOT close a separate, real gap discovered while
# reproducing it: `git branch -m old new` is NOT atomic on this host's git
# (2.53.0, files ref-storage backend). Empirically (poll-and-kill harness,
# /tmp scratch repo, 2026-09-17, see tools/loop/hooks/verify-rename-recovery.sh):
# git deletes refs/heads/old THROUGH THIS HOOK (the transaction this comment
# block is about), and only AFTER that transaction has fully committed and
# this hook has returned does git write refs/heads/new -- directly, with NO
# reference-transaction event of its own (same fact already established above
# for why refs/heads/new never appears on this hook's stdin at all). If the
# `git branch -m` process is killed in the window between "old ref deleted"
# and "new ref written", the branch is gone under BOTH names: this is a real,
# reproduced, permanent loss of a friendly ref to the commit, not a
# theoretical one.
#
# This hook cannot make git's own two-step rename atomic -- that is git's C
# code, not this hook's. What it CAN do, because it runs synchronously and
# fully inside the SAME process invocation that is about to allow the delete,
# is durably pin the commit under a DIFFERENT, never-deleted ref name before
# returning success -- so a kill in that window loses the friendly name but
# never loses the commit's reachability. Mechanism: immediately before
# allowing a refs/heads/X deletion via the parent-process-fallback path
# (i.e. exactly the case with no same-transaction pair to fall back on),
# `git update-ref refs/rename-recovery/<X-sanitized>-<old-oid>-<epoch>-<pid>
# <old-oid>` is run right here, synchronously, before this hook exits 0. That
# ref write does not depend on git's own rename completing at all -- it is a
# completely separate ref, created by this hook's own `git update-ref` call,
# which either lands on disk before this hook returns (in which case it is
# there no matter what happens to the rest of the `branch -m` afterward) or
# it does not run at all (this hook never got to "prepared", nothing was
# allowed either). There is no window where the delete is permitted but the
# anchor write has not yet been attempted.
#
# Naming is deliberately collision-safe rather than reusing X as-is: the oid,
# a wall-clock timestamp, and this hook's own pid are all folded into the ref
# name specifically so that (a) renaming branches that happen to share a name
# at different times never overwrites an earlier anchor, and (b) two
# concurrent renames (unlikely for the same name, but not impossible) do not
# race on the same ref name. refs/rename-recovery/* is added to the SAME
# protected namespace as refs/heads/*, refs/tags/*, refs/wip/* below (NS=strict)
# so an anchor, once written, is itself refused deletion by this same hook --
# it is meant to be a durable, append-only safety net, not another mutable
# ref a later round could clean up by mistake. Consequence, stated plainly:
# these accumulate forever and are NOT garbage collected by anything in this
# repo. That is intentional (this is a blast-radius limiter, not tidy
# housekeeping) but it is a real, known cost -- a human who wants to prune
# confirmed-safe old anchors does so manually, the same "move the hook aside"
# friction as every other override in this file.
#
# WHAT THIS DOES NOT COVER (stated as plainly as the rest of this header):
#   - It only fires for the parent-process-fallback path, i.e. only for
#     renames git implements as this hook actually seeing. If some future git
#     version changes `branch -m` to not go through a reference-transaction
#     hook call for the delete at all, this anchor is never written -- this
#     mechanism rides on the same empirical fact (2026-09-17, this host's
#     git) as the fallback rule itself, not a documented git guarantee.
#   - The `git update-ref` call for the anchor can itself fail (disk full,
#     permissions). This hook does NOT refuse the rename in that case -- it
#     logs a warning to stderr and allows the delete anyway, on the
#     reasoning that turning a rare local I/O failure into a blocked
#     everyday `branch -m` would be a worse false positive than the (already
#     rare -- it requires a kill in a narrow window) case this anchor
#     protects against. This means the anchor's guarantee is "best effort
#     durable", not "provably always written" -- see
#     verify-rename-recovery.sh for the measured lost-count with and without
#     this mechanism, including this failure mode left untested (would
#     require simulating disk-full inside the harness, not done).
#   - It recovers the COMMIT, not the FRIENDLY NAME. After a kill in the
#     window, `refs/heads/new` still does not exist and `refs/heads/old` is
#     still gone -- a human (or a follow-up automated step) must notice and
#     run `git branch new refs/rename-recovery/<...>` themselves. This
#     mechanism's contract is "no permanent unrecoverable loss of history",
#     not "the rename always finishes".
#
# F86, PART (a) -- STASH-DROP + REFLOG-EXPIRE + GC-PRUNE (2026-09-17,
# empirically exhausted, not guessed; CORRECTED 2026-09-17, see the
# "F86(a) CORRECTION" block immediately after this one -- read both, the
# analysis below is still accurate, the CONCLUSION it originally reached is
# not):
# The three-step sequence (drop a non-last stash entry, `git reflog expire
# --expire=now --all`, `git gc --prune=now`) permanently deletes the dropped
# object. Verified end to end in a scratch repo, WITH this hook installed,
# both via plain bash-invoked git and via
# `python3 -c "import subprocess; subprocess.run(['git', ...])"` for each of
# the three steps: after all three, `git cat-file -t <dropped-oid>` returns
# rc=128 "could not get object info" -- real, reproduced, permanent loss.
#   - `git stash drop <non-last>` and `git reflog expire` each independently
#     produce ZERO reference-transaction events (confirmed with a logging
#     stub in place of this hook): neither is a ref-VALUE update, so this
#     hook's only sensor -- the `reference-transaction` hook itself -- cannot
#     be invoked for either. This was already known (see the "WHAT THIS IS
#     NOT" section above for stash); F86 additionally confirmed reflog-expire
#     has the identical blind spot.
#   - `git gc --prune=now` DOES fire this hook, but only incidentally and too
#     late to help: internally it runs `git pack-refs --all --prune`, which
#     transiently deletes each loose ref (reported to this hook as
#     old=<real>, new=all-zeroes) before writing it back packed. For
#     `refs/stash` specifically that transient delete IS refused by the
#     existing stash policy above ("deletes refs/stash entirely") -- but
#     empirically (2026-09-17) `git gc`'s own C code does not treat a failed
#     pack-refs sub-step as fatal to the run: it prints
#     "error: failed to run pack-refs" to stderr and CONTINUES, still exits
#     rc=0, and still runs its object-pruning phase, which is a completely
#     separate operation (deleting now-unreachable loose objects, not a ref
#     update) that fires no hook at all. The refusal is real but inert: by
#     the time this hook is even asked about the ref, it is already too late
#     to stop the prune that actually destroys the object, and nothing in
#     `git gc`'s own exit-status handling lets a hook's refusal of one
#     internal sub-step abort the rest of the run.
#   - `pre-auto-gc` (the only other candidate git ships) is documented by
#     git's own `githooks(5)` as invoked ONLY by `git gc --auto`, and this was
#     verified directly (2026-09-17, `git help githooks`: "This hook is
#     invoked by git gc --auto"): a `pre-auto-gc` script that unconditionally
#     exits 1 was confirmed to fire and abort `git gc --auto` once the
#     `gc.auto` loose-object threshold was exceeded, proving the hook
#     mechanism itself works -- and the SAME script was confirmed to NEVER
#     fire for plain `git gc` or `git gc --prune=now`, with or without a
#     `gc.auto` threshold set, across multiple repeated runs. Even if it did
#     fire for manual invocations, `pre-auto-gc` cannot distinguish
#     `--prune=now` from git's own safe default (`gc.pruneExpire`, 2 weeks) --
#     it takes no arguments -- so it would not usefully gate this specific
#     threat model even where it applies.
# CONCLUSION AS ORIGINALLY WRITTEN (2026-09-17, morning pass -- KEPT FOR THE
# RECORD, BUT SEE THE CORRECTION BLOCK BELOW, WHICH SUPERSEDES IT): with
# `stash drop`/`reflog expire` invisible to every git hook and `git gc`'s
# object-pruning phase invisible to every git hook, F86 criterion (a) as
# phrased -- "the sequence must either be refused, or must leave the dropped
# object retrievable afterward" -- was judged UNSATISFIABLE, because every
# analysis above was scoped to REFUSING or intercepting the destructive
# steps themselves. That framing missed the criterion's own second clause:
# the object does not need to be protected AT drop/expire/gc time if it was
# already durably pinned under a DIFFERENT ref BEFORE any of those three
# steps ran -- the exact same idea already shipped for `branch -m` earlier
# in this file (RENAME RECOVERY ANCHOR) was not applied here on the first
# pass. It should have been; see the correction immediately below.
#
# F86(a) CORRECTION (2026-09-17, later same day, falsify pass): the original
# analysis above is still accurate on every point it actually measured --
# `stash drop`/`reflog expire` genuinely fire zero reference-transaction
# events, and `git gc --prune=now`'s object-pruning phase genuinely fires
# none either. What was wrong is the CONCLUSION drawn from those facts: this
# hook does not need to see or refuse the drop/expire/gc steps at all if it
# durably anchors the stash commit at PUSH time, before any of those steps
# exist to run. `git stash push` DOES fire this hook -- empirically
# confirmed (2026-09-17, logging-stub harness, hook installed BEFORE either
# push): a `refs/stash` transaction fires for the FIRST push into an empty
# stash (case handled at the "ref did not exist before this transaction"
# site above) and, separately, for every subsequent push on top of an
# existing entry (the `NS = stash`, non-zero -> non-zero case handled
# further below) -- and BOTH shapes report OLD=all-zeroes on stdin
# regardless of whether a prior stash value truly existed (same
# force-update-hides-old-value quirk this file already documents for
# `branch -f`), which is why the code below decides create-vs-update via
# `git rev-parse --verify` (RESOLVED) rather than trusting stdin's OLD
# field, exactly like the refs/heads/* logic already does.
# `_write_stash_push_anchor` (defined below, mirroring
# `_write_rename_recovery_anchor`'s shape) is called from BOTH of those
# sites and pins the pushed commit under `refs/stash-anchor/<oid>-<epoch>-
# <pid>` -- a durable, ordinary ref, not a reflog entry, so it is untouched
# by `reflog expire` and is a real (reachable) reference by the time `git gc
# --prune=now` runs its object-pruning phase, which only deletes objects
# unreachable from ANY ref. Verified end to end (2026-09-17, scratch repo,
# hook installed BEFORE the stash pushes -- see the ordering-bug note in
# verify-reference-transaction.sh's F86(a) section for why that ordering
# matters and was originally wrong there too): push two stash entries, drop
# the non-last one, `git reflog expire --expire=now --all`, `git gc
# --prune=now`, and `git cat-file -t <dropped-oid>` still succeeds --
# because the anchor ref, not the stash's own reflog entry, is what keeps it
# reachable.
# WHAT THIS DOES AND DOES NOT COVER, stated as plainly as the rest of this
# file's other anchor mechanisms:
#   - It only anchors stash entries created AFTER this corrected hook was
#     installed. A stash pushed under the OLD hook (or with no hook at all)
#     was never anchored and drop+expire+gc still destroys it exactly as
#     the original analysis found -- this is not retroactive.
#   - It recovers the COMMIT, not stash's place in the stash list or its
#     message metadata associated only with the reflog entry (e.g. branch
#     name it was stashed from, if that is not otherwise recoverable from
#     the commit itself) -- same "commit survives, friendly framing does
#     not" contract as RENAME RECOVERY ANCHOR above. A human recovers it via
#     `git stash apply <anchor-oid>` or `git branch <name> <anchor-oid>`.
#   - Anchors accumulate forever and are NOT garbage collected by anything
#     in this repo, same accepted tradeoff as refs/rename-recovery/* above --
#     every legitimate `stash push`, not just ones that later get dropped,
#     leaves a permanent anchor ref behind. A human who wants to prune
#     confirmed-safe old anchors does so manually.
#   - This closes criterion (a) for the STASH-PUSH shape specifically. It
#     does nothing for `reflog expire` run against non-stash reflogs (e.g.
#     `refs/heads/*` reflogs) losing a commit that was ONLY reachable via
#     that reflog and no live ref -- that is a materially different
#     scenario (no corresponding "creation" transaction analogous to `stash
#     push` to hang an anchor off of in the general case) and is not claimed
#     to be covered here.
# See verify-reference-transaction.sh's F86(a) section for the runnable,
# now-gating (not NOTE-only) check that keeps this finding falsifiable, plus
# its negative control (hook with the anchor call removed still loses the
# object).
#
# F86(a) SECOND CORRECTION (2026-09-17, second falsify pass on the fix
# above): two defects found, both fixed here, neither yet covered by a fresh
# falsify pass of ITS OWN as of this comment --
#   1. REFTABLE BACKEND: `_write_stash_push_anchor`'s nested `git update-ref`
#      cannot run inside git's own reftable transaction (`git init
#      --ref-format=reftable`), so on that backend the anchor write always
#      failed and the original fix here degraded to a stderr-only WARNING
#      while still allowing the push -- i.e. it silently protected nothing on
#      that backend while claiming to. Changed to a hard refusal
#      (BLOCK+REASON) at both call sites instead of a warning: if this hook
#      cannot anchor a stash push, it now refuses the push rather than
#      allowing an unprotected one. This project's actual trees all use the
#      default "files" backend (`git rev-parse --show-ref-format` in each),
#      so this refusal path is not expected to fire in practice here, but it
#      is the correct behavior if that ever changes.
#   2. STALE INSTALLED HOOKS: the fix in this file existed in source control
#      but `.git/hooks/reference-transaction` in all three of this project's
#      working trees still had the PRE-anchor version installed (missing
#      `_write_stash_push_anchor` entirely) until
#      `tools/loop/hooks/install-reference-transaction.sh install` was
#      re-run on 2026-09-17 -- i.e. the fix had never actually been deployed
#      anywhere it would run. Re-run that installer's `--check` mode after
#      any change to this file; nothing does so automatically.
#
# F86, PART (b) -- `branch -M <src> <dst>` WHERE <dst> PRE-EXISTS WITH
# DIVERGING HISTORY (2026-09-17): the falsify pass that opened this card
# asserted "today only <src>'s prior tip gets anchored; <dst>'s prior tip does
# not." That assertion is EMPIRICALLY FALSE for this host's git (2.53.0,
# files backend), verified directly against the unmodified, already-committed
# hook (not a hypothetical fix): `git branch -M src dst` where `dst` exists
# and points at a commit unreachable from `src` fires TWO INDEPENDENT
# `reference-transaction` "prepared" calls, not one combined transaction --
# one deleting `refs/heads/src` (git reports its real old value), and a
# SEPARATE, LATER one for `refs/heads/dst` (git reports old=new=all-zeroes
# for this one, same force-update-hides-old-value behavior the "HOW IT
# DECIDES" section above already documents for `branch -f`/`branch -D`, which
# is exactly why this hook resolves the ref's true prior value itself via
# `git rev-parse --verify` rather than trusting git's own old-value field).
# Because the PARENT-PROCESS FALLBACK rule above is written per-ref, not
# per-name -- it fires for ANY `refs/heads/X` deletion in a transaction whose
# parent argv is a branch move, whichever X that happens to be -- `dst`'s
# deletion independently qualifies for the exact same fallback as `src`'s,
# and `_write_rename_recovery_anchor` runs for `dst` too, pinning `dst`'s true
# prior oid before the delete is allowed. Verified twice (2026-09-17, scratch
# repo, unmodified hook): both the diverging case and, separately, a
# fast-forward-shaped case (`dst` an ancestor of the new tip) leave TWO
# anchors on disk afterward, `refs/rename-recovery/src-<oid>-...` and
# `refs/rename-recovery/dst-<oid>-...`, each pinning the correct pre-image --
# `git for-each-ref refs/rename-recovery` after the command shows both, and
# `<dst>`'s prior tip is not lost, only its friendly name is (recoverable via
# `git branch <name> refs/rename-recovery/<...>`, same as `src`'s case,
# already documented above). No code change was needed for this part: the
# generic, name-agnostic shape of the existing fallback already covers it.
# Negative control and the full repro are in verify-reference-transaction.sh's
# F86(b) section, including a run against the hook as it stood immediately
# before the F85 anchor commit (5a4eb1b~1, no `_write_rename_recovery_anchor`
# call at all) to prove the check actually distinguishes "anchored" from "not
# anchored" rather than passing regardless.
#
# No override environment variable, on purpose, same reasoning as
# deny-destructive.sh: an override is the first thing a confused agent would
# find and set. A human who actually needs one of these operations runs it in
# their own terminal after temporarily moving this file aside (see
# install-reference-transaction.sh's header for the exact command) --
# deliberate friction, not a flag.
set -u
STATE="${1:-}"
ZERO="0000000000000000000000000000000000000000"

# Captured once, at top level, BEFORE any subshell -- $PPID inside a subshell
# reflects the subshell's own parent (the running script itself, since a
# subshell is a fork of it), not the script's parent, so this must be read
# here and threaded through rather than re-read inside the function below.
_HOOK_PPID="$PPID"

# See the "PARENT-PROCESS FALLBACK" header comment above for why this exists
# and what it does and does not catch. Runs in a subshell purely so `set -f`
# (needed so a branch name containing a glob character like `*` doesn't
# expand against this process's cwd during word-splitting) doesn't leak into
# the rest of the script.
_parent_is_branch_move() {
  (
    set -f
    _pcmd=$(ps -ww -o command= -p "$_HOOK_PPID" 2>/dev/null) || exit 1
    [ -n "$_pcmd" ] || exit 1
    _seen_branch=
    for _tok in $_pcmd; do
      if [ -n "$_seen_branch" ]; then
        case "$_tok" in
          -m|-M|--move) exit 0 ;;
        esac
      fi
      case "$_tok" in
        branch) _seen_branch=1 ;;
      esac
    done
    exit 1
  )
}

# See the "RENAME RECOVERY ANCHOR" header comment above. Writes a durable
# ref pinning $2 (an oid) under a new, never-reused, never-deleted name
# derived from $1 (the refs/heads/X ref about to be deleted) before this
# hook returns success for that deletion. Best-effort: a failure here is
# logged but does not itself block the rename (see header for why).
_write_rename_recovery_anchor() {
  _rr_ref=$1
  _rr_oid=$2
  _rr_sanitized=$(printf '%s' "${_rr_ref#refs/heads/}" | tr '/' '_')
  _rr_anchor="refs/rename-recovery/${_rr_sanitized}-${_rr_oid}-$(date +%s)-$$"
  if ! git update-ref "$_rr_anchor" "$_rr_oid" 2>/dev/null; then
    echo "reference-transaction: WARNING failed to write recovery anchor $_rr_anchor for $_rr_ref (was $_rr_oid) -- allowing the rename anyway, see F85 fix notes in this file's header" >&2
  fi
}

# See "F86, PART (a) -- STASH-PUSH ANCHOR" header comment above. Writes a
# durable ref pinning $1 (an oid that a `refs/stash` transaction just made
# the new value, i.e. a `git stash push` result) under a new, never-reused,
# never-deleted name -- called for EVERY refs/stash transaction line this
# hook sees with a real (non-zero) NEW value, whether that line is the very
# first push into an empty stash or a push on top of an existing one (both
# shapes are handled at their respective call sites below; see the header
# for why the SAME code cannot also anchor `stash drop`/`stash pop` of a
# non-last entry -- those never produce a transaction for this hook to see
# in the first place, so there is no call site for them).
#
# NOT best-effort (2026-09-17 correction, second falsify pass on this
# function): a nested `git update-ref` cannot run inside the reftable
# backend's transaction (`git init --ref-format=reftable`), so on that
# backend this call ALWAYS fails -- silently warning and allowing the push
# anyway would mean F86(a) protects nothing at all there while claiming to.
# Sets $_ANCHOR_FAILED=1 instead; callers must turn that into BLOCK+REASON
# so the push is refused rather than silently unprotected. The files backend
# (this project's actual backend, `git rev-parse --show-ref-format`) is
# unaffected -- this only fires on reftable, which is exercised by
# verify-reference-transaction.sh's reftable negative control.
_write_stash_push_anchor() {
  _sp_oid=$1
  _sp_anchor="refs/stash-anchor/${_sp_oid}-$(date +%s)-$$"
  if ! git update-ref "$_sp_anchor" "$_sp_oid" 2>/dev/null; then
    echo "reference-transaction: refused -- could not write stash anchor $_sp_anchor for refs/stash (was $_sp_oid); this backend (see 'git rev-parse --show-ref-format') cannot anchor a stash push inside this hook, so F86(a) cannot protect it -- see this file's header" >&2
    _ANCHOR_FAILED=1
  fi
}

if [ "$STATE" != "prepared" ]; then
  cat >/dev/null   # drain stdin for committed/aborted calls, then no-op
  exit 0
fi

# Pass 1: buffer every relevant line of the transaction. Must happen before
# any decision is made -- see the rename comment above for why a single pass
# cannot tell a rename from a deletion.
declare -a REFS NEWS
COUNT=0
while read -r _OLD_FIELD NEW REF; do
  case "$REF" in
    refs/heads/*|refs/tags/*|refs/wip/*|refs/stash|refs/rename-recovery/*|refs/stash-anchor/*) : ;;
    *) continue ;;
  esac
  case "$NEW" in
    ref:*) continue ;;   # symbolic-ref target line, not an oid update
  esac
  REFS[COUNT]=$REF
  NEWS[COUNT]=$NEW
  COUNT=$((COUNT + 1))
done

BLOCK=0
REASON=""
_i=0
while [ "$_i" -lt "$COUNT" ]; do
  REF=${REFS[$_i]}
  NEW=${NEWS[$_i]}
  case "$REF" in
    refs/heads/*|refs/tags/*|refs/wip/*|refs/rename-recovery/*|refs/stash-anchor/*) NS=strict ;;
    refs/stash) NS=stash ;;
  esac

  RESOLVED=$(git rev-parse --verify --quiet "$REF" 2>/dev/null)
  if [ -z "$RESOLVED" ]; then
    if [ "$NS" = "stash" ] && [ "$NEW" != "$ZERO" ]; then
      # First-ever `stash push` into an empty stash -- empirically (see F86
      # header) this git reports OLD=all-zeroes on stdin for EVERY refs/stash
      # transaction, creation or update alike (the same force-update-hides-
      # old-value quirk already documented above for `branch -f`), so this
      # is the only place a brand-new stash's oid is ever seen; anchor it
      # here rather than trusting stdin's OLD field to tell create from
      # update.
      _ANCHOR_FAILED=
      _write_stash_push_anchor "$NEW"
      if [ -n "$_ANCHOR_FAILED" ]; then
        BLOCK=1
        REASON="could not anchor new refs/stash entry $NEW before allowing the push (see stderr above) -- refusing rather than allowing an unprotected stash"
      fi
    fi
    _i=$((_i + 1))
    continue   # ref did not exist before this transaction: creation (or BLOCK set above), either way go to next line
  fi
  if [ "$NEW" = "$ZERO" ]; then
    # Same-transaction rename check -- refs/heads/* only, see header above.
    if [ "$NS" = "strict" ]; then
      case "$REF" in
        refs/heads/*)
          _renamed=
          _j=0
          while [ "$_j" -lt "$COUNT" ]; do
            if [ "$_j" != "$_i" ]; then
              OREF=${REFS[$_j]}
              ONEW=${NEWS[$_j]}
              case "$OREF" in
                refs/heads/*)
                  if [ "$OREF" != "$REF" ] && [ "$ONEW" != "$ZERO" ] && [ "$ONEW" = "$RESOLVED" ]; then
                    _renamed=1
                  fi
                  ;;
              esac
            fi
            _j=$((_j + 1))
          done
          if [ -n "$_renamed" ]; then
            _i=$((_i + 1))
            continue   # allow: X's old oid reappears as some other refs/heads/Y in this same transaction
          fi
          # No same-transaction pair -- the shape this git actually produces
          # for `branch -m`/-M (see "PARENT-PROCESS FALLBACK" above). Ask the
          # only other signal that can answer this: was the process running
          # this exact transaction itself a `branch -m`/-M/--move invocation?
          if _parent_is_branch_move; then
            _write_rename_recovery_anchor "$REF" "$RESOLVED"
            _i=$((_i + 1))
            continue   # allow: this transaction's own process is a branch rename
          fi
          ;;
      esac
    fi
    BLOCK=1
    if [ "$NS" = "stash" ]; then
      REASON="deletes refs/stash entirely (was $RESOLVED) -- this is a whole-stash clear or the last remaining entry being dropped"
    else
      REASON="deletes ref $REF (was $RESOLVED)"
    fi
    _i=$((_i + 1))
    continue
  fi
  if [ "$RESOLVED" = "$NEW" ]; then
    _i=$((_i + 1))
    continue
  fi
  if [ "$NS" = "stash" ]; then
    # Non-zero -> non-zero on refs/stash: push/pop/drop, no ancestor
    # relationship required even for legitimate use -- see the header and
    # the "HOW IT DECIDES" refs/stash section for why. Anchor $NEW before
    # allowing: the only shape empirically observed to reach this line is a
    # `stash push` on top of an existing entry (see F86 header) -- dropping
    # a non-last entry never fires this hook at all -- but anchoring
    # unconditionally here is harmless even if some other git version ever
    # routes a drop/pop through this line, since pinning an oid that was
    # about to be dropped anyway costs nothing and only helps.
    _ANCHOR_FAILED=
    _write_stash_push_anchor "$NEW"
    if [ -n "$_ANCHOR_FAILED" ]; then
      BLOCK=1
      REASON="could not anchor updated refs/stash entry $NEW (was $RESOLVED) before allowing the push (see stderr above) -- refusing rather than allowing an unprotected stash"
    fi
    _i=$((_i + 1))
    continue
  fi
  if ! git merge-base --is-ancestor "$RESOLVED" "$NEW" 2>/dev/null; then
    BLOCK=1
    REASON="non-fast-forward update of $REF ($RESOLVED -> $NEW): this discards commits reachable only from the old value"
  fi
  _i=$((_i + 1))
done

if [ "$BLOCK" = 1 ]; then
  echo "reference-transaction: refused -- $REASON" >&2
  echo "reference-transaction: run it yourself in your own terminal if you mean it (see tools/loop/hooks/install-reference-transaction.sh)." >&2
  exit 1
fi
exit 0
