#!/bin/bash
# Refuses local ref rewrites/deletions -- reset --hard, branch -D, branch -f
# backward, commit --amend, filter-branch, etc. -- at the layer git itself
# always consults, no matter what process or language asked git to do it.
#
# WHY THIS EXISTS ON TOP OF deny-destructive.sh: that hook pattern-matches the
# literal Bash command STRING. Its own header already says what that is not
# good for: `python3 -c "import subprocess; subprocess.run(['git','reset',
# '--hard','HEAD~3'])"` never contains the substring "git reset --hard" (it's
# split across a Python list), so a string scanner cannot and does not catch
# it -- verified empirically, see verify-reference-transaction.sh. This file
# is NOT a second string scanner with a different regex; it does not look at
# the command that invoked git at all. It is installed as git's own
# `reference-transaction` hook (git >= 2.28), which git fires for essentially
# every local ref create/update/delete -- from bash, from a Python
# subprocess, from a shell alias, from another program entirely -- because it
# is git's own C code running the transaction, not a shell parsing a string.
# There is no command string here to lose to quoting tricks.
#
# COVERAGE (2026-09-16 extended from refs/heads/* only -- F46 falsify pass):
# refs/heads/*, refs/tags/*, and refs/wip/* (this project's anchor namespace,
# see docs/LOOP_CONTRACT.md) all get the SAME policy below (deletion refused,
# non-fast-forward rewrite refused). refs/stash gets a DIFFERENT, narrower
# policy -- see the dedicated comment above the stash branch in the loop
# below for exactly why the heads policy cannot simply be reused there.
#
# WHAT THIS IS NOT (read this before trusting it further than it goes):
#   - It only fires on REF updates. `git checkout -f` on the SAME branch and
#     `git clean -fdx` and `git restore .` discard working-tree/index content
#     without moving any ref, so this hook never sees them. That destruction
#     mode is still only covered by deny-destructive.sh's string match, which
#     a python-subprocess call defeats the same way it defeats "git reset
#     --hard". This is a known, intentional, and currently OPEN gap -- see
#     the negative-control notes for what was and was not exercised.
#   - `git reset --hard` while HEAD is DETACHED is a separate, DELIBERATE,
#     VERIFIED-OPEN gap, not an oversight. Empirically (2026-09-16, scratch
#     repo): while detached, git fires a reference-transaction update for the
#     literal ref name `HEAD` (old detached OID -> new OID) on BOTH a hard
#     reset AND on plain navigation via checkout to an older commit -- the
#     two produce the byte-for-byte identical transaction shape, because
#     browsing history backward while detached is exactly as "non-descendant"
#     as discarding it. Blocking non-fast-forward updates to `HEAD` the way
#     refs/heads/* is blocked below would refuse ordinary detached-HEAD
#     history browsing as a false positive -- ruled out by this project's own
#     standard (deny-destructive.sh's header: false positives cost as much as
#     false negatives). No git-native hook can tell these two apart, because
#     git itself cannot: the difference is operator intent, not ref state.
#     deny-destructive.sh denies the literal string "git reset --hard"
#     regardless of HEAD state, which covers the bash-invoked spelling; the
#     python-subprocess bypass of THAT (this hook was never going to catch
#     it, for the reason above, so there is nothing here for a subprocess
#     call to bypass) remains open, same limitation as every string-scan
#     case in that file.
#   - `git stash drop` / `git stash pop` of anything OTHER than the very last
#     remaining stash entry NEVER reaches this hook at all. Empirically
#     verified (2026-09-16, scratch repo, 2-entry stash): dropping stash@{0}
#     out of 2 produces ZERO reference-transaction events for refs/stash --
#     git implements that as reflog surgery (the same underlying mechanism
#     `git reflog expire` uses), not a ref-update transaction. Only two
#     shapes touch refs/stash through this hook: creating it from nothing
#     (first `stash push`) and deleting it entirely (`stash clear`, or
#     dropping the LAST remaining entry) -- both handled below. The
#     multi-entry-drop shape is NOT closeable by this mechanism; it is
#     covered, bash-invocation only, by deny-destructive.sh's string match on
#     "git stash drop" / "git stash pop" / "git stash clear" (same
#     python-subprocess limitation as everywhere else in that file).
#   - It is local-repo-scoped. It cannot stop a force-push landing on a
#     remote; that is `pre-push`'s job (tools/loop/hooks/pre-push), which is
#     itself invocation-shape-independent for the same reason (git runs it
#     for `git push` regardless of invoker) and already gates on
#     FHP_ALLOW_PUSH rather than on command text.
#   - `core.hooksPath` and the hooks directory itself are ordinary git config
#     and ordinary files. A round that thinks to run
#     `git config core.hooksPath ""` or delete this file unsets this
#     protection, and reference-transaction cannot catch that (git isn't
#     doing a ref update when you edit its config). This is not a security
#     boundary against an adversary with full filesystem access to the
#     repo -- it is a blast-radius limiter against an unattended round
#     confidently doing the thing it always does (calling git), the same
#     framing as deny-destructive.sh.
#
# HOW IT DECIDES: for the "prepared" state of every transaction (the point at
# which refusing still aborts cleanly -- see `man githooks`), for each queued
# update to a `refs/heads/*`, `refs/tags/*`, or `refs/wip/*` ref:
#   - resolve the ref's value ON DISK right now via `git rev-parse --verify`.
#     This is deliberate: git's own force-update code path (`branch -f`,
#     `branch -D`) reports the transaction's own <old-value> field as all-
#     zeroes even when a real prior value existed and is being discarded --
#     verified empirically below, and trusting that field would have let
#     exactly the two operations this hook exists for slip through under
#     their most common forced spelling.
#   - if the ref did not exist before (resolve fails): a brand new branch,
#     allow.
#   - if the new value is the all-zeroes object id: a deletion, refuse.
#   - if old == new: no-op, allow.
#   - otherwise require old to be an ancestor of new (`git merge-base
#     --is-ancestor`). Fast-forward commits and merge commits always satisfy
#     this (old is a parent of new). `reset --hard` to an earlier commit,
#     `branch -f` to anything not a descendant, and `commit --amend` (whose
#     result shares amend's parent, not the amended commit, so it is never a
#     descendant of what it replaces) all fail this check by construction --
#     which also happens to match this project's existing rule against
#     amending and rebasing rounds' commits.
#
# `refs/stash` GETS A DIFFERENT RULE, not the one above, because the one
# above would break ordinary stash use. Stash entries are not an ancestor
# chain -- each `git stash push` builds its commit from the CURRENT HEAD, not
# from the previous stash entry, so successive stash values routinely have no
# ancestor relationship at all even in completely legitimate use (verified
# 2026-09-16: two ordinary `stash push` calls in a row are NOT
# ancestor-related; requiring one anyway would refuse the second `stash push`
# on the very first legitimate use). So for `refs/stash` specifically:
#   - if the ref did not exist before: creation (`stash push` into an empty
#     stash), allow.
#   - if the new value is all-zeroes: deletion of the WHOLE stash (`stash
#     clear`, or dropping the last remaining entry -- verified these are the
#     only two shapes that reach this ref through a transaction at all,
#     see the header), refuse.
#   - otherwise (old and new both non-zero, old != new): allow, unconditionally,
#     with no ancestor check. This is deliberately permissive: it is exactly
#     the shape produced by `stash push`, and by dropping/popping a non-last
#     entry when that path DOES reach this hook (it usually does not, per the
#     header -- but if some other git version or code path ever changes that,
#     this rule must not start blocking ordinary stash use as a side effect).
#     The actual protection against a wrongful `stash drop`/`pop` of a
#     non-last entry lives in deny-destructive.sh's string match, not here --
#     see the header's "WHAT THIS IS NOT" for why this hook structurally
#     cannot do better.
#
# SAME-TRANSACTION RENAME, ATTEMPT 1 (F46 falsify pass, 2026-09-16 -- `git
# branch -m`/-M): the falsify pass's own hypothesis was that a rename is two
# lines in the SAME transaction -- one deleting the old name (new=all-zeroes),
# one creating the new name (old=all-zeroes, new=<the delete line's OLD
# value>) -- and that refusing the delete line the instant it is read, before
# the create line has been seen, is what produces the false positive.
#
# THAT HYPOTHESIS IS EMPIRICALLY FALSE for this host's git (2.53.0, files ref
# backend), and this project's own rule (`CLAUDE.md` root rule, "断言的保鲜期
# 规则": verify by running, a reasonable-sounding root cause is not evidence)
# applies to a bug report as much as to anything else in this repo. Traced
# 2026-09-16 with a logging stub in place of this hook plus
# `GIT_TRACE2_EVENT`: `git branch -m master renamed` fires the hook exactly
# THREE times (aborted, prepared, committed) for the WHOLE command, and EVERY
# one of those three calls carries exactly ONE line -- deleting
# refs/heads/master. `refs/heads/renamed` never appears on this hook's stdin
# at all, in any state, for this command. Polling `refs/heads/*` from inside
# the hook confirms why: at "prepared" (the only point a refusal is even
# possible) the new ref does not exist anywhere on disk yet; it is written
# directly, with no reference-transaction event of its own, only AFTER the
# hook for the delete has already returned and the delete has committed. So
# the two-line-same-transaction shape below is real (verified independently
# with `git update-ref --stdin` combining a delete and a create in one
# transaction -- that genuinely does produce two lines in one "prepared"
# call) but it is NOT the shape `git branch -m`/-M produces, so keeping only
# this check would still refuse the exact repro this fix exists for. See the
# SECOND, separate mechanism below ("PARENT-PROCESS FALLBACK") that actually
# closes that repro; this one is kept because it is independently correct for
# the shape it does cover, not because it fixes the reported bug by itself.
#
# THE MATCH RULE, stated precisely because it is also the thing an adversarial
# round could try to abuse: a `refs/heads/X` deletion (new=zero) is allowed as
# a rename IFF some OTHER line in the SAME transaction is a `refs/heads/Y`
# (Y != X) whose NEW value is exactly equal to X's OLD value (X's on-disk oid
# right before this transaction, i.e. what `git rev-parse --verify refs/heads/X`
# resolves to). That is deliberately narrow:
#   - It requires the SAME oid to reappear under a new name, not merely "some
#     other ref changed in this transaction" -- a round cannot smuggle a real
#     `update-ref -d refs/heads/victim` past this by pairing it with an
#     unrelated create of `refs/heads/decoy` at a DIFFERENT oid; the oid
#     equality check fails and the deletion is still refused. Tested below
#     (verify-reference-transaction.sh's "adversarial" section) by deleting a
#     ref while creating a same-transaction decoy at an unrelated commit.
#   - It is scoped to refs/heads/* on BOTH sides on purpose, not to
#     refs/tags/* or refs/wip/*. Renaming a branch to a name that collides
#     with an existing tag or wip ref does not take this path at all:
#     `git branch -m master v1` where `v1` is already a tag does not delete
#     refs/tags/v1, it creates/updates refs/heads/v1 alongside it (branches
#     and tags are different ref namespaces; git never conflates them) --
#     confirmed empirically below.
#   - WHAT THIS IS NOT: `git branch -c old new` (copy, not move) never deletes
#     `old` in the first place -- there is no zero-new line for it to pair
#     with, so it never enters this code path at all (empirically confirmed,
#     2026-09-16 scratch repo: a `branch -c` transaction contains exactly one
#     refs/heads line, the creation of `new`; `old` does not appear). Nothing
#     here treats a copy as a rename or vice versa.
#   - The paired create/update line for Y still goes through its OWN normal
#     decision below (ancestor check if Y already existed at a different
#     value) -- this rule only ever changes whether X's DELETION is refused,
#     never whether Y's own write is allowed.
#
# PARENT-PROCESS FALLBACK (the mechanism that actually closes the reported
# repro): reference-transaction structurally cannot see `refs/heads/Y` being
# created, because on this git it never happens through a transaction at all.
# The signal that IS available at "prepared" time: this hook's own PPID is
# always the `git` process running the exact command performing this
# transaction -- git invokes hooks directly (no intermediate shell), and this
# holds whether that `git` was launched from bash, from a python
# `subprocess.run(["git", ...])`, or anything else, because the hook's parent
# is never the launcher, it is always git itself (verified 2026-09-16: `ps -p
# $PPID` during all three aborted/prepared/committed calls of a rename shows
# the literal command `git branch -m tbX tbY`, stable across the whole
# transaction). This is not a string the invoker gets to choose the spelling
# of the way a wrapping shell command can be obfuscated -- it is git's own
# argv, and there is no channel for a round to make git's own C code delete
# some OTHER ref while its own argv says `branch -m`: the verb is what
# decides which ref gets deleted. So: for a `refs/heads/X` deletion not
# already matched by the same-transaction rule above, additionally allow it
# if the parent process's argv contains `branch` followed later by `-m`,
# `-M`, or `--move` (git branch's actual rename flags, confirmed via
# `git branch -h`; there is no separate `--move-force` spelling, `-M` is
# `--move --force` bundled). Consequence, and it is intentional: an
# alias-based rename (`git -c alias.rn='branch -m' rn X Y`) is NOT recognised
# here, because alias expansion happens inside git's C code and `ps` shows
# the pre-expansion argv (`git rn X Y`) -- that is a false NEGATIVE (still
# refused, run it yourself), never a false positive, so it is safe to leave
# open rather than trying to out-guess every alias shape.
#
# No override environment variable, on purpose, same reasoning as
# deny-destructive.sh: an override is the first thing a confused agent would
# find and set. A human who actually needs one of these operations runs it in
# their own terminal after temporarily moving this file aside (see
# install-reference-transaction.sh's header for the exact command) --
# deliberate friction, not a flag.
set -u
STATE="${1:-}"
ZERO="0000000000000000000000000000000000000000"

# Captured once, at top level, BEFORE any subshell -- $PPID inside a subshell
# reflects the subshell's own parent (the running script itself, since a
# subshell is a fork of it), not the script's parent, so this must be read
# here and threaded through rather than re-read inside the function below.
_HOOK_PPID="$PPID"

# See the "PARENT-PROCESS FALLBACK" header comment above for why this exists
# and what it does and does not catch. Runs in a subshell purely so `set -f`
# (needed so a branch name containing a glob character like `*` doesn't
# expand against this process's cwd during word-splitting) doesn't leak into
# the rest of the script.
_parent_is_branch_move() {
  (
    set -f
    _pcmd=$(ps -ww -o command= -p "$_HOOK_PPID" 2>/dev/null) || exit 1
    [ -n "$_pcmd" ] || exit 1
    _seen_branch=
    for _tok in $_pcmd; do
      if [ -n "$_seen_branch" ]; then
        case "$_tok" in
          -m|-M|--move) exit 0 ;;
        esac
      fi
      case "$_tok" in
        branch) _seen_branch=1 ;;
      esac
    done
    exit 1
  )
}

if [ "$STATE" != "prepared" ]; then
  cat >/dev/null   # drain stdin for committed/aborted calls, then no-op
  exit 0
fi

# Pass 1: buffer every relevant line of the transaction. Must happen before
# any decision is made -- see the rename comment above for why a single pass
# cannot tell a rename from a deletion.
declare -a REFS NEWS
COUNT=0
while read -r _OLD_FIELD NEW REF; do
  case "$REF" in
    refs/heads/*|refs/tags/*|refs/wip/*|refs/stash) : ;;
    *) continue ;;
  esac
  case "$NEW" in
    ref:*) continue ;;   # symbolic-ref target line, not an oid update
  esac
  REFS[COUNT]=$REF
  NEWS[COUNT]=$NEW
  COUNT=$((COUNT + 1))
done

BLOCK=0
REASON=""
_i=0
while [ "$_i" -lt "$COUNT" ]; do
  REF=${REFS[$_i]}
  NEW=${NEWS[$_i]}
  case "$REF" in
    refs/heads/*|refs/tags/*|refs/wip/*) NS=strict ;;
    refs/stash) NS=stash ;;
  esac

  RESOLVED=$(git rev-parse --verify --quiet "$REF" 2>/dev/null)
  if [ -z "$RESOLVED" ]; then
    _i=$((_i + 1))
    continue   # ref did not exist before this transaction: creation, allow
  fi
  if [ "$NEW" = "$ZERO" ]; then
    # Same-transaction rename check -- refs/heads/* only, see header above.
    if [ "$NS" = "strict" ]; then
      case "$REF" in
        refs/heads/*)
          _renamed=
          _j=0
          while [ "$_j" -lt "$COUNT" ]; do
            if [ "$_j" != "$_i" ]; then
              OREF=${REFS[$_j]}
              ONEW=${NEWS[$_j]}
              case "$OREF" in
                refs/heads/*)
                  if [ "$OREF" != "$REF" ] && [ "$ONEW" != "$ZERO" ] && [ "$ONEW" = "$RESOLVED" ]; then
                    _renamed=1
                  fi
                  ;;
              esac
            fi
            _j=$((_j + 1))
          done
          if [ -n "$_renamed" ]; then
            _i=$((_i + 1))
            continue   # allow: X's old oid reappears as some other refs/heads/Y in this same transaction
          fi
          # No same-transaction pair -- the shape this git actually produces
          # for `branch -m`/-M (see "PARENT-PROCESS FALLBACK" above). Ask the
          # only other signal that can answer this: was the process running
          # this exact transaction itself a `branch -m`/-M/--move invocation?
          if _parent_is_branch_move; then
            _i=$((_i + 1))
            continue   # allow: this transaction's own process is a branch rename
          fi
          ;;
      esac
    fi
    BLOCK=1
    if [ "$NS" = "stash" ]; then
      REASON="deletes refs/stash entirely (was $RESOLVED) -- this is a whole-stash clear or the last remaining entry being dropped"
    else
      REASON="deletes ref $REF (was $RESOLVED)"
    fi
    _i=$((_i + 1))
    continue
  fi
  if [ "$RESOLVED" = "$NEW" ]; then
    _i=$((_i + 1))
    continue
  fi
  if [ "$NS" = "stash" ]; then
    _i=$((_i + 1))
    continue   # non-zero -> non-zero on refs/stash: push/pop/drop, no ancestor
               # relationship required even for legitimate use -- see the
               # header and the "HOW IT DECIDES" refs/stash section for why.
  fi
  if ! git merge-base --is-ancestor "$RESOLVED" "$NEW" 2>/dev/null; then
    BLOCK=1
    REASON="non-fast-forward update of $REF ($RESOLVED -> $NEW): this discards commits reachable only from the old value"
  fi
  _i=$((_i + 1))
done

if [ "$BLOCK" = 1 ]; then
  echo "reference-transaction: refused -- $REASON" >&2
  echo "reference-transaction: run it yourself in your own terminal if you mean it (see tools/loop/hooks/install-reference-transaction.sh)." >&2
  exit 1
fi
exit 0
