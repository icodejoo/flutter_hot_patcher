<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. Copy to ~/Library/LaunchAgents/ to install; see tools/loop/README.md.
  Kept in the repo so the schedule is reviewable, not folklore living in a
  directory nobody looks at.

  StartInterval fires on wake if the machine was asleep when a tick was due, so
  a closed laptop delays the loop rather than ending it. RunAtLoad is false on
  purpose: installing the job should not immediately start burning tokens.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.tbu.fhp.loop</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/Cruz/Documents/flutter_hot_patcher/tools/loop/run_round.sh</string>
  </array>

  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/Users/Cruz/Documents/flutter_hot_patcher/.loop/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/Cruz/Documents/flutter_hot_patcher/.loop/launchd.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd starts with a near-empty PATH; claude lives in homebrew. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>FHP_LOOP_PERMISSION_MODE</key>
    <string>acceptEdits</string>
  </dict>
</dict>
</plist>
