+// Gate 1 spike (flutter_hot_patcher): like Internal_loadDynamicModule, but
+// returns the entry-point Function wrapped in a Closure instead of invoking
+// it. Lets Dart code call the interpreted entry point synchronously and
+// repeatedly (a cached closure), instead of once via the Future-wrapped
+// public API. See spikes/gate1_mixed_execution/cases/v1_replace_existing_function.
+DEFINE_NATIVE_ENTRY(Internal_loadDynamicModuleClosure, 0, 1) {
+#if defined(DART_DYNAMIC_MODULES)
+  GET_NON_NULL_NATIVE_ARGUMENT(TypedDataBase, module_bytes,
+                               arguments->NativeArgAt(0));
+
+  const intptr_t length = module_bytes.LengthInBytes();
+  uint8_t* data = reinterpret_cast<uint8_t*>(::malloc(length));
+  if (data == nullptr) {
+    const auto& exception = Instance::Handle(
+        zone, thread->isolate_group()->object_store()->out_of_memory());
+    Exceptions::Throw(thread, exception);
+  }
+  {
+    NoSafepointScope no_safepoint;
+    // The memory does not overlap.
+    memcpy(data, module_bytes.DataAddr(0), length);  // NOLINT
+  }
+  const ExternalTypedData& typed_data = ExternalTypedData::Handle(
+      zone,
+      ExternalTypedData::New(kExternalTypedDataUint8ArrayCid, data, length));
+  auto& function = Function::Handle();
+  {
+    SafepointWriteRwLocker ml(thread, thread->isolate_group()->program_lock());
+    bytecode::BytecodeLoader loader(thread, typed_data);
+    function = loader.LoadBytecode();
+  }
+
+  if (function.IsNull()) {
+    return Object::null();
+  }
+  ASSERT(function.is_static());
+  ASSERT(function.is_declared_in_bytecode());
+
+  const auto& closure = Closure::Handle(
+      zone, Closure::New(Object::null_type_arguments(),
+                         Object::null_type_arguments(), function,
+                         Object::null_object(), Heap::kOld));
+  return closure.ptr();
+#else
+  Exceptions::ThrowUnsupportedError(
+      "Loading of dynamic modules is not supported.");
+  return Object::null();
+#endif  // defined(DART_DYNAMIC_MODULES)
+}
+
+// Gate 1 spike (flutter_hot_patcher): invoke the zero-arg entry point stashed
+// inside a closure produced by Internal_loadDynamicModuleClosure, calling
+// DartEntry::InvokeFunction directly instead of going through the normal
+// Dart closure-call dispatch (which rejects bytecode-declared entry points
+// with a NoSuchMethodError due to a signature-representation mismatch).
+DEFINE_NATIVE_ENTRY(Internal_invokeDynamicModuleClosure, 0, 1) {
+#if defined(DART_DYNAMIC_MODULES)
+  GET_NON_NULL_NATIVE_ARGUMENT(Closure, closure, arguments->NativeArgAt(0));
+  const auto& function = Function::Handle(zone, closure.function());
+  const auto& args = Array::Handle(zone, Array::New(0));
+  auto& result = Object::Handle(zone, DartEntry::InvokeFunction(function, args));
+  if (result.IsError()) {
+    Exceptions::PropagateError(Error::Cast(result));
+  }
+  return result.ptr();
+#else
+  Exceptions::ThrowUnsupportedError(
+      "Loading of dynamic modules is not supported.");
+  return Object::null();
+#endif  // defined(DART_DYNAMIC_MODULES)
+}
+
+// Gate 1 spike (flutter_hot_patcher) V2: overwrite the dispatch-table entry
+// for [instance]'s class id so ALL interface/virtual calls that dispatch on
+// that class id observe [replacement]'s method body instead. See
+// spikes/gate1_mixed_execution/cases/v2_call_forms_matrix.
+DEFINE_NATIVE_ENTRY(Internal_redirectDispatchTableEntry, 0, 2) {
+  GET_NON_NULL_NATIVE_ARGUMENT(Instance, instance, arguments->NativeArgAt(0));
+  GET_NON_NULL_NATIVE_ARGUMENT(Closure, replacement, arguments->NativeArgAt(1));
+  auto* table = thread->isolate_group()->dispatch_table();
+  if (table == nullptr) {
+    Exceptions::ThrowUnsupportedError(
+        "No dispatch table for this isolate group.");
+  }
+  const intptr_t cid = instance.GetClassId();
+  const auto& function = Function::Handle(zone, replacement.function());
+  table->SetEntryForCid(cid, function.entry_point());
+  return Object::null();
+}
+
+// Gate 1 spike (flutter_hot_patcher) V2: overwrite [target]'s own entry_point
+// field so every call site that dispatches through THIS closure instance
+// observes [replacement]'s method body instead. See
+// spikes/gate1_mixed_execution/cases/v2_call_forms_matrix.
+DEFINE_NATIVE_ENTRY(Internal_redirectClosureEntryPoint, 0, 2) {
+#if defined(DART_PRECOMPILED_RUNTIME)
+  GET_NON_NULL_NATIVE_ARGUMENT(Closure, target, arguments->NativeArgAt(0));
+  GET_NON_NULL_NATIVE_ARGUMENT(Closure, replacement, arguments->NativeArgAt(1));
+  target.set_entry_point(replacement.entry_point());
+#else
+  Exceptions::ThrowUnsupportedError(
+      "Closure entry_point redirection is AOT/precompiled-runtime only.");
+#endif
+  return Object::null();
+}
+
