diff --git a/common/config.gni b/common/config.gni
index b2ae1118e2..22202a76d7 100644
--- a/common/config.gni
+++ b/common/config.gni
@@ -166,3 +166,12 @@ build_engine_artifacts =
     flutter_build_engine_artifacts && !is_android &&
     (current_toolchain == host_toolchain ||
      (is_linux && !is_chromeos && current_cpu != "arm") || is_mac || is_win)
+
+# Shorebird OTA 补丁支持（条件与 shorebirdtech/flutter 的 common/config.gni 一致）
+if (is_android || is_ios || is_linux || is_mac || is_win) {
+  feature_defines_list += [ "SHOREBIRD_PLATFORM_SUPPORTED=1" ]
+}
+
+if (is_ios) {
+  feature_defines_list += [ "SHOREBIRD_USE_INTERPRETER=1" ]
+}
