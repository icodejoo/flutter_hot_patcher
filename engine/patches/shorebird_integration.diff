diff --git a/shell/platform/darwin/ios/framework/Source/FlutterDartProject.mm b/shell/platform/darwin/ios/framework/Source/FlutterDartProject.mm
index 3f31c181f3..3235f516bf 100644
--- a/shell/platform/darwin/ios/framework/Source/FlutterDartProject.mm
+++ b/shell/platform/darwin/ios/framework/Source/FlutterDartProject.mm
@@ -12,6 +12,8 @@
 #include <syslog.h>
 
 #include "flutter/common/constants.h"
+#include "flutter/fml/paths.h"
+#include "flutter/shell/common/shorebird/shorebird.h"
 #include "flutter/fml/build_config.h"
 #include "flutter/shell/common/switches.h"
 #include "flutter/shell/platform/darwin/common/command_line.h"
@@ -160,6 +162,31 @@ flutter::Settings FLTDefaultSettingsForBundle(NSBundle* bundle, NSProcessInfo* p
   // Domain network configuration
   // Disabled in https://github.com/flutter/flutter/issues/72723.
   // Re-enable in https://github.com/flutter/flutter/issues/54448.
+  // --- Shorebird OTA 配置（移植自 shorebirdtech/flutter，规则 2）---
+  // 必须在 settings 交给引擎之前执行：它会把已 staged 的 .vmcode 路径插到
+  // settings.application_library_path 最前面，随后 dart_snapshot.cc 的
+  // ResolveIsolateData/Instructions 会认出并加载它。
+  {
+    NSString* sbAssetsPath = [NSString stringWithUTF8String:settings.assets_path.c_str()];
+    std::string sbCachePath =
+        fml::paths::JoinPaths({getenv("HOME"), "Library/Application Support/shorebird"});
+    NSURL* sbYamlURL = [NSURL URLWithString:@"shorebird.yaml"
+                              relativeToURL:[NSURL fileURLWithPath:sbAssetsPath]];
+    NSString* sbYaml = [NSString stringWithContentsOfURL:sbYamlURL
+                                               encoding:NSUTF8StringEncoding
+                                                  error:nil];
+    if (sbYaml != nil) {
+      NSString* sbVersion = [mainBundle objectForInfoDictionaryKey:@"CFBundleShortVersionString"];
+      NSString* sbBuild = [mainBundle objectForInfoDictionaryKey:@"CFBundleVersion"];
+      // 两次传同一个 cache_path 是上游的做法：Android 区分跨版本持久/非持久
+      // 目录，iOS 不区分。
+      flutter::ConfigureShorebird(sbCachePath, sbCachePath, settings, sbYaml.UTF8String,
+                                  sbVersion.UTF8String, sbBuild.UTF8String);
+    } else {
+      NSLog(@"[shorebird] Failed to find shorebird.yaml, not starting updater.");
+    }
+  }
+
   settings.may_insecurely_connect_to_all_domains = true;
   settings.domain_network_policy = "";
 
