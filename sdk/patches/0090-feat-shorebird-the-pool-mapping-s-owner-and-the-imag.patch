diff --git a/runtime/vm/shorebird/linker.cc b/runtime/vm/shorebird/linker.cc
index cbd0e882848..c6e5883631e 100644
--- a/runtime/vm/shorebird/linker.cc
+++ b/runtime/vm/shorebird/linker.cc
@@ -55,7 +55,7 @@ ShorebirdLinker::ShorebirdLinker()
     : gap0_{},
       base_object_pool_(nullptr),
       patch_object_pool_(nullptr),
-      gap1_{},
+      object_pool_mapping_(nullptr),
       dd_slot_mapping_(nullptr),
       dd_slot_voters_(nullptr),
       resolution_(nullptr),
@@ -385,7 +385,8 @@ void ShorebirdLinker::InitializeWithObjectPoolLinkInfo(
   patch_object_pool_ = std::move(patch);
 
   MappingCounts counts;
-  LinkObjectPools(&counts);
+  object_pool_mapping_ =
+      std::make_unique<std::vector<intptr_t>>(LinkObjectPools(&counts));
 }
 
 void ObjectPoolMappingsAggregator::AddVote(uintptr_t patch_index,
diff --git a/runtime/vm/shorebird/linker.h b/runtime/vm/shorebird/linker.h
index 7ca74887397..12762226043 100644
--- a/runtime/vm/shorebird/linker.h
+++ b/runtime/vm/shorebird/linker.h
@@ -341,6 +341,13 @@ class ShorebirdLinker {
 
   std::vector<intptr_t> LinkObjectPools(MappingCounts* counts) const;
 
+  // The mapping InitializeWithObjectPoolLinkInfo computed, or nullptr when no
+  // object pool link info was supplied. ImageWriter::Write consults this to
+  // decide whether there is anything to rewrite.
+  const std::vector<intptr_t>* object_pool_mapping() const {
+    return object_pool_mapping_.get();
+  }
+
   const ObjectPoolLinkInfo* base_object_pool() const {
     return base_object_pool_.get();
   }
@@ -386,8 +393,18 @@ class ShorebirdLinker {
   std::unique_ptr<ObjectPoolLinkInfo> base_object_pool_;   // +0x18
   std::unique_ptr<ObjectPoolLinkInfo> patch_object_pool_;  // +0x20
 
-  // +0x28: 8-byte gap. Same situation as gap0_.
-  uint8_t gap1_[8];
+  // +0x28: the object pool's old-index -> new-index table.
+  //
+  // Recovered from how ImageWriter::Write reaches it: their sp+0x70 comes from
+  // [[0x1005214b0] + 0x28], then [x8], then x8[index]. 0x1005214b0 is the
+  // ShorebirdLinker singleton pointer -- the same address shared() guards --
+  // so the table hangs off this object at +0x28. Two dereferences before the
+  // index means the slot holds a pointer to something whose first word is the
+  // array base, which is what a vector is; a bare array would need one.
+  //
+  // Recon (c)5 recorded this slot as "plainly old index -> new index, but
+  // which object owns it is not established". This is that answer.
+  std::unique_ptr<std::vector<intptr_t>> object_pool_mapping_;
 
   // +0x30 / +0x38
   std::unique_ptr<FieldTableLinkInfo> base_field_table_;
