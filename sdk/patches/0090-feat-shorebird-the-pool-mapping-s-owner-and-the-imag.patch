index b93630789ab..ddd4ded0737 100644
--- a/runtime/vm/image_snapshot.cc
+++ b/runtime/vm/image_snapshot.cc
@@ -20,6 +20,9 @@
 #include "vm/json_writer.h"
 #include "vm/object.h"
 #include "vm/object_store.h"
+#include "vm/os.h"
+#include "vm/shorebird/linker.h"
+#include "vm/shorebird/object_pool_editor.h"
 #include "vm/program_visitor.h"
 #include "vm/stub_code.h"
 #include "vm/timeline.h"
@@ -559,6 +562,8 @@ void ImageWriter::Write(NonStreamingWriteStream* clustered_stream, bool vm) {
     }
   }
 
+  EditObjectPoolAccesses();
+
   WriteBss(vm);
 
   offset_space_ = vm ? IdSpace::kVmText : IdSpace::kIsolateText;
@@ -571,6 +576,48 @@ void ImageWriter::Write(NonStreamingWriteStream* clustered_stream, bool vm) {
   WriteROData(clustered_stream, vm);
 }
 
+// Shorebird: renumber every object pool access to the index the linker's
+// mapping gives it, in place, before the payload is serialised.
+//
+// This is the driver their ObjectPoolEditor is inlined into -- the whole family
+// has exactly one production caller and it is this function (ten of the
+// thirteen call sites in their whole __text are inside it). The walk itself
+// lives in ObjectPoolEditor::Edit; what belongs here is which payloads to walk
+// and where the mapping comes from.
+//
+// Two reasons this can be a no-op and both are normal: a plain AOT compile has
+// no patch to link against, so there is no mapping at all; and a mapping that
+// leaves every index alone still runs, because Edit's second half re-assembles
+// each untouched access and checks it comes out byte for byte identical. That
+// self-check is theirs, and it is the closest thing this file has to a free
+// oracle -- it compares the editor's decoder and emitters against code the same
+// emitters produced during compilation.
+void ImageWriter::EditObjectPoolAccesses() {
+#if defined(TARGET_ARCH_ARM64)
+  const std::vector<intptr_t>* mapping =
+      ShorebirdLinker::shared()->object_pool_mapping();
+  if (mapping == nullptr || mapping->empty()) return;
+
+  bool ok = true;
+  for (intptr_t i = 0; i < instructions_.length(); i++) {
+    InstructionsData& data = instructions_[i];
+    if (data.trampoline_length != 0) continue;
+    const Instructions& insns = *data.insns_;
+    const uword start = insns.PayloadStart();
+    if (!ObjectPoolEditor::Edit(start, start + insns.Size(), mapping->data(),
+                                static_cast<intptr_t>(mapping->size()))) {
+      ok = false;
+    }
+  }
+  // Their self-check reports through "Expected:\n" / "Actual:\n" and does not
+  // abort; a declined site is not a corrupted one, because the editor only
+  // rewrites what it could decode and re-verify.
+  if (!ok) {
+    OS::PrintErr("Shorebird: some object pool accesses were left alone\n");
+  }
+#endif  // defined(TARGET_ARCH_ARM64)
+}
+
 void ImageWriter::WriteROData(NonStreamingWriteStream* stream, bool vm) {
   ASSERT(Utils::IsAligned(stream->Position(), kRODataAlignment));
   // Heap page starts here.
