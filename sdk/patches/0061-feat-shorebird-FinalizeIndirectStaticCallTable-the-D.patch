+// Shorebird: build the DD table.
+//
+// Reproduced from their gen_snapshot, where this is inlined into DoCompileAll
+// and only its local DDTableBuilder leaves symbols behind. Decode notes live in
+// spikes/shorebird_linkinfo_oracle/README.md; the addresses cited below are in
+// their arm64 gen_snapshot.
+void Precompiler::FinalizeIndirectStaticCallTable() {
+  HANDLESCOPE(T);
+
+  // No mapping file means no table at all -- `cbz x19` at 0x10021b414 skips the
+  // whole thing rather than producing an empty Array.
+  const DDSlotMapping* mapping = ShorebirdLinker::shared()->dd_slot_mapping();
+  if (mapping == nullptr) return;
+
+  // Phase 1: walk the program, collecting dd_slot -> Code.
+  class DDTableBuilder : public CodeVisitor {
+   public:
+    DDTableBuilder(Zone* zone, const DDSlotMapping* mapping)
+        : zone_(zone), function_(Function::Handle(zone)), mapping_(mapping) {}
+
+    void VisitCode(const Code& code) override {
+      // Their order exactly: unwrap a WeakSerializationReference first, then
+      // gate on the owner being a Function. Codes owned by a Class (allocation
+      // stubs) and ownerless stubs both fall out here.
+      const ObjectPtr owner = WeakSerializationReference::Unwrap(code.owner());
+      if (owner == Object::null()) return;
+      if (owner->GetClassId() != kFunctionCid) return;
+      function_ = Function::RawCast(owner);
+
+      const intptr_t slot =
+          mapping_->SlotForKernelOffset(function_.kernel_offset());
+      // A negative slot means "not in the mapping". Theirs tests the sign bit
+      // (`tbnz x21, #0x3f`) rather than comparing against a sentinel, so slot 0
+      // is a legal slot and must not be filtered here.
+      if (slot < 0) return;
+
+      // Zone handles rather than raw CodePtrs. Theirs stores raw pointers, but
+      // Array::New in phase 3 can allocate, and a compacting GC between capture
+      // and use would leave those pointers stale. A zone handle is visited by
+      // the GC, so this closes a hazard rather than reproducing it. Deliberate
+      // deviation, and the only one in this function.
+      slot_to_code_[slot] = &Code::ZoneHandle(zone_, code.ptr());
+      if (slot > max_slot_) max_slot_ = slot;
+    }
+
+    intptr_t max_slot() const { return max_slot_; }
+    const std::unordered_map<intptr_t, const Code*>& slot_to_code() const {
+      return slot_to_code_;
+    }
+
+   private:
+    Zone* zone_;
+    Function& function_;
+    const DDSlotMapping* mapping_;
+    // -1, not 0: their builder initialises it with `mov x8, #-1` at 0x10021b434
+    // and treats "still negative" as "nothing matched".
+    intptr_t max_slot_ = -1;
+    std::unordered_map<intptr_t, const Code*> slot_to_code_;
+  };
+
+  DDTableBuilder builder(Z, mapping);
+  ProgramVisitor::WalkProgram(Z, IG, &builder);
+
+  // `tbnz x8, #0x3f` at 0x10021b474: nothing matched, so no table.
+  if (builder.max_slot() < 0) return;
+
+  // Phase 2: retain every function the table can dispatch to. Without this the
+  // drop phase below would remove them and the table would point at dropped
+  // code -- which is what the "Dispatch table references code for function to
+  // drop" diagnostic above reports for the analogous dispatch-table case.
+  Function& function = Function::Handle(Z);
+  for (const auto& entry : builder.slot_to_code()) {
+    const ObjectPtr owner =
+        WeakSerializationReference::Unwrap(entry.second->owner());
+    if (owner == Object::null()) continue;
+    if (owner->GetClassId() != kFunctionCid) continue;
+    function = Function::RawCast(owner);
+    AddTypesOf(function);
+    AddRetainReason(function, "DD table target");
+  }
+
+  // Phase 3: materialise the table. Array, not ImmutableArray -- entries get
+  // repointed when a patch is linked, which is the whole purpose of the table.
+  //
+  // Theirs reads `Array::New(90, max_slot+1, 1)` at 0x10021b568, i.e. the
+  // three-argument (class_id, len, space) form with kArrayCid spelled out. That
+  // overload is protected, so what their disassembly actually shows is the
+  // public two-argument New inlined into it -- this call is the same thing.
+  const Array& table =
+      Array::Handle(Z, Array::New(builder.max_slot() + 1, Heap::kOld));
+  for (const auto& entry : builder.slot_to_code()) {
+    table.SetAt(entry.first, *entry.second);
+  }
+  IG->object_store()->set_indirect_static_call_table(table);
+}
