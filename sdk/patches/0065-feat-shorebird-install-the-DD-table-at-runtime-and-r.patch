+// Shorebird's DD table. Deliberately not the encoding WriteDispatchTable uses
+// below: no first-code-id base, no recent-entry window, no repeat runs, just a
+// length and one reference per slot. Their reader is the reason it can be that
+// plain -- it decodes an unsigned per entry and indexes refs directly, which
+// rules the compressed forms out.
+//
+// A zero reference is not writable here. Their reader treats zero as fatal
+// rather than as "absent", so the table this receives must already have a
+// sentinel in every slot no Code claimed -- Precompiler::FinalizeIndirect-
+// StaticCallTable is where that happens.
+void Serializer::WriteIndirectStaticCallTable(const Array& entries) {
+#if defined(DART_PRECOMPILER)
+  if (kind() != Snapshot::kFullAOT) return;
+
+  const intptr_t length = entries.IsNull() ? 0 : entries.Length();
+  ASSERT(length <= compiler::target::kWordMax);
+  WriteUnsigned(length);
+  if (length == 0) return;
+
+  Object& entry = Object::Handle(zone_);
+  for (intptr_t i = 0; i < length; i++) {
+    entry = entries.At(i);
+    const intptr_t id = RefId(entry.ptr());
+    // Would deserialize as a fatal zero. Reaching this means the sentinel fill
+    // was skipped or the Code was not pushed as a root, and both produce a
+    // snapshot that dies on load rather than here.
+    ASSERT(id != 0);
+    WriteUnsigned(id);
+  }
+#endif  // defined(DART_PRECOMPILER)
+}
+
 void Serializer::WriteDispatchTable(const Array& entries) {
 #if defined(DART_PRECOMPILER)
   if (kind() != Snapshot::kFullAOT) return;
@@ -9393,6 +9446,37 @@ DeserializationCluster* Deserializer::ReadCluster() {
   return nullptr;
 }
 
+// Shorebird. Transcribed from their engine: Deserializer::ReadIndirectStatic-
+// CallTable, declared at their app_snapshot.cc:1031 and inlined into their
+// 0x741f1c..0x74204c, which is where every step below was read off.
+//
+// The shape is much smaller than ReadDispatchTable's because the entries are
+// plain references rather than a delta encoding, and because there is no
+// deferred variant -- the table is complete when the object graph is.
+void Deserializer::ReadIndirectStaticCallTable() {
+#if defined(DART_PRECOMPILED_RUNTIME)
+  const intptr_t length = ReadUnsigned();
+  if (length == 0) return;
+
+  auto* const IG = isolate_group();
+  std::unique_ptr<uword[]> table(new uword[length]);
+
+  for (intptr_t i = 0; i < length; i++) {
+    const intptr_t ref = ReadUnsigned();
+    // Theirs branches a zero straight into an Assert::Fail rather than
+    // substituting a null-error entry the way ReadDispatchTable does. Keeping
+    // that is what makes a missing sentinel fail at the snapshot that caused
+    // it, instead of at the first call through the slot.
+    if (ref == 0) {
+      FATAL("Indirect static call table slot %" Pd " has no code", i);
+    }
+    table[i] = Code::RawCast(Ref(ref))->untag()->entry_point_;
+  }
+
+  IG->set_indirect_static_call_table(std::move(table), length);
+#endif  // defined(DART_PRECOMPILED_RUNTIME)
+}
+
 void Deserializer::ReadDispatchTable(
     ReadStream* stream,
     bool deferred,
diff --git a/runtime/vm/compiler/aot/precompiler.cc b/runtime/vm/compiler/aot/precompiler.cc
index 36233b30167..ce1858643fb 100644
--- a/runtime/vm/compiler/aot/precompiler.cc
+++ b/runtime/vm/compiler/aot/precompiler.cc
@@ -680,6 +680,8 @@ void Precompiler::DoCompileAll() {
       ProgramVisitor::Dedup(T);
     }
 
+    RefreshIndirectStaticCallTable();
+
     PruneDictionaries();
 
     if (retained_reasons_writer_ != nullptr) {
@@ -2204,7 +2206,73 @@ void Precompiler::FinalizeIndirectStaticCallTable() {
   for (const auto& entry : builder.slot_to_code()) {
     table.SetAt(entry.first, *entry.second);
   }
-  IG->object_store()->set_indirect_static_call_table(table);
+
+  // Slots below max_slot that no Code claimed are still null here, and null is
+  // not a value this table can carry: their Deserializer::ReadIndirectStatic-
+  // CallTable treats a zero reference as fatal rather than as an absent entry,
+  // the way ReadDispatchTable treats zero as "use the null-error stub". So the
+  // gap has to be closed before serialization, and their own linker report
+  // names the closure -- "unrewritten-null filled with sentinel".
+  //
+  // ⚠️ Which Code they use as that sentinel is not established. The phase this
+  // reproduces shows no fill loop, so theirs may fill from the linker instead.
+  // dispatch_table_null_error_stub is upstream's answer to the identical
+  // question one table over: a slot that must exist and must not be called.
+  const Code& sentinel =
+      Code::Handle(Z, IG->object_store()->dispatch_table_null_error_stub());
+  ASSERT(!sentinel.IsNull());
+  Object& entry = Object::Handle(Z);
+  for (intptr_t i = 0, n = table.Length(); i < n; i++) {
+    entry = table.At(i);
+    if (entry.IsNull()) {
+      table.SetAt(i, sentinel);
+    }
+  }
+
+  IG->object_store()->set_indirect_static_call_table_code_entries(table);
+}
+
+// The table is built before DropFunctions, because the retain pass above has to
+// run before anything is dropped. DiscardCodeObjects and ProgramVisitor::Dedup
+// come after, and both can leave a slot holding a Code object that is no longer
+// its function's current one -- a discarded duplicate that happens to share
+// Instructions with the survivor.
+//
+// That is not a cosmetic difference. The serializer pushes every slot's Code as
+// a root, so a stale duplicate becomes reachable, and two Code objects with one
+// Instructions trips CodeSerializationCluster::Insert's
+// RELEASE_ASSERT(!FLAG_precompiled_mode). It cost a real snapshot: gen_snapshot
+// died at app_snapshot.cc:2791 the first time a mapping covering the whole
+// program was run through it, and nothing before that point had noticed,
+// because every check until then read the emitted call sites rather than
+// loading the result.
+//
+// ⚠️ Theirs does all of this in one pass at the earlier position, with no
+// refresh that the disassembly shows. Either their ordering differs or they
+// reconcile it somewhere not yet found; this step is ours, and it is here
+// because the snapshot does not otherwise load.
+void Precompiler::RefreshIndirectStaticCallTable() {
+  HANDLESCOPE(T);
+
+  const Array& table = Array::Handle(
+      Z, IG->object_store()->indirect_static_call_table_code_entries());
+  if (table.IsNull()) return;
+
+  Code& code = Code::Handle(Z);
+  Object& owner = Object::Handle(Z);
+  Function& function = Function::Handle(Z);
+
+  for (intptr_t i = 0, n = table.Length(); i < n; i++) {
+    code ^= table.At(i);
+    if (code.IsNull()) continue;
+    owner = code.owner();
+    if (!owner.IsFunction()) continue;  // The sentinel stub owns nothing.
+    function ^= owner.ptr();
+    if (!function.HasCode()) continue;
+    if (function.CurrentCode() != code.ptr()) {
+      table.SetAt(i, Code::Handle(Z, function.CurrentCode()));
+    }
+  }
 }
 
 void Precompiler::ReplaceFunctionStaticCallEntries() {
