+void ShorebirdLinker::InitializeWithObjectPoolLinkInfo(
+    std::unique_ptr<ObjectPoolLinkInfo> base,
+    std::unique_ptr<ObjectPoolLinkInfo> patch) {
+  // Their assertion string, matching the class table's shape:
+  // "base_object_pool_ == nullptr && patch_object_pool_ == nullptr"
+  ASSERT(base_object_pool_ == nullptr && patch_object_pool_ == nullptr);
+  base_object_pool_ = std::move(base);
+  patch_object_pool_ = std::move(patch);
+
+  MappingCounts counts;
+  LinkObjectPools(&counts);
+}
+
+std::vector<ShorebirdLinker::PoolIndexPair>
+ShorebirdLinker::ComputeObjectPoolLinkResults(const ObjectPoolLinkInfo& base,
+                                              const ObjectPoolLinkInfo& patch) {
+  const auto key = [](const CodeInfo& info) { return info.op_subgraph_hash_; };
+  const auto base_groups = GroupBy<CodeInfo>(base.codes(), key);
+  const auto patch_groups = GroupBy<CodeInfo>(patch.codes(), key);
+
+  // Deduplicated, and ordered, because two code objects can reference the same
+  // pool slot and their count is of distinct pairs.
+  std::set<std::pair<intptr_t, intptr_t>> seen;
+  for (const auto& entry : patch_groups) {
+    if (entry.second.size() != 1) continue;
+    const auto found = base_groups.find(entry.first);
+    if (found == base_groups.end() || found->second.size() != 1) continue;
+
+    const std::vector<uintptr_t>& b = found->second[0].self_pp_indices_;
+    const std::vector<uintptr_t>& p = entry.second[0].self_pp_indices_;
+    const size_t n = b.size() < p.size() ? b.size() : p.size();
+    for (size_t i = 0; i < n; i++) {
+      seen.insert({static_cast<intptr_t>(b[i]), static_cast<intptr_t>(p[i])});
+    }
+  }
+
+  std::vector<PoolIndexPair> link_results;
+  link_results.reserve(seen.size());
+  for (const auto& pair : seen) {
+    link_results.push_back(PoolIndexPair{pair.first, pair.second});
+  }
+  return link_results;
+}
+
+std::vector<intptr_t> ShorebirdLinker::LinkObjectPools(
+    MappingCounts* counts) const {
+  ASSERT(counts != nullptr);
+  if (base_object_pool_ == nullptr || patch_object_pool_ == nullptr) {
+    return std::vector<intptr_t>();
+  }
+
+  const std::vector<PoolIndexPair> link_results =
+      ComputeObjectPoolLinkResults(*base_object_pool_, *patch_object_pool_);
+  std::vector<intptr_t> mapping = ComputeObjectPoolMapping(
+      link_results, patch_object_pool_->pair_constraints(),
+      patch_object_pool_->num_pool_entries(), counts);
+
+  if (FLAG_print_shorebird_info) {
+    OS::Print("Link Results %zu\n", static_cast<size_t>(counts->link_results));
+    OS::Print("Mappings from Link Results %zu\n",
+              static_cast<size_t>(counts->from_link_results));
+    OS::Print("Mappings from Pair Constraints %zu\n",
+              static_cast<size_t>(counts->from_pair_constraints));
+    OS::Print("Mappings from Backfill %zu\n",
+              static_cast<size_t>(counts->from_backfill));
+  }
+  return mapping;
+}
