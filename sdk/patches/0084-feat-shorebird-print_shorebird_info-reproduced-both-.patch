@@ -540,6 +611,29 @@ std::unique_ptr<ClassTableLinkInfo> ReadClassTableLinkInfo(const char* path,
   return ReadClassTableLinkInfo(&stream, ok);
 }
 
+std::unique_ptr<ObjectPoolLinkInfo> ReadObjectPoolLinkInfo(const char* path,
+                                                           bool* ok) {
+  uint8_t* buf = nullptr;
+  intptr_t size = 0;
+  if (path == nullptr || !ReadFileIntoBuffer(path, &buf, &size)) {
+    if (ok != nullptr) *ok = false;
+    return std::make_unique<ObjectPoolLinkInfo>(
+        std::vector<CodeInfo>{}, std::vector<int32_t>{}, 0);
+  }
+  std::unique_ptr<uint8_t, decltype(&free)> guard(buf, free);
+
+  ReadStream stream(buf, size);
+  std::unique_ptr<ObjectPoolLinkInfo> parsed =
+      ObjectPoolLinkInfo::ReadFromStream(&stream);
+  if (parsed == nullptr) {
+    if (ok != nullptr) *ok = false;
+    return std::make_unique<ObjectPoolLinkInfo>(
+        std::vector<CodeInfo>{}, std::vector<int32_t>{}, 0);
+  }
+  if (ok != nullptr) *ok = true;
+  return parsed;
+}
