   V(InitStaticField)                                                           \
   V(InitLateStaticField)                                                       \
   V(InitLateFinalStaticField)                                                  \
diff --git a/runtime/vm/thread.h b/runtime/vm/thread.h
index 82d17c0fe2a..566ff5e9ac6 100644
--- a/runtime/vm/thread.h
+++ b/runtime/vm/thread.h
@@ -577,6 +577,30 @@ class Thread : public ThreadState, public IntrusiveDListEntry<Thread> {
     return OFFSET_OF(Thread, simulator_call_from_ffi_);
   }
 
+  // Their 0x920 / 0x928. Upstream reaches the safepoint stubs through
+  // enter_safepoint_stub_, a Code object, and pays two loads to get an entry
+  // point out of it; Shorebird caches the entry point directly, so their
+  // SimulatorCallNativeThroughSafepoint slow path is one load and a blr.
+  uword enter_safepoint_entry_point() const {
+    return enter_safepoint_entry_point_;
+  }
+  void set_enter_safepoint_entry_point(uword v) {
+    enter_safepoint_entry_point_ = v;
+  }
+  static intptr_t enter_safepoint_entry_point_offset() {
+    return OFFSET_OF(Thread, enter_safepoint_entry_point_);
+  }
+
+  uword exit_safepoint_entry_point() const {
+    return exit_safepoint_entry_point_;
+  }
+  void set_exit_safepoint_entry_point(uword v) {
+    exit_safepoint_entry_point_ = v;
+  }
+  static intptr_t exit_safepoint_entry_point_offset() {
+    return OFFSET_OF(Thread, exit_safepoint_entry_point_);
+  }
+
   TaskKind task_kind() const {
     return task_kind_.load(std::memory_order_acquire);
   }
@@ -1743,6 +1767,8 @@ class Thread : public ThreadState, public IntrusiveDListEntry<Thread> {
   uword simulator_async_resume_pc_ = 0;
   uword simulator_execute_ = 0;
   uword simulator_call_from_ffi_ = 0;
+  uword enter_safepoint_entry_point_ = 0;
+  uword exit_safepoint_entry_point_ = 0;
 
   explicit Thread(bool is_vm_isolate);
 
