@@ -32,9 +32,14 @@ VM_UNIT_TEST_CASE(WrapperLayout_DerivedCountsMatchTheirDwarf) {
   EXPECT_EQ(static_cast<intptr_t>(2044), sim_to_cpu.num_wrappers_per_page);
 }
 
-// Guards the relation rather than the literals, so a future config change is
-// still checked against the rule their two data points establish.
-VM_UNIT_TEST_CASE(WrapperLayout_CountIsDerivedNotHardcoded) {
+// Guards that num_wrappers_per_page agrees with the three page fields it is
+// computed from, so a future config change cannot silently desync them. This
+// does NOT prove the count is derived rather than hardcoded: a config that
+// spelled out kNumWrappersPerPage = 2014 and had fromTemplate() copy it would
+// still satisfy this, because the division yields the same number. What pins
+// the values themselves is WrapperLayout_DerivedCountsMatchTheirDwarf, which
+// ties both the inputs and the output to their DWARF literals.
+VM_UNIT_TEST_CASE(WrapperLayout_CountIsConsistentWithPageFields) {
   const Layout a = Layout::fromTemplate<WrapperLayout<CPUToSimConfig>>();
   EXPECT_EQ((a.page_size - a.shared_body_size) / a.landing_pad_size,
             a.num_wrappers_per_page);
