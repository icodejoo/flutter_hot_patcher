+// An object pool reference opening at words[i], as (index, instructions).
+//
+// A transcription of 0x100196b98-0x1001975a0. Seven shapes, all of them ending
+// in their LoadStoreFromSingle:
+//
+//   ldr/str Xt,[PP,#imm12]                                            1
+//   add Xd,PP,#imm ; ldr/str Xt,[Xd,#imm12]                           2
+//   movz Wm,#imm16 ; ldr Xt,[PP,Xm]                                   2
+//   movz Wm,#lo ; movk Wm,#hi,lsl 16 ; ldr Xt,[PP,Xm]                 3
+//   ldp Xt,Xt2,[PP,#imm7]                                             1
+//   add x16,PP,#imm ; ldp Xt,Xt2,[x16,#imm7]                          2
+//   add Xd,PP,#imm ; add x16,Xd,#imm ; ldp Xt,Xt2,[x16,#imm7]         3
+//
+// ⚠️ `i` is the index of the LOAD, and the address-forming instructions are
+// BEHIND it -- their classifier looks backwards and then pops the entries it
+// already emitted for them (see ComputeShorebirdCodeFacts). Matching forwards
+// from the first instruction instead agrees on the one-instruction shapes,
+// which are the overwhelming majority, and shifts the stream on the others.
+static bool DecodePoolReference(const uint32_t* words, intptr_t count,
+                                intptr_t i, intptr_t* index, int32_t* used) {
+  const uint32_t w = words[i];
+
+  // --- single load/store, 0x100196b98 ---------------------------------
+  if ((w & 0x3A000000) == 0x38000000 && (w & 0x04400000) != 0x04000000 &&
+      ((w & 0x04000000) != 0 || (w >> 30) == 3)) {
+    const uint32_t scale = (w & 0x00800000) != 0 ? 4 : (w >> 30);
+    if ((w & 0x01000000) != 0) {                    // unsigned imm12
+      int64_t offset = static_cast<int64_t>((w >> 10) & 0xFFF) << scale;
+      const uint32_t rn = (w >> 5) & 0x1F;
+      if (rn == kPPRegister) {
+        *index = PoolIndexFromOffset(offset);
+        *used = 1;
+        return true;
+      }
+      if (i < 1) return false;
+      const uint32_t prev = words[i - 1];           // 0x100196d9c
+      if ((prev & 0x9F0003E0) != 0x91000360 || (prev & 0x1F) != rn) {
+        return false;
+      }
+      // ⚠️ Shifted by 12 unconditionally: nothing between 0x100196d9c and
+      // 0x100196ddc looks at the add's `sh` bit.
+      offset += static_cast<int64_t>((prev >> 10) & 0xFFF) << 12;
+      *index = PoolIndexFromOffset(offset);
+      *used = 2;
+      return true;
+    }
+    // register offset off PP, 0x100196cf8
+    if ((w & 0xFE0) != 0xB60 || i < 1) return false;
+    const uint32_t prev = words[i - 1];
+    if ((prev & 0x1F800000) != 0x12800000) return false;   // move wide imm
+    const uint32_t rd = prev & 0x1F;
+    if (rd != ((w >> 16) & 0x1F)) return false;
+    if ((w & 0x04000000) == 0 && rd != (w & 0x1F)) return false;
+    const uint32_t opc = (prev >> 29) & 3;
+    if (opc == 3) {                                        // movk, 0x100197550
+      if ((prev & 0x600000) != 0x200000 || i < 2) return false;
+      const uint32_t prev2 = words[i - 2];
+      if ((prev2 & 0x7FE00000) != 0x52800000 || (prev2 & 0x1F) != rd) {
+        return false;
+      }
+      *index = PoolIndexFromOffset(((prev2 >> 5) & 0xFFFF) |
+                                   (((prev >> 5) & 0xFFFF) << 16));
+      *used = 3;
+      return true;
+    }
+    if (opc == 2) {                                        // movz, 0x100196d60
+      if ((prev & 0x600000) != 0) return false;
+      *index = PoolIndexFromOffset((prev >> 5) & 0xFFFF);
+      *used = 2;
+      return true;
+    }
+    return false;
+  }
+
+  // --- 64-bit load pair, 0x100196bd4 -----------------------------------
+  if ((w & 0xFB400000) != 0xA9400000) return false;
+  const uint32_t rn = (w >> 5) & 0x1F;
+  int64_t offset = (w >> 12) & 0x3F8;             // imm7 * 8, unsigned
+  if (rn == kPPRegister) {
+    *index = PoolIndexFromOffset(offset);
+    *used = 1;
+    return true;
+  }
+  if (rn != kIP0Register || i < 1) return false;
+  const uint32_t prev = words[i - 1];             // 0x100196c64
+  uint32_t b, d, imm;
+  if ((prev & 0x9F00001F) != 0x91000010) return false;
+  if (!DecodeAddImmediate(prev, &b, &d, &imm)) return false;
+  offset += imm;
+  if (b == kPPRegister) {
+    *index = PoolIndexFromOffset(offset);
+    *used = 2;
+    return true;
+  }
+  if (b != kIP0Register || i < 2) return false;
+  const uint32_t prev2 = words[i - 2];            // 0x100196df0
+  if ((prev2 & 0x9F0003E0) != 0x91000360) return false;
+  if (!DecodeAddImmediate(prev2, &b, &d, &imm)) return false;
+  *index = PoolIndexFromOffset(offset + imm);
+  *used = 3;
+  return true;
+}
+
+// A field-table access opening at words[i], as (key, instructions).
+//
+// 0x10019705c-0x1001971a4. 🔑 The gate is `(w & 0x0A3FFBE0) == 0x08003B40`,
+// which pins Rn to THR *and* bits 11..21, leaving imm12 in {0x0e, 0x0f} for a
+// 64-bit load -- THR+0x70 or THR+0x78, `field_table_values_`. A rule that fires
+// on any `ldr Xt,[THR,#anything]` scores nearly as well on self_hash alone and
+// wrecks it once the ordinal counter is shared across the walk, because every
+// spurious hit shifts every later ordinal.
+static bool DecodeFieldReference(const uint32_t* words, intptr_t count,
+                                 intptr_t i, intptr_t* key, int32_t* used) {
+  if ((words[i] & 0x0A3FFBE0) != 0x08003B40 || i + 1 >= count) return false;
+  const uint32_t rt = words[i] & 0x1F;
+  const uint32_t second = words[i + 1];
+  uint32_t extra = 0, access, middle;
+  int32_t n;
+  if ((second & 0x1F000000) == 0x11000000) {            // add immediate
+    if ((second & 0x1F) != kIP1Register ||
+        ((second >> 5) & 0x1F) != rt || i + 2 >= count) {
+      return false;
+    }
+    extra = (second >> 10) & 0xFFF;
+    if ((second & 0xC00000) == 0x400000) extra <<= 12;
+    access = words[i + 2];
+    middle = second;
+    n = 3;
+  } else if ((second & 0x1F800000) == 0x12000000) {     // logical immediate
+    if ((second & 0x1F) != kIP1Register || i + 2 >= count) return false;
+    const uint32_t third = words[i + 2];
+    if ((third & 0x0A1F0000) != 0x08110000) return false;
+    if (((third >> 5) & 0x1F) != rt) return false;
+    *key = static_cast<intptr_t>(DecodeImmLogical(second));
+    *used = 3;
+    return true;
+  } else {
+    access = second;
+    middle = words[i];
+    n = 2;
+  }
+  if ((access & 0x0A000000) != 0x08000000) return false;
+  if ((middle & 0x1F000000) != 0x11000000 &&
+      (middle & 0x1F800000) != 0x12000000) {
+    if (((access >> 5) & 0x1F) != rt) return false;
+  }
+  *key = static_cast<intptr_t>(((access >> 7) & 0x7FF8) + extra);
+  *used = n;
+  return true;
+}
+
+// Instructions consumed by a dispatch-table call opening at words[i].
+//
+// 0x100196e64-0x100196fe4. The tail is always `ldr lr,[x21,lr,lsl 3]` ;
+// `blr lr`; the head is one of four ways of getting the row index into LR, and
+// the length is 3, 4 or 5:
+//
+//   mov lr, x0                                                    3
+//   add/sub lr, x0, #imm12{,lsl 12}                               3
+//   <logical immediate -> x17> ; add lr, x0, x17                  4
+//   movz x17,#imm ; add lr, x0, x17                               4
+//   movz x17,#lo ; movk x17,#hi ; add lr, x0, x17                 5
+//
+// Keying off the ldr/blr pair alone -- what the previous rule did -- is right
+// for the three-instruction heads and one word short on the others.
+static bool DecodeDispatchCall(const uint32_t* words, intptr_t count,
+                               intptr_t i, int32_t* used) {
+  const uint32_t w = words[i];
+  intptr_t j;
+  int32_t n;
+  if ((w & 0x1F000000) == 0x0A000000) {
+    if ((w & 0x201F001F) != 0x2000001E) return false;
+    j = i + 1;
+    n = 3;
+  } else if ((w & 0x1F800000) == 0x12800000) {          // move wide immediate
+    if ((w & 0x1F) != kIP1Register || i + 1 >= count) return false;
+    j = i + 1;
+    n = 4;
+    if ((words[j] & 0x1F800000) == 0x12800000) {
+      if ((words[j] & 0x1F) != kIP1Register) return false;
+      j++;
+      n = 5;
+    }
+    if (j >= count || (words[j] & 0x1F1F03FF) != 0x0B11001E) return false;
+    j++;
+  } else if ((w & 0x1F800000) == 0x12000000) {          // logical immediate
+    if ((w & 0x1F) != kIP1Register || i + 1 >= count) return false;
+    if ((words[i + 1] & 0x1F1F03FF) != 0x0B11001E) return false;
+    j = i + 2;
+    n = 4;
+  } else if ((w & 0x1F0003FF) == 0x1100001E) {          // add/sub lr, x0, #imm
+    j = i + 1;
+    n = 3;
+  } else {
+    return false;
+  }
+  if (j + 1 >= count) return false;
+  if ((words[j] & 0x0A0003FF) != 0x080002BE) return false;
+  if ((words[j + 1] & 0xFE0003FF) != 0xD60003C0) return false;
+  *used = n;
+  return true;
 }
 
