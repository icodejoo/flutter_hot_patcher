+class ReadStream;
 
 // ShorebirdLinker is the central aggregation point for all link-info
 // structures produced by a base snapshot and consumed by a patch link.
 // It is a function-local static singleton (not a global) — `shared()` uses
 // __cxa_guard_acquire/release, as confirmed by disassembly.
 //
+// NAMESPACE: plain `dart`, NOT `dart::shorebird`, even though this file lives
+// in runtime/vm/shorebird/. Measured, not a style choice: their symbols
+// demangle to `dart::ShorebirdLinker::...`, and the only things they place in
+// `dart::shorebird::` are the WrapperAllocator/WrapperLayout family. Putting
+// this class in `dart::shorebird` would compile fine while silently diverging
+// from their ABI, and would defeat any symbol-level check against their binary.
+//
 // Field layout (measured from their gen_snapshot.arm64 disassembly; see
 // LINKER_RECON.md §3):
 //
@@ -135,7 +147,56 @@ class ShorebirdLinker {
   DISALLOW_COPY_AND_ASSIGN(ShorebirdLinker);
 };
 
-}  // namespace shorebird
+// Readers for the three link-info wire formats.
+//
+// Each format comes in two overloads. The ReadStream* form is the PRIMARY
+// decoder; the const char* form reads the file into memory and delegates to it.
+// One decoder, two entry points -- so the production path (a file named by a
+// gen_snapshot option) and the test path (bytes straight from the real encoder)
+// cannot drift apart.
+//
+// All three decoders are COUNT-DRIVEN, never read-until-EOF. Both the class and
+// field formats put a scalar LAST (num_cids / max_field_id) rather than in the
+// header, so a parser that loops until the buffer is exhausted consumes that
+// trailer as a phantom final entry and then reports a clean full-buffer parse --
+// a false pass this project has already been bitten by once, caught only by
+// diffing against Shorebird's own JSON output. Read the count, loop exactly that
+// many times, then read the trailer.
+//
+// Objects are allocated with plain `new` (heap, not Zone) so they can be created
+// before an isolate exists, matching the _main call-site pattern in their
+// binary. ClassTableLinkInfo and friends derive from ZoneObject, whose
+// destructor is virtual, so unique_ptr's default deleter is correct here.
+//
+// Because the overloads are both on pointer types, calling these with a bare
+// `nullptr` is ambiguous; callers passing a null path must cast explicitly.
+
+// count:u, { id:u, name:str, hash:str } * count, num_cids:u
+std::unique_ptr<ClassTableLinkInfo> ReadClassTableLinkInfo(ReadStream* stream);
+
+// Reads the file produced by --print_class_table_link_info_to.
+// Returns an empty object (count=0, num_cids=0) on a null path, an unreadable
+// file, or an empty file. Never returns null, so callers need no null check
+// before handing the result to Initialize*.
+std::unique_ptr<ClassTableLinkInfo> ReadClassTableLinkInfo(const char* path);
+
+// count:u, { id:u, name:str, hash:str } * count, max_field_id:u
+std::unique_ptr<FieldTableLinkInfo> ReadFieldTableLinkInfo(ReadStream* stream);
+
+// Reads the file produced by --print_field_table_link_info_to.
+// Returns an empty object (count=0, max_field_id=0) on error, never null.
+std::unique_ptr<FieldTableLinkInfo> ReadFieldTableLinkInfo(const char* path);
+
+// count:u, { offset:u, hash:str, nranges:u, (lo:u, hi:u)*nranges } * count
+// No trailing scalar -- the end of the entry loop is the end of the data.
+std::unique_ptr<DispatchTableLinkInfo> ReadDispatchTableLinkInfo(
+    ReadStream* stream);
+
+// Reads the file produced by --print_dispatch_table_link_info_to.
+// Returns an empty object (count=0) on error, never null.
+std::unique_ptr<DispatchTableLinkInfo> ReadDispatchTableLinkInfo(
+    const char* path);
+
 }  // namespace dart
 
 #endif  // RUNTIME_VM_SHOREBIRD_LINKER_H_
