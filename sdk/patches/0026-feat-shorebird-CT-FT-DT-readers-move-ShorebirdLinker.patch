-}  // namespace shorebird
+// Reader smoke tests.
+//
+// These exercise ONLY the null-path guard. They deliberately do not go through
+// the singleton (see the plan's "Singleton state leaks across tests" rule): a
+// reader test that called Initialize* would mutate process-wide state that
+// every later test in the same process observes.
+//
+// Scope honesty: the null path returns before any decoding happens, so these
+// tests say nothing about whether the decoder is correct. A reader that returned
+// the right number of wrong entries, or one that stopped early, would pass all
+// three. The decoder's real oracle is the round-trip test in Task 3.
+//
+// The explicit static_cast<const char*> is required, not stylistic:
+// ReadClassTableLinkInfo is overloaded on (const char*) and (ReadStream*), so a
+// bare nullptr is ambiguous and does not compile.
+VM_UNIT_TEST_CASE(ReadClassTableLinkInfo_NullPathReturnsEmpty) {
+  std::unique_ptr<ClassTableLinkInfo> result =
+      ReadClassTableLinkInfo(static_cast<const char*>(nullptr));
+  EXPECT(result != nullptr);
+  EXPECT_EQ(static_cast<size_t>(0), result->classes().size());
+  EXPECT_EQ(static_cast<intptr_t>(0), result->num_cids());
+}
+
+VM_UNIT_TEST_CASE(ReadFieldTableLinkInfo_NullPathReturnsEmpty) {
+  std::unique_ptr<FieldTableLinkInfo> result =
+      ReadFieldTableLinkInfo(static_cast<const char*>(nullptr));
+  EXPECT(result != nullptr);
+  EXPECT_EQ(static_cast<size_t>(0), result->fields().size());
+  EXPECT_EQ(static_cast<intptr_t>(0), result->max_field_id());
+}
+
+VM_UNIT_TEST_CASE(ReadDispatchTableLinkInfo_NullPathReturnsEmpty) {
+  std::unique_ptr<DispatchTableLinkInfo> result =
+      ReadDispatchTableLinkInfo(static_cast<const char*>(nullptr));
+  EXPECT(result != nullptr);
+  EXPECT_EQ(static_cast<size_t>(0), result->selectors().size());
+}
+
 }  // namespace dart
