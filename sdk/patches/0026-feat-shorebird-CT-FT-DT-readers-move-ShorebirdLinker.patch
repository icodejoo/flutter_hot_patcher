-}  // namespace shorebird
+namespace {
+
+// Reads a file entirely into a heap-allocated buffer. Returns true and sets
+// *buf/*size on success, false on any error. Caller must free(*buf).
+//
+// An empty file is reported as an error rather than handed on as a zero-length
+// buffer: every one of these formats begins with a count, so zero bytes cannot
+// be a valid encoding, and ReadStream's bounds ASSERT is compiled out in
+// Release/Product builds -- decoding a zero-length buffer would read off the
+// end of the allocation instead of failing.
+bool ReadFileIntoBuffer(const char* path, uint8_t** buf, intptr_t* size) {
+  FILE* f = fopen(path, "rb");
+  if (f == nullptr) {
+    OS::PrintErr("ShorebirdLinker: cannot open %s\n", path);
+    return false;
+  }
+  if (fseek(f, 0, SEEK_END) != 0) {
+    fclose(f);
+    return false;
+  }
+  const long len = ftell(f);  // NOLINT(runtime/int)
+  if (len <= 0) {
+    if (len == 0) {
+      OS::PrintErr("ShorebirdLinker: %s is empty\n", path);
+    }
+    fclose(f);
+    return false;
+  }
+  rewind(f);
+  uint8_t* data = reinterpret_cast<uint8_t*>(malloc(len));
+  if (data == nullptr) {
+    fclose(f);
+    return false;
+  }
+  if (fread(data, 1, static_cast<size_t>(len), f) != static_cast<size_t>(len)) {
+    free(data);
+    fclose(f);
+    return false;
+  }
+  fclose(f);
+  *buf = data;
+  *size = static_cast<intptr_t>(len);
+  return true;
+}
+
+// str := len:u, char:s * len
+// Mirrors WriteString() in link_info.cc, which length-prefixes and then writes
+// each character with Write<int32_t> -- the signed varint form, so this must
+// read back with Read<int32_t> (kEndByteMarker), not ReadUnsigned.
+std::string ReadString(ReadStream* stream) {
+  const intptr_t len = stream->ReadUnsigned<intptr_t>();
+  std::string result;
+  result.reserve(static_cast<size_t>(len));
+  for (intptr_t i = 0; i < len; i++) {
+    const int32_t ch = stream->Read<int32_t>();
+    result.push_back(static_cast<char>(ch));
+  }
+  return result;
+}
+
+}  // namespace
+
+std::unique_ptr<ClassTableLinkInfo> ReadClassTableLinkInfo(ReadStream* stream) {
+  // count:u, { id:u, name:str, hash:str } * count, num_cids:u
+  //
+  // Count-driven: read the count, loop exactly that many times, and only then
+  // read the trailer. Looping until the buffer is exhausted would swallow
+  // num_cids as a phantom entry while still looking like a clean parse.
+  const intptr_t count = stream->ReadUnsigned<intptr_t>();
+  std::vector<ClassInfo> classes;
+  classes.reserve(static_cast<size_t>(count));
+  for (intptr_t i = 0; i < count; i++) {
+    ClassInfo info;
+    info.cid = stream->ReadUnsigned<intptr_t>();
+    info.name = ReadString(stream);
+    info.hash = ReadString(stream);
+    classes.push_back(std::move(info));
+  }
+  // Trailing scalar -- after the loop, not inside it.
+  const intptr_t num_cids = stream->ReadUnsigned<intptr_t>();
+
+  return std::make_unique<ClassTableLinkInfo>(std::move(classes), num_cids);
+}
+
+std::unique_ptr<ClassTableLinkInfo> ReadClassTableLinkInfo(const char* path) {
+  uint8_t* buf = nullptr;
+  intptr_t size = 0;
+  if (path == nullptr || !ReadFileIntoBuffer(path, &buf, &size)) {
+    return std::make_unique<ClassTableLinkInfo>(std::vector<ClassInfo>{},
+                                                /*num_cids=*/0);
+  }
+  // Frees buf however we leave this function.
+  std::unique_ptr<uint8_t, decltype(&free)> guard(buf, free);
+
+  ReadStream stream(buf, size);
+  return ReadClassTableLinkInfo(&stream);
+}
+
+std::unique_ptr<FieldTableLinkInfo> ReadFieldTableLinkInfo(ReadStream* stream) {
+  // count:u, { id:u, name:str, hash:str } * count, max_field_id:u
+  const intptr_t count = stream->ReadUnsigned<intptr_t>();
+  std::vector<FieldInfo> fields;
+  fields.reserve(static_cast<size_t>(count));
+  for (intptr_t i = 0; i < count; i++) {
+    FieldInfo info;
+    info.id = stream->ReadUnsigned<intptr_t>();
+    info.name = ReadString(stream);
+    info.hash = ReadString(stream);
+    fields.push_back(std::move(info));
+  }
+  // Trailing scalar.
+  const intptr_t max_field_id = stream->ReadUnsigned<intptr_t>();
+
+  return std::make_unique<FieldTableLinkInfo>(std::move(fields), max_field_id);
+}
+
+std::unique_ptr<FieldTableLinkInfo> ReadFieldTableLinkInfo(const char* path) {
+  uint8_t* buf = nullptr;
+  intptr_t size = 0;
+  if (path == nullptr || !ReadFileIntoBuffer(path, &buf, &size)) {
+    return std::make_unique<FieldTableLinkInfo>(std::vector<FieldInfo>{},
+                                                /*max_field_id=*/0);
+  }
+  std::unique_ptr<uint8_t, decltype(&free)> guard(buf, free);
+
+  ReadStream stream(buf, size);
+  return ReadFieldTableLinkInfo(&stream);
+}
+
+std::unique_ptr<DispatchTableLinkInfo> ReadDispatchTableLinkInfo(
+    ReadStream* stream) {
+  // count:u, { offset:u, hash:str, nranges:u, (lo:u, hi:u)*nranges } * count
+  // No trailing scalar; the end of the entry loop is the end of the data.
+  const intptr_t count = stream->ReadUnsigned<intptr_t>();
+  std::vector<SelectorRowInfo> selectors;
+  selectors.reserve(static_cast<size_t>(count));
+  for (intptr_t i = 0; i < count; i++) {
+    SelectorRowInfo row;
+    row.offset = stream->ReadUnsigned<intptr_t>();
+    row.hash = ReadString(stream);
+    const intptr_t nranges = stream->ReadUnsigned<intptr_t>();
+    row.ranges.reserve(static_cast<size_t>(nranges));
+    for (intptr_t j = 0; j < nranges; j++) {
+      const intptr_t lo = stream->ReadUnsigned<intptr_t>();
+      const intptr_t hi = stream->ReadUnsigned<intptr_t>();
+      row.ranges.push_back({lo, hi});
+    }
+    selectors.push_back(std::move(row));
+  }
+
+  return std::make_unique<DispatchTableLinkInfo>(std::move(selectors));
+}
+
+std::unique_ptr<DispatchTableLinkInfo> ReadDispatchTableLinkInfo(
+    const char* path) {
+  uint8_t* buf = nullptr;
+  intptr_t size = 0;
+  if (path == nullptr || !ReadFileIntoBuffer(path, &buf, &size)) {
+    return std::make_unique<DispatchTableLinkInfo>(
+        std::vector<SelectorRowInfo>{});
+  }
+  std::unique_ptr<uint8_t, decltype(&free)> guard(buf, free);
+
+  ReadStream stream(buf, size);
+  return ReadDispatchTableLinkInfo(&stream);
+}
+
 }  // namespace dart
