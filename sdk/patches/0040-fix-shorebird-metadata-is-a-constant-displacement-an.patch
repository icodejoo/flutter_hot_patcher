+void SimToCPUConfig::GetStubCodeRange(uword& code_start, uword& code_end) {
   if (!StubCode::HasBeenInitialized()) {
     // Consulted before StubCode::Init() -- politely report "no stub yet"
     // rather than crashing on an uninitialized Code handle.
@@ -91,22 +77,29 @@ intptr_t WrapperAllocator::MetadataOffset() const {
   return layout_.rx_mapping_size;
 }
 
+// A landing pad and its metadata are a fixed distance apart -- no page recovery,
+// no index arithmetic. This works because landing_pad_size == metadata_size == 8,
+// so pad i and Metadata[i] advance in lockstep and one constant displacement maps
+// between them.
+//
+// This is not a simplification we chose; it is what their Sim->CPU shared body
+// does, in three instructions:
+//
+//     mov  x17, #0x8000        ; == rx_mapping_size
+//     add  x16, x16, x17       ; x16 held &pad[i] from the pad's own adr x16, #0
+//     ldr  x16, [x16]          ; Metadata::target_entry_point
+//
+// See spikes/shorebird_linkinfo_oracle/WRAPPER_STUBS.md. Note the corollary that
+// their metadata array is shifted by offset_of_first_wrapper_in_page_ along with
+// the pads, rather than starting at the mapping's RW boundary. The earlier
+// version here recovered the page by masking and indexed from that boundary,
+// which differs from this by exactly that offset -- self-consistent, and wrong.
 void* WrapperAllocator::MetadataForWrapper(uword wrapper) const {
-  const uword page = MappingStart(wrapper);
-  const intptr_t index = static_cast<intptr_t>(
-      (wrapper - page - offset_of_first_wrapper_in_page_) /
-      layout_.landing_pad_size);
-  return reinterpret_cast<void*>(page + MetadataOffset() +
-                                 index * layout_.metadata_size);
+  return reinterpret_cast<void*>(wrapper + MetadataOffset());
 }
 
 uword WrapperAllocator::WrapperOfMetadata(void* metadata) const {
-  const uword address = reinterpret_cast<uword>(metadata);
-  const uword page = MappingStart(address);
-  const intptr_t index = static_cast<intptr_t>(
-      (address - page - MetadataOffset()) / layout_.metadata_size);
-  return page + offset_of_first_wrapper_in_page_ +
-         index * layout_.landing_pad_size;
+  return reinterpret_cast<uword>(metadata) - MetadataOffset();
 }
 
 bool WrapperAllocator::ContainsEntryPoint(uword entry_point, uword* target) {
@@ -175,8 +168,9 @@ VirtualMemory* WrapperAllocator::AllocateWrapperPage() {
     return nullptr;
   }
 
-  // Aligning to MappingAlignment() is what lets MappingStart() recover a page
-  // base by masking, so a wrapper address alone is enough to find its metadata.
+  // Aligning to MappingAlignment() lets MappingStart() recover a page base by
+  // masking, which is how ContainsEntryPoint tests page ownership. It is not
+  // needed to find a wrapper's metadata -- that is a constant displacement.
   VirtualMemory* page = VirtualMemory::AllocateAligned(
       layout_.MappingSize(), layout_.MappingAlignment(),
       /*is_executable=*/false, /*is_compressed=*/false,
@@ -216,23 +210,16 @@ void* WrapperAllocator::AllocateMetadata() {
   const intptr_t index = layout_.num_wrappers_per_page -
                          static_cast<intptr_t>(wrappers_left_in_current_page_);
   wrappers_left_in_current_page_--;
-  return reinterpret_cast<void*>(CurrentPage()->start() + MetadataOffset() +
-                                 index * layout_.metadata_size);
-}
 
-void InitSimToCpuWrapperPage() {
-  // Confirm the stub is visible and record its range for later use. This is a
-  // no-op while the shared body is a breakpoint placeholder -- the real work
-  // happens once the body is transcribed and a WrapperAllocator hands out pads.
-  // The call itself is what matters architecturally: it is the only live
-  // reference from stub_code.cc into wrapper.cc, and without it -dead_strip
-  // removes the entire allocator from gen_snapshot.
-  uword start = 0;
-  uword end = 0;
-  SimToCPUConfig::GetStubCodeRange(start, end);
-  USE(start);
-  USE(end);
+  // Reserve the pad, then derive its metadata slot the same way the shared body
+  // will at run time. Deriving it rather than computing a second, parallel
+  // formula is what keeps the two from drifting apart.
+  const uword wrapper = CurrentPage()->start() +
+                        offset_of_first_wrapper_in_page_ +
+                        index * layout_.landing_pad_size;
+  return MetadataForWrapper(wrapper);
 }
 
