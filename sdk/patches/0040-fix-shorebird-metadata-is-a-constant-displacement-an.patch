 }  // namespace shorebird
 }  // namespace dart
diff --git a/runtime/vm/shorebird/wrapper.h b/runtime/vm/shorebird/wrapper.h
index 551a4a4de82..7484c1fcd6e 100644
--- a/runtime/vm/shorebird/wrapper.h
+++ b/runtime/vm/shorebird/wrapper.h
@@ -131,9 +131,14 @@ class WrapperAllocator {
     uword CodeSize() const;
 
     // Their wrapper.h:116 and :117. Upstream's MappingSize() and
-    // MappingAlignment(). The alignment is what makes a page base recoverable
-    // from any address inside it by masking, which is how their one-argument
-    // MetadataForWrapper can work without being told the page.
+    // MappingAlignment(). The alignment makes a page base recoverable from any
+    // address inside it by masking, which is how ContainsEntryPoint decides
+    // whether an address belongs to one of our pages.
+    //
+    // It is NOT the reason MetadataForWrapper takes no page argument -- an
+    // earlier version of this comment claimed that, and their disassembled
+    // shared body disproves it: the body never masks anything. A pad and its
+    // metadata are simply a constant distance apart.
     intptr_t MappingSize() const { return rx_mapping_size + rw_mapping_size; }
     intptr_t MappingAlignment() const {
       return Utils::RoundUpToPowerOfTwo(MappingSize());
@@ -156,8 +161,10 @@ class WrapperAllocator {
   // They have no WrapEntryPoint -- this pair is the whole allocation API.
   void* AllocateMetadata();
 
-  // Their wrapper.h:131 and :132. Inverses of each other. Neither is told the
-  // page: it is recovered by masking with MappingAlignment().
+  // Their wrapper.h:131 and :132. Inverses of each other, and each is a single
+  // add or subtract of MetadataOffset(): a pad and its metadata sit a constant
+  // distance apart because landing_pad_size == metadata_size. Their shared body
+  // does exactly this in three instructions -- see wrapper.cc.
   uword WrapperOfMetadata(void* metadata) const;
   void* MetadataForWrapper(uword wrapper) const;
 
@@ -200,14 +207,6 @@ class WrapperAllocator {
   DISALLOW_COPY_AND_ASSIGN(WrapperAllocator);
 };
 
-// Called once from StubCode::Init() after InitializationDone(). Queries the
-// Sim→CPU stub's code range to verify it is reachable and to create a live
-// reference from stub_code.cc into wrapper.cc. Without this call the linker's
-// -dead_strip pass removes wrapper.cc from gen_snapshot because nothing else
-// in the product call graph touches it. The body is a no-op while the real
-// Sim→CPU shared body is still a breakpoint placeholder; the call becomes
-// meaningful once the real body lands.
-void InitSimToCpuWrapperPage();
 
 }  // namespace shorebird
 }  // namespace dart
diff --git a/runtime/vm/shorebird/wrapper_symbols_check.sh b/runtime/vm/shorebird/wrapper_symbols_check.sh
index d9d2aa8bc2d..901a948e6a4 100755
--- a/runtime/vm/shorebird/wrapper_symbols_check.sh
+++ b/runtime/vm/shorebird/wrapper_symbols_check.sh
@@ -1,21 +1,35 @@
 #!/usr/bin/env bash
-# Fails if wrapper.cc got dead-stripped out of the product gen_snapshot.
+# Is WrapperAllocator actually in the product artifact, or only compiled?
 #
-# Compiling is not landing. sim_bridge.cc produced a .o for months while
-# `nm gen_snapshot` found zero of its symbols, because no call site referenced
-# it. Expect this check to FAIL until plan #2 wires WrapEntryPoint into the
-# simulator -- that is the point of it.
+# wrapper.cc builds fine but has no caller, so -dead_strip discards it. This
+# reports whether that is still true.
+#
+# The pattern matches WrapperAllocator and nothing else, on purpose. An earlier
+# version also accepted CPUToSimConfig|SimToCPUConfig, and reported success on a
+# count of 2 that turned out to be one config getter listed twice (a FUN debug
+# entry plus its text symbol) while every allocator symbol was still stripped.
+# A check that a config accessor can satisfy is not a check on the allocator.
 set -euo pipefail
 
 BIN=${1:-$HOME/dart-3122/sdk/xcodebuild/ProductARM64/gen_snapshot}
 [ -x "$BIN" ] || { echo "missing binary: $BIN" >&2; exit 2; }
 
-n=$(nm -a "$BIN" 2>/dev/null | c++filt \
-    | grep -cE 'shorebird::(WrapperAllocator|Layout|CPUToSimConfig|SimToCPUConfig)' || true)
+n=$(nm -a "$BIN" 2>/dev/null | c++filt | sort -u \
+    | grep -c 'shorebird::WrapperAllocator' || true)
+
+echo "WrapperAllocator symbols in $(basename "$BIN"): $n"
 
-echo "wrapper.cc symbols in $(basename "$BIN"): $n"
 if [ "$n" -eq 0 ]; then
-  echo "FAIL: dead-stripped -- compiled but not referenced by anything" >&2
+  cat >&2 <<'EOF'
+FAIL: dead-stripped -- compiled, but nothing in the product call graph calls it.
+
+This is the expected state until a real caller exists. A real caller means code
+on the CPU<->Sim transition path that actually wraps an entry point. Calling
+into wrapper.cc from an init hook purely to keep the symbols alive satisfies
+this script without making the allocator reachable from anything that matters,
+so it does not count -- it was tried, and it did not even move this number.
+EOF
   exit 1
 fi
-echo "PASS: wrapper.cc is present in the product artifact"
+
+echo "PASS: WrapperAllocator survives into the product artifact"
diff --git a/runtime/vm/shorebird/wrapper_test.cc b/runtime/vm/shorebird/wrapper_test.cc
index b8afdc7903b..e1cbae62674 100644
--- a/runtime/vm/shorebird/wrapper_test.cc
+++ b/runtime/vm/shorebird/wrapper_test.cc
@@ -193,12 +193,36 @@ VM_UNIT_TEST_CASE(WrapperAllocator_WrapperMetadataRoundTrips) {
   for (intptr_t i = 0; i < l.num_wrappers_per_page; i++) {
     const uword wrapper = page + offset + i * l.landing_pad_size;
     void* metadata = allocator.MetadataForWrapper(wrapper);
-    EXPECT_EQ(page + l.rx_mapping_size + i * l.metadata_size,
+    // A pad and its metadata are a constant distance apart -- rx_mapping_size,
+    // which is the 0x8000 their shared body materializes. Note this is measured
+    // from the pad, so the metadata array is shifted by `offset` too; it does
+    // not begin at the mapping's RW boundary.
+    EXPECT_EQ(wrapper + static_cast<uword>(l.rx_mapping_size),
               reinterpret_cast<uword>(metadata));
     EXPECT_EQ(wrapper, allocator.WrapperOfMetadata(metadata));
   }
 }
 
+// The constant-displacement scheme only works if the last pad's metadata is
+// still inside the mapping, and it only just is: with the pads shifted by
+// `offset`, the final metadata word ends at offset + 49112 + 8 against a 65536
+// mapping. That leaves room only while `offset` stays under a page, which is
+// guaranteed because it is a byte offset within one OS page. Worth pinning,
+// because a larger rx_mapping_size or a smaller mapping would silently push the
+// tail of the metadata array out of the allocation.
+VM_UNIT_TEST_CASE(WrapperAllocator_LastMetadataFitsInsideTheMapping) {
+  const Layout l = TestLayout();
+  const uword offset = ExpectedFirstWrapperOffset();
+  EXPECT(offset < static_cast<uword>(l.page_size));
+
+  const uword last_pad = offset + (l.num_wrappers_per_page - 1) * l.landing_pad_size;
+  const uword last_metadata_end =
+      last_pad + l.rx_mapping_size + l.metadata_size;
+  EXPECT(last_metadata_end <= static_cast<uword>(l.MappingSize()));
+  // And it does not collide with the RX half it is measured from.
+  EXPECT(last_pad + l.rx_mapping_size >= static_cast<uword>(l.rx_mapping_size));
+}
+
 // Distinct allocations must get distinct landing pads, advancing by exactly one
 // pad each time.
 VM_UNIT_TEST_CASE(WrapperAllocator_HandsOutDistinctSequentialPads) {
