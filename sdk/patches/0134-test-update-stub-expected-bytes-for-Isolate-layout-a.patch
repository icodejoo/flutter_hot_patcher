From eadefa30021dade93cd403d1bef764169a1cabc2 Mon Sep 17 00:00:00 2001
From: cruz <cruz@tbu.net>
Date: Fri, 4 Sep 2026 14:21:59 +0800
Subject: [PATCH 134/206] test: update stub expected bytes for Isolate layout
 after 50c8136cc5f
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Commit 50c8136cc5f (D3 PROT_EXEC fix) changed three stub generators to
use dart::Isolate::simulator_offset() instead of the hardcoded value
0x20.  Shorebird reorganised Isolate's private members so their
simulator_ sits at Isolate+0x20; ours cannot be reorganised without
regenerating offset tables for 16 build configurations, so our host
offset is at a higher address.

The four affected tests had the old offset hardcoded as a pinned literal
(0xF940114A / 0xF940116B).  Convert those positions to derived
EXPECT_EQ checks that use the real host offset, matching the pattern
already used for Thread-layout differences.  Add a reference assertion
showing that the old literal encodes exactly their offset (0x20), so
the change is documented as a displacement-only difference.

Also update compare_stubs.py EXPECTED counts for the three stubs that
gain one extra differing word (CallSimulatorFromFfiTrampoline 2→3,
ResumeOnSimulator 10→11, RunDartOnCPU 7→8).

Negative control verified: replacing the w[7] derivation in CpuToSim
with 0xDEADBEEF turns that test red.

Four tests now green: CpuToSimBody, CallSimFromFfi, ResumeOnSimulator,
RunDartOnCPU.  verify_all.sh: 19 ran, 0 failed.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>

diff --git a/runtime/vm/shorebird/wrapper_stub_test.cc b/runtime/vm/shorebird/wrapper_stub_test.cc
index 608d7dc403e..c06278df740 100644
--- a/runtime/vm/shorebird/wrapper_stub_test.cc
+++ b/runtime/vm/shorebird/wrapper_stub_test.cc
@@ -156,7 +156,10 @@ ISOLATE_UNIT_TEST_CASE(StubCode_ShorebirdCpuToSimBodyMatchesTheirBytes) {
       0xb4000051u,  // [4]
       0xd61f0160u,  // [5]
       0u,  // [6] derived below
-      0xf940114au,  // [7]
+      0u,  // [7] derived below: LDR x10,[x10,#Isolate::simulator_offset()]
+            //   exempt: Shorebird reorganised Isolate's private members so their
+            //   simulator_ sits at Isolate+0x20; ours is at a different offset
+            //   because we cannot reorganise without regenerating 16 offset tables
       0xf901894bu,  // [8]
       0xf901894bu,  // [9]
       0xf9003d4fu,  // [10]
@@ -229,6 +232,17 @@ ISOLATE_UNIT_TEST_CASE(StubCode_ShorebirdCpuToSimBodyMatchesTheirBytes) {
 
   EXPECT_EQ(ldst_thr(kLdr, Thread::is_simulating_offset(), 17), w[3]);
   EXPECT_EQ(ldst_thr(kLdr, compiler::target::Thread::isolate_offset(), 10), w[6]);
+  // [7] LDR x10,[x10,#Isolate::simulator_offset()] -- exempt: Shorebird's
+  // Isolate has simulator_ at Isolate+0x20; ours is at a higher offset because
+  // we did not reorganise Isolate's private members (doing so would require
+  // regenerating offset tables for 16 build configurations).
+  EXPECT_EQ(0xF9400000u | (static_cast<uint32_t>(
+                               dart::Isolate::simulator_offset() / 8) << 10) |
+                (10u << 5) | 10u,
+            w[7]);
+  // Their value for reference: LDR x10,[x10,#0x20] (Isolate+0x20 = simulator_).
+  EXPECT_EQ(0xf940114au, 0xF9400000u | (uint32_t{0x20 / 8} << 10) |
+                             (10u << 5) | 10u);
   EXPECT_EQ(ldst_thr(kLdr, Thread::dart_state_is_on_cpu_offset(), 16), w[23]);
   EXPECT_EQ(ldst_thr(kStr, Thread::dart_state_is_on_cpu_offset(), 16), w[28]);
   EXPECT_EQ(ldst_thr(kLdr, Thread::simulator_csp_offset(), 16), w[29]);
@@ -277,7 +291,9 @@ ISOLATE_UNIT_TEST_CASE(StubCode_ShorebirdCallSimFromFfiMatchesTheirBytes) {
       0xa9bf7bfdu,  // [0]
       0x910003fdu,  // [1]
       0u,  // [2]  derived
-      0xf940116bu,  // [3]
+      0u,  // [3]  derived: LDR x11,[x11,#Isolate::simulator_offset()]
+            //   exempt: Shorebird's Isolate has simulator_ at Isolate+0x20;
+            //   ours differs (see CpuToSim [7] comment for full rationale)
       0xa9000560u,  // [4]
       0xa9010d62u,  // [5]
       0xa9021564u,  // [6]
@@ -313,6 +329,13 @@ ISOLATE_UNIT_TEST_CASE(StubCode_ShorebirdCallSimFromFfiMatchesTheirBytes) {
   };
   EXPECT_EQ(ldst_thr(0xf9400000u,
                      compiler::target::Thread::isolate_offset(), 11), w[2]);
+  // [3] LDR x11,[x11,#Isolate::simulator_offset()] -- exempt: Shorebird's
+  // Isolate has simulator_ at Isolate+0x20; ours is at a higher offset.
+  // Their value: LDR x11,[x11,#0x20] = 0xF940116B.
+  EXPECT_EQ(0xF9400000u | (static_cast<uint32_t>(
+                               dart::Isolate::simulator_offset() / 8) << 10) |
+                (11u << 5) | 11u,
+            w[3]);
   EXPECT_EQ(ldst_thr(0xf9400000u,
                      Thread::simulator_call_from_ffi_offset(), 16), w[17]);
 
@@ -489,7 +512,9 @@ ISOLATE_UNIT_TEST_CASE(StubCode_ShorebirdResumeOnSimulatorMatchesTheirBytes) {
       0xb4000051u,  // [3]
       0xd61f0160u,  // [4]
       0u,  // [5]  derived
-      0xf940114au,  // [6]
+      0u,  // [6]  derived: LDR x10,[x10,#Isolate::simulator_offset()]
+            //   exempt: Shorebird's Isolate has simulator_ at Isolate+0x20;
+            //   ours differs (see CpuToSim [7] comment for full rationale)
       0xf901894bu,  // [7]
       0xf9003d4fu,  // [8]
       0xa909d153u,  // [9]
@@ -564,6 +589,13 @@ ISOLATE_UNIT_TEST_CASE(StubCode_ShorebirdResumeOnSimulatorMatchesTheirBytes) {
             w[2]);
   EXPECT_EQ(ldst_thr(kLdr, compiler::target::Thread::isolate_offset(), 10),
             w[5]);
+  // [6] LDR x10,[x10,#Isolate::simulator_offset()] -- exempt: Shorebird's
+  // Isolate has simulator_ at Isolate+0x20; ours is at a higher offset.
+  // Their value: LDR x10,[x10,#0x20] = 0xF940114A.
+  EXPECT_EQ(0xF9400000u | (static_cast<uint32_t>(
+                               dart::Isolate::simulator_offset() / 8) << 10) |
+                (10u << 5) | 10u,
+            w[6]);
   EXPECT_EQ(ldst_thr(kLdr, Thread::dart_state_is_on_cpu_offset(), 16), w[21]);
   EXPECT_EQ(ldst_thr(kStr, Thread::dart_state_is_on_cpu_offset(), 16), w[26]);
   EXPECT_EQ(ldst_thr(kLdr, Thread::simulator_csp_offset(), 16), w[27]);
@@ -892,7 +924,9 @@ ISOLATE_UNIT_TEST_CASE(StubCode_ShorebirdRunDartOnCPUMatchesTheirBytes) {
       0xa9400420u,  // [41]
       0xd63f0200u,  // [42]
       0u,  // [43]  derived
-      0xf940114au,  // [44]
+      0u,  // [44]  derived: LDR x10,[x10,#Isolate::simulator_offset()]
+            //   exempt: Shorebird's Isolate has simulator_ at Isolate+0x20;
+            //   ours differs (see CpuToSim [7] comment for full rationale)
       0xa9000540u,  // [45]
       0xa9010d42u,  // [46]
       0xa9021544u,  // [47]
@@ -950,6 +984,13 @@ ISOLATE_UNIT_TEST_CASE(StubCode_ShorebirdRunDartOnCPUMatchesTheirBytes) {
   EXPECT_EQ(ldst_thr(kStr, csp, 11), w[31]);
   EXPECT_EQ(ldst_thr(kLdr, compiler::target::Thread::isolate_offset(), 10),
             w[43]);
+  // [44] LDR x10,[x10,#Isolate::simulator_offset()] -- exempt: Shorebird's
+  // Isolate has simulator_ at Isolate+0x20; ours is at a higher offset.
+  // Their value: LDR x10,[x10,#0x20] = 0xF940114A.
+  EXPECT_EQ(0xF9400000u | (static_cast<uint32_t>(
+                               dart::Isolate::simulator_offset() / 8) << 10) |
+                (10u << 5) | 10u,
+            w[44]);
   EXPECT_EQ(ldst_thr(kLdr, on_cpu, 16), w[66]);
   EXPECT_EQ(ldst_thr(kStr, on_cpu, 16), w[71]);
   EXPECT_EQ(ldst_thr(kLdr, csp, 16), w[72]);
