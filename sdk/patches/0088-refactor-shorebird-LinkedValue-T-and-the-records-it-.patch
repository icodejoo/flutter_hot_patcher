diff --git a/runtime/vm/shorebird/linker.h b/runtime/vm/shorebird/linker.h
index 2cc52c9964a..7ca74887397 100644
--- a/runtime/vm/shorebird/linker.h
+++ b/runtime/vm/shorebird/linker.h
@@ -21,6 +21,35 @@ namespace dart {
 // readers' signatures only need the declaration and the include could change.
 class ReadStream;
 
+// Their `LinkedValue<T>`: one thing from the base snapshot beside the thing in
+// the patch it was matched to. Both mappers' link results are a vector of it.
+//
+// It has no symbol of its own -- it is a template, and every use is inlined --
+// but two independent element sizes give it away, each read out of the exact
+// division libc++ compiles vector::size() into:
+//
+//   class table, 0x10019a75c:   sub, asr #4, then multiply by 7's modular
+//                               inverse 0x6db6db6db6db6db7 -> element size 112,
+//                               against sizeof(ClassInfo) == 0x38 == 56
+//   object pool, 0x10019dba8:   sub, asr #4, and no multiply -> element size 16,
+//                               against sizeof(uword) == 8
+//
+// Both are exactly double, from two unrelated instantiations, which is what
+// makes "a base T and a patch T" a reading rather than a guess. The member
+// order is fixed by their stage 1: 0x10019a4f8 reads the base cid at +0x00 and
+// the patch cid at +0x38, then 0x10019a500 does mapping[patch] = base.
+//
+// The class table's instantiation carries whole ClassInfo records rather than
+// the two cids the mapper actually uses -- that 0x70 stride and the +0x38 are
+// what say so. Narrowing at the point of use instead of at the point of
+// production is theirs, and following it keeps our stride and offsets equal to
+// theirs instead of merely equivalent.
+template <typename T>
+struct LinkedValue {
+  T base;
+  T patch;
+};
+
 // Their `dart::ObjectPoolMappingsAggregator`, which decides which base pool
 // index each patch pool index maps to when the evidence is ambiguous.
 //
@@ -170,15 +199,11 @@ class ShorebirdLinker {
   // definition for how each step was read; the counters it fills are the four
   // their report prints.
   //
-  // A link result pairs a base class with a patch class. Their container is
-  // `vector<LinkedValue<ClassInfo>>`, where LinkedValue<T> holds a base T then
-  // a patch T -- established by the element size their own vector::size()
-  // division reveals: 112 bytes against sizeof(ClassInfo) == 56, and 16 bytes
-  // against sizeof(uword) on the object pool side.
-  struct ClassIdPair {
-    intptr_t base_cid;
-    intptr_t patch_cid;
-  };
+  // A link result pairs a base class with a patch class: their
+  // `vector<LinkedValue<ClassInfo>>`. The whole records travel, and stage 1
+  // narrows them to cids where it uses them -- see LinkedValue's own comment
+  // for the stride and offsets that establish that.
+  using ClassLink = LinkedValue<ClassInfo>;
 
   struct MappingCounts {
     intptr_t link_results = 0;
@@ -191,7 +216,7 @@ class ShorebirdLinker {
   // `num_patch_cids`. Static and free of linker state, so it can be tested
   // directly against the numbers their own report prints.
   static std::vector<intptr_t> ComputeClassTableMapping(
-      const std::vector<ClassIdPair>& link_results,
+      const std::vector<ClassLink>& link_results,
       intptr_t num_patch_cids,
       MappingCounts* counts);
 
@@ -203,13 +228,14 @@ class ShorebirdLinker {
   // `link_results` is their vector<LinkedValue<uword>> -- a base index then a
   // patch index, 16 bytes -- and `pair_constraints` is ObjectPoolLinkInfo's own
   // index list, which the mapper reads at 0x10019d7c0.
-  struct PoolIndexPair {
-    intptr_t base_index;
-    intptr_t patch_index;
-  };
+  //
+  // uword rather than intptr_t because that is the instantiation their symbol
+  // table names. Only resolved indices are ever stored, so the -1 that
+  // GetBestMapping returns never reaches this type.
+  using PoolLink = LinkedValue<uword>;
 
   static std::vector<intptr_t> ComputeObjectPoolMapping(
-      const std::vector<PoolIndexPair>& link_results,
+      const std::vector<PoolLink>& link_results,
       const std::vector<int32_t>& pair_constraints,
       intptr_t num_pool_entries,
       MappingCounts* counts);
@@ -248,7 +274,7 @@ class ShorebirdLinker {
   // when it holds exactly one class -- the patch side checked at 0x100199ad4
   // and the base side at 0x100199dd4. A hash naming two classes on either side
   // is ambiguous, so it pairs nothing.
-  static std::vector<ClassIdPair> ComputeClassTableLinkResults(
+  static std::vector<ClassLink> ComputeClassTableLinkResults(
       const ClassTableLinkInfo& base,
       const ClassTableLinkInfo& patch);
 
@@ -309,7 +335,7 @@ class ShorebirdLinker {
   // 3. Their comparator captures the key by reference; ours takes it by value.
   //    The double load at 0x10019f22c-0x10019f230 proves the capture mode, but
