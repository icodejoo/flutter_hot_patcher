diff --git a/runtime/bin/snapshot_utils.h b/runtime/bin/snapshot_utils.h
index a68d152eebd..6894859fe2f 100644
--- a/runtime/bin/snapshot_utils.h
+++ b/runtime/bin/snapshot_utils.h
@@ -22,6 +22,14 @@ class AppSnapshot {
                           const uint8_t** isolate_data_buffer,
                           const uint8_t** isolate_instructions_buffer) = 0;
 
+  // Populate the byte sizes of the two data regions. Defaults to 0 (unknown)
+  // for snapshot types whose loaders do not expose segment sizes (ELF, MachO).
+  // Overridden in MappedAppSnapshot where MappedMemory::size() is available.
+  virtual void SetDataSizes(intptr_t* vm_data_size, intptr_t* isolate_data_size) {
+    *vm_data_size = 0;
+    *isolate_data_size = 0;
+  }
+
   bool IsJIT() const { return magic_number_ == DartUtils::kAppJITMagicNumber; }
   bool IsAOT() const { return DartUtils::IsAotMagicNumber(magic_number_); }
   bool IsJITorAOT() const { return IsJIT() || IsAOT(); }
