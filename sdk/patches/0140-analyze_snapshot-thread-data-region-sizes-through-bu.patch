+// F19: DataRegionSize bounds check.
+//
+// Build a minimal snapshot header of exactly kHeaderSize (20) bytes, then ask
+// Dart_DumpBlobs to measure it with vm_snapshot_data_size=20.  The
+// extra-block header lives at the 64-byte-aligned offset after snap_len (= 64
+// here), which is past the 20-byte region.  The fixed DataRegionSize must
+// detect this and fall back to snap_len=20 rather than reading out-of-bounds.
+//
+// Negative control: remove the bounds check in DataRegionSize; this test must
+// go red (OOB read changes out_len to snap_len + arbitrary garbage).
+UNIT_TEST_CASE(ShorebirdAnalyzeSnapshot_DataRegionSizeBoundsCheck) {
+  // Construct a minimal valid snapshot header: magic + length + kind.
+  // Total = kMagicSize(4) + kLengthSize(8) + kKindSize(8) = 20 bytes.
+  static_assert(Snapshot::kHeaderSize == 20, "header layout changed");
+  uint8_t buf[Snapshot::kHeaderSize] = {};
+
+  // Magic (4 bytes LE).
+  const uint32_t magic = Snapshot::kMagicValue;
+  memmove(buf + Snapshot::kMagicOffset, &magic, sizeof(magic));
+
+  // Stored length = snap_len - kMagicSize = 20 - 4 = 16.
+  const int64_t stored_len = static_cast<int64_t>(sizeof(buf)) -
+                             static_cast<int64_t>(Snapshot::kMagicSize);
+  memmove(buf + Snapshot::kLengthOffset, &stored_len, sizeof(stored_len));
+
+  // Kind = kFull (0) — SetupFromBuffer does not validate kind.
+  const int64_t kind = static_cast<int64_t>(Snapshot::kFull);
+  memmove(buf + Snapshot::kKindOffset, &kind, sizeof(kind));
+
+  // Verify our header is parseable.
+  const Snapshot* snap = Snapshot::SetupFromBuffer(buf);
+  EXPECT(snap != nullptr);
+  EXPECT_EQ(static_cast<intptr_t>(sizeof(buf)), snap->length());
+
+  // Call Dart_DumpBlobs with only vm_snapshot_data set and its size known.
+  // All other regions are null (sizes = 0, no copy).
+  dart::snapshot_analyzer::Dart_SnapshotAnalyzerInformation info = {};
+  info.vm_snapshot_data = buf;
+  info.vm_snapshot_data_size = static_cast<intptr_t>(sizeof(buf));
+
+  char* out = nullptr;
+  intptr_t out_len = 0;
+  Dart_DumpBlobs(info, &out, &out_len);
+
+  // DataRegionSize must have returned snap_len=20, not snap_len+garbage.
+  EXPECT_EQ(static_cast<intptr_t>(sizeof(buf)), out_len);
+  EXPECT(memcmp(out, buf, sizeof(buf)) == 0);
+  free(out);
+}
+
 }  // namespace dart
