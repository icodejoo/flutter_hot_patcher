+++ b/runtime/include/analyze_snapshot_api.h
@@ -17,6 +17,11 @@ typedef struct {
   const uint8_t* vm_snapshot_instructions;
   const uint8_t* vm_isolate_data;
   const uint8_t* vm_isolate_instructions;
+  // Byte sizes of the data regions. 0 means unknown: DataRegionSize falls back
+  // to the legacy unchecked read (needed for ELF/MachO loaders that do not
+  // expose segment sizes). Set via AppSnapshot::SetDataSizes when available.
+  intptr_t vm_snapshot_data_size;
+  intptr_t vm_isolate_data_size;
 } Dart_SnapshotAnalyzerInformation;
 
 void Dart_DumpSnapshotInformationAsJson(
diff --git a/runtime/vm/analyze_snapshot_api_impl.cc b/runtime/vm/analyze_snapshot_api_impl.cc
index 1df73517e6c..f60ebb16c79 100644
--- a/runtime/vm/analyze_snapshot_api_impl.cc
+++ b/runtime/vm/analyze_snapshot_api_impl.cc
@@ -1808,7 +1808,12 @@ bool ShorebirdHasIdentity(const std::string& name) {
 // The order -- both data regions, then both instructions regions -- is taken
 // from their output: it begins with the vm data magic and the instructions
 // bytes appear after all of the data.
-static intptr_t DataRegionSize(const uint8_t* region) {
+// region_size: known byte count of the mapped region, or 0 if unknown.
+// When 0, the extra-block header is read unconditionally (legacy behaviour
+// required for ELF/MachO loaders that do not expose segment sizes). When > 0,
+// the read is bounds-checked; if the extra-block header would fall outside the
+// region we fall back to snap_len (no Shorebird extras assumed).
+static intptr_t DataRegionSize(const uint8_t* region, intptr_t region_size) {
   if (region == nullptr) return 0;
   const Snapshot* snapshot = Snapshot::SetupFromBuffer(region);
   if (snapshot == nullptr) return 0;
@@ -1819,7 +1824,10 @@ static intptr_t DataRegionSize(const uint8_t* region) {
   const intptr_t aligned_off =
       (snap_len + kExtraAlignment - 1) & ~(kExtraAlignment - 1);
   uint32_t extra_size = 0;
-  memmove(&extra_size, region + aligned_off, sizeof(extra_size));
+  if (region_size == 0 ||
+      aligned_off + static_cast<intptr_t>(sizeof(extra_size)) <= region_size) {
+    memmove(&extra_size, region + aligned_off, sizeof(extra_size));
+  }
   return snap_len + static_cast<intptr_t>(extra_size);
 }
 
@@ -1838,7 +1846,8 @@ void Dart_DumpBlobs(const Dart_SnapshotAnalyzerInformation& info,
       info.vm_snapshot_data, info.vm_isolate_data,
       info.vm_snapshot_instructions, info.vm_isolate_instructions};
   const intptr_t sizes[4] = {
-      DataRegionSize(regions[0]), DataRegionSize(regions[1]),
+      DataRegionSize(regions[0], info.vm_snapshot_data_size),
+      DataRegionSize(regions[1], info.vm_isolate_data_size),
       InstructionsRegionSize(regions[2]), InstructionsRegionSize(regions[3])};
 
   intptr_t total = 0;
diff --git a/runtime/vm/dart_api_impl.cc b/runtime/vm/dart_api_impl.cc
index c6eacff48fb..39e25fa8c46 100644
--- a/runtime/vm/dart_api_impl.cc
+++ b/runtime/vm/dart_api_impl.cc
@@ -7281,14 +7281,22 @@ DART_EXPORT bool Dart_ShorebirdLoadVmcode(const char* vmcode_path) {
   // Only an overflow guard; LinkOracle applies the real limit.
   if (static_cast<size_t>(n_entries) > (SIZE_MAX - 4) / 8) { fclose(f); return false; }
 
-  const size_t header_size = 4 + static_cast<size_t>(n_entries) * 8;
-  std::unique_ptr<uint8_t[]> header(new uint8_t[header_size]);
+  const size_t table_size = 4 + static_cast<size_t>(n_entries) * 8;
+  // ReadHeaderSize page-aligns the table and then requires that the ELF start
+  // offset falls strictly inside the buffer (header_size < size). Read enough
+  // to satisfy that: the padded header plus four bytes of what follows it.
+  // kSnapshotAlignment must match the constant in shorebird.cc.
+  static constexpr size_t kSnapshotAlignment = 16384;
+  const size_t pages = (table_size + kSnapshotAlignment - 1) / kSnapshotAlignment;
+  const size_t read_size = (pages == 0 ? 1 : pages) * kSnapshotAlignment + 4;
+  std::unique_ptr<uint8_t[]> header(new uint8_t[read_size]);
   rewind(f);
-  const bool header_read = fread(header.get(), 1, header_size, f) == header_size;
+  const size_t bytes_read = fread(header.get(), 1, read_size, f);
   fclose(f);
-  if (!header_read) return false;
+  // Need at least the declared table; the rest is padding + ELF bytes.
+  if (bytes_read < table_size) return false;
 
-  if (Shorebird_ReadLinkHeader(header.get(), header_size) == 0) return false;
+  if (Shorebird_ReadLinkHeader(header.get(), bytes_read) == 0) return false;
 
   // Store the vmcode path; the Simulator will read and apply it lazily
   // when the first isolate creates its Simulator via Simulator::Current().
