index 00000000000..ccdb5b9bd5b
--- /dev/null
+++ b/runtime/vm/shorebird/cascade_limiter_test.cc
@@ -0,0 +1,198 @@
+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#include "vm/shorebird/cascade_limiter.h"
+
+#include <string>
+#include <vector>
+
+#include "vm/datastream.h"
+#include "vm/unit_test.h"
+
+namespace dart {
+
+// These tests pin the pieces of CascadeLimiter that can be stated on a graph
+// small enough to reason about by hand. The end-to-end claim -- that the whole
+// pipeline reproduces Shorebird's own --compute_dd_table output byte for byte at
+// seventeen budgets -- lives outside the tree, in the spike's
+// dd_table_model.py / dd_table_check.sh, because it needs their fixture.
+//
+// What is deliberately NOT tested here: the introsort tie order. It is
+// std::sort's, and asserting a particular permutation of a hand-made graph would
+// be asserting whatever libc++ happened to do, which is a tautology, not a
+// check. The order is pinned against the real libc++ by introsort_order_check.sh.
+
+using Adjacency = std::unordered_map<int64_t, std::unordered_set<int64_t>>;
+
+static Adjacency Graph(const std::vector<std::vector<int64_t>>& rows) {
+  Adjacency a;
+  for (size_t u = 0; u < rows.size(); u++) {
+    if (rows[u].empty()) continue;
+    a[static_cast<int64_t>(u)].insert(rows[u].begin(), rows[u].end());
+  }
+  return a;
+}
+
+UNIT_TEST_CASE(CascadeLimiter_LongestPathDepthOnAChain) {
+  // 0 -> 1 -> 2 -> 3
+  const auto depth = CascadeLimiter::LongestPathDepth(
+      Graph({{1}, {2}, {3}, {}}), 4);
+  EXPECT_EQ(0, depth[0]);
+  EXPECT_EQ(1, depth[1]);
+  EXPECT_EQ(2, depth[2]);
+  EXPECT_EQ(3, depth[3]);
+}
+
+UNIT_TEST_CASE(CascadeLimiter_LongestPathTakesTheLongerRoute) {
+  // 0 -> 1 -> 2 -> 4 and 0 -> 3 -> 4. Node 4 must get 3, not 2: the relaxation
+  // is a max, and a shortest-path or a plain BFS level would say 2.
+  const auto depth = CascadeLimiter::LongestPathDepth(
+      Graph({{1, 3}, {2}, {4}, {4}, {}}), 5);
+  EXPECT_EQ(1, depth[1]);
+  EXPECT_EQ(1, depth[3]);
+  EXPECT_EQ(2, depth[2]);
+  EXPECT_EQ(3, depth[4]);
+}
+
+UNIT_TEST_CASE(CascadeLimiter_CyclicNodesNeverPropagateDepth) {
+  // 0 -> 1, 1 -> 2, 2 -> 1. Nodes 1 and 2 are on a cycle, so neither ever
+  // reaches in-degree 0 and neither is ever dequeued.
+  //
+  // ⚠️ The consequence is finer than "cyclic nodes keep depth 0", which is how
+  // CASCADE_LIMITER_RECON.md phrases it, and the difference is what this test
+  // exists to pin: the relaxation fires on every edge OUT of a dequeued node
+  // regardless of the target's in-degree, so node 1 does get depth 1 from node
+  // 0. What it never does is propagate: node 2 stays at 0 because node 1 is
+  // never dequeued. 716 of the 1380 nodes in their own fixture sit at 0 for
+  // that second reason, and "fixing" the cycle handling changes the visit order
+  // and therefore the table.
+  //
+  // (My first version of this test asserted depth[1] == 0 and failed. The model
+  // that reproduces their bytes relaxes first and decrements second, so the
+  // assertion was wrong, not the code.)
+  const auto depth = CascadeLimiter::LongestPathDepth(
+      Graph({{1}, {2}, {1}}), 3);
+  EXPECT_EQ(0, depth[0]);
+  EXPECT_EQ(1, depth[1]);
+  EXPECT_EQ(0, depth[2]);
+}
+
+UNIT_TEST_CASE(CascadeLimiter_VisitOrderIsEveryNodeAscendingByDepth) {
+  const std::vector<int64_t> depth = {3, 0, 2, 0, 1, 2, 0};
+  const auto order = CascadeLimiter::VisitOrder(depth);
+  // Every node appears exactly once: the sort is over the whole population, and
+  // eligibility is applied afterwards, inside the greedy.
+  EXPECT_EQ(depth.size(), order.size());
+  std::vector<bool> seen(depth.size(), false);
+  for (int64_t v : order) {
+    EXPECT(!seen[v]);
+    seen[v] = true;
+  }
+  for (size_t i = 1; i < order.size(); i++) {
+    EXPECT(depth[order[i - 1]] <= depth[order[i]]);
+  }
+}
+
+UNIT_TEST_CASE(CascadeLimiter_CostExcludesTheNodeItself) {
+  // The shape that measured this on their own tables: a size-12 allocation stub
+  // with a single size-24 caller. The cost is 24. Including the node itself
+  // would make it 36, and the three functions that drop between budget 16 and
+  // budget 32 would not drop.
+  const std::vector<std::vector<int64_t>> callers = {{1}, {}};
+  const std::vector<int64_t> sizes = {12, 24};
+  const std::vector<bool> cut(2, false);
+  EXPECT_EQ(24, CascadeLimiter::Cost(callers, sizes, 0, cut));
+}
+
+UNIT_TEST_CASE(CascadeLimiter_CostCountsCutNodesWithoutExpandingThem) {
+  // 2 -> 1 -> 0 as callee edges, i.e. 0's callers are 1 and then 2.
+  const std::vector<std::vector<int64_t>> callers = {{1}, {2}, {}};
+  const std::vector<int64_t> sizes = {8, 16, 32};
+  std::vector<bool> none(3, false);
+  EXPECT_EQ(48, CascadeLimiter::Cost(callers, sizes, 0, none));
+  // With 1 cut, 1 is still counted -- it does have to be re-shipped -- but the
+  // walk stops there, so 2 is not.
+  std::vector<bool> one_cut(3, false);
+  one_cut[1] = true;
+  EXPECT_EQ(16, CascadeLimiter::Cost(callers, sizes, 0, one_cut));
+}
+
+UNIT_TEST_CASE(CascadeLimiter_RunSkipsNodesWithNoHashOrNoCaller) {
+  // 0 -> 1, 0 -> 2, 0 -> 3. Budget 0 means every eligible node is cut, so what
+  // is left out is exactly what was ineligible: node 0 has no caller, and node 2
+  // has no hash (our encoding of "[Optimized] or allocation stub"; see the
+  // header).
+  const std::vector<int64_t> sizes = {100, 4, 4, 4};
+  const std::vector<std::string> hashes = {"h0", "h1", "", "h3"};
+  const auto selected =
+      CascadeLimiter::Run(Graph({{1, 2, 3}, {}, {}, {}}), sizes, hashes, 4, 0);
+  std::vector<bool> in(4, false);
+  for (int64_t v : selected) in[v] = true;
+  EXPECT(!in[0]);
+  EXPECT(in[1]);
+  EXPECT(!in[2]);
+  EXPECT(in[3]);
+  EXPECT_EQ(2u, selected.size());
+}
+
+UNIT_TEST_CASE(CascadeLimiter_RunCutsOnlyWhenTheCascadeExceedsTheBudget) {
+  // One caller of size 24 above one node. Cost 24: cut at budget 16, kept at
+  // budget 24 (strictly greater, not greater-or-equal) and at 32.
+  const std::vector<int64_t> sizes = {12, 24};
+  const std::vector<std::string> hashes = {"aa", "bb"};
+  const auto g = Graph({{}, {0}});
+  EXPECT_EQ(1u, CascadeLimiter::Run(g, sizes, hashes, 2, 16).size());
+  EXPECT_EQ(0u, CascadeLimiter::Run(g, sizes, hashes, 2, 24).size());
+  EXPECT_EQ(0u, CascadeLimiter::Run(g, sizes, hashes, 2, 32).size());
+}
+
+UNIT_TEST_CASE(CascadeLimiter_EntriesAscendByHashAndIndexIsDense) {
+  const std::vector<int64_t> sizes = {12, 16, 20};
+  const std::vector<std::string> hashes = {"cc", "aa", "bb"};
+  const auto entries = CascadeLimiter::BuildEntries({0, 1, 2}, sizes, hashes);
+  EXPECT_EQ(3u, entries.size());
+  EXPECT_STREQ("aa", entries[0].hash.c_str());
+  EXPECT_STREQ("bb", entries[1].hash.c_str());
+  EXPECT_STREQ("cc", entries[2].hash.c_str());
+  EXPECT_EQ(16, entries[0].size);
+  EXPECT_EQ(20, entries[1].size);
+  EXPECT_EQ(12, entries[2].size);
+  for (size_t i = 0; i < entries.size(); i++) {
+    EXPECT_EQ(static_cast<int64_t>(i), entries[i].index);
+  }
+}
+
+UNIT_TEST_CASE(CascadeLimiter_WriteEntriesEncodesTheContainerExactly) {
+  // DDTable := count:u, { hash:str, index:u, size:u } * count, written with
+  // Dart's WriteStream: unsigned varints terminate at >= 0x80, characters are
+  // SIGNED varints and terminate at >= 0xC0, so a letter costs two bytes.
+  //
+  // Hand-computed rather than captured from a run, which is the only way this
+  // test says anything: 2 -> 0x82; "ab" -> 0x82 0x61 0xC0 0x62 0xC0;
+  // index 0 -> 0x80; size 12 -> 0x8C; "b" -> 0x81 0x62 0xC0; index 1 -> 0x81;
+  // size 300 -> 0x2C 0x82 (300 & 0x7F == 44, 300 >> 7 == 2).
+  std::vector<CascadeLimiterEntry> entries = {
+      CascadeLimiterEntry{0, "ab", 12},
+      CascadeLimiterEntry{1, "b", 300},
+  };
+  MallocWriteStream stream(/*initial_size=*/64);
+  CascadeLimiter::WriteEntries(&stream, entries);
+  const uint8_t expected[] = {0x82, 0x82, 0x61, 0xC0, 0x62, 0xC0, 0x80,
+                              0x8C, 0x81, 0x62, 0xC0, 0x81, 0x2C, 0x82};
+  EXPECT_EQ(static_cast<intptr_t>(sizeof(expected)), stream.bytes_written());
+  for (intptr_t i = 0; i < static_cast<intptr_t>(sizeof(expected)); i++) {
+    EXPECT_EQ(expected[i], stream.buffer()[i]);
+  }
+}
+
+UNIT_TEST_CASE(CascadeLimiter_EmptyGraphWritesJustTheCount) {
+  const auto selected = CascadeLimiter::Run(Adjacency(), {}, {}, 0, 10000);
+  EXPECT_EQ(0u, selected.size());
+  MallocWriteStream stream(/*initial_size=*/16);
+  CascadeLimiter::WriteEntries(&stream, CascadeLimiter::BuildEntries({}, {}, {}));
+  EXPECT_EQ(1, stream.bytes_written());
+  EXPECT_EQ(0x80, stream.buffer()[0]);
+}
+
+}  // namespace dart
