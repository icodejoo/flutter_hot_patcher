+// Shorebird's `--compute_dd_table=<file>`: which functions go in the DD table,
+// under a byte budget given by `--dd_max_bytes` (their own error message names
+// the default, 10000).
+//
+// The algorithm is `CascadeLimiter`, from their private
+// `runtime/vm/shorebird/cascade_limiter.cc`; see cascade_limiter.h for what was
+// read out of the disassembly and what is our own encoding.
+//
+// ⚠️ INTERFACE DEVIATION, stated rather than hidden. Their exported symbol is
+//   Dart_ComputeDDTable(char**, long*, char**, long*, long long, char const*,
+//                       long)
+// -- two output buffers, a budget, and one input buffer. We attribute only the
+// budget and one output pair with any confidence, so rather than invent roles
+// for the other four parameters this follows the shape of the neighbouring
+// entry points in this file. Same class of known deviation as LinkOracle's
+// Install() and the DDFunctionIdentity class name.
+void Dart_ComputeDDTable(const Dart_SnapshotAnalyzerInformation& info,
+                         int64_t max_bytes,
+                         char** out,
+                         intptr_t* out_len) {
+  Thread* thread = Thread::Current();
+  IsolateGroup* ig = thread->isolate_group();
+  DARTSCOPE(thread);
+
+  const uintptr_t isolate_instr_base =
+      reinterpret_cast<uintptr_t>(info.vm_isolate_instructions);
+
+  std::vector<CodeEntry> codes;
+  {
+    SafepointReadRwLocker ml(thread, ig->program_lock());
+    CollectAllCodes(ig, isolate_instr_base, codes);
+  }
+
+  const intptr_t n = static_cast<intptr_t>(codes.size());
+  std::vector<ShorebirdCodeFacts> facts;
+  facts.reserve(n);
+  std::vector<int64_t> sizes(n);
+  std::vector<std::string> hashes(n);
+  for (intptr_t i = 0; i < n; i++) {
+    facts.push_back(ComputeShorebirdCodeFacts(codes[i].payload, codes[i].size));
+    sizes[i] = static_cast<int64_t>(codes[i].size);
+    // An empty hash is how CascadeLimiter::Run is told a node is ineligible;
+    // see the note in cascade_limiter.h. The other half of eligibility ("has a
+    // caller") it derives from the graph itself.
+    if (ShorebirdHasIdentity(codes[i].name)) {
+      hashes[i] = facts[i].self_hash;
+    }
+  }
+
+  const std::vector<std::vector<intptr_t>> callees =
+      ShorebirdCallGraph(codes, facts);
+  std::unordered_map<int64_t, std::unordered_set<int64_t>> adjacency;
+  for (intptr_t u = 0; u < n; u++) {
+    if (callees[u].empty()) continue;
+    adjacency[u].insert(callees[u].begin(), callees[u].end());
+  }
+
+  const std::vector<int64_t> selected =
+      CascadeLimiter::Run(adjacency, sizes, hashes, n, max_bytes);
+  const std::vector<CascadeLimiterEntry> entries =
+      CascadeLimiter::BuildEntries(selected, sizes, hashes);
+
+  MallocWriteStream stream(/*initial_size=*/64 * KB);
+  CascadeLimiter::WriteEntries(&stream, entries);
+  *out_len = stream.bytes_written();
+  *out = reinterpret_cast<char*>(malloc(*out_len));
+  memcpy(*out, stream.buffer(), *out_len);
+}
+
 void Dart_DumpSnapshotInformationShorebirdAsJson(
     const Dart_SnapshotAnalyzerInformation& info,
     char** out,
@@ -1236,7 +1371,7 @@ void Dart_DumpSnapshotInformationShorebirdAsJson(
