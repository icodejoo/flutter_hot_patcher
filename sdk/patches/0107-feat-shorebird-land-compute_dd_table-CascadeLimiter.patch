@@ -0,0 +1,131 @@
+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#ifndef RUNTIME_VM_SHOREBIRD_CASCADE_LIMITER_H_
+#define RUNTIME_VM_SHOREBIRD_CASCADE_LIMITER_H_
+
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include "vm/datastream.h"
+
+namespace dart {
+
+// Shorebird's `analyze_snapshot --compute_dd_table` selector, from
+// `runtime/vm/shorebird/cascade_limiter.cc`.
+//
+// Their `Run` has no symbol of its own -- it is inlined into
+// `Dart_ComputeDDTable` -- but the introsort instantiated inside it does, and
+// the mangled name carries the enclosing signature verbatim:
+//
+//   dart::CascadeLimiter::Run(
+//       const std::unordered_map<long, std::unordered_set<long>>&,
+//       const std::vector<long>&,
+//       const std::vector<std::string>&,
+//       long,
+//       long long);
+//
+// The parameter list below is that one. Full derivation, with addresses, in
+// `spikes/shorebird_linkinfo_oracle/CASCADE_LIMITER_RECON.md` and
+// `LIBCXX_INTROSORT_RECON.md`; the whole pipeline is reproduced byte for byte
+// against their own artifact at seventeen budgets by `dd_table_model.py`.
+//
+// ⚠️ ONE INTERFACE DETAIL IS OURS, NOT THEIRS. Their signature carries no
+// eligibility argument, and where they apply the kind predicate ("[Optimized]
+// or allocation stub") is not established. We encode it in `hashes`: a node
+// whose hash is EMPTY is ineligible. That is the least invented encoding
+// available -- the hash is literally what an entry consists of, so a node
+// without one cannot be an entry -- but it is a choice, and it is flagged here
+// rather than passed off as recovered. The other half of eligibility, "has at
+// least one caller", is derivable from `callees` and is derived.
+struct CascadeLimiterEntry {
+  // Layout read off the swap code in their `__sort3` (sizeof == 0x28):
+  //   long /* +0x00 */ ; std::string /* +0x08 */ ; long /* +0x20 */ ;
+  int64_t index;
+  std::string hash;
+  int64_t size;
+};
+
+class CascadeLimiter {
+ public:
+  // The set of node indices to put in the DD table, in no particular order.
+  static std::vector<int64_t> Run(
+      const std::unordered_map<int64_t, std::unordered_set<int64_t>>& callees,
+      const std::vector<int64_t>& sizes,
+      const std::vector<std::string>& hashes,
+      int64_t node_count,
+      int64_t budget);
+
+  // Kahn's algorithm over the CALLEE edges, keeping the longest path to each
+  // node.
+  //
+  // ⚠️ The graph has cycles and Kahn's does not handle them: a node whose
+  // in-degree never reaches zero is never dequeued, so it never PROPAGATES a
+  // depth. It can still receive one -- the relaxation fires on every edge out
+  // of a dequeued node regardless of the target's in-degree -- which is why
+  // this is not simply "cyclic nodes keep depth 0"; see
+  // CascadeLimiter_CyclicNodesNeverPropagateDepth. 716 of 1380 nodes on their
+  // own fixture end up at depth 0 as a result, and that is reproduced
+  // deliberately rather than smoothed over. Seeding at 0x10024e980, the
+  // `std::deque` worklist at sp+0x1b0, `indeg[v]--` at 0x10024eab8 and the
+  // relaxation `depth[v] = max(depth[v], depth[u] + 1)` at 0x10024ea9c.
+  //
+  // The result does not depend on any container's iteration order: a node is
+  // dequeued only once every in-edge has been consumed, so `depth[u]` is final
+  // when `u` is dequeued, and the relaxation is a max over all edges.
+  static std::vector<int64_t> LongestPathDepth(
+      const std::unordered_map<int64_t, std::unordered_set<int64_t>>& callees,
+      int64_t node_count);
+
+  // The visit order: `std::sort` over the identity permutation of ALL nodes
+  // with the single key `depth[]`, ascending.
+  //
+  // 🔑 This calls the real `std::sort` on purpose. Their comparator has exactly
+  // one key (proven: the only store into the lambda is `str x9,[sp,#0x170]`
+  // with `x9 = &depth`, and all 64 reads through it are at offset 0), there are
+  // only ~20 distinct depths over 1380 nodes, and `std::sort` is not stable --
+  // so what survives among equal depths is libc++'s introsort trajectory. Our
+  // fork compiles against a libc++ whose `__algorithm/sort.h` is byte-identical
+  // to theirs (md5 35a0f94a..., measured across two toolchains AND behaviourally
+  // via `libcxx_sort_oracle.cc`), and a lambda comparator selects the same
+  // `__introsort<..., /*_UseBitSetPartition=*/false>` instantiation their symbol
+  // names show. Transcribing introsort by hand here would reproduce the same
+  // trajectory at best and drift from it at worst.
+  //
+  // ⚠️ The sort is over ALL nodes, not the eligible ones. Sorting only the
+  // eligible subset gives a genuinely different relative order of those same
+  // nodes -- measured, not assumed.
+  static std::vector<int64_t> VisitOrder(const std::vector<int64_t>& depth);
+
+  // The bytes that have to be re-shipped when `node` changes: its transitive
+  // CALLER closure, stopping at (but still counting) nodes already cut, and NOT
+  // counting `node` itself.
+  //
+  // Excluding self is measured rather than assumed: budget 32 drops exactly
+  // three functions relative to budget 16, all size 12 with a single caller and
+  // closures of 24, 24 and 32 bytes. Counting the node itself would make them
+  // 36, 36 and 44 -- all over budget, and none would drop.
+  static int64_t Cost(const std::vector<std::vector<int64_t>>& callers,
+                      const std::vector<int64_t>& sizes,
+                      int64_t node,
+                      const std::vector<bool>& cut);
+
+  // Emission: ascending by hash, `index` dense 0..n-1 afterwards. Written with
+  // Dart's own WriteStream as
+  //     DDTable := count:u, { hash:str, index:u, size:u } * count
+  static std::vector<CascadeLimiterEntry> BuildEntries(
+      const std::vector<int64_t>& selected,
+      const std::vector<int64_t>& sizes,
+      const std::vector<std::string>& hashes);
+
+  static void WriteEntries(BaseWriteStream* stream,
+                           const std::vector<CascadeLimiterEntry>& entries);
+};
+
+}  // namespace dart
+
+#endif  // RUNTIME_VM_SHOREBIRD_CASCADE_LIMITER_H_
