@@ -0,0 +1,171 @@
+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#include "vm/shorebird/cascade_limiter.h"
+
+#include <algorithm>
+#include <deque>
+
+#include "vm/shorebird/link_info.h"
+
+namespace dart {
+
+std::vector<int64_t> CascadeLimiter::LongestPathDepth(
+    const std::unordered_map<int64_t, std::unordered_set<int64_t>>& callees,
+    int64_t node_count) {
+  std::vector<int64_t> indegree(node_count, 0);
+  for (int64_t u = 0; u < node_count; u++) {
+    const auto it = callees.find(u);
+    if (it == callees.end()) continue;
+    for (int64_t v : it->second) {
+      if (v >= 0 && v < node_count) indegree[v]++;
+    }
+  }
+
+  std::vector<int64_t> depth(node_count, 0);
+  std::deque<int64_t> worklist;
+  for (int64_t u = 0; u < node_count; u++) {
+    if (indegree[u] == 0) worklist.push_back(u);
+  }
+
+  while (!worklist.empty()) {
+    const int64_t u = worklist.front();
+    worklist.pop_front();
+    const auto it = callees.find(u);
+    if (it == callees.end()) continue;
+    for (int64_t v : it->second) {
+      if (v < 0 || v >= node_count) continue;
+      if (depth[u] + 1 > depth[v]) depth[v] = depth[u] + 1;
+      if (--indegree[v] == 0) worklist.push_back(v);
+    }
+  }
+  // Nodes on a cycle never reach in-degree 0 and are never dequeued, so they
+  // never propagate a depth -- though they can still have received one, because
+  // the relaxation above runs before the decrement and does not look at the
+  // target's in-degree. See the header and
+  // CascadeLimiter_CyclicNodesNeverPropagateDepth.
+  return depth;
+}
+
+std::vector<int64_t> CascadeLimiter::VisitOrder(
+    const std::vector<int64_t>& depth) {
+  std::vector<int64_t> order(depth.size());
+  for (size_t i = 0; i < order.size(); i++) {
+    order[i] = static_cast<int64_t>(i);
+  }
+  // The single-key comparator. A lambda (rather than std::less) is what makes
+  // libc++ pick __introsort<..., _UseBitSetPartition = false>, which is the
+  // instantiation their symbols show.
+  std::sort(order.begin(), order.end(),
+            [&depth](int64_t a, int64_t b) { return depth[a] < depth[b]; });
+  return order;
+}
+
+int64_t CascadeLimiter::Cost(
+    const std::vector<std::vector<int64_t>>& callers,
+    const std::vector<int64_t>& sizes,
+    int64_t node,
+    const std::vector<bool>& cut) {
+  const int64_t n = static_cast<int64_t>(callers.size());
+  std::vector<bool> seen(n, false);
+  seen[node] = true;
+  std::vector<int64_t> stack;
+  stack.push_back(node);
+  int64_t total = 0;
+  while (!stack.empty()) {
+    const int64_t x = stack.back();
+    stack.pop_back();
+    // A cut node is counted (it was added when first reached) but not expanded:
+    // whatever calls it no longer has to move when this node changes.
+    if (cut[x]) continue;
+    for (int64_t u : callers[x]) {
+      if (seen[u]) continue;
+      seen[u] = true;
+      total += sizes[u];
+      stack.push_back(u);
+    }
+  }
+  return total;
+}
+
+std::vector<int64_t> CascadeLimiter::Run(
+    const std::unordered_map<int64_t, std::unordered_set<int64_t>>& callees,
+    const std::vector<int64_t>& sizes,
+    const std::vector<std::string>& hashes,
+    int64_t node_count,
+    int64_t budget) {
+  ASSERT(static_cast<int64_t>(sizes.size()) == node_count);
+  ASSERT(static_cast<int64_t>(hashes.size()) == node_count);
+
+  std::vector<std::vector<int64_t>> callers(node_count);
+  for (int64_t u = 0; u < node_count; u++) {
+    const auto it = callees.find(u);
+    if (it == callees.end()) continue;
+    for (int64_t v : it->second) {
+      if (v >= 0 && v < node_count) callers[v].push_back(u);
+    }
+  }
+
+  const std::vector<int64_t> depth = LongestPathDepth(callees, node_count);
+  const std::vector<int64_t> order = VisitOrder(depth);
+
+  // The growing greedy: one pass, cutting as it goes. A second pass changes
+  // nothing at any budget measured, so this single pass is also the fixpoint.
+  std::vector<bool> cut(node_count, false);
+  std::vector<int64_t> selected;
+  for (int64_t v : order) {
+    // Eligibility: a hash (the kind predicate, see the header) and at least one
+    // caller. A function nothing calls cannot be an indirect call target.
+    if (hashes[v].empty() || callers[v].empty()) continue;
+    if (Cost(callers, sizes, v, cut) > budget) {
+      cut[v] = true;
+      selected.push_back(v);
+    }
+  }
+  return selected;
+}
+
+std::vector<CascadeLimiterEntry> CascadeLimiter::BuildEntries(
+    const std::vector<int64_t>& selected,
+    const std::vector<int64_t>& sizes,
+    const std::vector<std::string>& hashes) {
+  std::vector<CascadeLimiterEntry> entries;
+  entries.reserve(selected.size());
+  for (int64_t v : selected) {
+    entries.push_back(CascadeLimiterEntry{0, hashes[v], sizes[v]});
+  }
+  // Their comparator is a plain memcmp over the entry's std::string field --
+  // std::string::compare inlined, with the short-string branch -- and nothing
+  // else: it runs before anything else and no second compare follows it.
+  //
+  // ⚠️ So this sort is NOT stable and equal hashes are ordered by introsort's
+  // trajectory, exactly as in VisitOrder. That is unobservable here rather than
+  // handled: every group of equal hashes in their own tables carries a single
+  // `size` (measured at all seventeen budgets -- 18 duplicate hashes at the
+  // saturated budgets, zero of them with differing sizes), so the emitted bytes
+  // do not depend on how a tie is broken. If a fixture ever produces two
+  // entries with the same hash and different sizes, this becomes observable and
+  // the tie order has to be derived.
+  std::sort(entries.begin(), entries.end(),
+            [](const CascadeLimiterEntry& a, const CascadeLimiterEntry& b) {
+              return a.hash < b.hash;
+            });
+  for (size_t i = 0; i < entries.size(); i++) {
+    entries[i].index = static_cast<int64_t>(i);
+  }
+  return entries;
+}
+
+void CascadeLimiter::WriteEntries(
+    BaseWriteStream* stream,
+    const std::vector<CascadeLimiterEntry>& entries) {
+  stream->WriteUnsigned<intptr_t>(static_cast<intptr_t>(entries.size()));
+  for (const CascadeLimiterEntry& e : entries) {
+    WriteString(stream, e.hash);
+    stream->WriteUnsigned<intptr_t>(static_cast<intptr_t>(e.index));
+    stream->WriteUnsigned<intptr_t>(static_cast<intptr_t>(e.size));
+  }
+}
+
+}  // namespace dart
