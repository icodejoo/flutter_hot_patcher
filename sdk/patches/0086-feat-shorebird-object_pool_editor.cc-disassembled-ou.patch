new file mode 100644
index 00000000000..f615f619b01
--- /dev/null
+++ b/runtime/vm/shorebird/object_pool_editor.h
@@ -0,0 +1,128 @@
+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#ifndef RUNTIME_VM_SHOREBIRD_OBJECT_POOL_EDITOR_H_
+#define RUNTIME_VM_SHOREBIRD_OBJECT_POOL_EDITOR_H_
+
+#include "vm/allocation.h"
+#include "vm/globals.h"
+
+namespace dart {
+
+// Shorebird's object_pool_editor.cc, recovered by disassembling their shipped
+// gen_snapshot_arm64. The full recon, with every address, is in
+// spikes/shorebird_linkinfo_oracle/OBJECT_POOL_EDITOR_RECON.md; the private
+// file name string sits at 0x1004bfd5e in their binary.
+//
+// What the file is for. Linking a patch against a base snapshot moves object
+// pool entries around, so code that reads entry 40 in the base may have to read
+// entry 41 in the patch. Rewriting the *code* is only possible if the rewrite
+// does not change its length -- otherwise every branch after it would have to
+// move. Shorebird makes that true by giving every object pool access a fixed
+// three-instruction footprint (Assembler::PadLoadStore, in the upstream arm64
+// assembler), and then patching accesses in place with a plain memcpy. There is
+// no relocation and no re-layout.
+//
+// Four functions, all confirmed by their mangled names in `nm`:
+//
+//   DetectObjectPoolOp                        0x1001a2720, 884 B
+//   LoadStoreFromSingle              (static) 0x1001a2a94, 192 B
+//   ObjectPoolEditor::InstructionCountNoPadding
+//                                             0x1001a2b54, 420 B
+//   AssembleReplacement              (static) 0x1001a2de8, 1016 B
+//
+// The two static ones have internal linkage and live in the .cc. What is *not*
+// recovered is the walk that drives them: it is fully inlined into upstream's
+// ImageWriter::Write, with no surviving symbol, so its name and signature are
+// ours (see Edit below). Their loop's shape is recovered; the old-index to
+// new-index table it consumes is not -- who owns it, and how it relates to
+// ObjectPoolMappingsAggregator::GetBestMapping, is undetermined (recon (c)5).
+// That is why nothing in this tree calls Edit from the image writer yet: the
+// input does not exist, and Shorebird's companion change -- routing the
+// nineteen upstream emitters through PadLoadStore so that snapshots come out
+// padded in the first place -- is not made here either.
+//
+// ⚠️ Every encoding below is arm64. The implementation is compiled only for
+// TARGET_ARCH_ARM64.
+
+// What kind of object pool access a detected sequence is. The values are proven
+// rather than guessed: each arm of their AssembleReplacement installs a
+// distinct std::function vtable, and the vtable's operator() slot demangles to
+// a name that spells out the Assembler method being called. These C++
+// identifiers are ours; the numbers are theirs.
+enum ObjectPoolOpKind : int32_t {
+  // Not a pool access. Reaching AssembleReplacement or
+  // InstructionCountNoPadding with this is UNREACHABLE in their code too
+  // (their lines 419 and 525).
+  kObjectPoolOpNone = 0,
+  kObjectPoolOpLoadWord = 1,        // Assembler::LoadWordFromPoolIndex
+  kObjectPoolOpStoreWord = 2,       // Assembler::StoreWordToPoolIndex
+  kObjectPoolOpLoadDoubleWord = 3,  // Assembler::LoadDoubleWordFromPoolIndex
+  kObjectPoolOpLoadFloat = 4,       // Assembler::LoadSFromOffset
+  kObjectPoolOpLoadDouble = 5,      // Assembler::LoadDFromOffset
+  kObjectPoolOpLoadQuad = 6,        // Assembler::LoadQFromOffset
+};
+
+// Their layout, from the stores DetectObjectPoolOp makes into it
+// (`str x0,[x1]` then `str w8,[x1,#0x8]`) and from its caller zeroing exactly
+// twelve bytes before the call.
+struct ObjectPoolOp {
+  int64_t index;
+  int32_t kind;
+};
+
+// Decode the object pool access ending at [pc], walking backwards for the
+// instructions that built up the offset. [pc] is the *last* instruction of the
+// sequence -- the load or store itself -- and [limit] is an inclusive lower
+// bound: a sequence that would need to read below it is declined rather than
+// read.
+//
+// The fourth parameter is in their mangled name and is never read anywhere in
+// the 884 bytes of their implementation -- no reference to x3 exists, and both
+// of their call sites pass three arguments. LLVM only eliminates a dead
+// argument, so it is unused in their source as well. What it was meant to be is
+// undetermined (recon (c)1), so it is declared and ignored here too rather than
+// given an invented meaning.
+bool DetectObjectPoolOp(uword pc,
+                        ObjectPoolOp& op,
+                        uword limit,
+                        int* unused = nullptr);
+
+// AllStatic because their class has no constructor, destructor or field symbol
+// anywhere in the binary -- but that is absence of evidence, not evidence: it
+// would look the same if the class had state and were always inlined. Likewise
+// whether InstructionCountNoPadding is a static member is undetermined (recon
+// (c)2): the observed ABI takes the index in x0 and the kind in w1 with no
+// `this`, which both a static member and a non-static one with an unused
+// `this` compile to.
+class ObjectPoolEditor : public AllStatic {
+ public:
+  // How many instructions this access occupies before padding. Their five
+  // switch arms and the exact OperandSize / AddressType each passes are
+  // recovered; for kinds 1, 2 and 3 the helper was inlined and constant-folded,
+  // which is a compiler artifact and is deliberately not reproduced.
+  static intptr_t InstructionCountNoPadding(const ObjectPoolOp& op);
+
+  // Walk [start, end) -- an Instructions payload -- and, for every object pool
+  // access in it, either move it to the index [index_mapping] gives or, when
+  // the mapping leaves it alone, re-assemble it and check it comes out byte for
+  // byte identical to what is already there.
+  //
+  // That second half is their own standing self-check, and it is the closest
+  // thing to a free oracle this file has: it compares this decoder and these
+  // emitters against code the same emitters produced during AOT compilation.
+  // Its failure output is theirs, "Expected:\n" and "Actual:\n", each of which
+  // occurs exactly once in their binary.
+  //
+  // Returns false if any self-check failed or any site had to be declined.
+  // The name is ours: theirs did not survive as a symbol.
+  static bool Edit(uword start,
+                   uword end,
+                   const intptr_t* index_mapping,
+                   intptr_t mapping_length);
+};
+
+}  // namespace dart
+
+#endif  // RUNTIME_VM_SHOREBIRD_OBJECT_POOL_EDITOR_H_
diff --git a/runtime/vm/shorebird/object_pool_editor_test.cc b/runtime/vm/shorebird/object_pool_editor_test.cc
new file mode 100644
index 00000000000..2ec35087479
--- /dev/null
+++ b/runtime/vm/shorebird/object_pool_editor_test.cc
@@ -0,0 +1,579 @@
+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#include "vm/shorebird/object_pool_editor.h"
+
+#if defined(TARGET_ARCH_ARM64) && !defined(DART_PRECOMPILED_RUNTIME)
+
+#include <string.h>
+
+#include <vector>
+
+#include "vm/compiler/assembler/assembler.h"
+#include "vm/compiler/runtime_api.h"
+#include "vm/constants.h"
+#include "vm/unit_test.h"
+
+namespace dart {
+
+// The editor decodes machine code, so almost everything here has to assemble
+// real instructions to have anything to decode -- which is also the only honest
+// way to test it. Checking the decoder against hand-written expected words
+// would be checking it against a second copy of the same encoding rules.
+//
+// ISOLATE_UNIT_TEST_CASE throughout: an Assembler is a StackResource and
+// dereferences a null ThreadState if there is no current thread, which is a
+// segfault at construction rather than a compile error.
+
+// Which OperandSize and AddressType each kind's emitter uses. These are the
+// values recovered from their AssembleReplacement's PadLoadStore call sites,
+// and the same ones ObjectPoolEditor::InstructionCountNoPadding passes.
+struct KindInfo {
+  compiler::OperandSize sz;
+  compiler::Address::AddressType type;
+};
+
+static KindInfo InfoForKind(int32_t kind) {
+  switch (kind) {
+    case kObjectPoolOpLoadWord:
+    case kObjectPoolOpStoreWord:
+      return {compiler::kEightBytes, compiler::Address::Offset};
+    case kObjectPoolOpLoadDoubleWord:
+      return {compiler::kEightBytes, compiler::Address::PairOffset};
+    case kObjectPoolOpLoadFloat:
+      return {compiler::kSWord, compiler::Address::Offset};
+    case kObjectPoolOpLoadDouble:
+      return {compiler::kDWord, compiler::Address::Offset};
+    case kObjectPoolOpLoadQuad:
+      return {compiler::kQWord, compiler::Address::Offset};
+    default:
+      UNREACHABLE();
+  }
+}
+
+// Not PP, not TMP and not TMP2, so that a sequence's base register says
+// unambiguously which emitter produced it.
+static const Register kDst = R3;
+static const Register kDst2 = R4;
+static const VRegister kFpDst = V5;
+
+static int32_t OffsetOfIndex(intptr_t index) {
+  return static_cast<int32_t>(
+      compiler::target::ObjectPool::element_offset(index));
+}
+
+// The bare emitter for each kind, with no padding.
+static void EmitRaw(compiler::Assembler* a, int32_t kind, intptr_t index) {
+  const int32_t offset = OffsetOfIndex(index);
+  switch (kind) {
+    case kObjectPoolOpLoadWord:
+      a->LoadWordFromPoolIndex(kDst, index, PP);
+      break;
+    case kObjectPoolOpStoreWord:
+      a->StoreWordToPoolIndex(kDst, index, PP);
+      break;
+    case kObjectPoolOpLoadDoubleWord:
+      a->LoadDoubleWordFromPoolIndex(kDst, kDst2, index);
+      break;
+    case kObjectPoolOpLoadFloat:
+      a->LoadSFromOffset(kFpDst, PP, offset);
+      break;
+    case kObjectPoolOpLoadDouble:
+      a->LoadDFromOffset(kFpDst, PP, offset);
+      break;
+    case kObjectPoolOpLoadQuad:
+      a->LoadQFromOffset(kFpDst, PP, offset);
+      break;
+    default:
+      UNREACHABLE();
+  }
+}
+
+// How many instructions the emitter really uses, measured rather than reasoned
+// about. This is the number ObjectPoolEditor::InstructionCountNoPadding is
+// supposed to predict.
+static intptr_t MeasuredCount(int32_t kind, intptr_t index) {
+  compiler::ObjectPoolBuilder pool_builder;
+  compiler::Assembler assembler(&pool_builder);
+  assembler.set_constant_pool_allowed(true);
+  const intptr_t before = assembler.CodeSize();
+  EmitRaw(&assembler, kind, index);
+  return (assembler.CodeSize() - before) / Instr::kInstrSize;
+}
+
+// Assemble a padded access -- the same emitter and the same PadLoadStore call
+// their AssembleReplacement makes -- and copy it into buffer[at..]. Returns the
+// address of its last real instruction, which is what the editor calls pc.
+static uword WritePaddedAccess(uint32_t* buffer,
+                               intptr_t at,
+                               int32_t kind,
+                               intptr_t index) {
+  const KindInfo info = InfoForKind(kind);
+  compiler::ObjectPoolBuilder pool_builder;
+  compiler::Assembler assembler(&pool_builder);
+  assembler.set_constant_pool_allowed(true);
+  assembler.PadLoadStore([&]() { EmitRaw(&assembler, kind, index); }, PP,
+                         OffsetOfIndex(index), info.sz, info.type);
+  const intptr_t bytes = assembler.CodeSize();
+  memmove(&buffer[at], reinterpret_cast<const void*>(assembler.CodeAddress(0)),
+          bytes);
+  return reinterpret_cast<uword>(&buffer[at + MeasuredCount(kind, index) - 1]);
+}
+
+static void FillWithNops(uint32_t* buffer, intptr_t words) {
+  for (intptr_t i = 0; i < words; i++) {
+    buffer[i] = static_cast<uint32_t>(Instr::kNopInstruction);
+  }
+}
+
+static std::vector<intptr_t> IdentityMapping(intptr_t entries) {
+  std::vector<intptr_t> mapping(entries);
+  for (intptr_t i = 0; i < entries; i++) {
+    mapping[i] = i;
+  }
+  return mapping;
+}
+
+// Their layout, and the only part of it that is not inference: the stores
+// DetectObjectPoolOp makes into it are `str x0,[x1]` and `str w8,[x1,#0x8]`,
+// and its caller zeroes exactly twelve bytes.
+VM_UNIT_TEST_CASE(ObjectPoolOp_LayoutMatchesTheirs) {
+  static_assert(sizeof(ObjectPoolOp) == 16, "int64 index then int32 kind");
+  EXPECT_EQ(static_cast<size_t>(0x00), offsetof(ObjectPoolOp, index));
+  EXPECT_EQ(static_cast<size_t>(0x08), offsetof(ObjectPoolOp, kind));
+  EXPECT_EQ(static_cast<size_t>(8), sizeof(ObjectPoolOp::index));
+  EXPECT_EQ(static_cast<size_t>(4), sizeof(ObjectPoolOp::kind));
+}
+
+// One row per shape their decoder recognises. The counts are not asserted here
+// -- MeasuredCount supplies them -- but the spread of indices is chosen so that
+// every kind is exercised in its one-, two- and where reachable
+// three-instruction form, because those are three completely different decode
+// paths: bare scaled offset, `add` off PP first, and movz/movk into an index
+// register.
+struct DetectCase {
+  int32_t kind;
+  intptr_t index;
+  intptr_t expected_count;
+};
+
+static const DetectCase kDetectCases[] = {
+    // Bare `ldr Xt, [PP, #imm12]` and friends.
+    {kObjectPoolOpLoadWord, 0, 1},
+    {kObjectPoolOpLoadWord, 4093, 1},
+    {kObjectPoolOpStoreWord, 0, 1},
+    {kObjectPoolOpLoadDoubleWord, 0, 1},
+    {kObjectPoolOpLoadDoubleWord, 61, 1},
+    {kObjectPoolOpLoadFloat, 0, 1},
+    {kObjectPoolOpLoadDouble, 0, 1},
+    // kQWord scales by 16, so only even indices land on a representable
+    // scaled offset; an odd one assembles to the unscaled form, which their
+    // decoder does not recognise.
+    {kObjectPoolOpLoadQuad, 0, 1},
+    {kObjectPoolOpLoadQuad, 2, 1},
+    // `add Xd, PP, #hi` then a 12-bit offset off Xd.
+    {kObjectPoolOpLoadWord, 5000, 2},
+    {kObjectPoolOpStoreWord, 5000, 2},
+    {kObjectPoolOpLoadDoubleWord, 511, 2},
+    {kObjectPoolOpLoadFloat, 5000, 2},
+    {kObjectPoolOpLoadDouble, 5000, 2},
+    {kObjectPoolOpLoadQuad, 10000, 2},
+    // movz/movk into an index register, then a register-offset access.
+    {kObjectPoolOpLoadWord, 2100000, 3},
+    {kObjectPoolOpLoadFloat, 2100000, 3},
+    {kObjectPoolOpLoadDouble, 2100000, 3},
+    {kObjectPoolOpLoadQuad, 2100000, 3},
+};
+
+ISOLATE_UNIT_TEST_CASE(ObjectPoolEditor_DetectsEveryKind) {
+  for (const DetectCase& c : kDetectCases) {
+    // The measured count is asserted too: a row whose form silently changed
+    // would otherwise keep passing while testing a different path.
+    EXPECT_EQ(c.expected_count, MeasuredCount(c.kind, c.index));
+
+    uint32_t buffer[8];
+    FillWithNops(buffer, ARRAY_SIZE(buffer));
+    const uword pc = WritePaddedAccess(buffer, 2, c.kind, c.index);
+
+    ObjectPoolOp op = {};
+    EXPECT(DetectObjectPoolOp(pc, op, reinterpret_cast<uword>(buffer)));
+    EXPECT_EQ(static_cast<int64_t>(c.index), op.index);
+    EXPECT_EQ(c.kind, op.kind);
+
+    // And nothing else in the sequence decodes as an access on its own: the
+    // walk steps one instruction at a time, so a prefix that also matched
+    // would be rewritten twice.
+    for (intptr_t i = 0; i < c.expected_count - 1; i++) {
+      ObjectPoolOp spurious = {};
+      EXPECT(!DetectObjectPoolOp(reinterpret_cast<uword>(&buffer[2 + i]),
+                                 spurious, reinterpret_cast<uword>(buffer)));
+    }
+  }
+}
+
+// A load the general-purpose Assembler::Load path produced, which reaches the
+// pool through the scratch register rather than the destination. Their
+// AssembleReplacement has a separate arm for exactly this shape.
+ISOLATE_UNIT_TEST_CASE(ObjectPoolEditor_DetectsScratchBasedLoad) {
+  const intptr_t index = 5000;
+  compiler::ObjectPoolBuilder pool_builder;
+  compiler::Assembler assembler(&pool_builder);
+  assembler.set_constant_pool_allowed(true);
+  assembler.LoadFromOffset(kDst, PP, OffsetOfIndex(index),
+                           compiler::kEightBytes);
+  const intptr_t count = assembler.CodeSize() / Instr::kInstrSize;
+  EXPECT_EQ(static_cast<intptr_t>(2), count);
+
+  uint32_t buffer[4];
+  FillWithNops(buffer, ARRAY_SIZE(buffer));
+  memmove(buffer, reinterpret_cast<const void*>(assembler.CodeAddress(0)),
+          assembler.CodeSize());
+
+  ObjectPoolOp op = {};
+  EXPECT(DetectObjectPoolOp(reinterpret_cast<uword>(&buffer[count - 1]), op,
+                            reinterpret_cast<uword>(buffer)));
+  EXPECT_EQ(static_cast<int64_t>(index), op.index);
+  EXPECT_EQ(static_cast<int32_t>(kObjectPoolOpLoadWord), op.kind);
+}
+
+ISOLATE_UNIT_TEST_CASE(ObjectPoolEditor_DeclinesNonPoolCode) {
+  compiler::ObjectPoolBuilder pool_builder;
+  compiler::Assembler assembler(&pool_builder);
+  assembler.set_constant_pool_allowed(true);
+  // A load off something that is not the pool pointer.
+  assembler.ldr(kDst, compiler::Address(R5, 16));
+  // A 32-bit load off the pool pointer: an integer pool entry is a whole word.
+  assembler.ldr(kDst, compiler::Address(PP, 16), compiler::kFourBytes);
+  // An FP store off the pool pointer. There is no StoreDToPoolIndex, so V set
+  // with L clear is excluded before anything else is looked at.
+  assembler.StoreDToOffset(kFpDst, PP, 16);
+  // Not a load or store at all.
+  assembler.ret();
+
+  const intptr_t words = assembler.CodeSize() / Instr::kInstrSize;
+  std::vector<uint32_t> buffer(words);
+  memmove(buffer.data(), reinterpret_cast<const void*>(assembler.CodeAddress(0)),
+          assembler.CodeSize());
+
+  for (intptr_t i = 0; i < words; i++) {
+    ObjectPoolOp op = {};
+    EXPECT(!DetectObjectPoolOp(reinterpret_cast<uword>(&buffer[i]), op,
+                               reinterpret_cast<uword>(buffer.data())));
+  }
+}
+
+// Recorded, not fixed. StoreWordToPoolIndex's widest form materialises the
+// offset in TMP, but their decoder insists that an *integer* access's index
+// register also be its data register -- which is true of
+// LoadWordFromPoolIndex, whose scratch is the destination, and false of every
+// store. So the three-instruction store is undetectable in their decoder, and
+// therefore here.
+ISOLATE_UNIT_TEST_CASE(ObjectPoolEditor_DeclinesTheThreeInstructionStore) {
+  const intptr_t index = 2100000;
+  EXPECT_EQ(static_cast<intptr_t>(3),
+            MeasuredCount(kObjectPoolOpStoreWord, index));
+
+  uint32_t buffer[8];
+  FillWithNops(buffer, ARRAY_SIZE(buffer));
+  const uword pc =
+      WritePaddedAccess(buffer, 2, kObjectPoolOpStoreWord, index);
+  ObjectPoolOp op = {};
+  EXPECT(!DetectObjectPoolOp(pc, op, reinterpret_cast<uword>(buffer)));
+}
+
+// limit is an inclusive lower bound, and a sequence that would need to read
+// below it is declined rather than read. Without that, the walk over an
+// Instructions payload would read whatever precedes the payload.
+ISOLATE_UNIT_TEST_CASE(ObjectPoolEditor_DetectionStopsAtTheLimit) {
+  const intptr_t index = 5000;  // Two instructions: add off PP, then the load.
+  uint32_t buffer[8];
+  FillWithNops(buffer, ARRAY_SIZE(buffer));
+  const uword pc = WritePaddedAccess(buffer, 2, kObjectPoolOpLoadWord, index);
+  const uword add_pc = pc - Instr::kInstrSize;
+
+  ObjectPoolOp op = {};
+  EXPECT(DetectObjectPoolOp(pc, op, add_pc));
+  EXPECT_EQ(static_cast<int64_t>(index), op.index);
+
+  // One byte higher and the `add` is out of bounds.
+  ObjectPoolOp declined = {};
+  EXPECT(!DetectObjectPoolOp(pc, declined, add_pc + 1));
+  EXPECT(!DetectObjectPoolOp(pc, declined, pc));
+}
+
+ISOLATE_UNIT_TEST_CASE(ObjectPoolEditor_InstructionCountMatchesTheEmitters) {
+  // The three FP kinds emit through PrepareLargeOffset, which is exactly what
+  // the counter counts, so these agree by construction and the whole range of
+  // indices is fair game.
+  static const int32_t kThroughPrepareLargeOffset[] = {
+      kObjectPoolOpLoadFloat, kObjectPoolOpLoadDouble, kObjectPoolOpLoadQuad};
+  static const intptr_t kIndices[] = {0,    2,    30,      1000,    2046,
+                                      4094, 5000, 65536,   2097150, 2100000};
+  for (int32_t kind : kThroughPrepareLargeOffset) {
+    for (intptr_t index : kIndices) {
+      const ObjectPoolOp op = {index, kind};
+      EXPECT_EQ(MeasuredCount(kind, index),
+                ObjectPoolEditor::InstructionCountNoPadding(op));
+    }
+  }
+
+  // The two integer kinds emit through LoadWordFromPoolIndex and
+  // StoreWordToPoolIndex, which have a ladder of their own. They agree with the
+  // counter everywhere below 2^24; where they do not is the test below.
+  static const int32_t kOwnLadder[] = {kObjectPoolOpLoadWord,
+                                       kObjectPoolOpStoreWord};
+  for (int32_t kind : kOwnLadder) {
+    for (intptr_t index : kIndices) {
+      if (OffsetOfIndex(index) >= (1 << 24)) continue;
+      const ObjectPoolOp op = {index, kind};
+      EXPECT_EQ(MeasuredCount(kind, index),
+                ObjectPoolEditor::InstructionCountNoPadding(op));
+    }
+  }
+  // Not a vacuous loop: at least one index in the list is past the cutoff, so
+  // the skip above is skipping something and the rest really ran.
+  EXPECT(OffsetOfIndex(kIndices[ARRAY_SIZE(kIndices) - 1]) >= (1 << 24));
+  EXPECT(OffsetOfIndex(kIndices[0]) < (1 << 24));
+}
+
+// Two divergences found while landing this, recorded rather than papered over
+// -- and recorded here rather than "fixed", because the recon is explicit that
+// InstructionCountNoPadding calls InstructionCountForLoadStoreFromOffset for
+// all six kinds and that re-deriving their constant-folded ladder would be
+// copying an optimiser artifact.
+//
+// Both have the same cause. The counter counts PrepareLargeOffset, and three of
+// the six emitters use it. The other three -- LoadWordFromPoolIndex,
+// StoreWordToPoolIndex and LoadDoubleWordFromPoolIndex -- each have a ladder of
+// their own, which can disagree:
+//
+//   * pair, index 62 (offset 512). LoadDoubleWordFromPoolIndex will take
+//     `add TMP, PP, #imm` for any immediate an add can hold; PrepareLargeOffset
+//     additionally insists the low twelve bits fit an imm7. Emitter 2,
+//     counter 3.
+//   * word, index 2097150 (offset exactly 2^24). LoadWordFromPoolIndex always
+//     emits movz *and* movk, where PrepareLargeOffset goes through
+//     LoadImmediate, which drops the movk when the low sixteen bits are zero.
+//     Emitter 3, counter 2.
+//
+// The second one is ours rather than theirs: the recon reads their folded
+// Address::Offset ladder as "1 if -256 <= offset < 32768, else 2 if
+// offset >> 24 == 0, else 3", which is 3 at 2^24 and so agrees with the
+// emitter. Our counter is written against PrepareLargeOffset instead.
+//
+// The consequence of either is visible end to end: with the count wrong, the
+// editor locates the start of the sequence at the wrong instruction, and its own
+// self-check catches it and declines the site instead of corrupting it. Which is
+// at least the self-check working.
+ISOLATE_UNIT_TEST_CASE(ObjectPoolEditor_CountFollowsPrepareLargeOffset) {
+  // Where the pair emitter agrees: inside the imm7 range, and past it when the
+  // low twelve bits still fit one.
+  for (intptr_t index : {0, 1, 61, 511, 512}) {
+    const ObjectPoolOp op = {index, kObjectPoolOpLoadDoubleWord};
+    EXPECT_EQ(MeasuredCount(kObjectPoolOpLoadDoubleWord, index),
+              ObjectPoolEditor::InstructionCountNoPadding(op));
+  }
+
+  struct Divergence {
+    int32_t kind;
+    intptr_t index;
+    intptr_t emitted;
+    intptr_t counted;
+  };
+  static const Divergence kDivergences[] = {
+      {kObjectPoolOpLoadDoubleWord, 62, 2, 3},
+      {kObjectPoolOpLoadWord, 2097150, 3, 2},
+      {kObjectPoolOpStoreWord, 2097150, 3, 2},
+  };
+
+  for (const Divergence& d : kDivergences) {
+    const ObjectPoolOp op = {d.index, d.kind};
+    EXPECT_EQ(d.emitted, MeasuredCount(d.kind, d.index));
+    EXPECT_EQ(d.counted, ObjectPoolEditor::InstructionCountNoPadding(op));
+
+    // The store's three-instruction form is not detectable at all (see
+    // ObjectPoolEditor_DeclinesTheThreeInstructionStore), so there is no site
+    // for the editor to decline.
+    if (d.kind == kObjectPoolOpStoreWord) continue;
+
+    // Two words of slack in front, because a count that is too high makes the
+    // editor look further back than the sequence actually starts.
+    uint32_t buffer[8];
+    FillWithNops(buffer, ARRAY_SIZE(buffer));
+    WritePaddedAccess(buffer, 2, d.kind, d.index);
+    const std::vector<intptr_t> mapping = IdentityMapping(d.index + 1);
+    EXPECT(!ObjectPoolEditor::Edit(
+        reinterpret_cast<uword>(buffer),
+        reinterpret_cast<uword>(buffer + ARRAY_SIZE(buffer)), mapping.data(),
+        static_cast<intptr_t>(mapping.size())));
+  }
+}
+
+// Their standing self-check, which is the closest thing to a free oracle this
+// file has: for every access the mapping leaves alone, re-assemble it and
+// compare bytes with what is already there. Here the "already there" is code
+// this test assembled with the same emitters, which is the same relationship
+// their image writer has to the AOT compiler's output.
+ISOLATE_UNIT_TEST_CASE(ObjectPoolEditor_SelfCheckAcceptsAssembledCode) {
+  intptr_t highest = 0;
+  for (const DetectCase& c : kDetectCases) {
+    if (c.index > highest) highest = c.index;
+  }
+  const std::vector<intptr_t> mapping = IdentityMapping(highest + 1);
+
+  for (const DetectCase& c : kDetectCases) {
+    uint32_t buffer[8];
+    FillWithNops(buffer, ARRAY_SIZE(buffer));
+    WritePaddedAccess(buffer, 2, c.kind, c.index);
+    EXPECT(ObjectPoolEditor::Edit(
+        reinterpret_cast<uword>(buffer),
+        reinterpret_cast<uword>(buffer + ARRAY_SIZE(buffer)), mapping.data(),
+        static_cast<intptr_t>(mapping.size())));
+  }
+}
+
+// The one arm of their AssembleReplacement that does not go through
+// PadLoadStore, because in their build the padding happens further out, in
+// Assembler::Load. It still has to reproduce the original byte for byte.
+ISOLATE_UNIT_TEST_CASE(ObjectPoolEditor_SelfCheckAcceptsAScratchBasedLoad) {
+  const intptr_t index = 5000;
+  compiler::ObjectPoolBuilder pool_builder;
+  compiler::Assembler assembler(&pool_builder);
+  assembler.set_constant_pool_allowed(true);
+  assembler.PadLoadStore(
+      [&]() {
+        assembler.LoadFromOffset(kDst, PP, OffsetOfIndex(index),
+                                 compiler::kEightBytes);
+      },
+      PP, OffsetOfIndex(index), compiler::kEightBytes,
+      compiler::Address::Offset);
+  EXPECT_EQ(static_cast<intptr_t>(3),
+            assembler.CodeSize() / Instr::kInstrSize);
+
+  uint32_t buffer[8];
+  FillWithNops(buffer, ARRAY_SIZE(buffer));
+  memmove(&buffer[2], reinterpret_cast<const void*>(assembler.CodeAddress(0)),
+          assembler.CodeSize());
+
+  const std::vector<intptr_t> mapping = IdentityMapping(index + 1);
+  EXPECT(ObjectPoolEditor::Edit(
+      reinterpret_cast<uword>(buffer),
+      reinterpret_cast<uword>(buffer + ARRAY_SIZE(buffer)), mapping.data(),
+      static_cast<intptr_t>(mapping.size())));
+}
+
+// The padding is what makes an in-place rewrite legal, so a site that is not
+// padded must be declined -- overwriting the twelve-byte footprint would
+// destroy a real instruction.
+ISOLATE_UNIT_TEST_CASE(ObjectPoolEditor_DeclinesUnpaddedSites) {
+  const intptr_t index = 0;  // One instruction, so two words of padding.
+  uint32_t buffer[8];
+  FillWithNops(buffer, ARRAY_SIZE(buffer));
+  WritePaddedAccess(buffer, 2, kObjectPoolOpLoadWord, index);
+
+  const std::vector<intptr_t> mapping = IdentityMapping(index + 1);
+  const uword start = reinterpret_cast<uword>(buffer);
+  const uword end = reinterpret_cast<uword>(buffer + ARRAY_SIZE(buffer));
+  EXPECT(ObjectPoolEditor::Edit(start, end, mapping.data(),
+                                static_cast<intptr_t>(mapping.size())));
+
+  // Replace the second padding word with something that is not a NOP.
+  buffer[4] = 0xd65f03c0;  // ret
+  EXPECT(!ObjectPoolEditor::Edit(start, end, mapping.data(),
+                                 static_cast<intptr_t>(mapping.size())));
+}
+
+// The point of the file: move an access to a different pool entry without
+// moving anything around it.
+ISOLATE_UNIT_TEST_CASE(ObjectPoolEditor_RewriteMovesTheIndex) {
+  struct Move {
+    int32_t kind;
+    intptr_t from;
+    intptr_t to;
+  };
+  // The destination is never wider than the source. Their walk advances one
+  // instruction at a time and does not skip what it just wrote, so a
+  // replacement whose load lands after the old one would be found again and
+  // translated twice.
+  static const Move kMoves[] = {
+      {kObjectPoolOpLoadWord, 0, 7},
+      {kObjectPoolOpLoadWord, 5000, 40},
+      {kObjectPoolOpStoreWord, 0, 12},
+      {kObjectPoolOpStoreWord, 5000, 5001},
+      {kObjectPoolOpLoadDoubleWord, 0, 61},
+      {kObjectPoolOpLoadFloat, 0, 9},
+      {kObjectPoolOpLoadDouble, 5000, 3},
+      {kObjectPoolOpLoadQuad, 0, 2},
+  };
+
+  for (const Move& m : kMoves) {
+    EXPECT(MeasuredCount(m.kind, m.to) <= MeasuredCount(m.kind, m.from));
+
+    uint32_t buffer[8];
+    FillWithNops(buffer, ARRAY_SIZE(buffer));
+    WritePaddedAccess(buffer, 2, m.kind, m.from);
+    const uint32_t before_head = buffer[1];
+    const uint32_t before_tail = buffer[ARRAY_SIZE(buffer) - 1];
+
+    intptr_t entries = (m.from > m.to ? m.from : m.to) + 1;
+    std::vector<intptr_t> mapping = IdentityMapping(entries);
+    mapping[m.from] = m.to;
+
+    EXPECT(ObjectPoolEditor::Edit(
+        reinterpret_cast<uword>(buffer),
+        reinterpret_cast<uword>(buffer + ARRAY_SIZE(buffer)), mapping.data(),
+        static_cast<intptr_t>(mapping.size())));
+
+    // The rewritten sequence starts where the old one did and reads the new
+    // index.
+    const intptr_t new_count = MeasuredCount(m.kind, m.to);
+    const uword new_pc = reinterpret_cast<uword>(&buffer[2 + new_count - 1]);
+    ObjectPoolOp op = {};
+    EXPECT(DetectObjectPoolOp(new_pc, op, reinterpret_cast<uword>(buffer)));
+    EXPECT_EQ(static_cast<int64_t>(m.to), op.index);
+    EXPECT_EQ(m.kind, op.kind);
+
+    // And nothing outside the footprint moved. There is no relocation here:
+    // the whole scheme depends on the replacement being the same size.
+    EXPECT_EQ(before_head, buffer[1]);
+    EXPECT_EQ(before_tail, buffer[ARRAY_SIZE(buffer) - 1]);
+    EXPECT_EQ(static_cast<uint32_t>(Instr::kNopInstruction), buffer[5]);
+  }
+}
+
+// A rewrite has to leave the neighbouring access alone, and both have to still
+// pass the self-check afterwards. This is the case a footprint that was not
+// really fixed would break.
+ISOLATE_UNIT_TEST_CASE(ObjectPoolEditor_RewriteLeavesNeighboursAlone) {
+  uint32_t buffer[12];
+  FillWithNops(buffer, ARRAY_SIZE(buffer));
+  WritePaddedAccess(buffer, 0, kObjectPoolOpLoadWord, 11);
+  WritePaddedAccess(buffer, 3, kObjectPoolOpLoadDouble, 22);
+  WritePaddedAccess(buffer, 6, kObjectPoolOpStoreWord, 33);
+  const uint32_t first_before = buffer[0];
+  const uint32_t third_before = buffer[6];
+
+  std::vector<intptr_t> mapping = IdentityMapping(64);
+  mapping[22] = 44;
+  const uword start = reinterpret_cast<uword>(buffer);
+  const uword end = reinterpret_cast<uword>(buffer + ARRAY_SIZE(buffer));
+  EXPECT(ObjectPoolEditor::Edit(start, end, mapping.data(),
+                                static_cast<intptr_t>(mapping.size())));
+
+  EXPECT_EQ(first_before, buffer[0]);
+  EXPECT_EQ(third_before, buffer[6]);
+  ObjectPoolOp op = {};
+  EXPECT(DetectObjectPoolOp(reinterpret_cast<uword>(&buffer[3]), op, start));
+  EXPECT_EQ(static_cast<int64_t>(44), op.index);
+
+  // Everything now agrees with the mapping's fixed points, so a second pass
+  // must be a pure self-check and must pass.
+  std::vector<intptr_t> settled = IdentityMapping(64);
+  EXPECT(ObjectPoolEditor::Edit(start, end, settled.data(),
+                                static_cast<intptr_t>(settled.size())));
+}
