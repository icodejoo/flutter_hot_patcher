+void FieldTableLinkInfo::WriteToFile(const char* path) const {
+  MallocWriteStream stream(/*initial_size=*/1 * MB);
+  stream.WriteUnsigned<intptr_t>(static_cast<intptr_t>(fields_.size()));
+  for (const FieldInfo& info : fields_) {
+    stream.WriteUnsigned<intptr_t>(info.id);
+    WriteString(&stream, info.name);
+    WriteString(&stream, info.hash);
+  }
+  stream.WriteUnsigned<intptr_t>(max_field_id_);
+
+  CallbackFile file(path);
+  if (file.is_open()) {
+    file.Write(stream.buffer(), stream.bytes_written());
+  }
+}
+
+void FieldTableLinkInfo::WriteDebugInfoToFile(const char* path) const {
+  JSONWriter js;
+  js.OpenObject();
+  js.PrintProperty64("max_field_id", max_field_id_);
+  js.OpenArray("fields");
+  for (const FieldInfo& info : fields_) {
+    js.OpenObject();
+    js.PrintProperty64("id", info.id);
+    js.PrintProperty("name", info.name.c_str());
+    js.PrintProperty("hash", info.hash.c_str());
+    js.CloseObject();
+  }
+  js.CloseArray();
+  js.CloseObject();
+
+  char* output = nullptr;
+  intptr_t output_length = 0;
+  js.Steal(&output, &output_length);
+  CallbackFile file(path);
+  if (file.is_open()) {
+    file.Write(output, output_length);
+  }
+  free(output);
+}
+
+// Their CollectAllStaticFields walks the heap (the decompiled code calls
+// Heap::ResetObjectIdTable and UntaggedObject::VisitPointers), not the library
+// dictionaries. That matters: by the time DoCompileAll finishes, the precompiler
+// has dropped fields from Class::fields(), but the Field objects themselves are
+// still live on the heap. Iterating class dictionaries finds a strict subset --
+// 360 of 622 on our fixture.
+FieldTableLinkInfo* GetFieldTableLinkInfo(Thread* thread) {
+  Zone* zone = thread->zone();
+
+  GrowableArray<FieldPtr> raw_fields;
+  {
+    HeapIterationScope iteration(thread);
+    class Collector : public ObjectVisitor {
+     public:
+      explicit Collector(GrowableArray<FieldPtr>* out) : out_(out) {}
+      void VisitObject(ObjectPtr obj) override {
+        if (obj->GetClassId() == kFieldCid) {
+          out_->Add(Field::RawCast(obj));
+        }
+      }
+     private:
+      GrowableArray<FieldPtr>* out_;
+    } collector(&raw_fields);
+    iteration.IterateObjects(&collector);
+  }
+
+  Field& field = Field::Handle(zone);
+  Class& owner = Class::Handle(zone);
+  String& name = String::Handle(zone);
+
+  std::vector<FieldInfo> fields;
+  std::map<std::string, intptr_t> seen;
+  intptr_t max_field_id = 0;
+
+  for (intptr_t i = 0; i < raw_fields.length(); i++) {
+    field = raw_fields[i];
+    name = field.name();
+    if (name.IsNull()) continue;
+    const bool is_ext =
+        field.is_extension_member() || field.is_extension_type_member();
+    const std::string field_name(String::ScrubName(name, is_ext));
+
+    owner = field.Owner();
+    std::string owner_name;
+    if (!owner.IsNull()) {
+      name = owner.Name();
+      if (!name.IsNull()) owner_name = String::ScrubName(name);
+    }
+
+    std::string qualified = owner_name;
+    qualified += '.';
+    qualified += field_name;
+    const intptr_t occurrence = ++seen[qualified];
+
+    std::string hash = qualified;
+    hash += ' ';
+    hash += std::to_string(field.kind_bits());
+    hash += ' ';
+    hash += std::to_string(occurrence);
+
+    const intptr_t id = field.field_id();
+    max_field_id = Utils::Maximum(max_field_id, id);
+    fields.push_back(FieldInfo{id, field_name, std::move(hash)});
+  }
+
+  std::stable_sort(fields.begin(), fields.end(),
+                   [](const FieldInfo& a, const FieldInfo& b) {
+                     return a.id < b.id;
+                   });
+
+  return new (zone) FieldTableLinkInfo(std::move(fields), max_field_id);
+}
+
+void PrintFieldTableLinkInfoIfRequested(Thread* thread) {
+  const bool want_binary = FLAG_print_field_table_link_info_to != nullptr;
+  const bool want_json = FLAG_print_field_table_link_debug_info_to != nullptr;
+  if (!want_binary && !want_json) return;
+
+  const FieldTableLinkInfo* info = GetFieldTableLinkInfo(thread);
+  if (want_binary) info->WriteToFile(FLAG_print_field_table_link_info_to);
+  if (want_json) {
+    info->WriteDebugInfoToFile(FLAG_print_field_table_link_debug_info_to);
+  }
+}
+
