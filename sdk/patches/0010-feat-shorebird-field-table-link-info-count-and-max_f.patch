   const bool want_binary = FLAG_print_class_table_link_info_to != nullptr;
   const bool want_json = FLAG_print_class_table_link_debug_info_to != nullptr;
diff --git a/runtime/vm/shorebird/link_info.h b/runtime/vm/shorebird/link_info.h
index 83fed61dd76..9abb0c9bdbb 100644
--- a/runtime/vm/shorebird/link_info.h
+++ b/runtime/vm/shorebird/link_info.h
@@ -56,12 +56,42 @@ class ClassTableLinkInfo : public ZoneObject {
   intptr_t num_cids_;
 };
 
+// Link information describing the fields a base snapshot contains.
+struct FieldInfo {
+  intptr_t id;        // Field::field_id(), i.e. the raw host_offset_or_field_id
+  std::string name;   // ScrubName(field name)
+  // "<Owner>.<name> <kind_bits> <occurrence>" -- their FieldHasher builds this
+  // from ScrubName(owner) + '.' + ScrubName(name) + ' ' + the whole kind_bits_
+  // word + ' ' + a 1-based duplicate index (hence DuplicateAwareHash).
+  std::string hash;
+};
+
+class FieldTableLinkInfo : public ZoneObject {
+ public:
+  FieldTableLinkInfo(std::vector<FieldInfo> fields, intptr_t max_field_id)
+      : fields_(std::move(fields)), max_field_id_(max_field_id) {}
+
+  const std::vector<FieldInfo>& fields() const { return fields_; }
+  intptr_t max_field_id() const { return max_field_id_; }
+
+  // count, { id, name, hash }, max_field_id -- the scalar is again a trailer.
+  void WriteToFile(const char* path) const;
+  void WriteDebugInfoToFile(const char* path) const;
+
+ private:
+  std::vector<FieldInfo> fields_;
+  intptr_t max_field_id_;
+};
+
 // Walks the class table and computes the link info for the current isolate.
 ClassTableLinkInfo* GetClassTableLinkInfo(Thread* thread);
 
-// Honours --print_class_table_link_info_to / _debug_info_to. No-op when neither
-// flag is set.
+// Walks every library's classes (and their toplevel class) collecting fields.
+FieldTableLinkInfo* GetFieldTableLinkInfo(Thread* thread);
+
+// Honour the --print_*_link_info_to flags. No-op when none are set.
 void PrintClassTableLinkInfoIfRequested(Thread* thread);
+void PrintFieldTableLinkInfoIfRequested(Thread* thread);
 
 }  // namespace dart
 
