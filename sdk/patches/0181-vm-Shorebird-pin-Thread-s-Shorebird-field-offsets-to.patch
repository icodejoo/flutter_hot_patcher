From 1bf8a935dded49c36027dea97db9421790605bba Mon Sep 17 00:00:00 2001
From: cruz <cruz@tbu.net>
Date: Tue, 29 Sep 2026 15:22:06 +0800
Subject: [PATCH 181/206] [vm] Shorebird: pin Thread's Shorebird field offsets
 to theirs in a test (F147)

Shorebird_ThreadFieldOffsetsEqualTheirs checks the 17 accessible Shorebird
Thread offsets, plus isolate_/isolate_group_/tsan_utils_ as upstream anchors
behind the insertions, against the DW_AT_data_member_location values of their
Flutter.framework.dSYM. Guarded to arm64 without compressed pointers, the only
configuration whose layout equals theirs.

Also corrects three wrapper_stub_test.cc comments that said our fields are
appended. The existing literal-0x8d8 expectations are unchanged: they check an
encoding expression against their instruction word and never read our layout.

diff --git a/runtime/vm/shorebird/wrapper_stub_test.cc b/runtime/vm/shorebird/wrapper_stub_test.cc
index c06278df740..b422eac9c58 100644
--- a/runtime/vm/shorebird/wrapper_stub_test.cc
+++ b/runtime/vm/shorebird/wrapper_stub_test.cc
@@ -18,9 +18,10 @@ namespace shorebird {
 // The Sim->CPU shared body reaches it with a single
 //   ldr x17, [THR, #<offset>]        (kEightBytes)
 // which on arm64 encodes the offset as a 12-bit immediate scaled by 8. Their
-// 0x8d8 satisfies that trivially; ours is at the end of Thread and does not
-// trivially, so the assembler's own predicate decides -- not an open-coded
-// bound that could drift from the encoder.
+// 0x8d8 satisfies that trivially, and so does ours since F147 (same offset);
+// the assembler's own predicate still decides -- not an open-coded bound that
+// could drift from the encoder -- because other configurations lay Thread out
+// differently.
 ISOLATE_UNIT_TEST_CASE(Thread_IsSimulatingIsReachableFromGeneratedCode) {
   // `thread` is supplied by ISOLATE_UNIT_TEST_CASE.
   //
@@ -40,6 +41,40 @@ ISOLATE_UNIT_TEST_CASE(Thread_IsSimulatingIsReachableFromGeneratedCode) {
                                           compiler::kEightBytes));
 }
 
+// F147: every Shorebird Thread field at Shorebird's offset. The values are
+// DW_AT_data_member_location of dart::Thread's members in their
+// Flutter.framework.dSYM (ios-release, engine c15ef6379403). Our layout is the
+// same in JIT/AOT and PRODUCT/non-PRODUCT builds (their offsets_extractor
+// outputs agree on every Thread entry), so this holds in every arm64 build
+// without compressed pointers; elsewhere Thread is laid out differently and
+// there is nothing of theirs to compare with. isolate_ and isolate_group_ are
+// upstream anchors on the far side of the first insertion: their published
+// analyze_snapshot metadata reads 1672/1680 for them.
+#if defined(TARGET_ARCH_ARM64) && !defined(DART_COMPRESSED_POINTERS)
+VM_UNIT_TEST_CASE(Shorebird_ThreadFieldOffsetsEqualTheirs) {
+  EXPECT_EQ(0x288, Thread::resume_on_simulator_entry_point_offset());
+  EXPECT_EQ(0x290, Thread::resume_on_cpu_entry_point_offset());
+  EXPECT_EQ(0x688, Thread::isolate_offset());
+  EXPECT_EQ(0x690, Thread::isolate_group_offset());
+  EXPECT_EQ(0x700, Thread::base_instructions_entry_point_offset());
+  EXPECT_EQ(0x708, Thread::base_instructions_end_offset());
+  EXPECT_EQ(0x8d8, Thread::is_simulating_offset());
+  EXPECT_EQ(0x8e0, Thread::dart_state_is_on_cpu_offset());
+  EXPECT_EQ(0x8e8, Thread::simulator_csp_offset());
+  EXPECT_EQ(0x8f0, Thread::simulator_async_resume_pc_offset());
+  EXPECT_EQ(0x8f8, Thread::simulator_execute_offset());
+  EXPECT_EQ(0x900, Thread::simulator_call_from_ffi_offset());
+  EXPECT_EQ(0x908, Thread::call_bootstrap_native_entry_point_offset());
+  EXPECT_EQ(0x910, Thread::call_no_scope_native_entry_point_offset());
+  EXPECT_EQ(0x918, Thread::call_auto_scope_native_entry_point_offset());
+  EXPECT_EQ(0x920, Thread::enter_safepoint_entry_point_offset());
+  EXPECT_EQ(0x928, Thread::exit_safepoint_entry_point_offset());
+  // 0x930 is the placeholder; tsan_utils_ right after it is their 0x938.
+  EXPECT_EQ(0x938, Thread::tsan_utils_offset());
+  EXPECT_EQ(0x978, Thread::indirect_static_call_table_offset());
+}
+#endif  // defined(TARGET_ARCH_ARM64) && !defined(DART_COMPRESSED_POINTERS)
+
 // Stubs are generated at VM startup, so this needs an isolate -- VM_UNIT_TEST_CASE
 // runs without one and StubCode would not be initialized.
 ISOLATE_UNIT_TEST_CASE(StubCode_ShorebirdWrappersExist) {
@@ -89,9 +124,9 @@ ISOLATE_UNIT_TEST_CASE(StubCode_ShorebirdWrapperPadArraysAreExact) {
 // register R9-vs-IP0 and the stub names both slipped past size checks earlier in
 // this work -- so the bytes themselves are compared. Six of the seven are
 // position independent and must equal theirs exactly. The fourth encodes
-// Thread::is_simulating_'s offset, which is 0x8d8 for them and larger here
-// because our field is appended, so it is checked by re-deriving the encoding
-// rather than by equality.
+// Thread::is_simulating_'s offset, 0x8d8 for them and (since F147) for us on
+// arm64 without compressed pointers; it is checked by re-deriving the encoding
+// from the accessor, so it stays right in configurations where it is not.
 ISOLATE_UNIT_TEST_CASE(StubCode_ShorebirdSimToCpuBodyMatchesTheirBytes) {
   using Layout = WrapperAllocator::Layout;
   const Layout l = Layout::fromTemplate<WrapperLayout<SimToCPUConfig>>();
@@ -128,10 +163,11 @@ ISOLATE_UNIT_TEST_CASE(StubCode_ShorebirdSimToCpuBodyMatchesTheirBytes) {
 // field.
 //
 // 60 of the 68 are position independent and are pinned as literals. The other
-// eight encode a Thread offset; theirs sit at 0x8d8..0x900 mid-struct and ours
-// are appended, so those are re-derived from the offset accessors instead. A
-// literal there would break the moment anyone adds a Thread field, and would be
-// pinning our layout rather than their instruction.
+// eight encode a Thread offset (theirs at 0x8d8..0x900 mid-struct, ours at the
+// same offsets since F147), so those are re-derived from the offset accessors
+// instead. A literal there would break the moment anyone adds a Thread field,
+// and would be pinning our layout rather than their instruction; the layout
+// itself is pinned once, in Shorebird_ThreadFieldOffsetsEqualTheirs.
 ISOLATE_UNIT_TEST_CASE(StubCode_ShorebirdCpuToSimBodyMatchesTheirBytes) {
   using Layout = WrapperAllocator::Layout;
   const Layout l = Layout::fromTemplate<WrapperLayout<CPUToSimConfig>>();
