diff --git a/runtime/vm/shorebird/dd_voting_test.cc b/runtime/vm/shorebird/dd_voting_test.cc
index d91b89da5e5..041293a97a1 100644
--- a/runtime/vm/shorebird/dd_voting_test.cc
+++ b/runtime/vm/shorebird/dd_voting_test.cc
@@ -4,6 +4,7 @@
 
 #include "vm/shorebird/dd_voting.h"
 
+#include "vm/shorebird/linker.h"
 #include "vm/unit_test.h"
 
 namespace dart {
@@ -624,4 +625,103 @@ VM_UNIT_TEST_CASE(DDSlotResolution_MultipleSlotsDoNotAlias) {
   EXPECT_EQ(59582u, g2.signature_hash);
 }
 
+// ===========================================================================
+// Task 4: ShorebirdLinker DD-slot wiring
+// ===========================================================================
+//
+// Each run_vm_tests invocation is a fresh process, so the function-local static
+// singleton starts null in every test and the Initialize* null-ASSERTs hold.
+
+// A fresh singleton has all three DD slots null. Without this, a test that
+// found voters already present could not tell a successful store from a
+// leftover from another test.
+VM_UNIT_TEST_CASE(ShorebirdLinker_FreshHasNullDDSlots) {
+  ShorebirdLinker* linker = ShorebirdLinker::shared();
+  EXPECT(linker->dd_slot_voters() == nullptr);
+  EXPECT(linker->dd_slot_mapping() == nullptr);
+  EXPECT(linker->resolution() == nullptr);
+}
+
+// The singleton holds exactly what was parsed — checked field-by-field through
+// the accessor, not merely "non-null".
+//
+// This is the both-halves assertion Slice 1's equivalent block was missing: the
+// reader returns an EMPTY object rather than null on failure, so "non-null" is
+// satisfied by a total parse failure. Only reading the data back distinguishes
+// a real parse from an empty one.
+VM_UNIT_TEST_CASE(ShorebirdLinker_HoldsDDSlotVoters) {
+  ReadStream rs(kOracleVotersBin,
+                static_cast<intptr_t>(sizeof(kOracleVotersBin)));
+  auto voters = std::make_unique<DDSlotVoters>();
+  EXPECT(voters->ReadFromStream(&rs));
+  EXPECT_EQ(0, rs.PendingBytes());
+
+  ShorebirdLinker* linker = ShorebirdLinker::shared();
+  EXPECT(linker->dd_slot_voters() == nullptr);  // before
+  linker->InitializeWithDDSlotVoters(std::move(voters));
+
+  const DDSlotVoters* held = linker->dd_slot_voters();
+  EXPECT(held != nullptr);
+  if (held == nullptr) return;
+
+  // Half one: the real data landed, not an empty object.
+  EXPECT_EQ(static_cast<size_t>(8), held->slot_count());
+  EXPECT_EQ(static_cast<size_t>(8), held->voters().size());
+
+  // Field-exact spot check through the accessor: slot 2's caller/target.
+  const std::vector<size_t>* idxs = held->voters_for_slot(2);
+  EXPECT(idxs != nullptr);
+  if (idxs != nullptr) {
+    EXPECT_EQ(static_cast<size_t>(1), idxs->size());
+    const SlotVoter& v = held->voters()[(*idxs)[0]];
+    EXPECT_EQ(7L, v.caller_key.library_kernel_offset);
+    EXPECT_EQ(698L, v.caller_key.owner_class_kernel_offset);
+    EXPECT_EQ(836L, v.caller_key.kernel_offset);
+    EXPECT_EQ(5, static_cast<int>(v.caller_key.kind));
+    EXPECT_EQ(178746u, v.caller_key.signature_hash);
+    EXPECT_EQ(7L, v.target_key.library_kernel_offset);
+    EXPECT_EQ(1018L, v.target_key.owner_class_kernel_offset);
+    EXPECT_EQ(1484L, v.target_key.kernel_offset);
+    EXPECT_EQ(2, static_cast<int>(v.target_key.kind));
+    EXPECT_EQ(119164u, v.target_key.signature_hash);
+  }
+
+  // The mapping slot must still be null — storing voters must not populate it.
+  EXPECT(linker->dd_slot_mapping() == nullptr);
+  EXPECT(linker->resolution() == nullptr);
+}
+
+// Half two of the both-halves assertion: a deliberately bogus input must NOT
+// produce the same singleton state as a good one. A corrupted magic makes
+// ReadFromStream fail, so nothing is stored and the slot stays null.
+VM_UNIT_TEST_CASE(ShorebirdLinker_BogusVotersDoesNotPopulate) {
+  uint8_t corrupted[sizeof(kOracleVotersBin)];
+  memcpy(corrupted, kOracleVotersBin, sizeof(kOracleVotersBin));
+  corrupted[0] ^= 0xFF;  // break the magic
+
+  ReadStream rs(corrupted, static_cast<intptr_t>(sizeof(corrupted)));
+  auto voters = std::make_unique<DDSlotVoters>();
+  EXPECT(!voters->ReadFromStream(&rs));
+
+  // The failed parse yields an EMPTY object, not null — which is exactly why
+  // a pointer check alone is not a verification.
+  EXPECT_EQ(static_cast<size_t>(0), voters->slot_count());
+  EXPECT_EQ(static_cast<size_t>(0), voters->voters().size());
+
+  // gen_snapshot exits before storing on this path, so the singleton stays null.
+  ShorebirdLinker* linker = ShorebirdLinker::shared();
+  EXPECT(linker->dd_slot_voters() == nullptr);
+}
+
+// DDSlotMapping::ReadFromStream is a documented stub. Pin that it returns false
+// so the gen_snapshot non-voters branch is known to reject rather than silently
+// succeed. When slice-2c implements it, this test is the tripwire that says so.
+VM_UNIT_TEST_CASE(DDSlotMapping_ReadFromStreamIsStillAStub) {
+  const uint8_t bytes[8] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};
+  ReadStream rs(bytes, sizeof(bytes));
+  DDSlotMapping mapping;
+  EXPECT(!mapping.ReadFromStream(&rs));
+  EXPECT_EQ(static_cast<size_t>(0), mapping.size());
+}
+
 }  // namespace dart
