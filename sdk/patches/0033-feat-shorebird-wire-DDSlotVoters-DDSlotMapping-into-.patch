@@ -708,6 +711,155 @@ static void InitializeShorebirdLinkData() {
     dart::ShorebirdLinker::shared()->InitializeWithDispatchTableLinkInfo(
         std::move(base));
   }
+
+  // --dd_slot_mapping: one file holding a DDSlotVoters section, optionally
+  // followed by a DDSlotMapping. Their _main sniffs the first 4 bytes and
+  // dispatches on the DDSlotVoters magic (LINKER_RECON §2/§5); there is no
+  // separate --dd_slot_voters option.
+  //
+  // EVERY failure path below is LOUD. The readers return an empty object rather
+  // than null on error, so a wrong path, an unreadable file, a zero-length file
+  // and a correct parse of an empty table are otherwise indistinguishable --
+  // all four would exit 0 with an empty linker. That was the defect caught in
+  // Slice 1's equivalent block.
+  if (dd_slot_mapping_filename != nullptr) {
+    FILE* f = fopen(dd_slot_mapping_filename, "rb");
+    if (f == nullptr) {
+      Syslog::PrintErr("Error: cannot open --dd_slot_mapping=%s\n\n",
+                       dd_slot_mapping_filename);
+      exit(kErrorExitCode);
+    }
+    if (fseek(f, 0, SEEK_END) != 0) {
+      Syslog::PrintErr("Error: cannot seek --dd_slot_mapping=%s\n\n",
+                       dd_slot_mapping_filename);
+      fclose(f);
+      exit(kErrorExitCode);
+    }
+    const long file_len = ftell(f);
+    // Reject zero-length and short files before any allocation. The header
+    // alone is 8 bytes (u32 magic + u32 version).
+    if (file_len < 8) {
+      Syslog::PrintErr(
+          "Error: --dd_slot_mapping=%s is %ld bytes; the header alone needs "
+          "8\n\n",
+          dd_slot_mapping_filename, file_len);
+      fclose(f);
+      exit(kErrorExitCode);
+    }
+    rewind(f);
+
+    // Slack past the logical end, filled with varint TERMINATOR bytes (0xFF).
+    // NOT 0x00: datastream.h continues a varint `while (b <= 127)`, so a zero
+    // pad is a CONTINUATION byte and invites the very overrun it looks like it
+    // prevents (measured in Slice 1: 4831 bytes out of bounds with 0x00, 1 byte
+    // with 0xFF). ReadStream's own bounds checks are ASSERTs and compile out in
+    // Release and Product, so this slack is the real guard.
+    constexpr intptr_t kSlack = 16;
+    uint8_t* buf = reinterpret_cast<uint8_t*>(malloc(file_len + kSlack));
+    if (buf == nullptr) {
+      Syslog::PrintErr("Error: out of memory reading --dd_slot_mapping\n\n");
+      fclose(f);
+      exit(kErrorExitCode);
+    }
+    if (fread(buf, 1, static_cast<size_t>(file_len), f) !=
+        static_cast<size_t>(file_len)) {
+      Syslog::PrintErr("Error: short read on --dd_slot_mapping=%s\n\n",
+                       dd_slot_mapping_filename);
+      free(buf);
+      fclose(f);
+      exit(kErrorExitCode);
+    }
+    fclose(f);
+    memset(buf + file_len, 0xFF, kSlack);
+
+    // Sniff the first 4 bytes as a raw LE u32 (little-endian host).
+    uint32_t sniff = 0;
+    memcpy(&sniff, buf, sizeof(sniff));
+    // NOTE: the two branches are distinguishable only by their error MESSAGE,
+    // not by exit code -- a bogus file exits 255 either way (verified by
+    // negative control: forcing this to `if (true)` still exits 255 on a
+    // non-voters file, but reports "DDSlotVoters: bad magic" instead of the
+    // "neither ... nor" message). Any test of the sniff must assert on output.
+    if (sniff == dart::DDSlotVoters::kMagic) {
+      dart::ReadStream stream(buf, static_cast<intptr_t>(file_len));
+      auto voters = std::make_unique<dart::DDSlotVoters>();
+      if (!voters->ReadFromStream(&stream)) {
+        Syslog::PrintErr(
+            "Error: failed to parse DDSlotVoters from --dd_slot_mapping=%s\n\n",
+            dd_slot_mapping_filename);
+        free(buf);
+        exit(kErrorExitCode);
+      }
+      dart::ShorebirdLinker::shared()->InitializeWithDDSlotVoters(
+          std::move(voters));
+
+      // Read the counts back THROUGH THE SINGLETON, never from a local
+      // captured before the move. Reporting the pre-move local would print the
+      // right numbers even if the store were a no-op -- the diagnostic would
+      // then be vacuous, which is the whole failure mode it exists to rule out.
+      const dart::DDSlotVoters* stored =
+          dart::ShorebirdLinker::shared()->dd_slot_voters();
+      if (stored == nullptr) {
+        Syslog::PrintErr(
+            "Error: DDSlotVoters parsed from --dd_slot_mapping=%s but the "
+            "linker singleton did not retain it.\n\n",
+            dd_slot_mapping_filename);
+        free(buf);
+        exit(kErrorExitCode);
+      }
+      const size_t parsed_slots = stored->slot_count();
+      const size_t parsed_voters = stored->voters().size();
+
+      // A DDSlotMapping may follow in the same stream. Absent is normal on a
+      // base build: dd_pipeline.sh step 6 passes voters only and their
+      // gen_snapshot still resolves 7 slots.
+      if (stream.PendingBytes() > 0) {
+        auto mapping = std::make_unique<dart::DDSlotMapping>();
+        if (!mapping->ReadFromStream(&stream)) {
+          // TODO(slice-2c): DDSlotMapping::ReadFromStream is a documented stub
+          // that always returns false; the wire format at 0x100198fb0 has not
+          // been disassembled. Trailing bytes are therefore expected to land
+          // here for now. Warn rather than fail so a voters-only file still
+          // works, but say so explicitly -- silence here would hide a real
+          // parse failure once the stub is implemented.
+          Syslog::PrintErr(
+              "Warning: %" Pd
+              " trailing bytes in --dd_slot_mapping=%s were not consumed; "
+              "DDSlotMapping::ReadFromStream is not yet implemented (stub). "
+              "Proceeding with voters only.\n",
+              stream.PendingBytes(), dd_slot_mapping_filename);
+        } else {
+          dart::ShorebirdLinker::shared()->InitializeWithDDSlotMapping(
+              std::move(mapping));
+        }
+      }
+
+      if (verbose) {
+        Syslog::PrintErr("DDSlotVoters loaded: %zu slots, %zu voters\n",
+                         parsed_slots, parsed_voters);
+      }
+    } else {
+      // Not a DDSlotVoters stream, so this must be a bare DDSlotMapping.
+      // ReadFromStream is a stub returning false, so this path REJECTS rather
+      // than silently succeeding. Without the exit, a wrong file would take the
+      // stub path and exit 0, leaving the sniffing branch untestable and making
+      // a mistyped filename look like success.
+      dart::ReadStream stream(buf, static_cast<intptr_t>(file_len));
+      auto mapping = std::make_unique<dart::DDSlotMapping>();
+      if (!mapping->ReadFromStream(&stream)) {
+        Syslog::PrintErr(
+            "Error: --dd_slot_mapping=%s is neither a DDSlotVoters stream "
+            "(magic 0x%X, got 0x%X) nor a parseable DDSlotMapping "
+            "(DDSlotMapping::ReadFromStream is not yet implemented).\n\n",
+            dd_slot_mapping_filename, dart::DDSlotVoters::kMagic, sniff);
+        free(buf);
+        exit(kErrorExitCode);
+      }
+      dart::ShorebirdLinker::shared()->InitializeWithDDSlotMapping(
+          std::move(mapping));
+    }
+    free(buf);
+  }
 }
 
 static void CreateAndWritePrecompiledSnapshot() {
