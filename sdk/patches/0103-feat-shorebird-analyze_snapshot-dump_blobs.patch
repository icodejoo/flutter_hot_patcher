diff --git a/runtime/vm/analyze_snapshot_api_impl.cc b/runtime/vm/analyze_snapshot_api_impl.cc
index 03da6546950..4f9b50069ed 100644
--- a/runtime/vm/analyze_snapshot_api_impl.cc
+++ b/runtime/vm/analyze_snapshot_api_impl.cc
@@ -22,6 +22,8 @@
 #include "vm/object.h"
 #include "vm/object_store.h"
 #include "vm/shorebird/link_info.h"
+#include "vm/image_snapshot.h"
+#include "vm/snapshot.h"
 #include "vm/thread.h"
 
 namespace dart {
@@ -1159,6 +1161,59 @@ void CollectAllCodes(
 // isolate's class table and produces exactly {id, name, hash} per class, and
 // our --print_class_table_link_info_to output is byte-identical to theirs, so
 // the hashes here are already known to agree with Shorebird's.
+// Shorebird's --dump_blobs: the four snapshot regions concatenated, which their
+// help describes as being for "avoiding Mach-O/ELF differences".
+//
+// ⚠️ The lengths are the ones the VM knows, NOT the ELF section sizes, and that
+// distinction is measured rather than assumed. On their own base.so the blob is
+// 669622 bytes while .rodata plus .text is 669760 -- the 138-byte difference is
+// section alignment padding, and using the section sizes would have produced a
+// blob that looks right and is wrong.
+//
+// Data regions carry their length in the snapshot header; instructions regions
+// carry theirs in the image header. Neither is in
+// Dart_SnapshotAnalyzerInformation, which is why this needed finding.
+//
+// The order -- both data regions, then both instructions regions -- is taken
+// from their output: it begins with the vm data magic and the instructions
+// bytes appear after all of the data.
+static intptr_t DataRegionSize(const uint8_t* region) {
+  if (region == nullptr) return 0;
+  const Snapshot* snapshot = Snapshot::SetupFromBuffer(region);
+  return snapshot == nullptr ? 0 : snapshot->length();
+}
+
+static intptr_t InstructionsRegionSize(const uint8_t* region) {
+  if (region == nullptr) return 0;
+  Image image(region);
+  const uword start = reinterpret_cast<uword>(region);
+  const uword object_start = reinterpret_cast<uword>(image.object_start());
+  return static_cast<intptr_t>((object_start - start) + image.object_size());
+}
+
+void Dart_DumpBlobs(const Dart_SnapshotAnalyzerInformation& info,
+                    char** out,
+                    intptr_t* out_len) {
+  const uint8_t* regions[4] = {
+      info.vm_snapshot_data, info.vm_isolate_data,
+      info.vm_snapshot_instructions, info.vm_isolate_instructions};
+  const intptr_t sizes[4] = {
+      DataRegionSize(regions[0]), DataRegionSize(regions[1]),
+      InstructionsRegionSize(regions[2]), InstructionsRegionSize(regions[3])};
+
+  intptr_t total = 0;
+  for (intptr_t i = 0; i < 4; i++) total += sizes[i];
+
+  char* buffer = reinterpret_cast<char*>(malloc(total));
+  intptr_t cursor = 0;
+  for (intptr_t i = 0; i < 4; i++) {
+    if (sizes[i] > 0) memcpy(buffer + cursor, regions[i], sizes[i]);
+    cursor += sizes[i];
+  }
+  *out = buffer;
+  *out_len = total;
+}
+
 void Dart_DumpClassTableAsJson(const Dart_SnapshotAnalyzerInformation& info,
                                char** out,
                                intptr_t* out_len) {
