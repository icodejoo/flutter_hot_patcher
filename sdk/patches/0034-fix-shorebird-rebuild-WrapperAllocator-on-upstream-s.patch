+    // Their wrapper.h:113, returns uword. Size of the stub's own code, which
+    // only the callback knows. INFERRED: the DWARF gives the name, return type
+    // and constness, not the body; this definition is the one consistent with
+    // upstream's use of trampoline_code.Size().
+    uword CodeSize() const;
