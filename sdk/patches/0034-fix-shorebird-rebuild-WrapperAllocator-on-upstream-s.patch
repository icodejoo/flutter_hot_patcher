+// True if a mapped region begins at exactly this address. mach_vm_region
+// reports the first region at or above the address it is given, so a freed
+// page makes it report the next one up instead, at a higher address.
+static bool RegionStartsAt(uword address) {
+  mach_vm_address_t addr = static_cast<mach_vm_address_t>(address);
+  mach_vm_size_t size = 0;
+  vm_region_basic_info_data_64_t info;
+  mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+  mach_port_t object_name = MACH_PORT_NULL;
+  const kern_return_t kr =
+      mach_vm_region(mach_task_self(), &addr, &size, VM_REGION_BASIC_INFO_64,
+                     reinterpret_cast<vm_region_info_t>(&info), &count,
+                     &object_name);
+  return kr == KERN_SUCCESS && addr == static_cast<mach_vm_address_t>(address);
+}
