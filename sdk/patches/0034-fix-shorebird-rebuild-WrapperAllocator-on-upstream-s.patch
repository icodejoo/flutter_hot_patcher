+  // Their wrapper.h:77; DW_AT_byte_size 0x60. Members are const in their DWARF,
+  // so a Layout is built once and never edited. Keeping it an aggregate (no
+  // user-declared constructor) is what allows const members to be initialized.
+  struct Layout {
+    const intptr_t page_size = 0;              // 0x00
+    const intptr_t rx_mapping_size = 0;        // 0x08
+    const intptr_t rw_mapping_size = 0;        // 0x10
+    const intptr_t num_wrappers_per_page = 0;  // 0x18
+    const intptr_t metadata_size = 0;          // 0x20
+    const intptr_t landing_pad_size = 0;       // 0x28
+    const intptr_t shared_body_size = 0;       // 0x30
+    const char* wrapper_page_name = nullptr;   // 0x38
+    // Their wrapper.h:90, DWARF type void(unsigned long&, unsigned long&).
+    // The two out-parameters are the (code_start, code_end) pair that upstream
+    // EnsureStubPageLocked computes locally; hoisting it into a callback is
+    // what lets one class serve both directions.
+    std::function<void(uword&, uword&)> get_stub_code_range;  // 0x40
+
+    // Their wrapper.h:93. The wrapper count is derived, never spelled out: one
+    // shared body plus a run of fixed-size landing pads fills one page. This
+    // reproduces both of their counts -- 2014 for CPUToSim, and 2044 for
+    // SimToCPU, the latter a truncated 2044.5.
+    template <typename C>
+    static Layout fromTemplate() {
+      return Layout{C::kPageSize,
+                    C::kRxMappingSize,
+                    C::kRwMappingSize,
+                    (C::kPageSize - C::kSharedBodySize) / C::kLandingPadSize,
+                    C::kMetadataSize,
+                    C::kLandingPadSize,
+                    C::kSharedBodySize,
+                    C::kWrapperPageName,
+                    C::GetStubCodeRange};
+    }
