+    // Their wrapper.h:116 and :117. Upstream's MappingSize() and
+    // MappingAlignment(). The alignment is what makes a page base recoverable
+    // from any address inside it by masking, which is how their one-argument
+    // MetadataForWrapper can work without being told the page.
+    intptr_t MappingSize() const { return rx_mapping_size + rw_mapping_size; }
+    intptr_t MappingAlignment() const {
