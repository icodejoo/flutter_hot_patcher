+// Shorebird ResumeOnSimulator, 66 instructions / 264 bytes. All but six are the
+// shared GenerateEnterSimulator sequence, so this also guards the refactor that
+// TransitionDartToSimulatorIfNeeded now shares: if the helper drifts, both
+// tests fail. Ten words encode a Thread offset and are re-derived.
+ISOLATE_UNIT_TEST_CASE(StubCode_ShorebirdResumeOnSimulatorMatchesTheirBytes) {
+  const Code& stub = StubCode::ResumeOnSimulator();
+  EXPECT_EQ(static_cast<intptr_t>(264), static_cast<intptr_t>(stub.Size()));
+  const uint32_t* w = reinterpret_cast<const uint32_t*>(stub.EntryPoint());
+
+  static const uint32_t kExpected[66] = {
