+// derived rather than copied.
+static void GenerateEnterSimulator(Assembler* assembler,
+                                   intptr_t source,
+                                   bool duplicate_pc_store) {
   constexpr intptr_t kSimReg = 8;           // registers_[r]  == r * 8
   constexpr intptr_t kSimVRegBase = 0x100;  // vregisters_[v] == 0x100 + v * 16
   constexpr intptr_t kSimVReg = 16;
   constexpr intptr_t kSimPc = 0x310;        // Simulator::pc_
-  // Their frame pointer lands 0xd0 above the simulator's C stack pointer.
