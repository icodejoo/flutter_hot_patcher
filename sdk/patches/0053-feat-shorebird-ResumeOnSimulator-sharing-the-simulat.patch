+      0xf9407d50u,  // [51]
+      0x9100021fu,  // [52]
+      0xad4c2548u,  // [53]
+      0xad4d2d4au,  // [54]
+      0xad4e354cu,  // [55]
+      0xad4f3d4eu,  // [56]
+      0u,  // [57]  derived
+      0xf100021fu,  // [58]
+      0x54000040u,  // [59]
+      0xd4200000u,  // [60]
+      0xd2400210u,  // [61]
+      0u,  // [62]  derived
+      0x3dc04140u,  // [63]
+      0xa9400540u,  // [64]
+      0xd65f03c0u,  // [65]
+  };
+
+  auto ldst_thr = [](uint32_t base, intptr_t off, uint32_t rt) {
+    return base | (static_cast<uint32_t>(off / 8) << 10) |
+           (static_cast<uint32_t>(THR) << 5) | rt;
+  };
+  constexpr uint32_t kLdr = 0xf9400000u;
+  constexpr uint32_t kStr = 0xf9000000u;
+  EXPECT_EQ(ldst_thr(kLdr, Thread::is_simulating_offset(), 17), w[0]);
+  EXPECT_EQ(ldst_thr(kLdr, Thread::simulator_async_resume_pc_offset(), 11),
+            w[1]);
+  EXPECT_EQ(ldst_thr(kStr, Thread::simulator_async_resume_pc_offset(), 31),
+            w[2]);
+  EXPECT_EQ(ldst_thr(kLdr, compiler::target::Thread::isolate_offset(), 10),
+            w[5]);
+  EXPECT_EQ(ldst_thr(kLdr, Thread::dart_state_is_on_cpu_offset(), 16), w[21]);
+  EXPECT_EQ(ldst_thr(kStr, Thread::dart_state_is_on_cpu_offset(), 16), w[26]);
+  EXPECT_EQ(ldst_thr(kLdr, Thread::simulator_csp_offset(), 16), w[27]);
+  EXPECT_EQ(ldst_thr(kLdr, Thread::simulator_execute_offset(), 16), w[41]);
+  EXPECT_EQ(ldst_thr(kLdr, Thread::dart_state_is_on_cpu_offset(), 16), w[57]);
+  EXPECT_EQ(ldst_thr(kStr, Thread::dart_state_is_on_cpu_offset(), 16), w[62]);
+
+  for (intptr_t i = 0; i < 66; i++) {
+    if (kExpected[i] == 0u) continue;
+    EXPECT_EQ(kExpected[i], w[i]);
+  }
+}
