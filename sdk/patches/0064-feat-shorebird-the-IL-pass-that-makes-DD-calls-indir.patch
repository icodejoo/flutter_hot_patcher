@@ -639,9 +639,24 @@ void FlowGraphCompiler::EmitDispatchTableCall(
   });
 }
 
-// Shorebird. Their sequence, from IndirectStaticCallInstr::EmitNativeCode at
-// 0x1002a3e28: load the table base out of Thread, scale dd_slot by the word
-// size, add, and call through the resulting address.
+// Shorebird. Three instructions, transcribed from call sites their own
+// gen_snapshot emitted (out_dd/patch_dd.so, the only build in that pipeline
+// given a --dd_slot_mapping):
+//
+//     ldr x16, [x26, #0x978]   ; TMP = indirect_static_call_table_
+//     ldr x16, [x16, #0x20]    ; TMP = table[dd_slot]
+//     blr x16
+//
+// Note what the second load says about the table: the slot index is folded
+// into the load's immediate, and the loaded word is branched to directly. So
+// the table is a bare array of entry points, not a Dart Array of Code -- a
+// tagged Array would need the 0x17 data offset and an untag, and there is
+// none. dd_slot 4 lands at 0x20, which is what identified the two slots that
+// pipeline reported as rewritten.
+//
+// The scale-and-add lives at compile time, in the immediate, because dd_slot
+// is a constant here. An out-of-range slot is still correct: PrepareLargeOffset
+// falls back through TMP2, which this sequence does not use.
 //
 // ⚠️ Thread::indirect_static_call_table_offset() rather than their literal
 // 0x978. Their Shorebird block sits mid-Thread and ours is appended, so 0x978
@@ -664,8 +679,8 @@ void FlowGraphCompiler::EmitIndirectStaticCall(
     // dart::Thread::simulator_execute_offset().
     __ LoadFromOffset(TMP, THR,
                       dart::Thread::indirect_static_call_table_offset());
-    __ AddImmediate(LR, TMP, dd_slot * compiler::target::kWordSize);
-    __ Call(compiler::Address(LR, 0));
+    __ LoadFromOffset(TMP, TMP, dd_slot * compiler::target::kWordSize);
+    __ blr(TMP);
   });
 
   // Record the original target even though the branch went through the table.
diff --git a/runtime/vm/compiler/backend/il.h b/runtime/vm/compiler/backend/il.h
index 7be9f2896a2..b74aafa732f 100644
--- a/runtime/vm/compiler/backend/il.h
+++ b/runtime/vm/compiler/backend/il.h
@@ -5784,6 +5784,33 @@ class IndirectStaticCallInstr : public TemplateDartCall<0> {
 
   DECLARE_INSTRUCTION(IndirectStaticCall)
 
+  // Builds the replacement for a direct static call whose target owns a DD
+  // slot. Everything except the dispatch is carried across unchanged, which is
+  // what makes the substitution invisible in the emitted code: in their
+  // out_dd/patch_dd.so the rewritten functions differ from the unrewritten
+  // build by exactly the three-instruction call sequence and nothing else.
+  //
+  // entry_kind is deliberately not carried. A table slot holds one entry point,
+  // and their EmitNativeCode records the call site with a hardcoded normal
+  // entry kind, so an unchecked-entry static call becomes a normal-entry
+  // indirect one. That is slower, never wrong.
+  static IndirectStaticCallInstr* FromCall(Zone* zone,
+                                           const StaticCallInstr* call,
+                                           intptr_t dd_slot) {
+    ASSERT(!call->HasMoveArguments());
+    InputsArray args(zone, call->ArgumentCount());
+    for (intptr_t i = 0; i < call->ArgumentCount(); i++) {
+      args.Add(call->ArgumentValueAt(i)->CopyWithType());
+    }
+    IndirectStaticCallInstr* new_call = new (zone) IndirectStaticCallInstr(
+        call->source(), call->function(), dd_slot, call->type_args_len(),
+        call->argument_names(), std::move(args), call->deopt_id());
+    if (call->result_type() != nullptr) {
+      new_call->result_type_ = call->result_type();
+    }
+    return new_call;
+  }
+
   const Function& function() const { return function_; }
 
   // Index into Thread::indirect_static_call_table_. The name is theirs: their
