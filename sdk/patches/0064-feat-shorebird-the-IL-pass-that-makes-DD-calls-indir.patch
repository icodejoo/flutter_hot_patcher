+// Shorebird. Sited immediately after UseTableDispatch because the two do the
+// same kind of thing -- turn a resolved call into a table dispatch -- at the
+// point where every optimisation that reads the call has already run.
+COMPILER_PASS(UseIndirectStaticCalls, {
+  state->call_specializer->ReplaceStaticCallsWithIndirectStaticCalls();
+});
