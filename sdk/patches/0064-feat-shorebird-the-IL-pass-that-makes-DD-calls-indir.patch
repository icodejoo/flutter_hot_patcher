+// Shorebird: send every static call whose target owns a DD slot through the
+// indirect static call table instead of straight at the target.
+//
+// Their own pass leaves no symbol -- it is inlined away completely -- so this
+// is reconstructed from what it does to the output. Driving their gen_snapshot
+// over the same kernel twice, once with --dd_slot_mapping and once without
+// (spikes/shorebird_linkinfo_oracle/dd_pipeline.sh, out_dd/patch{,_dd}.so),
+// establishes all of it:
+//
+//   * The mapping is the gate. Without it their build has zero loads of
+//     Thread+0x978; with it, three. Same gate as the table build itself.
+//   * The rule is total, not heuristic. Their patch.so makes three direct calls
+//     to DD-slot targets (two to Expando.[], one to _FinalizerImpl.
+//     _runFinalizers); patch_dd.so makes none, and has exactly three indirect
+//     sites. Nothing was left behind and nothing else was rewritten -- the five
+//     resolved slots with no call sites produced no sites either.
+//   * Nothing else about the function changes. _NativeFinalizer._removeEntries
+//     is 77 instructions in the unmapped build and 79 in the mapped one, and a
+//     normalised diff of the two bodies is exactly one `bl <Expando.[]>`
+//     against the three-instruction indirect sequence.
+//
+// That last point is why this runs here, immediately after UseTableDispatch and
+// after the final TypePropagation: it is late enough that no earlier decision
+// can move. ⚠️ It does not prove they run it here. An earlier position that
+// happened to leave every other decision untouched would look identical in this
+// fixture, and the fixture cannot separate the two -- all three sites were
+// already un-inlined calls before the rewrite, so a pass running before the
+// inliner would have produced the same output. Running late is the position
+// consistent with the evidence, not the position the evidence forces.
+void AotCallSpecializer::ReplaceStaticCallsWithIndirectStaticCalls() {
+  const DDSlotMapping* mapping = ShorebirdLinker::shared()->dd_slot_mapping();
+  if (mapping == nullptr) return;
+
+  ASSERT(current_iterator_ == nullptr);
+  for (BlockIterator block_it = flow_graph()->reverse_postorder_iterator();
+       !block_it.Done(); block_it.Advance()) {
+    ForwardInstructionIterator it(block_it.Current());
+    current_iterator_ = &it;
+    while (!it.Done()) {
+      Instruction* instr = it.Current();
+      it.Advance();
+
+      StaticCallInstr* call = instr->AsStaticCall();
+      if (call == nullptr) continue;
+
+      const Function& target = call->function();
+      if (target.IsNull()) continue;
+
+      // kernel_offset_ is the key their DDTableBuilder::VisitCode uses on this
+      // same map, so a call site and the table entry it dispatches to agree by
+      // construction. It is also the only per-function identity that survives
+      // recompilation of the same source, which is the whole point.
+      const long slot = mapping->SlotForKernelOffset(target.kernel_offset());
+      if (slot < 0) continue;
+
+      call->ReplaceWith(IndirectStaticCallInstr::FromCall(Z, call, slot),
+                        current_iterator());
+    }
+    current_iterator_ = nullptr;
+  }
+}
+
 const Function& AotCallSpecializer::InterfaceTargetForTableDispatch(
     InstanceCallBaseInstr* call) {
   const Function& interface_target = call->interface_target();
