+void ClassTableLinkInfo::WriteToStream(BaseWriteStream* stream) const {
+  stream->WriteUnsigned<intptr_t>(static_cast<intptr_t>(classes_.size()));
   for (const ClassInfo& info : classes_) {
-    stream.WriteUnsigned<intptr_t>(info.cid);
-    WriteString(&stream, info.name);
-    WriteString(&stream, info.hash);
+    stream->WriteUnsigned<intptr_t>(info.cid);
+    WriteString(stream, info.name);
+    WriteString(stream, info.hash);
   }
-  // The class table size is a trailer, not a header field.
-  stream.WriteUnsigned<intptr_t>(num_cids_);
+  // The class table size is a trailer, not a header field. Deliberately last --
