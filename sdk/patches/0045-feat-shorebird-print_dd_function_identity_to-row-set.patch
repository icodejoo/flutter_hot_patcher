+#include "vm/shorebird/link_info.h"
 #include "vm/shorebird/linker.h"
 #include "vm/unit_test.h"
 
@@ -724,4 +726,69 @@ VM_UNIT_TEST_CASE(DDSlotMapping_ReadFromStreamIsStillAStub) {
   EXPECT_EQ(static_cast<size_t>(0), mapping.size());
 }
 
+// --- DD function identity (--print_dd_function_identity_to) ------------------
+//
+// The load-bearing check for this dump is the six-fixture row-set comparison
+// against their own .ddid files, which cannot live in this binary because it
+// needs their gen_snapshot. These two tests pin what can regress silently
+// in-tree: the wire format, and the alloc-stub key shape.
+
+// index followed by FunctionKey's five varints, count header, no trailer.
+// Decoded by hand rather than through a reader, so writer and reader cannot
+// drift together and still pass.
+VM_UNIT_TEST_CASE(DDFunctionIdentity_RoundTrip) {
+  FunctionKey fn;
+  fn.library_kernel_offset = 20;
+  fn.owner_class_kernel_offset = 44770;
+  fn.kernel_offset = 45250;
+  fn.kind = 5;
+  fn.signature_hash = 89373;
+
+  FunctionKey stub;
+  stub.library_kernel_offset = 1;
+  stub.owner_class_kernel_offset = 59393;
+  stub.kernel_offset = 0;
+  stub.kind = FunctionKey::kAllocStubKind;
+  stub.signature_hash = 0;
+
+  DDFunctionIdentity info({{1379, fn}, {1253, stub}});
+
+  MallocWriteStream ws(/*initial_size=*/256);
+  info.WriteToStream(&ws);
+
+  ReadStream rs(ws.buffer(), ws.bytes_written());
+  EXPECT_EQ(static_cast<intptr_t>(2), rs.ReadUnsigned<intptr_t>());
+
+  EXPECT_EQ(static_cast<intptr_t>(1379), rs.ReadUnsigned<intptr_t>());
+  EXPECT_EQ(static_cast<intptr_t>(20), rs.ReadUnsigned<intptr_t>());
+  EXPECT_EQ(static_cast<intptr_t>(44770), rs.ReadUnsigned<intptr_t>());
+  EXPECT_EQ(static_cast<intptr_t>(45250), rs.ReadUnsigned<intptr_t>());
+  EXPECT_EQ(static_cast<intptr_t>(5), rs.ReadUnsigned<intptr_t>());
+  EXPECT_EQ(static_cast<intptr_t>(89373), rs.ReadUnsigned<intptr_t>());
+
+  EXPECT_EQ(static_cast<intptr_t>(1253), rs.ReadUnsigned<intptr_t>());
+  EXPECT_EQ(static_cast<intptr_t>(1), rs.ReadUnsigned<intptr_t>());
+  EXPECT_EQ(static_cast<intptr_t>(59393), rs.ReadUnsigned<intptr_t>());
+  EXPECT_EQ(static_cast<intptr_t>(0), rs.ReadUnsigned<intptr_t>());
+  EXPECT_EQ(static_cast<intptr_t>(255), rs.ReadUnsigned<intptr_t>());
+  EXPECT_EQ(static_cast<intptr_t>(0), rs.ReadUnsigned<intptr_t>());
+
+  // No trailing scalar: the stream must be exactly consumed.
+  EXPECT_EQ(static_cast<intptr_t>(0), rs.PendingBytes());
+}
+
+// All 87 alloc-stub rows in their base.ddid carry kernel_offset == 0 and
+// signature_hash == 0. A class with a real kernel_offset must not leak it into
+// either field.
+ISOLATE_UNIT_TEST_CASE(FunctionKey_ForAllocStub_ZeroesOffsetAndSignature) {
+  const Class& cls =
+      Class::Handle(thread->isolate_group()->object_store()->object_class());
+  const FunctionKey key = FunctionKey::ForAllocStub(cls);
+
+  EXPECT_EQ(static_cast<intptr_t>(0), key.kernel_offset);
+  EXPECT_EQ(static_cast<uint32_t>(0), key.signature_hash);
+  EXPECT_EQ(FunctionKey::kAllocStubKind, key.kind);
+  EXPECT_EQ(cls.kernel_offset(), key.owner_class_kernel_offset);
+}
+
 }  // namespace dart
diff --git a/runtime/vm/shorebird/link_info.cc b/runtime/vm/shorebird/link_info.cc
index 3e166068738..8e964d7e39b 100644
--- a/runtime/vm/shorebird/link_info.cc
+++ b/runtime/vm/shorebird/link_info.cc
@@ -54,6 +54,11 @@ DEFINE_FLAG(charp,
             nullptr,
             "Print dispatch table link debug information to the given file");
 
+DEFINE_FLAG(charp,
+            print_dd_function_identity_to,
+            nullptr,
+            "Print DD function identity table to the given file");
+
 // Declared, never read -- and that is not an omission on our side. Their own
 // arm64 gen_snapshot never reads it either: the flag has zero code references
 // (verified two ways, see spikes/shorebird_linkinfo_oracle/scripts/xref.py),
@@ -431,4 +436,62 @@ void PrintDispatchTableLinkInfoIfRequested(
   }
 }
 
+void DDFunctionIdentity::WriteToStream(BaseWriteStream* stream) const {
+  stream->WriteUnsigned<intptr_t>(static_cast<intptr_t>(rows_.size()));
+  for (const DDFunctionIdentityRow& row : rows_) {
+    stream->WriteUnsigned<intptr_t>(row.index);
+    row.key.WriteToStream(stream);
+  }
+  // No trailing scalar, like the dispatch table.
+}
+
+void DDFunctionIdentity::WriteToFile(const char* path) const {
+  MallocWriteStream stream(/*initial_size=*/64 * KB);
+  WriteToStream(&stream);
+
+  CallbackFile file(path);
+  if (file.is_open()) {
+    file.Write(stream.buffer(), stream.bytes_written());
+  }
+}
+
+bool WantsDDFunctionIdentity() {
+  return FLAG_print_dd_function_identity_to != nullptr;
+}
+
+void PrintDDFunctionIdentityIfRequested(Thread* thread,
+                                        const GrowableArray<CodePtr>& codes) {
+  if (!WantsDDFunctionIdentity()) return;
+
+  Zone* zone = thread->zone();
+  auto& code = Code::Handle(zone);
+  auto& owner = Object::Handle(zone);
+  auto& function = Function::Handle(zone);
+  auto& cls = Class::Handle(zone);
+
+  std::vector<DDFunctionIdentityRow> rows;
+  rows.reserve(codes.length());
+
+  for (intptr_t i = 0; i < codes.length(); i++) {
+    code = codes[i];
+
+    // Three-way split on Code::owner(), which is exactly the discriminator the
+    // measured row predicate needs: a Class for allocation stubs, a Type for
+    // type-test stubs, null for the remaining VM stubs, otherwise a Function.
+    if (code.IsStubCode() || code.IsTypeTestStubCode()) continue;
+
+    owner = code.owner();
+    if (code.IsAllocationStubCode()) {
+      cls ^= owner.ptr();
+      rows.push_back({i, FunctionKey::ForAllocStub(cls)});
+    } else if (owner.IsFunction()) {
+      function ^= owner.ptr();
+      rows.push_back({i, FunctionKey::FromFunction(function)});
+    }
+  }
+
+  DDFunctionIdentity info(std::move(rows));
+  info.WriteToFile(FLAG_print_dd_function_identity_to);
+}
+
 }  // namespace dart
