+// One row of the DD function identity table: a code-entry index paired with the
+// identity of whatever that code belongs to.
+struct DDFunctionIdentityRow {
+  intptr_t index;   // position in the serializer's code list
+  FunctionKey key;
+};
+
+// The table dumped by --print_dd_function_identity_to.
+//
+// Despite the name this does NOT depend on the DD subsystem: it is emitted on a
+// plain base build with no link data and no --dd_slot_mapping. What it needs is
+// the serializer's code list plus FunctionKey, both of which exist.
+//
+// The row predicate was established per-entry against their base.ddid, using
+// `analyze_snapshot --shorebird` (whose `functions` list shares this exact index
+// space -- 1380 entries, index_in_entries 0..1379) rather than by arithmetic on
+// counts. Over that fixture, with zero exceptions in either direction:
+//
+//   Code::IsAllocationStubCode()  -> row, kind = kAllocStubKind       (87)
+//   Code::IsTypeTestStubCode()    -> no row  ([Stub] Type Test Type:) (110)
+//   Code::IsStubCode()            -> no row  ([unknown stub])         (4)
+//   otherwise (owner is Function) -> row, kind = Function::kind()     (1179)
+//
+// KNOWN GAP: the emission ORDER is not reproduced. Theirs is a descending run of
+// 1187 rows (index 1379 -> 29) followed by 79 rows scattered over ~52 short
+// runs; the mechanism behind that is unexplained. We emit in ascending index
+// order, so the file is NOT byte-identical to theirs. The row SET is what is
+// verified. Do not read a passing set comparison as byte-level agreement.
+class DDFunctionIdentity {
+ public:
+  explicit DDFunctionIdentity(std::vector<DDFunctionIdentityRow> rows)
+      : rows_(std::move(rows)) {}
+
+  const std::vector<DDFunctionIdentityRow>& rows() const { return rows_; }
+
+  // count, { index, library_kernel_offset, owner_class_kernel_offset,
+  //          kernel_offset, kind, signature_hash } * count
+  // i.e. the row index followed by FunctionKey's five varints, no trailer.
+  // WriteToStream is the real encoder; see the note on ClassTableLinkInfo.
+  void WriteToStream(BaseWriteStream* stream) const;
+  void WriteToFile(const char* path) const;
+
+ private:
+  std::vector<DDFunctionIdentityRow> rows_;
+};
+
+// True when --print_dd_function_identity_to is set, so the serializer can skip
+// the collection walk otherwise.
+bool WantsDDFunctionIdentity();
+
+// Honour --print_dd_function_identity_to. `codes` is the serializer's code list
+// in index order; row i of the dump keys off position i here.
+void PrintDDFunctionIdentityIfRequested(Thread* thread,
+                                        const GrowableArray<CodePtr>& codes);
+
 // Honour the dispatch table flags. Called from DispatchTableGenerator, which is
 // the only place with access to the selector rows.
 void PrintDispatchTableLinkInfoIfRequested(
