diff --git a/runtime/vm/shorebird/dd_voting.cc b/runtime/vm/shorebird/dd_voting.cc
index 8f09083b029..e9c23570169 100644
--- a/runtime/vm/shorebird/dd_voting.cc
+++ b/runtime/vm/shorebird/dd_voting.cc
@@ -9,6 +9,7 @@
 
 #include "platform/assert.h"
 #include "vm/datastream.h"
+#include "vm/object.h"
 #include "vm/os.h"
 
 namespace dart {
@@ -59,6 +60,37 @@ void FunctionKey::WriteToStream(BaseWriteStream* stream) const {
          num_optional_named * 31u + num_type_params;
 }
 
+/*static*/ FunctionKey FunctionKey::FromFunction(const Function& function) {
+  const Class& owner = Class::Handle(function.Owner());
+  const Library& library =
+      owner.IsNull() ? Library::Handle() : Library::Handle(owner.library());
+
+  FunctionKey key;
+  key.library_kernel_offset =
+      library.IsNull() ? 0 : library.kernel_library_index();
+  key.owner_class_kernel_offset = owner.IsNull() ? 0 : owner.kernel_offset();
+  key.kernel_offset = function.kernel_offset();
+  key.kind = static_cast<uint8_t>(function.kind());
+  key.signature_hash = ComputeSignatureHash(
+      function.num_fixed_parameters(),
+      function.NumOptionalPositionalParameters(),
+      function.NumOptionalNamedParameters(), function.NumTypeParameters());
+  return key;
+}
+
+/*static*/ FunctionKey FunctionKey::ForAllocStub(const Class& cls) {
+  const Library& library = Library::Handle(cls.library());
+
+  FunctionKey key;
+  key.library_kernel_offset =
+      library.IsNull() ? 0 : library.kernel_library_index();
+  key.owner_class_kernel_offset = cls.kernel_offset();
+  key.kernel_offset = 0;
+  key.kind = kAllocStubKind;
+  key.signature_hash = 0;
+  return key;
+}
+
 size_t FunctionKeyHash::operator()(const FunctionKey& k) const {
   // Combine the five fields with the same basis used by signature_hash so
   // that keys with identical signature_hash values still spread across buckets.
diff --git a/runtime/vm/shorebird/dd_voting.h b/runtime/vm/shorebird/dd_voting.h
index 14c2264cf99..b309b7df95a 100644
--- a/runtime/vm/shorebird/dd_voting.h
+++ b/runtime/vm/shorebird/dd_voting.h
@@ -14,6 +14,9 @@
 
 namespace dart {
 
+class Class;
+class Function;
+
 // FunctionKey: 32-byte identity for a Dart function or allocation stub.
 //
 // Source: DWARF from Flutter.framework.dSYM — field names, offsets, and sizes
@@ -62,6 +65,20 @@ struct FunctionKey {
                                        uint32_t num_optional_positional,
                                        uint32_t num_optional_named,
                                        uint32_t num_type_params);
+
+  // Builds the key for a Dart function.
+  //
+  // library_kernel_offset carries the *library index*, not a byte offset: in
+  // their base.ddid it takes only 15 small dense values (0, 1, 7, 9, 12, 20,
+  // ...) over 1266 rows, with dart:core == 20 and dart:async == 1. A byte
+  // offset into the kernel binary cannot look like that. The field name is
+  // theirs (DWARF); the value is Library::kernel_library_index().
+  static FunctionKey FromFunction(const Function& function);
+
+  // Builds the key for a class allocation stub. Measured over all 87 alloc-stub
+  // rows of their base.ddid: kernel_offset and signature_hash are zero in every
+  // one, and owner_class_kernel_offset is distinct per class (87/87).
+  static FunctionKey ForAllocStub(const Class& cls);
 };
 
 // Hash functor so FunctionKey can be used as an unordered_map key.
