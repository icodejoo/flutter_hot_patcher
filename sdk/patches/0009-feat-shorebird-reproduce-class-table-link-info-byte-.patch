@@ -0,0 +1,68 @@
+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#ifndef RUNTIME_VM_SHOREBIRD_LINK_INFO_H_
+#define RUNTIME_VM_SHOREBIRD_LINK_INFO_H_
+
+#include <string>
+#include <vector>
+
+#include "vm/allocation.h"
+#include "vm/globals.h"
+
+namespace dart {
+
+class Thread;
+
+// Link information describing a base snapshot's class table, so a patch
+// compiled later can be mapped onto it.
+//
+// Reproduced from Shorebird's closed dart-sdk. The file layout and the hash
+// encoding were recovered from their shipped binaries; see
+// flutter_hot_patcher spikes/shorebird_linkinfo_oracle/README.md. Their own
+// source lives in runtime/vm/shorebird/link_info.cc (path recovered from
+// assertion strings in their binaries), which is why this file is placed here.
+struct ClassInfo {
+  intptr_t cid;
+  std::string name;
+  // str(Utils::StringHash(ScrubName(name))) followed by the 1-based occurrence
+  // index among classes sharing that scrubbed name. The index disambiguates
+  // genuine duplicates -- e.g. the VM's Function (cid 7) and dart:core's
+  // Function both hash to 909654927 and are distinguished as ...1 and ...2.
+  std::string hash;
+};
+
+class ClassTableLinkInfo : public ZoneObject {
+ public:
+  ClassTableLinkInfo(std::vector<ClassInfo> classes, intptr_t num_cids)
+      : classes_(std::move(classes)), num_cids_(num_cids) {}
+
+  const std::vector<ClassInfo>& classes() const { return classes_; }
+  intptr_t num_cids() const { return num_cids_; }
+
+  // Binary form, matching --print_class_table_link_info_to. Uses Dart's own
+  // WriteStream varint encoding:
+  //   count, { cid, name, hash }, num_cids
+  // Note num_cids is written *last*, not in the header.
+  void WriteToFile(const char* path) const;
+
+  // JSON form, matching --print_class_table_link_debug_info_to. Same data, and
+  // the cross-check for the binary writer.
+  void WriteDebugInfoToFile(const char* path) const;
+
+ private:
+  std::vector<ClassInfo> classes_;
+  intptr_t num_cids_;
+};
+
+// Walks the class table and computes the link info for the current isolate.
+ClassTableLinkInfo* GetClassTableLinkInfo(Thread* thread);
+
+// Honours --print_class_table_link_info_to / _debug_info_to. No-op when neither
+// flag is set.
+void PrintClassTableLinkInfoIfRequested(Thread* thread);
+
+}  // namespace dart
+
+#endif  // RUNTIME_VM_SHOREBIRD_LINK_INFO_H_
