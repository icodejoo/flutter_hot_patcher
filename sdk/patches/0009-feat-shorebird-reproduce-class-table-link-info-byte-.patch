diff --git a/runtime/vm/shorebird/link_info.cc b/runtime/vm/shorebird/link_info.cc
new file mode 100644
index 00000000000..1883a259752
--- /dev/null
+++ b/runtime/vm/shorebird/link_info.cc
@@ -0,0 +1,172 @@
+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#include "vm/shorebird/link_info.h"
+
+#include <map>
+#include <string>
+
+#include "platform/utils.h"
+#include "vm/class_table.h"
+#include "vm/dart.h"
+#include "vm/dart_api_state.h"
+#include "vm/datastream.h"
+#include "vm/flags.h"
+#include "vm/json_writer.h"
+#include "vm/object.h"
+#include "vm/thread.h"
+#include "vm/zone_text_buffer.h"
+
+namespace dart {
+
+DEFINE_FLAG(charp,
+            print_class_table_link_info_to,
+            nullptr,
+            "Write class table link info as a binary file");
+DEFINE_FLAG(charp,
+            print_class_table_link_debug_info_to,
+            nullptr,
+            "Write class table link info as JSON, for debugging");
+
+namespace {
+
+// Opens via the embedder's file callbacks, the way upstream's
+// ClassTable::PrintToJSONObject-to-file path does.
+class CallbackFile {
+ public:
+  explicit CallbackFile(const char* path) : path_(path) {
+    open_ = Dart::file_open_callback();
+    write_ = Dart::file_write_callback();
+    close_ = Dart::file_close_callback();
+    if (open_ == nullptr || write_ == nullptr || close_ == nullptr) {
+      OS::PrintErr(
+          "warning: %s requires Dart file callbacks (open/write/close); "
+          "none were registered by the embedder.\n",
+          path);
+      return;
+    }
+    handle_ = open_(path, /*write=*/true);
+    if (handle_ == nullptr) {
+      OS::PrintErr("warning: %s: failed to open file for writing.\n", path);
+    }
+  }
+
+  ~CallbackFile() {
+    if (handle_ != nullptr) close_(handle_);
+  }
+
+  bool is_open() const { return handle_ != nullptr; }
+
+  void Write(const void* data, intptr_t length) {
+    if (handle_ != nullptr && length > 0) write_(data, length, handle_);
+  }
+
+ private:
+  const char* path_;
+  Dart_FileOpenCallback open_ = nullptr;
+  Dart_FileWriteCallback write_ = nullptr;
+  Dart_FileCloseCallback close_ = nullptr;
+  void* handle_ = nullptr;
+};
+
+// Strings are length-prefixed, then one signed varint per character. Characters
+// <= 63 therefore occupy a single byte and letters occupy two.
+void WriteString(BaseWriteStream* stream, const std::string& s) {
+  stream->WriteUnsigned<intptr_t>(static_cast<intptr_t>(s.size()));
+  for (char c : s) {
+    stream->Write<int32_t>(static_cast<int32_t>(c));
+  }
+}
+
+}  // namespace
+
+void ClassTableLinkInfo::WriteToFile(const char* path) const {
+  MallocWriteStream stream(/*initial_size=*/1 * MB);
+  stream.WriteUnsigned<intptr_t>(static_cast<intptr_t>(classes_.size()));
+  for (const ClassInfo& info : classes_) {
+    stream.WriteUnsigned<intptr_t>(info.cid);
+    WriteString(&stream, info.name);
+    WriteString(&stream, info.hash);
+  }
+  // The class table size is a trailer, not a header field.
+  stream.WriteUnsigned<intptr_t>(num_cids_);
+
+  CallbackFile file(path);
+  if (file.is_open()) {
+    file.Write(stream.buffer(), stream.bytes_written());
+  }
+}
+
+void ClassTableLinkInfo::WriteDebugInfoToFile(const char* path) const {
+  JSONWriter js;
+  js.OpenObject();
+  js.PrintProperty64("num_cids", num_cids_);
+  js.OpenArray("classes");
+  for (const ClassInfo& info : classes_) {
+    js.OpenObject();
+    js.PrintProperty64("id", info.cid);
+    js.PrintProperty("name", info.name.c_str());
+    js.PrintProperty("hash", info.hash.c_str());
+    js.CloseObject();
+  }
+  js.CloseArray();
+  js.CloseObject();
+
+  char* output = nullptr;
+  intptr_t output_length = 0;
+  js.Steal(&output, &output_length);
+  CallbackFile file(path);
+  if (file.is_open()) {
+    file.Write(output, output_length);
+  }
+  free(output);
+}
+
+ClassTableLinkInfo* GetClassTableLinkInfo(Thread* thread) {
+  Zone* zone = thread->zone();
+  ClassTable* table = thread->isolate_group()->class_table();
+  const intptr_t num_cids = table->NumCids();
+
+  std::vector<ClassInfo> classes;
+  // Counts occurrences of each scrubbed name, so duplicates can be told apart
+  // by a 1-based index appended to the hash.
+  std::map<std::string, intptr_t> seen;
+
+  Class& cls = Class::Handle(zone);
+  String& name = String::Handle(zone);
+  for (intptr_t cid = 1; cid < num_cids; cid++) {
+    if (!table->HasValidClassAt(cid)) continue;
+    cls = table->At(cid);
+    if (cls.IsNull()) continue;
+    name = cls.Name();
+    if (name.IsNull()) continue;
+
+    const char* scrubbed = String::ScrubName(name);
+    const std::string key(scrubbed);
+    const intptr_t occurrence = ++seen[key];
+
+    const uint32_t string_hash =
+        Utils::StringHash(scrubbed, static_cast<int>(key.size()));
+    std::string hash = std::to_string(string_hash);
+    hash += std::to_string(occurrence);
+
+    classes.push_back(ClassInfo{cid, key, std::move(hash)});
+  }
+
+  return new (zone) ClassTableLinkInfo(std::move(classes), num_cids);
+}
+
+void PrintClassTableLinkInfoIfRequested(Thread* thread) {
+  const bool want_binary = FLAG_print_class_table_link_info_to != nullptr;
+  const bool want_json = FLAG_print_class_table_link_debug_info_to != nullptr;
+  if (!want_binary && !want_json) return;
+
+  const ClassTableLinkInfo* info = GetClassTableLinkInfo(thread);
+  if (want_binary) info->WriteToFile(FLAG_print_class_table_link_info_to);
+  if (want_json) {
+    info->WriteDebugInfoToFile(FLAG_print_class_table_link_debug_info_to);
+  }
+}
+
+}  // namespace dart
