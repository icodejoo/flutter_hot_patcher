+// Digit value of |ch| in the numeral system NextName() counts in, or -1 if
+// |ch| is not one of its digits.
+static intptr_t RenameDigit(char ch) {
+  if ((ch >= 'a') && (ch <= 'z')) return ch - 'a';
+  if ((ch >= 'A') && (ch <= 'Z')) return ch - 'A' + 26;
+  return -1;
+}
+
+// Recover the raw counter value (ObfuscationState::name_) from a rename handed
+// out by NewAtomicRename(). BuildRename() wraps that value in a 'get:'/'set:'
+// prefix, a leading '_' and a trailing '@<private-key>'. Returns the length of
+// the counter value and sets |start| to its first character, or returns 0 if
+// |rename| was not generated by the obfuscator.
+static intptr_t AtomicRenameCore(const char* rename, const char** start) {
+  const char* cursor = rename;
+  if ((strncmp(cursor, "get:", 4) == 0) || (strncmp(cursor, "set:", 4) == 0)) {
+    cursor += 4;
+  }
+  if (*cursor == '_') cursor++;
+  *start = cursor;
+  while (RenameDigit(*cursor) >= 0) {
+    cursor++;
+  }
+  if ((*cursor != '\0') && (*cursor != '@')) return 0;
+  return cursor - *start;
+}
+
+// Renames are little-endian numerals (NextName() carries from name_[0] up), so
+// a longer one is always generated later and within one length the last
+// character is the most significant digit.
+static bool IsLaterRename(const char* a,
+                          intptr_t a_length,
+                          const char* b,
+                          intptr_t b_length) {
+  if (a_length != b_length) return a_length > b_length;
+  for (intptr_t i = a_length - 1; i >= 0; i--) {
+    const intptr_t a_digit = RenameDigit(a[i]);
+    const intptr_t b_digit = RenameDigit(b[i]);
+    if (a_digit != b_digit) return a_digit > b_digit;
+  }
+  return false;
+}
+
+void Obfuscator::DeserializeMap(Thread* thread,
+                                const GrowableObjectArray& pairs) {
+  ASSERT((pairs.Length() % 2) == 0);
+  Zone* zone = thread->zone();
+
+  const Array& renames = Array::Handle(
+      zone, HashTables::New<ObfuscationMap>(pairs.Length(), Heap::kOld));
+  ObfuscationMap renames_map(renames.ptr());
+
+  // SerializeMap() does not record the obfuscator's counter, only the renames
+  // it produced. Recovering the last name handed out is what keeps a continued
+  // compilation from issuing a rename the previous one already used: renames
+  // are dense, so the largest one is the last one. Identity entries are skipped
+  // because those names come from the program, not from the counter.
+  char last_name[kMaxRenameLength] = {0};
+  intptr_t last_length = 0;
+
+  String& original = String::Handle(zone);
+  String& renamed = String::Handle(zone);
+  for (intptr_t i = 0; i < pairs.Length(); i += 2) {
+    original ^= pairs.At(i);
+    renamed ^= pairs.At(i + 1);
+    renames_map.UpdateOrInsert(original, renamed);
+
+    if (original.ptr() == renamed.ptr()) continue;
+    const char* core = nullptr;
+    const intptr_t length =
+        AtomicRenameCore(renamed.ToCString(), &core);
+    if ((length > 0) && (length < kMaxRenameLength) &&
+        IsLaterRename(core, length, last_name, last_length)) {
+      memmove(last_name, core, length);
+      last_name[length] = '\0';
+      last_length = length;
+    }
+  }
+
+  const Array& obfuscation_state = Array::Handle(zone, Array::New(kSavedStateSize));
+  obfuscation_state.SetAt(kSavedStateNameIndex,
+                          String::Handle(zone, String::New(last_name, Heap::kOld)));
+  obfuscation_state.SetAt(kSavedStateRenamesIndex, renames_map.Release());
+  thread->isolate_group()->object_store()->set_obfuscation_map(
+      obfuscation_state);
+}
+
 #endif  // defined(DART_PRECOMPILER) && !defined(TARGET_ARCH_IA32)
 
 }  // namespace dart
