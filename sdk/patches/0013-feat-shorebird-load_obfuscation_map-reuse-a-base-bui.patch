+// Reads one JSON string literal, undoing the escaping BaseTextBuffer applies in
+// EscapeAndAddCodeUnit. |cursor| points at the opening quote and is left just
+// past the closing one. Returns false if the literal is malformed.
+static bool ReadEscapedString(const char** cursor,
+                              const char* end,
+                              BaseTextBuffer* out) {
+  const char* p = *cursor;
+  if ((p == end) || (*p != '"')) return false;
+  p++;
+  while ((p != end) && (*p != '"')) {
+    if (*p != '\\') {
+      out->AddChar(*p++);
+      continue;
+    }
+    if (++p == end) return false;
+    switch (*p) {
+      case '"':
+      case '\\':
+      case '/':
+        out->AddChar(*p);
+        break;
+      case 'b':
+        out->AddChar('\b');
+        break;
+      case 'f':
+        out->AddChar('\f');
+        break;
+      case 'n':
+        out->AddChar('\n');
+        break;
+      case 'r':
+        out->AddChar('\r');
+        break;
+      case 't':
+        out->AddChar('\t');
+        break;
+      case 'u': {
+        if ((end - p) < 5) return false;
+        uint32_t code_unit = 0;
+        for (intptr_t i = 1; i <= 4; i++) {
+          const char digit = p[i];
+          if ((digit >= '0') && (digit <= '9')) {
+            code_unit = (code_unit << 4) | (digit - '0');
+          } else if ((digit >= 'a') && (digit <= 'f')) {
+            code_unit = (code_unit << 4) | (digit - 'a' + 10);
+          } else if ((digit >= 'A') && (digit <= 'F')) {
+            code_unit = (code_unit << 4) | (digit - 'A' + 10);
+          } else {
+            return false;
+          }
+        }
+        p += 4;
+        // Only control characters and unpaired surrogates are written this
+        // way, so a direct UTF-8 encoding round-trips them.
+        if (code_unit < 0x80) {
+          out->AddChar(static_cast<char>(code_unit));
+        } else if (code_unit < 0x800) {
+          out->AddChar(static_cast<char>(0xC0 | (code_unit >> 6)));
+          out->AddChar(static_cast<char>(0x80 | (code_unit & 0x3F)));
+        } else {
+          out->AddChar(static_cast<char>(0xE0 | (code_unit >> 12)));
+          out->AddChar(static_cast<char>(0x80 | ((code_unit >> 6) & 0x3F)));
+          out->AddChar(static_cast<char>(0x80 | (code_unit & 0x3F)));
+        }
+        break;
+      }
+      default:
+        return false;
+    }
+    p++;
+  }
+  if (p == end) return false;
+  *cursor = p + 1;  // Skip the closing quote.
+  return true;
+}
+
+// Reads the file named by --load_obfuscation_map and installs the renaming map
+// it holds, which is the JSON array of names Dart_GetObfuscationMap writes.
+static void LoadObfuscationMapFromFile(Thread* thread) {
+  auto file_open = Dart::file_open_callback();
+  auto file_read = Dart::file_read_callback();
+  auto file_close = Dart::file_close_callback();
+  if ((file_open == nullptr) || (file_read == nullptr) ||
+      (file_close == nullptr)) {
+    FATAL("Could not load obfuscation map: file callbacks not set");
+  }
+
+  void* stream = file_open(FLAG_load_obfuscation_map, /*write=*/false);
+  if (stream == nullptr) {
+    FATAL("Could not load obfuscation map: failed to open %s",
+          FLAG_load_obfuscation_map);
+  }
+  uint8_t* buffer = nullptr;
+  intptr_t length = 0;
+  file_read(&buffer, &length, stream);
+  file_close(stream);
+  if (buffer == nullptr) {
+    FATAL("Could not load obfuscation map: failed to read %s",
+          FLAG_load_obfuscation_map);
+  }
+
+  Zone* zone = thread->zone();
+  const char* cursor = reinterpret_cast<const char*>(buffer);
+  const char* end = cursor + length;
+  if ((cursor == end) || (*cursor++ != '[')) {
+    FATAL("Obfuscation map %s is not a JSON array", FLAG_load_obfuscation_map);
+  }
+
+  const GrowableObjectArray& pairs =
+      GrowableObjectArray::Handle(zone, GrowableObjectArray::New());
+  ZoneTextBuffer name(zone);
+  while ((cursor != end) && (*cursor != ']')) {
+    if ((pairs.Length() > 0) && (*cursor++ != ',')) {
+      FATAL("Obfuscation map %s: entries must be comma separated",
+            FLAG_load_obfuscation_map);
+    }
+    name.Clear();
+    if (!ReadEscapedString(&cursor, end, &name)) {
+      FATAL("Obfuscation map %s: entry %" Pd " is not a valid string",
+            FLAG_load_obfuscation_map, pairs.Length());
+    }
+    // The renaming map is keyed by identity, so every name has to be a Symbol.
+    pairs.Add(
+        String::Handle(zone, Symbols::New(thread, name.buffer(), name.length())));
+  }
+  if (cursor == end) {
+    FATAL("Obfuscation map %s is missing its closing bracket",
+          FLAG_load_obfuscation_map);
+  }
+  if ((pairs.Length() % 2) != 0) {
+    FATAL("Obfuscation map %s holds %" Pd
+          " names, expected pairs of (original, obfuscated)",
+          FLAG_load_obfuscation_map, pairs.Length());
+  }
+  free(buffer);
+
+  Obfuscator::DeserializeMap(thread, pairs);
+}
