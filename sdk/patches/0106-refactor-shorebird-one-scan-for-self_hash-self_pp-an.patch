+    // because that one needs the callee walk.
+    js.OpenArray("self_field_table");
+    for (intptr_t slot : facts.field_indices) js.PrintValue64(slot);
     js.CloseArray();
-    // subgraph_pp, self_selectors, subgraph_selectors, self_field_table,
