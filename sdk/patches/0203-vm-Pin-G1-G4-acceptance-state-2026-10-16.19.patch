+  const size_t length = static_cast<size_t>(s->length());
+  const size_t aligned = (length + 63) & ~static_cast<size_t>(63);
+  uint32_t extra = 0;
+  memmove(&extra, snapshot + aligned, sizeof(extra));
+  return length + extra;
 }
 
