+  // Shorebird: an object pool load is topped up with NOPs to a fixed footprint
+  // of Assembler::kObjectPoolLoadStoreMinInstructionCount words, so that
+  // renumbering a pool index can never move the code around it. At most one
+  // fewer than that many words are padding, which is what the reverse decoders
+  // in instructions_arm64.cc have to step back over.
+  //
+  // The assembler's constant lives in a compiler-side header that the AOT
+  // runtime does not build, so it is restated here; assembler_arm64.h
+  // static_asserts the two against each other.
+  static constexpr intptr_t kMaxObjectPoolLoadPaddingInstructions = 2;
+
   // Reserved brk and hlt instruction codes.
   static constexpr int32_t kBreakPointCode = 0xdeb0;  // For breakpoint.
   static constexpr int32_t kSimulatorBreakCode =
diff --git a/runtime/vm/instructions_arm64.cc b/runtime/vm/instructions_arm64.cc
index 3eb898d9f37..16ef38bc9af 100644
--- a/runtime/vm/instructions_arm64.cc
+++ b/runtime/vm/instructions_arm64.cc
@@ -16,6 +16,32 @@
 
 namespace dart {
 
+// Shorebird: object pool loads are topped up with NOPs to a fixed footprint so
+// that renumbering an index never moves the code around it (see
+// Assembler::PadLoadStore). Every reverse decode in this file is handed the
+// address one past the load sequence, so the padding sits between that address
+// and the last instruction the decode actually wants to look at.
+//
+// This is where the fix belongs rather than in the emitters: measured over
+// their own gen_snapshot output, all 2299 PP-relative loads are followed by
+// nop,nop -- including the ones inside call sequences, which is exactly the
+// case a fixed backward distance reads. So their readback steps over it too.
+//
+// The loop is bounded rather than open, so that a run of NOPs that is not
+// padding cannot walk this off the front of an instructions payload. In an
+// unpadded build it never takes a step: a pool load sequence always ends in an
+// ldr or an ldp, never in a NOP.
+static uword SkipBackOverObjectPoolLoadPadding(uword end) {
+  for (intptr_t i = 0; i < Instr::kMaxObjectPoolLoadPaddingInstructions; i++) {
+    if (Instr::At(end - Instr::kInstrSize)->InstructionBits() !=
+        Instr::kNopInstruction) {
+      break;
+    }
+    end -= Instr::kInstrSize;
+  }
+  return end;
+}
+
 static bool IsBranchLinkScratch(Register reg) {
   // See Assembler::BranchLink
   return FLAG_precompiled_mode ? reg == LINK_REGISTER : reg == CODE_REG;
@@ -106,6 +132,11 @@ uword InstructionPattern::DecodeLoadWordImmediate(uword end,
   //    orri
   // or
   // 3. LoadPatchableImmediate
+  //
+  // Cases 1 and 2 embed a padded pool load; see
+  // SkipBackOverObjectPoolLoadPadding. Case 3 never ends in a NOP, so the skip
+  // is inert for it.
+  end = SkipBackOverObjectPoolLoadPadding(end);
   uword start = end - Instr::kInstrSize;
   Instr* instr = Instr::At(start);
   bool odd = false;
@@ -114,9 +145,10 @@ uword InstructionPattern::DecodeLoadWordImmediate(uword end,
   if (instr->IsLogicalImmOp()) {
     ASSERT(instr->Bit(29) == 1);
     odd = true;
-    // end points at orri so that we can pass it to DecodeLoadWordFromPool.
-    end = start;
-    start -= Instr::kInstrSize;
+    // end points past the pool load -- at the orri, or at whatever padding
+    // precedes it -- so that we can pass it to DecodeLoadWordFromPool.
+    end = SkipBackOverObjectPoolLoadPadding(start);
+    start = end - Instr::kInstrSize;
     instr = Instr::At(start);
     // Case 2 falls through to case 1.
   }
@@ -177,6 +209,10 @@ uword InstructionPattern::DecodeLoadWordFromPool(uword end,
   // 3. movz dst, low_offset, 0
   //    movk dst, hi_offset, 1 (optional)
   //    ldr dst, [pp, dst]
+  //
