   const uint32_t offset = target::ObjectPool::element_offset(index);
-  const uint32_t upper20 = offset & 0xfffff000;
-  if (Address::CanHoldOffset(offset)) {
-    ldr(dst, Address(pp, offset));
-  } else if (Operand::CanHold(upper20, kXRegSizeInBits, &op) ==
-             Operand::Immediate) {
-    const uint32_t lower12 = offset & 0x00000fff;
-    ASSERT(Address::CanHoldOffset(lower12));
-    add(dst, pp, op);
-    ldr(dst, Address(dst, lower12));
+  // Shorebird: padded to a fixed footprint so that renumbering the pool never
+  // moves the code around it. See PadLoadStore.
+  //
+  // ⚠️ Precompiled mode only, and that gate is OURS. The padding exists so the
+  // object pool editor can renumber entries without moving code, which is only
+  // ever done to an AOT snapshot; in JIT mode it would cost two words per pool
+  // access and buy nothing. Their gen_snapshot is precompiler-only, so whether
+  // their JIT build pads is not observable from anything here.
+  //
+  // The gate is no longer load bearing for correctness. It used to be: the
+  // InstructionPattern decoders read these sequences back from a fixed backward
+  // distance, so padding crashed unoptimized code loudly, in
+  // IL_IndirectStaticCall_SerializationRoundTrip and
+  // IsolateReload_ShapeChange_Const_AddSlot. Those decoders now step over the
+  // padding -- SkipBackOverObjectPoolLoadPadding in instructions_arm64.cc --
+  // which is where their build has to handle it too: all 2299 PP loads in their
+  // own snapshot are followed by nop,nop, including the ones inside call
+  // sequences, which is precisely the fixed-distance case.
+  const auto emit = [&]() {
+        Operand op;
+        const uint32_t upper20 = offset & 0xfffff000;
+        if (Address::CanHoldOffset(offset)) {
+          ldr(dst, Address(pp, offset));
+        } else if (Operand::CanHold(upper20, kXRegSizeInBits, &op) ==
+                   Operand::Immediate) {
+          const uint32_t lower12 = offset & 0x00000fff;
+          ASSERT(Address::CanHoldOffset(lower12));
+          add(dst, pp, op);
+          ldr(dst, Address(dst, lower12));
+        } else {
+          const uint16_t offset_low = Utils::Low16Bits(offset);
+          const uint16_t offset_high = Utils::High16Bits(offset);
+          movz(dst, Immediate(offset_low), 0);
+          movk(dst, Immediate(offset_high), 1);
+          ldr(dst, Address(pp, dst));
+        }
+  };
+  if (FLAG_precompiled_mode) {
+    PadLoadStore(emit, pp, static_cast<int32_t>(offset), kEightBytes,
+                 Address::Offset);
   } else {
-    const uint16_t offset_low = Utils::Low16Bits(offset);
-    const uint16_t offset_high = Utils::High16Bits(offset);
-    movz(dst, Immediate(offset_low), 0);
-    movk(dst, Immediate(offset_high), 1);
-    ldr(dst, Address(pp, dst));
+    emit();
   }
 }
 
