+  // SkipBackOverObjectPoolLoadPadding.
+  end = SkipBackOverObjectPoolLoadPadding(end);
   uword start = end - Instr::kInstrSize;
   Instr* instr = Instr::At(start);
   intptr_t offset = 0;
@@ -256,6 +292,9 @@ uword InstructionPattern::DecodeLoadDoubleWordFromPool(uword end,
   //
   // Note that the pp register is untagged!
   //
+  // Any of the four may be followed by NOP padding; see
+  // SkipBackOverObjectPoolLoadPadding.
+  end = SkipBackOverObjectPoolLoadPadding(end);
   uword start = end - Instr::kInstrSize;
   Instr* ldr_instr = Instr::At(start);
 
