diff --git a/runtime/vm/compiler/assembler/assembler_arm64.h b/runtime/vm/compiler/assembler/assembler_arm64.h
index 4a1148e1350..c7509dad630 100644
--- a/runtime/vm/compiler/assembler/assembler_arm64.h
+++ b/runtime/vm/compiler/assembler/assembler_arm64.h
@@ -1896,6 +1896,12 @@ class Assembler : public AssemblerBase {
   // and the trailing bound is 13 bytes, so the footprint is three instructions.
   static constexpr intptr_t kObjectPoolLoadStoreMinInstructionCount = 3;
 
+  // The reverse decoders in instructions_arm64.cc have to step back over the
+  // padding this emits, and they cannot see this header. Keep the two numbers
+  // from drifting apart.
+  static_assert(kObjectPoolLoadStoreMinInstructionCount - 1 ==
+                Instr::kMaxObjectPoolLoadPaddingInstructions);
+
   void PadLoadStore(std::function<void()> emit,
                     Register base,
                     int32_t offset,
diff --git a/runtime/vm/compiler/assembler/assembler_arm64_test.cc b/runtime/vm/compiler/assembler/assembler_arm64_test.cc
index c03720fa9f5..772c45dd964 100644
--- a/runtime/vm/compiler/assembler/assembler_arm64_test.cc
+++ b/runtime/vm/compiler/assembler/assembler_arm64_test.cc
@@ -10,6 +10,7 @@
 #include "vm/compiler/assembler/assembler_test.h"
 #include "vm/compiler/backend/locations.h"
 #include "vm/cpu.h"
+#include "vm/instructions.h"
 #include "vm/os.h"
 #include "vm/unit_test.h"
 #include "vm/virtual_memory.h"
@@ -123,6 +124,118 @@ ISOLATE_UNIT_TEST_CASE(Arm64PadLoadStoreOnlyPadsPoolAccesses) {
   EXPECT_EQ(static_cast<intptr_t>(1), assembler.CodeSize() / Instr::kInstrSize);
 }
 
+// Shorebird: emitting the padding and reading it back are one change, not two.
+// Every InstructionPattern reader in instructions_arm64.cc is handed a fixed
+// backward distance from a call site -- CallPattern uses
+// pc - 2 * Instr::kInstrSize -- which lands past the padding, not on the load.
+// So the decoders step back over it, and this is the other half of that.
+//
+// Routing the pool emitters through PadLoadStore without that step was a real
+// regression: gen_kernel's own AOT snapshot segfaulted on startup with
+// SEGV_ACCERR and no stack. Nothing in this file caught it -- it was found by
+// running a program at a scale hello.dart does not reach. This is the test that
+// would have.
+//
+// The assertion is a round trip against the unpadded emission rather than a
+// table of expected indices, so it cannot pass by agreeing with itself.
+ISOLATE_UNIT_TEST_CASE(Arm64PadLoadStoreRemainsDecodable) {
+  // Indices picked to reach all three arms of LoadWordFromPoolIndex: a plain
+  // ldr (padded by two NOPs), an add/ldr pair (padded by one), and the
+  // movz/movk/ldr form (already at the footprint, padded by none).
+  const intptr_t kIndices[] = {0, 1, 100, 4000, 4096, 300000};
+
+  for (intptr_t index : kIndices) {
+    Register bare_reg = kNoRegister;
+    intptr_t bare_index = -1;
+    intptr_t natural = 0;
+    {
+      compiler::ObjectPoolBuilder pool_builder;
+      compiler::Assembler bare(&pool_builder);
+      bare.set_constant_pool_allowed(true);
+      bare.LoadWordFromPoolIndex(R3, index);
+      natural = bare.CodeSize() / Instr::kInstrSize;
+      dart::InstructionPattern::DecodeLoadWordFromPool(
+          reinterpret_cast<uword>(bare.CodeAddress(0)) + bare.CodeSize(),
+          &bare_reg, &bare_index);
+    }
+    EXPECT_EQ(R3, bare_reg);
+    EXPECT_EQ(index, bare_index);
+
+    // Now the same load with the gate open, which is what an AOT snapshot gets.
+    const bool saved = FLAG_precompiled_mode;
+    FLAG_precompiled_mode = true;
+    Register padded_reg = kNoRegister;
+    intptr_t padded_index = -1;
+    intptr_t footprint = 0;
+    {
+      compiler::ObjectPoolBuilder pool_builder;
+      compiler::Assembler padded(&pool_builder);
+      padded.set_constant_pool_allowed(true);
+      padded.LoadWordFromPoolIndex(R3, index);
+      footprint = padded.CodeSize() / Instr::kInstrSize;
+      // The end handed over is past the padding, exactly as a call site's fixed
+      // backward distance computes it.
+      dart::InstructionPattern::DecodeLoadWordFromPool(
+          reinterpret_cast<uword>(padded.CodeAddress(0)) + padded.CodeSize(),
+          &padded_reg, &padded_index);
+    }
+    FLAG_precompiled_mode = saved;
+
+    EXPECT_EQ(compiler::Assembler::kObjectPoolLoadStoreMinInstructionCount,
+              footprint);
+    EXPECT_EQ(bare_reg, padded_reg);
+    EXPECT_EQ(bare_index, padded_index);
+    EXPECT(natural <=
+           compiler::Assembler::kObjectPoolLoadStoreMinInstructionCount);
+  }
+}
+
+// The double-word form has its own decoder, reached from ICCallPattern and from
+// both switchable call patterns, and its own fixed backward distance.
+ISOLATE_UNIT_TEST_CASE(Arm64PadLoadStoreDoubleWordRemainsDecodable) {
+  const intptr_t kIndices[] = {0, 2, 100, 4000, 4096};
+
+  for (intptr_t index : kIndices) {
+    Register bare_lower = kNoRegister, bare_upper = kNoRegister;
+    intptr_t bare_index = -1;
+    {
+      compiler::ObjectPoolBuilder pool_builder;
+      compiler::Assembler bare(&pool_builder);
+      bare.set_constant_pool_allowed(true);
+      bare.LoadDoubleWordFromPoolIndex(R3, R4, index);
+      dart::InstructionPattern::DecodeLoadDoubleWordFromPool(
+          reinterpret_cast<uword>(bare.CodeAddress(0)) + bare.CodeSize(),
+          &bare_lower, &bare_upper, &bare_index);
+    }
+    EXPECT_EQ(R3, bare_lower);
+    EXPECT_EQ(R4, bare_upper);
+    EXPECT_EQ(index, bare_index);
+
+    const bool saved = FLAG_precompiled_mode;
+    FLAG_precompiled_mode = true;
+    Register padded_lower = kNoRegister, padded_upper = kNoRegister;
+    intptr_t padded_index = -1;
+    intptr_t footprint = 0;
+    {
+      compiler::ObjectPoolBuilder pool_builder;
+      compiler::Assembler padded(&pool_builder);
+      padded.set_constant_pool_allowed(true);
+      padded.LoadDoubleWordFromPoolIndex(R3, R4, index);
+      footprint = padded.CodeSize() / Instr::kInstrSize;
+      dart::InstructionPattern::DecodeLoadDoubleWordFromPool(
+          reinterpret_cast<uword>(padded.CodeAddress(0)) + padded.CodeSize(),
+          &padded_lower, &padded_upper, &padded_index);
+    }
+    FLAG_precompiled_mode = saved;
+
+    EXPECT_EQ(compiler::Assembler::kObjectPoolLoadStoreMinInstructionCount,
+              footprint);
+    EXPECT_EQ(bare_lower, padded_lower);
+    EXPECT_EQ(bare_upper, padded_upper);
+    EXPECT_EQ(bare_index, padded_index);
+  }
+}
+
 ASSEMBLER_TEST_GENERATE(Simple, assembler) {
   __ add(R0, ZR, Operand(ZR));
   __ add(R0, R0, Operand(42));
