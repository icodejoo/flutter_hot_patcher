+    js.PrintProperty("subgraph_hash", subgraph_hashes[ci].c_str());
+    // op_subgraph_hash is still DELIBERATELY ABSENT, and the reason is now
+    // narrow rather than "the walk is unsolved". Its routing is known -- the
