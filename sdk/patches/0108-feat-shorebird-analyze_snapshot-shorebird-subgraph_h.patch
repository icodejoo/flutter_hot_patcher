+    // consumer cannot tell which.
     //
     // Omitting beats emitting a wrong value here, and the reason is a specific
     // consumer rather than taste. tools/linker.py matches patch functions to
@@ -1426,14 +1597,7 @@ void Dart_DumpSnapshotInformationShorebirdAsJson(
     // parameter, so pointing it at this one would have produced a quietly
     // degraded patch with no error anywhere. A missing key raises KeyError on
     // the first function instead.
-    //
-    // ⚠️ This is a deliberate divergence from their schema, which does carry
-    // both keys. Rule 3 asks us to reproduce their interface so our output can
-    // be checked against theirs; emitting a field whose value we know to be
-    // wrong imitates the shape while breaking the contract, and buys a
-    // fidelity nothing can observe at the price of a silent failure
-    // downstream. Restore the keys when the walk is implemented, not before.
-    
+
     js.OpenArray("self_pp");
     for (intptr_t slot : facts.pool_indices) js.PrintValue64(slot);
     js.CloseArray();
