 // Collect PP slot indices used by a function.
+// Shorebird's self_hash. The algorithm is reconstructed rather than guessed --
+// see SUBGRAPH_HASHER_RECON.md in the research tree for how each rule was
+// established and what the evidence was.
+//
+// It is SHA-1 over a stream of entries, not over the instruction bytes. Each
+// entry is two little-endian int32s, a kind and a value, and the value is
+// deliberately lossy: pool and field references carry an ordinal within the
+// function rather than the real index, which is what lets the hash survive
+// relinking, and a local branch carries a constant.
+//
+// ⚠️ Reproduces 1185 of Shorebird's own 1380 functions exactly. The remaining
+// 195 need the callee walk simulated, because the ordinal counters are shared
+// across it -- so this is a faithful implementation of a partly-solved
+// algorithm, not a finished one. Do not read a matching hash as proof that two
+// builds agree; read a differing one as proof that they do not.
+enum ShorebirdEntryKind {
+  kEntryCodeName = 0,
+  kEntryOffsetFromPayloadStart = 1,
+  kEntryObjectPoolLoadIndex = 2,
+  kEntryDispatchTableCall = 3,
+  kEntryExternalBranchTargetIndex = 4,
+  kEntryLocalBranch = 5,
+  kEntryFieldTableLoadIndex = 6,
+  kEntryRawInstructionBits = 7,
+  kEntryIndirectStaticCall = 8,
+};
+
+static constexpr uint32_t kArm64Nop = 0xD503201F;
+static constexpr uint32_t kPPRegister = 27;
+static constexpr uint32_t kTHRRegister = 26;
+static constexpr uint32_t kDispatchTableRegister = 21;
+
+// (base, dest, byte offset) for an unsigned-offset load or store.
+static bool DecodeLoadStore(uint32_t w, uint32_t* base, uint32_t* dest,
+                            uint32_t* offset) {
+  if ((w & 0x3B000000) != 0x39000000) return false;
+  *base = (w >> 5) & 0x1F;
+  *dest = w & 0x1F;
+  *offset = ((w >> 10) & 0xFFF) << (w >> 30);
+  return true;
+}
+
+// ldar / stlr, which the field table path also reaches through.
+static bool DecodeAcquireRelease(uint32_t w, uint32_t* base, uint32_t* dest) {
+  const uint32_t masked = w & 0x3FDFFC00;
+  if (masked != 0x08DFFC00 && masked != 0x089FFC00) return false;
+  *base = (w >> 5) & 0x1F;
+  *dest = w & 0x1F;
+  return true;
+}
+
+// 64-bit `add xD, xN, #imm{, lsl 12}`.
+//
+// ⚠️ The mask is 0xFF800000, not 0x7F800000. Masking bit 31 away makes this
+// never match, and a matcher that cannot fire reports the same result as a
+// refuted hypothesis.
+static bool DecodeAddImmediate(uint32_t w, uint32_t* base, uint32_t* dest,
+                               uint32_t* imm) {
+  if ((w & 0xFF800000) != 0x91000000) return false;
+  *base = (w >> 5) & 0x1F;
+  *dest = w & 0x1F;
+  *imm = (w >> 10) & 0xFFF;
+  if ((w >> 22) & 1) *imm <<= 12;
+  return true;
+}
+
+// ldp / stp with a signed-offset immediate.
+static bool DecodePair(uint32_t w, uint32_t* base, uint32_t* offset) {
+  if ((w & 0x3A000000) != 0x28000000) return false;
+  *base = (w >> 5) & 0x1F;
+  *offset = ((w >> 15) & 0x7F) * 8;
+  return true;
+}
+
+// Branch displacement in instructions, for the forms that carry one.
+static bool DecodeBranchDelta(uint32_t w, int32_t* delta) {
+  if ((w & 0x7C000000) == 0x14000000) {           // b / bl
+    uint32_t off = w & 0x03FFFFFF;
+    *delta = (off >= (1u << 25)) ? static_cast<int32_t>(off) - (1 << 26)
+                                 : static_cast<int32_t>(off);
+    return true;
+  }
+  if ((w & 0xFF000010) == 0x54000000 ||           // b.cond
+      (w & 0x7E000000) == 0x34000000) {           // cbz / cbnz
+    uint32_t off = (w >> 5) & 0x7FFFF;
+    *delta = (off >= (1u << 18)) ? static_cast<int32_t>(off) - (1 << 19)
+                                 : static_cast<int32_t>(off);
+    return true;
+  }
+  if ((w & 0x7E000000) == 0x36000000) {           // tbz / tbnz
+    uint32_t off = (w >> 5) & 0x3FFF;
+    *delta = (off >= (1u << 13)) ? static_cast<int32_t>(off) - (1 << 14)
+                                 : static_cast<int32_t>(off);
+    return true;
+  }
+  return false;
+}
+
+static intptr_t Ordinal(std::map<intptr_t, intptr_t>* seen, intptr_t key) {
+  auto it = seen->find(key);
+  if (it != seen->end()) return it->second;
+  const intptr_t next = static_cast<intptr_t>(seen->size());
+  (*seen)[key] = next;
+  return next;
+}
+
+std::string ShorebirdSelfHash(const uint8_t* code, intptr_t size) {
+  std::vector<uint8_t> stream;
+  std::map<intptr_t, intptr_t> pool, external, field;
+
+  auto emit = [&](int32_t kind, uint32_t value) {
+    for (int i = 0; i < 4; i++) stream.push_back((kind >> (i * 8)) & 0xFF);
+    for (int i = 0; i < 4; i++) stream.push_back((value >> (i * 8)) & 0xFF);
+  };
+
+  const intptr_t words = size / 4;
+  auto word_at = [&](intptr_t i) {
+    uint32_t w;
+    memcpy(&w, code + i * 4, 4);
+    return w;
+  };
+
+
+  emit(kEntryOffsetFromPayloadStart, 0);
+
+  intptr_t i = 0;
+  while (i < words) {
+    const uint32_t w = word_at(i);
+    uint32_t base, dest, offset, imm;
+
+    // A pool access with a large displacement, the PrepareLargeOffset shape.
+    if (DecodeAddImmediate(w, &base, &dest, &imm) && base == kPPRegister &&
+        i + 1 < words) {
+      uint32_t total = imm, consumed = 2;
+      uint32_t b2, d2, i2;
+      if (DecodeAddImmediate(word_at(i + 1), &b2, &d2, &i2) && b2 == dest &&
+          d2 == dest && i + 2 < words) {
+        total += i2;
+        consumed = 3;
+      }
+      const uint32_t tail = word_at(i + consumed - 1);
+      uint32_t tb, td, to;
+      bool ok = DecodeLoadStore(tail, &tb, &td, &to) && tb == dest;
+      if (!ok && DecodePair(tail, &tb, &to)) ok = (tb == dest);
+      if (ok) {
+        emit(kEntryObjectPoolLoadIndex,
+             Ordinal(&pool, (total + to - 16) / 8));
+        i += consumed;
+        while (i < words && word_at(i) == kArm64Nop) i++;
+        continue;
+      }
+    }
+
+    if (DecodePair(w, &base, &offset) && base == kPPRegister) {
+      emit(kEntryObjectPoolLoadIndex, Ordinal(&pool, (offset - 16) / 8));
+      i++;
+      while (i < words && word_at(i) == kArm64Nop) i++;
+      continue;
+    }
+
+    if (DecodeLoadStore(w, &base, &dest, &offset)) {
+      if (base == kPPRegister) {
+        emit(kEntryObjectPoolLoadIndex, Ordinal(&pool, (offset - 16) / 8));
+        // The load owns its whole padded footprint; the NOPs after it are not
+        // entries of their own.
+        i++;
+        while (i < words && word_at(i) == kArm64Nop) i++;
+        continue;
+      }
+      if (base == kTHRRegister && i + 1 < words) {
+        uint32_t nb, nd, no = 0;
+        if ((DecodeLoadStore(word_at(i + 1), &nb, &nd, &no) ||
+             DecodeAcquireRelease(word_at(i + 1), &nb, &nd)) &&
+            nb == dest) {
+          emit(kEntryFieldTableLoadIndex, Ordinal(&field, no / 8));
+          i += 2;
+          continue;
+        }
+        uint32_t ab, ad, ai;
+        if (i + 2 < words && DecodeAddImmediate(word_at(i + 1), &ab, &ad, &ai) &&
+            ab == dest) {
+          uint32_t tb, td, to = 0;
+          if ((DecodeLoadStore(word_at(i + 2), &tb, &td, &to) ||
+               DecodeAcquireRelease(word_at(i + 2), &tb, &td)) &&
+              tb == ad) {
+            emit(kEntryFieldTableLoadIndex, Ordinal(&field, (ai + to) / 8));
+            i += 3;
+            continue;
+          }
+        }
+      }
+    }
+
+    // Dispatch table call: <compute cid> ; ldr xN,[x21,xM,lsl 3] ; blr xN.
+    if (i + 2 < words) {
+      const uint32_t table = word_at(i + 1), call = word_at(i + 2);
+      if ((table & 0xFFE0FC00) == 0xF8607800 &&
+          ((table >> 5) & 0x1F) == kDispatchTableRegister &&
+          (call & 0xFFFFFC1F) == 0xD63F0000 &&
+          ((call >> 5) & 0x1F) == (table & 0x1F)) {
+        emit(kEntryDispatchTableCall, 1);
+        i += 3;
+        continue;
+      }
+    }
+
+    int32_t delta;
+    if (DecodeBranchDelta(w, &delta)) {
+      const int64_t target = i * 4 + static_cast<int64_t>(delta) * 4;
+      if (target >= 0 && target < size) {
+        emit(kEntryLocalBranch, 1);
+      } else if ((w & 0x7C000000) == 0x14000000) {
+        emit(kEntryExternalBranchTargetIndex,
+             Ordinal(&external, static_cast<intptr_t>(target)));
+      } else {
+        emit(kEntryRawInstructionBits, w);
+      }
+      i++;
+      continue;
+    }
+
+    emit(kEntryRawInstructionBits, w);
+    i++;
+  }
+
+  return Sha1HexOf(stream.data(), stream.size());
+}
+
 std::vector<intptr_t> GetSelfPPIndices(const uint8_t* code, intptr_t size) {
   std::vector<intptr_t> slots;
   for (intptr_t i = 0; i + 4 <= size; i += 4) {
@@ -972,10 +1207,14 @@ void Dart_DumpSnapshotInformationShorebirdAsJson(
     js.PrintProperty64("size", entry.size);
     
     // Compute SHA-1 hash of instruction bytes
-    std::string hash = Sha1HexOf(entry.payload, entry.size);
-    js.PrintProperty("self_hash", hash.c_str());
-    js.PrintProperty("subgraph_hash", hash.c_str());   // simplified: same as self_hash
-    js.PrintProperty("op_subgraph_hash", hash.c_str()); // simplified: same
+    const std::string self_hash =
+        ShorebirdSelfHash(entry.payload, entry.size);
+    js.PrintProperty("self_hash", self_hash.c_str());
+    // ⚠️ NOT the real subgraph hashes. Those accumulate over the callee walk,
+    // which is unsolved -- see SUBGRAPH_HASHER_RECON.md. The keys are kept so
+    // the schema matches theirs; the values are self_hash and are wrong.
+    js.PrintProperty("subgraph_hash", self_hash.c_str());
+    js.PrintProperty("op_subgraph_hash", self_hash.c_str());
     
     // PP slot indices
     std::vector<intptr_t> pp_slots = GetSelfPPIndices(entry.payload, entry.size);
