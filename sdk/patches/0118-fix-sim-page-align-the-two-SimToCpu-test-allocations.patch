From 3ad8e0b8255310a1a22e98bf5741a60f4e9a6bbe Mon Sep 17 00:00:00 2001
From: cruz <cruz@tbu.net>
Date: Thu, 27 Aug 2026 18:49:21 +0800
Subject: [PATCH 118/206] fix(sim): page-align the two SimToCpu test
 allocations

Both asked VirtualMemory::Allocate for 4096 bytes. Allocate asserts the size
is a multiple of VirtualMemory::PageSize(), which is 16384 on macOS/arm64, so
ShorebirdSimToCpu_BasicCall and ShorebirdSimToCpu_RunDartOnCpuHypercall both
died on that assert before executing a single simulated instruction.

Neither had ever been run. They sit behind
  #if defined(TARGET_ARCH_ARM64) && defined(DART_INCLUDE_SIMULATOR)
so the Release build our verification script uses compiles them out, and a test
that is never selected does not report SKIPPED -- it is simply absent. The
companion change on the research side adds a check that runs these nine in a
dart_force_simulator build so this cannot recur.

Measured after the fix: all nine simulator-only tests pass, 1.3 s total.

diff --git a/runtime/vm/shorebird_sim_to_cpu_test.cc b/runtime/vm/shorebird_sim_to_cpu_test.cc
index d0fc25fbfc0..d87dd1529a8 100644
--- a/runtime/vm/shorebird_sim_to_cpu_test.cc
+++ b/runtime/vm/shorebird_sim_to_cpu_test.cc
@@ -39,8 +39,13 @@ ISOLATE_UNIT_TEST_CASE(ShorebirdSimToCpu_BasicCall) {
   sim->SetSimToCpuEnabled(true);   // threshold=0: fire immediately (no startup window)
 
   // Build arm64 code: movz x0,#21; [load target into x3]; blr x3; ret
-  std::unique_ptr<VirtualMemory> mem(
-      VirtualMemory::Allocate(4096, false, false, "a2test"));
+  // One page, asked for by name. VirtualMemory::Allocate asserts the size is
+  // a multiple of VirtualMemory::PageSize(), and on macOS/arm64 that is 16384,
+  // not 4096 -- a literal 4096 here aborted the test on the assert before it
+  // could execute a single instruction. It went unnoticed because this file is
+  // only compiled into a simulator build, and no automated run ever built one.
+  std::unique_ptr<VirtualMemory> mem(VirtualMemory::Allocate(
+      VirtualMemory::PageSize(), false, false, "a2test"));
   ASSERT(mem != nullptr);
   uint32_t* code = reinterpret_cast<uint32_t*>(mem->address());
   const uint64_t addr = static_cast<uint64_t>(target);
@@ -68,8 +73,10 @@ ISOLATE_UNIT_TEST_CASE(ShorebirdSimToCpu_RunDartOnCpuHypercall) {
   Simulator* sim = Simulator::Current();
   const uword target = reinterpret_cast<uword>(&ShorebirdTestNativeDoubler);
 
-  std::unique_ptr<VirtualMemory> mem(
-      VirtualMemory::Allocate(4096, false, false, "hypercalltest"));
+  // See the note in ShorebirdSimToCpu_BasicCall: the size must be a multiple of
+  // VirtualMemory::PageSize(), which is 16384 here.
+  std::unique_ptr<VirtualMemory> mem(VirtualMemory::Allocate(
+      VirtualMemory::PageSize(), false, false, "hypercalltest"));
   ASSERT(mem != nullptr);
   uint32_t* code = reinterpret_cast<uint32_t*>(mem->address());
   const uint64_t addr = static_cast<uint64_t>(target);
