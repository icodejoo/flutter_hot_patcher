From 4944e8b81126b3cf4a22254af82972ee5db8df9c Mon Sep 17 00:00:00 2001
From: cruz <cruz@tbu.net>
Date: Thu, 27 Aug 2026 14:09:19 +0800
Subject: [PATCH 113/206] fix(shorebird): close the PairOffset counter gap,
 index 62..510

LoadDoubleWordFromPoolIndex and PrepareLargeOffset disagree for offsets
512..4095 (index 62..510): the emitter's second rung accepts any add-
immediate (CanHold(full_offset)), while PrepareLargeOffset's second rung
additionally requires CanHoldOffset(lower12, PairOffset), which fails
above 504. The old path fell through to LoadImmediate + add(TMP2,PP) +
ldp = 3; the emitter emits 2.

InstructionCountForLoadStoreFromOffset now has a dedicated branch for
kEightBytes + PairOffset that mirrors the emitter's five-rung ladder.
PadLoadStore's RELEASE_ASSERT is now unconditional.

Verified: release build passes the assert, negative control (rung-2
return 99) aborts ObjectPoolEditor_DetectsEveryKind on AOT compile via
PadLoadStore's RELEASE_ASSERT and fails ObjectPoolEditor_CountFollows-
PrepareLargeOffset with expected <2> but was <99>, restoring the
original value removes both failures. verify_reproduction.sh 28/0.

Co-Authored-By: Claude <noreply@anthropic.com>

diff --git a/runtime/vm/compiler/assembler/assembler_arm64.cc b/runtime/vm/compiler/assembler/assembler_arm64.cc
index ac6f4e3724e..e4bb7bf8a8c 100644
--- a/runtime/vm/compiler/assembler/assembler_arm64.cc
+++ b/runtime/vm/compiler/assembler/assembler_arm64.cc
@@ -1136,6 +1136,33 @@ intptr_t Assembler::InstructionCountForLoadStoreFromOffset(
     }
     return 3;  // movz ; movk ; ldr/str Rt, [PP, TMP]
   }
+  if (sz == kEightBytes && addr_type == Address::AddressType::PairOffset) {
+    // LoadDoubleWordFromPoolIndex has its own five-rung ladder that differs from
+    // PrepareLargeOffset for offsets in the range 512..4095 (index 62..510):
+    // its second rung accepts any add-immediate (CanHold(full_offset)), while
+    // PrepareLargeOffset's second rung additionally requires
+    // CanHoldOffset(lower12, PairOffset), which fails above 504. The old path
+    // fell through to LoadImmediate + add(TMP2, TMP2, PP) + ldp = 3; the
+    // emitter emits 2. This branch mirrors the emitter's five-rung ladder.
+    const uint32_t uoffset = static_cast<uint32_t>(offset);
+    const uint32_t upper20 = uoffset & 0xfffff000;
+    const uint32_t lower12 = uoffset & 0x00000fff;
+    Operand op;
+    if (Address::CanHoldOffset(offset, addr_type, sz)) {
+      return 1;  // ldp Rt1, Rt2, [PP, #imm7]
+    }
+    if (Operand::CanHold(uoffset, kXRegSizeInBits, &op) == Operand::Immediate) {
+      return 2;  // add TMP, PP, #offset ; ldp [TMP, #0]
+    }
+    if (Operand::CanHold(upper20, kXRegSizeInBits, &op) == Operand::Immediate &&
+        Address::CanHoldOffset(static_cast<int32_t>(lower12), addr_type, sz)) {
+      return 2;  // add TMP, PP, #upper20 ; ldp [TMP, #lower12]
+    }
+    if (Utils::IsUint(24, uoffset)) {
+      return 3;  // add TMP, PP, hi12 ; add TMP, TMP, lo12 ; ldp [TMP, #0]
+    }
+    return 4;  // movz ; movk ; add TMP, TMP, PP ; ldp [TMP, #0]
+  }
   ASSERT(ThreadState::Current() != nullptr);
   compiler::ObjectPoolBuilder pool_builder;
   Assembler assembler(&pool_builder);
@@ -1172,23 +1199,18 @@ intptr_t Assembler::InstructionCountForLoadStoreFromOffset(
 // property was never once tested. (Their release build likewise still contains
 // the two calls to the counter, which an ASSERT would have compiled out.)
 //
-// ⚠️ The exception, still open, is LoadDoubleWordFromPoolIndex, the PairOffset
-// kind. Its second rung takes `add TMP, PP, #offset` for any immediate an add
-// can hold; PrepareLargeOffset, which the counter still measures for that kind,
-// additionally insists the low twelve bits be a valid imm7 pair offset. So the
-// two disagree from the first pool index whose offset exceeds the imm7 range
-// until the offset passes 4096 -- index 62 upwards, which is not a corner:
-// flow_graph_compiler_arm64.cc emits this for every AOT instance call, and
-// making the check below unconditional aborts gen_snapshot on hello.dart.
+// The PairOffset (LoadDoubleWordFromPoolIndex) counter gap is now closed.
+// InstructionCountForLoadStoreFromOffset has a dedicated branch for
+// kEightBytes + PairOffset that mirrors the emitter's five-rung ladder exactly.
+// The RELEASE_ASSERT below is therefore unconditional.
 //
-// That abort is what makes the carve-out a finding rather than a convenience:
-// the disagreement is reachable, so today the editor declines those sites. But
-// which of the two ladders their counter follows is undetermined, and their
-// emitter here is upstream code we have not diverged from, so guessing would be
-// free invention. Nothing is changed to suit either side, and the release check
-// is applied only where the ladder is known. ObjectPoolEditor_CountFollows-
-// PrepareLargeOffset pins the case, and ObjectPoolEditor::Edit's own self-check
-// declines such a site instead of corrupting it.
+// Previously the counter measured PrepareLargeOffset for that kind, which
+// disagreed with the emitter from index 62 (offset 512) to index 510
+// (offset 4088): the emitter's second rung accepts any add-immediate
+// (CanHold(full_offset)), while PrepareLargeOffset's second rung additionally
+// requires CanHoldOffset(lower12, PairOffset), which fails above 504.
+// ObjectPoolEditor_CountFollowsPrepareLargeOffset now asserts agreement at
+// every rung, and ObjectPoolEditor::Edit accepts those previously declined sites.
 //
 // ⚠️ Re-entrant, and the guard below is not defensive tidiness. AssembleReplace-
 // ment wraps this around LoadWordFromPoolIndex, StoreWordToPoolIndex and
@@ -1226,10 +1248,8 @@ void Assembler::PadLoadStore(std::function<void()> emit,
   emit();
   in_pad_load_store_ = false;
   const intptr_t emitted = (CodeSize() - start) / Instr::kInstrSize;
-  if (addr_type != Address::AddressType::PairOffset) {
-    RELEASE_ASSERT(emitted == InstructionCountForLoadStoreFromOffset(
-                                  offset, sz, addr_type));
-  }
+  RELEASE_ASSERT(emitted == InstructionCountForLoadStoreFromOffset(
+      offset, sz, addr_type));
   if (base != PP) return;
   for (intptr_t i = emitted; i < kObjectPoolLoadStoreMinInstructionCount; i++) {
     nop();
