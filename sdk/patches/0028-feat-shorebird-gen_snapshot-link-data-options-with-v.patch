+// Loads any --base_*/--patch_* link data into the ShorebirdLinker singleton.
+//
+// Ordering follows their _main (LINKER_RECON.md section 2): CT (base+patch),
+// then FT (base), then DT (base), all before compilation begins.
+//
+// Every read passes `ok` and treats false as fatal. Without that, a mistyped
+// filename or an unreadable file yields an empty link table and the compile
+// still exits 0 -- indistinguishable from having loaded the data correctly.
+static void InitializeShorebirdLinkData() {
+  // CT is a pair. Their binary carries the matching error string, and the XOR
+  // catches either half being supplied alone.
+  if ((base_ct_link_data_filename == nullptr) !=
+      (patch_ct_link_data_filename == nullptr)) {
+    Syslog::PrintErr(
+        "Error: --base_ct_link_data must be used with"
+        " --patch_ct_link_data.\n\n");
+    exit(kErrorExitCode);
+  }
+
+  if (base_ct_link_data_filename != nullptr) {
+    bool base_ok = false;
+    bool patch_ok = false;
+    auto base =
+        dart::ReadClassTableLinkInfo(base_ct_link_data_filename, &base_ok);
+    auto patch =
+        dart::ReadClassTableLinkInfo(patch_ct_link_data_filename, &patch_ok);
+    if (!base_ok) {
+      Syslog::PrintErr("Error: could not read --base_ct_link_data=%s\n\n",
+                       base_ct_link_data_filename);
+      exit(kErrorExitCode);
+    }
+    if (!patch_ok) {
+      Syslog::PrintErr("Error: could not read --patch_ct_link_data=%s\n\n",
+                       patch_ct_link_data_filename);
+      exit(kErrorExitCode);
+    }
+    dart::ShorebirdLinker::shared()->InitializeWithClassTableLinkInfo(
+        std::move(base), std::move(patch));
+  }
+
+  if (base_ft_link_data_filename != nullptr) {
+    bool ok = false;
+    auto base = dart::ReadFieldTableLinkInfo(base_ft_link_data_filename, &ok);
+    if (!ok) {
+      Syslog::PrintErr("Error: could not read --base_ft_link_data=%s\n\n",
+                       base_ft_link_data_filename);
+      exit(kErrorExitCode);
+    }
+    dart::ShorebirdLinker::shared()->InitializeWithFieldTableLinkInfo(
+        std::move(base));
+  }
+
+  if (base_dt_link_data_filename != nullptr) {
+    bool ok = false;
+    auto base =
+        dart::ReadDispatchTableLinkInfo(base_dt_link_data_filename, &ok);
+    if (!ok) {
+      Syslog::PrintErr("Error: could not read --base_dt_link_data=%s\n\n",
+                       base_dt_link_data_filename);
+      exit(kErrorExitCode);
+    }
+    dart::ShorebirdLinker::shared()->InitializeWithDispatchTableLinkInfo(
+        std::move(base));
+  }
+}
+
 static void CreateAndWritePrecompiledSnapshot() {
   ASSERT(IsSnapshottingForPrecompilation());
 
+  // Before any compilation, and before the kVMAOTAssembly early return below,
+  // so both snapshot paths see the same linker state.
+  InitializeShorebirdLinkData();
+
   if (snapshot_kind == kVMAOTAssembly) {
     File* file = OpenFile(assembly_filename);
     RefCntReleaseScope<File> rs(file);
