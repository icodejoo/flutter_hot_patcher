+// ---------------------------------------------------------------------------
+// File-path reader tests, and the singleton actually holding what was read.
+//
+// WriteToFile needs Dart's file open/write/close callbacks, which no
+// VM_UNIT_TEST_CASE registers, so these write bytes with plain stdio. The
+// ENCODER is still the real one (WriteToStream) -- only the file write is done
+// directly, so the wire format is never re-implemented here.
+// ---------------------------------------------------------------------------
+
+namespace {
+
+// Per-process temp path, so concurrent runs cannot collide.
+void MakeTempPath(char* out, intptr_t out_len, const char* tag) {
+  Utils::SNPrint(out, out_len, "/tmp/fhp_linker_%s_%" Pd ".bin", tag,
+                 OS::ProcessId());
+}
+
+bool WriteBytesToPath(const char* path, const void* data, intptr_t len) {
+  FILE* f = fopen(path, "wb");
+  if (f == nullptr) return false;
+  const bool wrote =
+      (len == 0) ||
+      (fwrite(data, 1, static_cast<size_t>(len), f) ==
+       static_cast<size_t>(len));
+  fclose(f);
+  return wrote;
+}
+
+}  // namespace
+
+// POSITIVE half of the observable assertion: after reading a real file, the
+// singleton holds exactly what that file contained. The null->populated
+// transition is checked in one test so it carries its own baseline.
+//
+// NOTE: this mutates the process-wide singleton, so it must run in its own
+// process -- which is how this harness is driven (one named test per
+// invocation). It would otherwise perturb ShorebirdLinker_FreshHasNullSlots.
+// No test-only Reset() is added: their class has no such method, and inventing
+// one to make tests convenient is the divergence this reproduction avoids.
+VM_UNIT_TEST_CASE(ShorebirdLinker_SingletonHoldsWhatTheFileContained) {
+  std::vector<ClassInfo> classes = {
+      ClassInfo{1, "String", "12345671"},
+      ClassInfo{7, "Function", "9096549271"},
+      ClassInfo{42, "Function", "9096549272"},
+  };
+  const intptr_t num_cids = 500;
+  ClassTableLinkInfo original(classes, num_cids);
+
+  MallocWriteStream ws(1 * MB);
+  original.WriteToStream(&ws);  // the real encoder
+
+  char path[256];
+  MakeTempPath(path, sizeof(path), "ct");
+  EXPECT(WriteBytesToPath(path, ws.buffer(), ws.bytes_written()));
+
+  // The file-path reader, through a real file.
+  bool ok = false;
+  std::unique_ptr<ClassTableLinkInfo> parsed =
+      ReadClassTableLinkInfo(path, &ok);
+  EXPECT(ok);
+  EXPECT_EQ(classes.size(), parsed->classes().size());
+  for (intptr_t i = 0; i < static_cast<intptr_t>(classes.size()); i++) {
+    EXPECT_EQ(classes[i].cid, parsed->classes()[i].cid);
+    EXPECT_STREQ(classes[i].name.c_str(), parsed->classes()[i].name.c_str());
+    EXPECT_STREQ(classes[i].hash.c_str(), parsed->classes()[i].hash.c_str());
+  }
+  EXPECT_EQ(num_cids, parsed->num_cids());
+
+  // The singleton: null before, holding the file's contents after.
+  ShorebirdLinker* linker = ShorebirdLinker::shared();
+  EXPECT(linker->base_class_table() == nullptr);
+  EXPECT(linker->patch_class_table() == nullptr);
+
+  bool base_ok = false;
+  bool patch_ok = false;
+  linker->InitializeWithClassTableLinkInfo(
+      ReadClassTableLinkInfo(path, &base_ok),
+      ReadClassTableLinkInfo(path, &patch_ok));
+  EXPECT(base_ok);
+  EXPECT(patch_ok);
+
+  EXPECT(linker->base_class_table() != nullptr);
+  EXPECT(linker->patch_class_table() != nullptr);
+  EXPECT_EQ(classes.size(), linker->base_class_table()->classes().size());
+  EXPECT_EQ(num_cids, linker->base_class_table()->num_cids());
+  EXPECT_STREQ("String", linker->base_class_table()->classes()[0].name.c_str());
+  EXPECT_STREQ("9096549272",
+               linker->base_class_table()->classes()[2].hash.c_str());
+  EXPECT_EQ(classes.size(), linker->patch_class_table()->classes().size());
+
+  remove(path);
+}
+
+// NEGATIVE half: a bogus path must not look like a successful parse. Without the
+// `ok` signal this is indistinguishable from correctly reading an empty table --
+// the hole that made the original Task 4 verification vacuous.
+VM_UNIT_TEST_CASE(ReadClassTableLinkInfo_BogusPathIsNotSilentSuccess) {
+  bool ok = true;
+  std::unique_ptr<ClassTableLinkInfo> parsed =
+      ReadClassTableLinkInfo("/nonexistent/fhp/definitely_not_here.bin", &ok);
+  EXPECT(!ok);
+  EXPECT(parsed != nullptr);
+  EXPECT_EQ(static_cast<size_t>(0), parsed->classes().size());
+}
+
+// A zero-length file is rejected: no valid encoding is zero bytes, and decoding
+// one would read past the allocation with ReadStream's ASSERTs compiled out.
+VM_UNIT_TEST_CASE(ReadClassTableLinkInfo_EmptyFileIsRejected) {
+  char path[256];
+  MakeTempPath(path, sizeof(path), "empty");
+  EXPECT(WriteBytesToPath(path, "", 0));
+
+  bool ok = true;
+  std::unique_ptr<ClassTableLinkInfo> parsed =
+      ReadClassTableLinkInfo(path, &ok);
+  EXPECT(!ok);
+  EXPECT_EQ(static_cast<size_t>(0), parsed->classes().size());
+  remove(path);
+}
+
+// A truncated file must be rejected, not silently yield a short table: the
+// header count still says 3, but the entry bytes are not all present.
+VM_UNIT_TEST_CASE(ReadClassTableLinkInfo_TruncatedFileIsRejected) {
+  std::vector<ClassInfo> classes = {
+      ClassInfo{1, "String", "12345671"},
+      ClassInfo{7, "Function", "9096549271"},
+      ClassInfo{42, "Function", "9096549272"},
+  };
+  ClassTableLinkInfo original(classes, 500);
+
+  MallocWriteStream ws(1 * MB);
+  original.WriteToStream(&ws);
+
+  char path[256];
+  MakeTempPath(path, sizeof(path), "trunc");
+  EXPECT(WriteBytesToPath(path, ws.buffer(), ws.bytes_written() / 2));
+
+  bool ok = true;
+  std::unique_ptr<ClassTableLinkInfo> parsed =
+      ReadClassTableLinkInfo(path, &ok);
+  EXPECT(!ok);
+  remove(path);
+}
+
+// A corrupt count must not reach reserve(). These bytes decode to a varint far
+// larger than any 4-byte file could hold.
+VM_UNIT_TEST_CASE(ReadClassTableLinkInfo_AbsurdCountIsRejected) {
+  const uint8_t corrupt[] = {0x7F, 0x7F, 0x7F, 0x7F};
+  char path[256];
+  MakeTempPath(path, sizeof(path), "absurd");
+  EXPECT(WriteBytesToPath(path, corrupt, sizeof(corrupt)));
+
+  bool ok = true;
+  std::unique_ptr<ClassTableLinkInfo> parsed =
+      ReadClassTableLinkInfo(path, &ok);
+  EXPECT(!ok);
+  EXPECT_EQ(static_cast<size_t>(0), parsed->classes().size());
+  remove(path);
+}
+
 }  // namespace dart
