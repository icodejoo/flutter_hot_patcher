+// ReadStream's bounds checks are ASSERTs and compile out in Release and
+// Product, so a truncated varint at the end of a malformed file would otherwise
+// read until it happened to find a terminator -- unbounded, and measured at
+// 4831 bytes past the end on a 4-byte corrupt file before this was fixed.
+//
+// The decoder (ReadStream::Read, datastream.h) continues while the byte is
+// <= kMaxUnsignedDataPerByte (127) and stops on any byte >= 128, identically for
+// the signed and unsigned forms. So the fill byte MUST be >= 128. Zero-filling
+// is precisely wrong: 0x00 is a continuation byte and would invite the very
+// overrun this guards against. With 0xFF here, a varint starting at the last
+// logical byte terminates at most one byte into the slack, so any overread stays
+// inside our own allocation and PendingBytes() bottoms out at -1.
+constexpr uint8_t kVarintTerminator = 0xFF;
+constexpr intptr_t kReadSlack = 16;
+
+// The fewest bytes a single entry can occupy in any of the three formats: three
+// varints at one byte each. Used to reject a count that the remaining bytes
+// could not possibly hold, before it reaches reserve().
+constexpr intptr_t kMinBytesPerEntry = 3;
+
+// A (lo, hi) range pair is two varints, so at least two bytes.
+constexpr intptr_t kMinBytesPerRange = 2;
+
+// Reads a file entirely into a heap-allocated, zero-padded buffer. Returns true
+// and sets *buf/*size (the LOGICAL size, excluding slack) on success, false on
+// any error. Caller must free(*buf).
+//
+// An empty file is an error rather than a zero-length buffer: every one of these
+// formats begins with a count, so zero bytes cannot be a valid encoding.
 bool ReadFileIntoBuffer(const char* path, uint8_t** buf, intptr_t* size) {
   FILE* f = fopen(path, "rb");
   if (f == nullptr) {
@@ -103,7 +128,7 @@ bool ReadFileIntoBuffer(const char* path, uint8_t** buf, intptr_t* size) {
     return false;
   }
   rewind(f);
-  uint8_t* data = reinterpret_cast<uint8_t*>(malloc(len));
+  uint8_t* data = reinterpret_cast<uint8_t*>(malloc(len + kReadSlack));
   if (data == nullptr) {
     fclose(f);
     return false;
@@ -114,54 +139,92 @@ bool ReadFileIntoBuffer(const char* path, uint8_t** buf, intptr_t* size) {
     return false;
   }
   fclose(f);
+  memset(data + len, kVarintTerminator, kReadSlack);
   *buf = data;
   *size = static_cast<intptr_t>(len);
   return true;
 }
 
+bool AtEnd(ReadStream* stream) {
+  return stream->PendingBytes() <= 0;
+}
+
+// Reads one unsigned varint, refusing to start a read at the end of the buffer.
+bool TryReadUnsigned(ReadStream* stream, intptr_t* out) {
+  if (AtEnd(stream)) return false;
+  *out = stream->ReadUnsigned<intptr_t>();
+  return true;
+}
+
+// True only if `count` entries of at least `min_bytes_each` could fit in what
+// remains. This is the guard that stops a corrupt count from driving an
+// unbounded reserve() or a very long read loop.
+bool PlausibleCount(ReadStream* stream, intptr_t count, intptr_t min_bytes_each) {
+  if (count < 0) return false;
+  return count <= stream->PendingBytes() / min_bytes_each;
+}
+
 // str := len:u, char:s * len
 // Mirrors WriteString() in link_info.cc, which length-prefixes and then writes
 // each character with Write<int32_t> -- the signed varint form, so this must
-// read back with Read<int32_t> (kEndByteMarker), not ReadUnsigned.
-std::string ReadString(ReadStream* stream) {
-  const intptr_t len = stream->ReadUnsigned<intptr_t>();
-  std::string result;
-  result.reserve(static_cast<size_t>(len));
+// read back with Read<int32_t> (kEndByteMarker), not ReadUnsigned. Each
+// character occupies at least one byte, so a length exceeding the bytes
+// remaining is corrupt.
+bool TryReadString(ReadStream* stream, std::string* out) {
+  intptr_t len = 0;
+  if (!TryReadUnsigned(stream, &len)) return false;
+  if (len < 0 || len > stream->PendingBytes()) return false;
+  out->clear();
+  out->reserve(static_cast<size_t>(len));
   for (intptr_t i = 0; i < len; i++) {
-    const int32_t ch = stream->Read<int32_t>();
-    result.push_back(static_cast<char>(ch));
+    if (AtEnd(stream)) return false;
+    out->push_back(static_cast<char>(stream->Read<int32_t>()));
   }
-  return result;
+  return true;
 }
 
 }  // namespace
 
