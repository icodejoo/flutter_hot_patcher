+  // leaves no room for the ELF after the pad.
   static size_t ReadHeaderSize(const uint8_t* buffer, size_t size);
 
   // their :56. False for a table that pairs nothing -- a patch in which every
diff --git a/runtime/vm/shorebird/shorebird_test.cc b/runtime/vm/shorebird/shorebird_test.cc
index eadb2922093..a45cae4e3e9 100644
--- a/runtime/vm/shorebird/shorebird_test.cc
+++ b/runtime/vm/shorebird/shorebird_test.cc
@@ -19,15 +19,29 @@ namespace dart {
 
 // Builds a `.vmcode` header the way tools/linker.py does: a little-endian
 // uint32 count followed by that many (patch, base) uint32 pairs.
+// A well-formed `.vmcode` prefix: the table, the zero pad up to the snapshot
+// alignment, then the first bytes of where the ELF would be. The pad is not
+// decoration -- ReadHeaderSize returns the offset the loader uses for the ELF,
+// so a fixture without it cannot tell a correct reader from one that stops at
+// the end of the table. It could not, and did not: this helper used to emit
+// exactly 4 + 8n bytes, and two tests below asserted that unpadded number.
+static constexpr size_t kTestSnapshotAlignment = 16384;
+
 static std::vector<uint8_t> MakeHeader(
     const std::vector<std::pair<int32_t, int32_t>>& pairs) {
-  std::vector<uint8_t> bytes(4 + 8 * pairs.size());
+  const size_t table_size = 4 + 8 * pairs.size();
+  const size_t pages =
+      (table_size + kTestSnapshotAlignment - 1) / kTestSnapshotAlignment;
+  const size_t padded = (pages == 0 ? 1 : pages) * kTestSnapshotAlignment;
+  // Four bytes standing in for the ELF, so the ELF offset lands inside.
+  std::vector<uint8_t> bytes(padded + 4);
   const int32_t count = static_cast<int32_t>(pairs.size());
   memcpy(bytes.data(), &count, 4);
   for (size_t i = 0; i < pairs.size(); i++) {
     memcpy(bytes.data() + 4 + 8 * i, &pairs[i].first, 4);
     memcpy(bytes.data() + 8 + 8 * i, &pairs[i].second, 4);
   }
+  memcpy(bytes.data() + padded, "\x7f" "ELF", 4);
   return bytes;
 }
 
@@ -139,17 +153,38 @@ VM_UNIT_TEST_CASE(LinkOracle_RunTargetOffsetPredicates) {
   EXPECT(!on_sim.is_cpu());
 }
 
-VM_UNIT_TEST_CASE(LinkOracle_ReadHeaderSizeIsCountTimesEight) {
+VM_UNIT_TEST_CASE(LinkOracle_ReadHeaderSizeIsPageAlignedNotCountTimesEight) {
+  // The value is the ELF's file offset, and Dart_LoadELF rejects one that is
+  // not page-aligned. The old name and the old expectation (4 + 8n) were both
+  // wrong, and wrong in a way no unit test could see while the fixture was
+  // also unpadded -- it took a device reporting "patch 1 failed to launch".
   const std::vector<uint8_t> bytes = MakeHeader({{128, 52016}, {256, 52100}});
-  EXPECT_EQ(static_cast<size_t>(4 + 16),
+  EXPECT_EQ(kTestSnapshotAlignment,
             LinkOracle::ReadHeaderSize(bytes.data(), bytes.size()));
 
-  // An empty table is well-formed: every function changed.
+  // An empty table is well-formed: every function changed. Still one page.
   const std::vector<uint8_t> empty = MakeHeader({});
-  EXPECT_EQ(static_cast<size_t>(4),
+  EXPECT_EQ(kTestSnapshotAlignment,
             LinkOracle::ReadHeaderSize(empty.data(), empty.size()));
 }
 
+VM_UNIT_TEST_CASE(LinkOracle_ReadHeaderSizeSpansSeveralPages) {
+  // The regression that mattered. A real app's table is far bigger than one
+  // page -- the b5 test app links 8686 entries, so 4 + 8 * 8686 = 69492 and
+  // the ELF sits at 81920, five pages in. Reading it back as 69492 pointed the
+  // loader into the zero pad.
+  const size_t count = 8686;
+  std::vector<std::pair<int32_t, int32_t>> pairs;
+  pairs.reserve(count);
+  for (size_t i = 0; i < count; i++) {
+    pairs.emplace_back(static_cast<int32_t>(128 + 8 * i),
+                       static_cast<int32_t>(52016 + 8 * i));
+  }
+  const std::vector<uint8_t> bytes = MakeHeader(pairs);
+  EXPECT_EQ(static_cast<size_t>(81920),
+            LinkOracle::ReadHeaderSize(bytes.data(), bytes.size()));
+}
+
 VM_UNIT_TEST_CASE(LinkOracle_ReadHeaderSizeRejectsMalformed) {
   EXPECT_EQ(static_cast<size_t>(0), LinkOracle::ReadHeaderSize(nullptr, 100));
 
@@ -158,9 +193,11 @@ VM_UNIT_TEST_CASE(LinkOracle_ReadHeaderSizeRejectsMalformed) {
   EXPECT_EQ(static_cast<size_t>(0), LinkOracle::ReadHeaderSize(stub, 3));
 
   // Declares two entries but carries one. Reading this as a header would walk
-  // eight bytes past the buffer.
+  // eight bytes past the buffer. Cut back to the table, not off the end of the
+  // pad -- with a padded fixture, dropping trailing bytes leaves the declared
+  // table entirely inside the buffer and proves nothing.
   std::vector<uint8_t> truncated = MakeHeader({{128, 52016}, {256, 52100}});
-  truncated.resize(truncated.size() - 8);
+  truncated.resize(4 + 8);
   EXPECT_EQ(static_cast<size_t>(0),
             LinkOracle::ReadHeaderSize(truncated.data(), truncated.size()));
 
@@ -187,7 +224,7 @@ VM_UNIT_TEST_CASE(LinkOracle_FromBufferParsesTheTable) {
   std::unique_ptr<LinkOracle> oracle =
       LinkOracle::fromBuffer(bytes.data(), bytes.size());
   EXPECT(oracle != nullptr);
-  EXPECT_EQ(static_cast<size_t>(4 + 24), oracle->header_size());
+  EXPECT_EQ(kTestSnapshotAlignment, oracle->header_size());
   EXPECT_EQ(static_cast<intptr_t>(3), oracle->entry_count());
   EXPECT(oracle->HasPatch());
 }
