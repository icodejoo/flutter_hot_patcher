diff --git a/runtime/vm/shorebird.cc b/runtime/vm/shorebird.cc
index 01c8f82f79d..6e5d8cce673 100644
--- a/runtime/vm/shorebird.cc
+++ b/runtime/vm/shorebird.cc
@@ -40,6 +40,14 @@ static constexpr size_t kEntrySize = 8;
 // in a product build, so this is a plain `if`.
 static constexpr int64_t kMaxEntries = 1 << 24;
 
+// The pad the header comment above describes. It is not cosmetic: the value
+// ReadHeaderSize returns is handed straight to the loader as the ELF's file
+// offset, and Dart_LoadELF rejects an offset that is not page-aligned with
+// "File offset must be page-aligned." (measured on device 2026-08-14, recorded
+// in tools/linker.py). 16384 rather than 4096 because that is the iOS arm64
+// page size, and the writer rounds to it.
+static constexpr size_t kSnapshotAlignment = 16384;
+
 int32_t LinkOracle::int32_in(const uint8_t* buffer, size_t offset) {
   int32_t value;
   memcpy(&value, buffer + offset, sizeof(value));
@@ -57,10 +65,21 @@ size_t LinkOracle::ReadHeaderSize(const uint8_t* buffer, size_t size) {
   const int32_t count = int32_in(buffer, 0);
   if (count < 0 || count > kMaxEntries) return 0;
 
-  const size_t header_size =
+  const size_t table_size =
       kEntryCountSize + static_cast<size_t>(count) * kEntrySize;
   // The declared table has to fit in what we were actually handed.
-  if (header_size > size) return 0;
+  if (table_size > size) return 0;
+
+  // Round up to where the writer actually put the ELF. Reading this back
+  // unpadded was a real bug, not a hypothetical: it pointed the loader at the
+  // zero pad instead of the ELF, and the only symptom was the engine reporting
+  // "patch N failed to launch" while it silently fell back to the base. At
+  // least one page even when the table is empty, matching the writer.
+  const size_t pages =
+      (table_size + kSnapshotAlignment - 1) / kSnapshotAlignment;
+  const size_t header_size = (pages == 0 ? 1 : pages) * kSnapshotAlignment;
+  // And the ELF has to start inside the buffer, not past its end.
+  if (header_size >= size) return 0;
   return header_size;
 }
 
@@ -83,8 +102,14 @@ std::unique_ptr<LinkOracle> LinkOracle::fromBuffer(const uint8_t* buffer,
 }
 
 intptr_t LinkOracle::entry_count() const {
-  if (header_size_ < kEntryCountSize) return 0;
-  return static_cast<intptr_t>((header_size_ - kEntryCountSize) / kEntrySize);
+  // Read the stored count, do not derive it from header_size_. It used to be
+  // derivable because header_size_ was exactly 4 + 8n; now that it is rounded
+  // up to the page the ELF starts on, (header_size_ - 4) / 8 answers 2047 for
+  // every table that fits in one page.
+  if (backing_ == nullptr || header_size_ < kEntryCountSize) return 0;
+  const int32_t count = int32_at(0);
+  if (count < 0) return 0;
+  return static_cast<intptr_t>(count);
 }
 
 void LinkOracle::BuildCaches() {
diff --git a/runtime/vm/shorebird/shorebird.h b/runtime/vm/shorebird/shorebird.h
