+// Shorebird's --disassemble, which adds a "disassembly" key to every entry of
+// the --shorebird functions array. Everything about the shape below is measured
+// against their own binary on their own base.so rather than chosen:
+//
+//   * The value is an array of human-readable instruction strings with no
+//     addresses and no hex bytes -- just the mnemonic and operands, which is
+//     exactly DisassemblyFormatter's human_buffer.
+//   * One string per instruction, covering [payload, payload + size). Checked
+//     across all 1380 of their entries: instruction_count * 4 == size for every
+//     single one, and every entry has the key (none omitted, including size 0).
+//   * Branch targets are printed RELATIVE ("bl +100", not an absolute address).
+//     That is FLAG_disassemble_relative: disassembler_arm64.cc:423 switches to
+//     "%+" Pd64 under that flag and prints an address otherwise. Their output
+//     contains 0 branches rendered with an 0x address, so the flag is on.
+//
+// The flag is scoped to this dump rather than left set, because it is a global
+// the rest of the VM reads.
+class ShorebirdDisassemblyCollector : public DisassemblyFormatter {
+ public:
+  explicit ShorebirdDisassemblyCollector(std::vector<std::string>* out)
+      : out_(out) {}
+
+  void ConsumeInstruction(char* hex_buffer,
+                          intptr_t hex_size,
+                          char* human_buffer,
+                          intptr_t human_size,
+                          Object* object,
+                          uword pc) override {
+    out_->push_back(human_buffer);
+  }
+
+  // Disassemble() routes comments and "..." markers through Print(). Theirs
+  // emits neither -- the array is instructions only, one per 4 bytes -- so
+  // swallowing these is what reproduces their output, not laziness.
+  void Print(const char* format, ...) override {}
+
+ private:
+  std::vector<std::string>* out_;
+};
+
+static std::vector<std::string> ShorebirdDisassembleEntry(uword start,
+                                                          uword size) {
+  std::vector<std::string> lines;
+#if !defined(PRODUCT) || defined(FORCE_INCLUDE_DISASSEMBLER)
+  const bool saved_relative = FLAG_disassemble_relative;
+  FLAG_disassemble_relative = true;
+  ShorebirdDisassemblyCollector collector(&lines);
+  Disassembler::Disassemble(start, start + size, &collector);
+  FLAG_disassemble_relative = saved_relative;
+#endif
+  return lines;
+}
+
 void Dart_DumpSnapshotInformationShorebirdAsJson(
     const Dart_SnapshotAnalyzerInformation& info,
     char** out,
-    intptr_t* out_len) {
+    intptr_t* out_len,
+    bool include_disassembly) {
   Thread* thread = Thread::Current();
   IsolateGroup* ig = thread->isolate_group();
   DARTSCOPE(thread);
@@ -2141,6 +2197,19 @@ void Dart_DumpSnapshotInformationShorebirdAsJson(
     js.PrintProperty64("offset", entry.offset);
     js.PrintProperty64("size", entry.size);
 
+    // Between "size" and "subgraph_hash", which is where theirs puts it. The
+    // position is measured, not incidental: all 1380 of their entries have the
+    // first six keys in the order
+    //   name, index_in_entries, offset, size, disassembly, subgraph_hash
+    if (include_disassembly) {
+      js.OpenArray("disassembly");
+      for (const auto& line : ShorebirdDisassembleEntry(
+               reinterpret_cast<uword>(entry.payload), entry.size)) {
+        js.PrintValue(line.c_str());
+      }
+      js.CloseArray();
+    }
