diff --git a/runtime/vm/compiler/backend/flow_graph_compiler_arm64.cc b/runtime/vm/compiler/backend/flow_graph_compiler_arm64.cc
index 0f90cbc2b08..530b035c7c1 100644
--- a/runtime/vm/compiler/backend/flow_graph_compiler_arm64.cc
+++ b/runtime/vm/compiler/backend/flow_graph_compiler_arm64.cc
@@ -639,6 +639,47 @@ void FlowGraphCompiler::EmitDispatchTableCall(
   });
 }
 
+// Shorebird. Their sequence, from IndirectStaticCallInstr::EmitNativeCode at
+// 0x1002a3e28: load the table base out of Thread, scale dd_slot by the word
+// size, add, and call through the resulting address.
+//
+// ⚠️ Thread::indirect_static_call_table_offset() rather than their literal
+// 0x978. Their Shorebird block sits mid-Thread and ours is appended, so 0x978
+// would read an unrelated field here -- and the symptom would look like a
+// corrupt table rather than a wrong offset.
+void FlowGraphCompiler::EmitIndirectStaticCall(
+    intptr_t dd_slot,
+    const Function& function,
+    const Array& arguments_descriptor) {
+  ASSERT(CanCallDart());
+  ASSERT(dd_slot >= 0);
+  if (!arguments_descriptor.IsNull()) {
+    __ LoadObject(ARGS_DESC_REG, arguments_descriptor);
+  }
+  CLOBBERS_LR({
+    // dart::Thread rather than compiler::target::Thread: the offset table the
+    // target mirror reads from is generated and does not know about fields we
+    // added. The existing Shorebird stubs reach their Thread fields the same
+    // way -- see stub_code_compiler_arm64.cc's use of
+    // dart::Thread::simulator_execute_offset().
+    __ LoadFromOffset(TMP, THR,
+                      dart::Thread::indirect_static_call_table_offset());
+    __ AddImmediate(LR, TMP, dd_slot * compiler::target::kWordSize);
+    __ Call(compiler::Address(LR, 0));
+  });
+
+  // Record the original target even though the branch went through the table.
+  // This is what keeps a patched call site attributable: the snapshot's
+  // static-call table still says which function this site was for. Done here
+  // rather than at the IL site because AddStaticCallTarget is private to
+  // FlowGraphCompiler.
+  //
+  // kNormal unconditionally -- theirs passes a hardcoded 0 rather than reading
+  // any field, which is one of the three reasons the 32-bit field at 0xd8 was
+  // ruled out as entry_kind_.
+  AddStaticCallTarget(function, Code::EntryKind::kNormal);
+}
+
 Condition FlowGraphCompiler::EmitEqualityRegConstCompare(
     Register reg,
     const Object& obj,
diff --git a/runtime/vm/compiler/backend/il.cc b/runtime/vm/compiler/backend/il.cc
index 0f0f3f994f7..efeeea70d68 100644
--- a/runtime/vm/compiler/backend/il.cc
+++ b/runtime/vm/compiler/backend/il.cc
@@ -5478,6 +5478,32 @@ Representation StaticCallInstr::representation() const {
   return FlowGraph::ReturnRepresentationOf(function());
 }
 
+// Shorebird: an indirect static call keeps the direct call's convention --
+// same arguments, same layout, same return representation. Only the dispatch
+// differs, so these delegate to function() exactly as StaticCallInstr does
+// above. Divergence here would mean a patched target could not satisfy the
+// call site it replaces.
+Representation IndirectStaticCallInstr::RequiredInputRepresentation(
+    intptr_t idx) const {
+  if (type_args_len() > 0 || function().IsFactory()) {
+    if (idx == 0) {
+      return kTagged;
+    }
+    idx--;
+  }
+  return FlowGraph::ParameterRepresentationAt(function(), idx);
+}
+
+intptr_t IndirectStaticCallInstr::ArgumentsSize() const {
+  return FlowGraph::ComputeArgumentsSizeInWords(
+             function(), ArgumentCountWithoutTypeArgs()) +
+         ((type_args_len() > 0) ? 1 : 0);
+}
+
+Representation IndirectStaticCallInstr::representation() const {
+  return FlowGraph::ReturnRepresentationOf(function());
+}
+
 const CallTargets& StaticCallInstr::Targets() {
   if (targets_ == nullptr) {
     Zone* zone = Thread::Current()->zone();
@@ -5952,6 +5978,39 @@ void StaticCallInstr::EmitNativeCode(FlowGraphCompiler* compiler) {
   }
 }
 
+LocationSummary* IndirectStaticCallInstr::MakeLocationSummary(
+    Zone* zone,
+    bool optimizing) const {
+  return MakeCallSummary(zone, this);
+}
+
+// Shorebird. Their EmitNativeCode at 0x1002a3e28 builds the arguments
+// descriptor and IC data exactly as a static call does, then dispatches through
+// the DD table instead of branching to the target -- and still hands the
+// original function to AddStaticCallTarget.
+//
+// That last line is the load-bearing one. The snapshot's static-call table
+// therefore still records what this call site originally meant, while the DD
+// table entry it dispatches through stays repointable. Drop it and the call
+// becomes patchable but anonymous: nothing downstream could say which function
+// the site was for.
+//
+// The entry kind is kNormal unconditionally. Theirs passes a hardcoded 0 rather
+// than reading a field, which is one of the three reasons the 32-bit field at
+// 0xd8 could be ruled out as entry_kind_.
+void IndirectStaticCallInstr::EmitNativeCode(FlowGraphCompiler* compiler) {
+  ArgumentsInfo args_info(type_args_len(), ArgumentCount(), ArgumentsSize(),
+                          argument_names());
+  const Array& arguments_descriptor =
+      Array::ZoneHandle(compiler->zone(), args_info.ToArgumentsDescriptor());
+
+  compiler->EmitIndirectStaticCall(dd_slot(), function(),
+                                   arguments_descriptor);
+  compiler->EmitCallsiteMetadata(source(), deopt_id(),
+                                 UntaggedPcDescriptors::kOther, locs(), env());
+  compiler->EmitDropArguments(ArgumentsSize());
+}
+
 CachableIdempotentCallInstr::CachableIdempotentCallInstr(
     const InstructionSource& source,
     Representation representation,
