diff --git a/runtime/vm/compiler/backend/flow_graph_compiler.h b/runtime/vm/compiler/backend/flow_graph_compiler.h
index 2f1d48583b4..fe7342c69df 100644
--- a/runtime/vm/compiler/backend/flow_graph_compiler.h
+++ b/runtime/vm/compiler/backend/flow_graph_compiler.h
@@ -772,6 +772,14 @@ class FlowGraphCompiler : public ValueObject {
   void EmitDispatchTableCall(int32_t selector_offset,
                              const Array& arguments_descriptor);
 
+  // Shorebird: dispatch a static call through the DD table rather than
