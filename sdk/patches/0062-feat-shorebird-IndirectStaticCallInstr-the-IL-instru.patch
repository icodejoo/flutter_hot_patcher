@@ -498,6 +498,17 @@ void ConstantPropagator::VisitDispatchTableCall(DispatchTableCallInstr* instr) {
   SetValue(instr, non_constant_);
 }
 
+// Shorebird: never fold an indirect static call, even where the recognised-kind
+// machinery in VisitStaticCall below could evaluate the same target. The table
+// entry this dispatches through gets repointed when a patch is linked, so
+// folding the result would bake in the pre-patch answer and quietly defeat the
+// mechanism. Non-constant is the correct answer here, not a conservative
+// placeholder.
+void ConstantPropagator::VisitIndirectStaticCall(
+    IndirectStaticCallInstr* instr) {
+  SetValue(instr, non_constant_);
+}
