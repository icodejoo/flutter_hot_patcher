 };
 
+// Shorebird: a static call dispatched through the DD table.
+//
+// Where StaticCallInstr emits a direct branch to its target, this loads an
+// entry out of Thread::indirect_static_call_table_ at index dd_slot() and calls
+// through it. The original target is still recorded in the snapshot's
+// static-call table -- EmitNativeCode passes function_ to AddStaticCallTarget
+// -- so the call site still says what it originally meant while the table entry
+// remains repointable. That is what makes a patched target reachable.
+//
+// Shape reproduced from their gen_snapshot; see
+// spikes/shorebird_linkinfo_oracle/README.md. It is StaticCallInstr on the same
+// TemplateDartCall<0> base with ic_data_ and call_count_ dropped -- an AOT-only
+// call has no use for either -- which is why function_ lands at 0xc0 in their
+// binary where upstream's is at 0xd0.
+class IndirectStaticCallInstr : public TemplateDartCall<0> {
+ public:
+  IndirectStaticCallInstr(const InstructionSource& source,
+                          const Function& function,
+                          intptr_t dd_slot,
+                          intptr_t type_args_len,
+                          const Array& argument_names,
+                          InputsArray&& arguments,
+                          intptr_t deopt_id)
+      : TemplateDartCall(deopt_id,
+                         type_args_len,
+                         argument_names,
+                         std::move(arguments),
+                         source),
+        function_(function),
+        dd_slot_(dd_slot),
+        result_type_(nullptr),
+        shorebird_flags_(0) {
+    DEBUG_ASSERT(function.IsNotTemporaryScopedHandle());
+    ASSERT(!function.IsNull());
+    ASSERT(dd_slot >= 0);
+  }
+
+  DECLARE_INSTRUCTION(IndirectStaticCall)
+
+  const Function& function() const { return function_; }
+
+  // Index into Thread::indirect_static_call_table_. The name is theirs: their
+  // PrintOperandsTo formats this field with " %s<%" Pd "> [dd_slot=%" Pd "]".
+  intptr_t dd_slot() const { return dd_slot_; }
+
+  virtual intptr_t ArgumentsSize() const;
+
+  virtual Representation RequiredInputRepresentation(intptr_t idx) const;
+  virtual Representation representation() const;
+
+  virtual bool ComputeCanDeoptimize() const { return false; }
+  virtual bool CanBecomeDeoptimizationTarget() const { return true; }
+  virtual intptr_t DeoptimizationTarget() const { return deopt_id(); }
+  virtual bool HasUnknownSideEffects() const { return true; }
+  virtual bool CanCallDart() const { return true; }
+
+  virtual CompileType ComputeType() const;
+
+  PRINT_OPERANDS_TO_SUPPORT
+
+#define FIELD_LIST(F)                                                          \
+  F(const Function&, function_)                                                \
+  F(const intptr_t, dd_slot_)                                                  \
+  F(CompileType*, result_type_)                                                \
+  F(int32_t, shorebird_flags_)
+
+  DECLARE_INSTRUCTION_SERIALIZABLE_FIELDS(IndirectStaticCallInstr,
+                                          TemplateDartCall,
+                                          FIELD_LIST)
+#undef FIELD_LIST
+
+ private:
+  // shorebird_flags_ is at 0xd8 in their layout and is deliberately NOT given a
+  // meaning. It is not a renamed upstream field: dropping ic_data_/call_count_
+  // makes 0xd8 land on upstream's is_known_list_constructor_/entry_kind_/
+  // identity_ span, and all three are excluded -- the first is a bool where the
+  // load is `ldr w`, the second is contradicted by EmitNativeCode passing a
+  // hardcoded 0 for entry kind, and the third is 8 bytes because AliasIdentity
+  // wraps an intptr_t. So they added it, four oracles decline to name it, and
+  // there is no upstream counterpart to borrow a meaning from. The name says
+  // where it lives and nothing about what it means, on purpose.
+
+  DISALLOW_COPY_AND_ASSIGN(IndirectStaticCallInstr);
+};
+
 // A call to a function which has no side effects and of which the result can
 // be cached.
 //
diff --git a/runtime/vm/compiler/backend/il_printer.cc b/runtime/vm/compiler/backend/il_printer.cc
index 54f01fe289c..76e53d04aa3 100644
--- a/runtime/vm/compiler/backend/il_printer.cc
+++ b/runtime/vm/compiler/backend/il_printer.cc
@@ -912,6 +912,27 @@ void EqualityCompareInstr::PrintOperandsTo(BaseTextBuffer* f) const {
   right()->PrintTo(f);
 }
 
+// Shorebird. The format string is theirs byte for byte: it sits at 0x1004cbd3e
+// in their gen_snapshot and reads " %s<%ld> [dd_slot=%ld]". This is where the
+// name `dd_slot` comes from -- it is what their own printer calls the field at
+// 0xc8, which is why that field carries a name and the one at 0xd8 does not.
+//
+// Note the difference from StaticCallInstr below: upstream's format ends in a
+// space, theirs ends at the `]` and emits the separator only when arguments
+// follow. Their disassembly gates it on `cmp x0, #1`.
+void IndirectStaticCallInstr::PrintOperandsTo(BaseTextBuffer* f) const {
+  f->Printf(" %s<%" Pd "> [dd_slot=%" Pd "]",
+            String::Handle(function().name()).ToCString(), type_args_len(),
+            dd_slot());
+  if (ArgumentCount() > 0) {
+    f->AddString(" ");
+  }
+  for (intptr_t i = 0; i < ArgumentCount(); ++i) {
+    if (i > 0) f->AddString(", ");
+    ArgumentValueAt(i)->PrintTo(f);
+  }
+}
+
 void StaticCallInstr::PrintOperandsTo(BaseTextBuffer* f) const {
   f->Printf(" %s<%" Pd "> ", String::Handle(function().name()).ToCString(),
             type_args_len());
diff --git a/runtime/vm/compiler/backend/type_propagator.cc b/runtime/vm/compiler/backend/type_propagator.cc
index 92dd13db25e..a7a6f971de3 100644
--- a/runtime/vm/compiler/backend/type_propagator.cc
+++ b/runtime/vm/compiler/backend/type_propagator.cc
@@ -1564,6 +1564,46 @@ CompileType StaticCallInstr::ComputeType() const {
   return result;
 }
 
+// Shorebird: the same inference as StaticCallInstr above, minus the
+// list-factory branch. That branch keys off is_known_list_constructor_, which
+// their instruction does not carry -- it is a bool, and the field at 0xd8 is
+// loaded 32-bit, which is part of how that candidate was ruled out.
+//
+// Note what is deliberately absent: no attempt to sharpen the type from the
+// target's body. The table entry is repointed when a patch is linked, so
+// anything inferred from the pre-patch target would be a claim about code that
+// may not be the code that runs.
+CompileType IndirectStaticCallInstr::ComputeType() const {
+  CompileType* const inferred_type = result_type_;
+
+  intptr_t inferred_cid = kDynamicCid;
+  bool is_nullable = CompileType::kCanBeNull;
+  if (inferred_type != nullptr) {
+    if (inferred_type->IsNullableInt()) {
+      TraceStrongModeType(this, inferred_type);
+      return *inferred_type;
+    }
+    inferred_cid = inferred_type->ToNullableCid();
+    is_nullable = inferred_type->is_nullable();
+  }
+
+  if (function_.has_pragma()) {
+    const intptr_t cid = MethodRecognizer::ResultCidFromPragma(function_);
+    if (cid != kDynamicCid) {
+      return CompileType::FromCid(cid);
+    }
+  }
+
+  const AbstractType& result_type =
+      AbstractType::ZoneHandle(function().result_type());
+  CompileType result(is_nullable && !result_type.IsStrictlyNonNullable(),
+                     CompileType::kCannotBeSentinel,
+                     inferred_cid == kDynamicCid ? kIllegalCid : inferred_cid,
+                     &result_type);
+  TraceStrongModeType(this, &result);
+  return result;
+}
