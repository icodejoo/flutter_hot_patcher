+// ============================================================
+// flutter_hot_patcher B2: --shorebird mode
+// Outputs Shorebird-compatible JSON with function hashes.
+// The hash is SHA-1 of code bytes - stable for same source code,
+// changes when function body changes. Self-consistent for our pipeline.
+// ============================================================
+
+// flutter_hot_patcher B2: Inline SHA-1 implementation (avoids external deps)
+// Based on RFC 3174 reference implementation.
+namespace {
+struct FhpSHA1Ctx {
+  uint32_t state[5];
+  uint32_t count[2];
+  uint8_t  buffer[64];
+};
+static void FhpSHA1Init(FhpSHA1Ctx* ctx) {
+  ctx->state[0]=0x67452301; ctx->state[1]=0xEFCDAB89;
+  ctx->state[2]=0x98BADCFE; ctx->state[3]=0x10325476;
+  ctx->state[4]=0xC3D2E1F0;
+  ctx->count[0]=ctx->count[1]=0;
+}
+static inline uint32_t FhpRot(uint32_t x,int n){return (x<<n)|(x>>(32-n));}
+static void FhpSHA1Transform(uint32_t state[5], const uint8_t buf[64]) {
+  uint32_t a,b,c,d,e,t,w[80];
+  for(int i=0;i<16;i++) w[i]=(buf[i*4]<<24)|(buf[i*4+1]<<16)|(buf[i*4+2]<<8)|buf[i*4+3];
+  for(int i=16;i<80;i++) w[i]=FhpRot(w[i-3]^w[i-8]^w[i-14]^w[i-16],1);
+  a=state[0];b=state[1];c=state[2];d=state[3];e=state[4];
+  #define FF(i,f,k) t=FhpRot(a,5)+(f)+e+(k)+w[i]; e=d; d=c; c=FhpRot(b,30); b=a; a=t
+  for(int i= 0;i<20;i++) FF(i,(b&c)|(~b&d),0x5A827999);
+  for(int i=20;i<40;i++) FF(i,b^c^d,0x6ED9EBA1);
+  for(int i=40;i<60;i++) FF(i,(b&c)|(b&d)|(c&d),0x8F1BBCDC);
+  for(int i=60;i<80;i++) FF(i,b^c^d,0xCA62C1D6);
+  #undef FF
+  state[0]+=a;state[1]+=b;state[2]+=c;state[3]+=d;state[4]+=e;
+}
+static void FhpSHA1Update(FhpSHA1Ctx* ctx, const uint8_t* data, size_t len) {
+  int j = (ctx->count[0]>>3) & 63;
+  if((ctx->count[0]+=len<<3)<(uint32_t)(len<<3)) ctx->count[1]++;
+  ctx->count[1]+=len>>29;
+  size_t i=0;
+  if(len>=64-(size_t)j){ memcpy(ctx->buffer+j,data,64-j); FhpSHA1Transform(ctx->state,ctx->buffer); i=64-j; j=0; for(;i+63<len;i+=64) FhpSHA1Transform(ctx->state,data+i); }
+  memcpy(ctx->buffer+j,data+i,len-i);
+}
+static void FhpSHA1Final(uint8_t digest[20], FhpSHA1Ctx* ctx) {
+  uint8_t finalcount[8];
+  for(int i=0;i<8;i++) finalcount[i]=(uint8_t)((i<4)?ctx->count[1]>>((3-i)*8):ctx->count[0]>>((7-i)*8));
+  FhpSHA1Update(ctx,(uint8_t*)"\x80",1);
+  while((ctx->count[0]&504)!=448) FhpSHA1Update(ctx,(uint8_t*)"\0",1);
+  FhpSHA1Update(ctx,finalcount,8);
+  for(int i=0;i<20;i++) digest[i]=(uint8_t)(ctx->state[i>>2]>>((3-(i&3))*8));
+}
+static void FhpSHA1(const uint8_t* data, size_t len, uint8_t digest[20]) {
+  FhpSHA1Ctx ctx; FhpSHA1Init(&ctx); FhpSHA1Update(&ctx,data,len); FhpSHA1Final(digest,&ctx);
+}
+} // namespace (anonymous for SHA1)
+
+namespace {
+
+// ARM64 Dart register constants for PP load detection
+static constexpr int kDartPPReg = 27;   // x27 = Object Pool pointer
+
+// Compute SHA-1 of instruction bytes as hex string.
+std::string Sha1HexOf(const uint8_t* data, size_t len) {
+  uint8_t digest[20];
+  FhpSHA1(data, len, digest);
+  char hex[41];
+  for (int i = 0; i < 20; i++) {
+    snprintf(hex + i * 2, 3, "%02x", digest[i]);
+  }
+  return std::string(hex);
+}
+
+// Collect PP slot indices used by a function.
+std::vector<intptr_t> GetSelfPPIndices(const uint8_t* code, intptr_t size) {
+  std::vector<intptr_t> slots;
+  for (intptr_t i = 0; i + 4 <= size; i += 4) {
+    uint32_t instr;
+    memcpy(&instr, code + i, 4);
+    // 64-bit LDR unsigned offset: bits[31:22] = 0b1111100101 = 0x3E5
+    if (((instr >> 22) & 0x3FF) == 0x3E5) {
+      int rn = (instr >> 5) & 0x1F;
+      if (rn == kDartPPReg) {
+        intptr_t imm12 = (instr >> 10) & 0xFFF;
+        // PP slot N is at offset (N+2)*8, so imm12 = N+2 → N = imm12-2
+        if (imm12 >= 2) slots.push_back(imm12 - 2);
+      }
+    }
+  }
+  return slots;
+}
+
+// Enumerate all Code objects in the snapshot in offset order.
+struct CodeEntry {
+  std::string name;
+  intptr_t index_in_entries;
+  intptr_t offset;   // from isolate_snapshot_instructions base
+  intptr_t size;
+  const uint8_t* payload;
+};
+
+// 枚举快照中的全部 Code 对象。
+//
+// 早期实现遍历 cls.functions()，但 **AOT 快照里该数组多被清空**，
+// 结果只找到一百多个函数、遗漏 app 自身代码；且它把 VM 区的 Code 也按
+// isolate 基址算偏移，产生负值。
+//
+// 这里改用与上游 SnapshotAnalyzer::DumpInterestingObjects 相同的可达对象图
+// 遍历：从 global object pool、libraries、class table、closure_functions 出发
+// 递归 VisitPointers，沿途收集 Code。凡 payload 落在 isolate instructions
+// 基址之前的（即 VM 区）一律跳过。
+void CollectAllCodes(
+    IsolateGroup* isolate_group,
+    const uintptr_t isolate_instr_base,
+    std::vector<CodeEntry>& out_codes) {
+  Thread* thread = Thread::Current();
+  Zone* zone = thread->zone();
+  Heap* heap = isolate_group->heap();
+
+  std::vector<const Code*> discovered;
+
+  heap->ResetObjectIdTable();
+  {
+    NoSafepointScope ns(thread);
+
+    FieldVisitor visitor(isolate_group);
+    std::function<void(ObjectPtr)> handle_object = [&](ObjectPtr value) {
+      if (!value.IsHeapObject()) return;
+      // 每个对象只处理一次。
+      if (heap->GetObjectId(value) != 0) return;
+      heap->SetObjectId(value, 1);
+
+      if (value->GetClassId() == kCodeCid) {
+        discovered.push_back(&Code::Handle(zone, Code::RawCast(value)));
+      }
+
+      value->untag()->VisitPointers(&visitor);
+    };
+    visitor.init(&handle_object);
+
+    Object& object = Object::Handle(zone);
+
+    // 对象池中可达的一切（AOT 下绝大多数 Code 由此可达）
+    object = isolate_group->object_store()->global_object_pool();
+    if (!object.IsNull()) handle_object(object.ptr());
+
+    // 所有库
+    object = isolate_group->object_store()->libraries();
+    if (!object.IsNull()) {
+      object = GrowableObjectArray::Cast(object).data();
+      if (!object.IsNull()) object.ptr().untag()->VisitPointers(&visitor);
+    }
+
+    // 所有类
+    auto class_table = isolate_group->class_table();
+    for (intptr_t cid = 0; cid < class_table->NumCids(); ++cid) {
+      if (!class_table->HasValidClassAt(cid)) continue;
+      object = class_table->At(cid);
+      if (!object.IsNull()) handle_object(object.ptr());
+    }
+
+    // 闭包函数（只需一次；旧实现误置于 cid 循环内，重复了 NumCids 遍）
+    object = isolate_group->object_store()->closure_functions();
+    if (!object.IsNull()) handle_object(object.ptr());
+
+    // AOT 的 bare-instructions 模式下，绝大多数 Code 不再从类/库可达，
+    // 而是挂在 InstructionsTable 的 code_objects_ 上。把这些表交给遍历器，
+    // 其内部指针会被 VisitPointers 走到，从而覆盖 app 自身的代码。
+    object = isolate_group->object_store()->instructions_tables();
+    if (!object.IsNull()) handle_object(object.ptr());
+  }
+
+  Function& func = Function::Handle(zone);
+  Object& owner = Object::Handle(zone);
+
+  for (const Code* code_ptr : discovered) {
+    const Code& code = *code_ptr;
+    if (code.IsNull()) continue;
+
+    const uintptr_t payload = static_cast<uintptr_t>(code.PayloadStart());
+    // payload == 0 出现在被树摇掉的 VM 快照条目上；
+    // payload < base 表示该 Code 位于 VM instructions 区，不属于本快照。
+    if (payload == 0 || payload < isolate_instr_base) continue;
+
+    CodeEntry entry;
+    owner = code.owner();
+    if (!owner.IsNull() && owner.IsFunction()) {
+      func ^= owner.ptr();
+      entry.name = func.QualifiedUserVisibleNameCString();
+    } else if (code.IsStubCode()) {
+      entry.name = std::string("[Stub] ") + code.Name();
+    } else {
+      entry.name = code.Name();
+    }
+    entry.offset = static_cast<intptr_t>(payload - isolate_instr_base);
+    entry.size = code.Size();
+    entry.payload = reinterpret_cast<const uint8_t*>(payload);
+    entry.index_in_entries = -1;  // 排序后填充
+    out_codes.push_back(std::move(entry));
+  }
+
+  // 按偏移排序并按偏移去重（同一段代码可能被多个 owner 引用）
+  std::sort(out_codes.begin(), out_codes.end(),
+            [](const CodeEntry& a, const CodeEntry& b) {
+              return a.offset < b.offset;
+            });
+  out_codes.erase(std::unique(out_codes.begin(), out_codes.end(),
+                              [](const CodeEntry& a, const CodeEntry& b) {
+                                return a.offset == b.offset;
+                              }),
+                  out_codes.end());
+  for (intptr_t i = 0; i < static_cast<intptr_t>(out_codes.size()); ++i) {
+    out_codes[i].index_in_entries = i;
+  }
+}
+
+}  // namespace
+
+// Dumps Shorebird-compatible analyze_snapshot JSON (--shorebird mode).
+// Output format matches Shorebird's analyze_snapshot --shorebird JSON:
+//   {"shorebird":"true","snapshot_data":{...},"functions":[...]}
+// Each function entry: {name, index_in_entries, offset, size,
+//                       self_hash, subgraph_hash, op_subgraph_hash,
+//                       self_pp, subgraph_pp, callees, ...}
+void Dart_DumpSnapshotInformationShorebirdAsJson(
+    const Dart_SnapshotAnalyzerInformation& info,
+    char** out,
+    intptr_t* out_len) {
+  Thread* thread = Thread::Current();
+  IsolateGroup* ig = thread->isolate_group();
+  DARTSCOPE(thread);
+  
+  const uintptr_t isolate_instr_base =
+      reinterpret_cast<uintptr_t>(info.vm_isolate_instructions);
+  
+  // Collect all Code objects
+  std::vector<CodeEntry> codes;
+  SafepointReadRwLocker ml(thread, ig->program_lock());
+  CollectAllCodes(ig, isolate_instr_base, codes);
+  
+  JSONWriter js;
+  js.OpenObject();
+  js.PrintProperty("shorebird", "true");
+  
+  // snapshot_data section
+  js.OpenObject("snapshot_data");
+  js.PrintfProperty("vm_data", "%p", info.vm_snapshot_data);
+  js.PrintfProperty("vm_instructions", "%p", info.vm_snapshot_instructions);
+  js.PrintfProperty("isolate_data", "%p", info.vm_isolate_data);
+  js.PrintfProperty("isolate_instructions", "%p", info.vm_isolate_instructions);
+  js.CloseObject();
+  
+  // functions array
+  js.OpenArray("functions");
+  for (const auto& entry : codes) {
+    js.OpenObject();
+    js.PrintProperty("name", entry.name.c_str());
+    js.PrintProperty64("index_in_entries", entry.index_in_entries);
+    js.PrintProperty64("offset", entry.offset);
+    js.PrintProperty64("size", entry.size);
+    
+    // Compute SHA-1 hash of instruction bytes
+    std::string hash = Sha1HexOf(entry.payload, entry.size);
+    js.PrintProperty("self_hash", hash.c_str());
+    js.PrintProperty("subgraph_hash", hash.c_str());   // simplified: same as self_hash
+    js.PrintProperty("op_subgraph_hash", hash.c_str()); // simplified: same
+    
+    // PP slot indices
+    std::vector<intptr_t> pp_slots = GetSelfPPIndices(entry.payload, entry.size);
+    js.OpenArray("self_pp");
+    for (intptr_t s : pp_slots) js.PrintValue64(s);
+    js.CloseArray();
+    js.OpenArray("subgraph_pp");
+    for (intptr_t s : pp_slots) js.PrintValue64(s);
+    js.CloseArray();
+    
+    // Empty arrays for other fields (simplified)
+    js.OpenArray("self_selectors"); js.CloseArray();
+    js.OpenArray("subgraph_selectors"); js.CloseArray();
+    js.OpenArray("self_field_table"); js.CloseArray();
+    js.OpenArray("subgraph_field_table"); js.CloseArray();
+    js.OpenArray("callees"); js.CloseArray();
+    js.CloseObject();
+  }
+  js.CloseArray();
+  js.CloseObject();
+  
+  js.Steal(out, out_len);
+}
+
 }  // namespace snapshot_analyzer
 }  // namespace dart
