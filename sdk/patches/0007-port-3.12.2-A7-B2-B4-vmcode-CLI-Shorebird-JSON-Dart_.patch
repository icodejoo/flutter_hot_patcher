@@ -1054,6 +1057,51 @@ void RunMainIsolate(const char* script_name,
 
   Dart_EnterScope();
 
+#if defined(DART_INCLUDE_SIMULATOR)
+  // flutter_hot_patcher A7: if --shorebird-vmcode was provided,
+  // parse the link table and configure the Simulator for Sim↔CPU transitions.
+  if (Options::shorebird_vmcode_path() != nullptr) {
+    const char* vmcode_path = Options::shorebird_vmcode_path();
+    File* vmcode_file = File::Open(nullptr, vmcode_path, File::kRead);
+    if (vmcode_file == nullptr) {
+      Syslog::PrintErr("[A7] Cannot open vmcode: %s\n", vmcode_path);
+    } else {
+      // Read link table header
+      uint32_t n_entries = 0;
+      vmcode_file->ReadFully(&n_entries, 4);
+      // Get base instructions base address (the currently loaded snapshot)
+      const uword base_instr_base =
+          reinterpret_cast<uword>(app_isolate_snapshot_instructions);
+      // Get patch instructions base: it's in the ELF that follows the header
+      // For now, patch ELF is same-offset layout as base ELF, so we use
+      // the same base address after loading the patch.
+      // The sim_offset values are relative to _kDartIsolateSnapshotInstructions
+      // in the patch ELF, and cpu_offset values are relative to the base ELF.
+      //
+      // Configure Simulator link table
+      Simulator* sim = Simulator::Current();
+      if (sim != nullptr) {
+        // Pass absolute cpu addresses; set base=0 to avoid double-adding in BLR handler.
+        sim->SetBaseInstructionsBase(0);
+        for (uint32_t i = 0; i < n_entries; i++) {
+          uint32_t sim_off = 0, cpu_off = 0;
+          vmcode_file->ReadFully(&sim_off, 4);
+          vmcode_file->ReadFully(&cpu_off, 4);
+          // sim address = base_instr_base + sim_off (patch offset)
+          // cpu address = base_instr_base + cpu_off (base offset)
+          sim->SetLinkedFunction(base_instr_base + sim_off,
+                                 base_instr_base + cpu_off);
+        }
+        Syslog::PrintErr("[A7] Configured %u link table entries from %s\n",
+                         n_entries, vmcode_path);
+        // Set 50M instruction threshold to skip VM startup phase.
+        sim->SetSimToCpuStartupThreshold(50000000ULL);
+      }
+      vmcode_file->Release();
+    }
+  }
+#endif  // DART_INCLUDE_SIMULATOR
+
   // Kernel snapshots should have been handled before reaching this point.
   ASSERT(Options::gen_snapshot_kind() != kKernel);
   // Lookup the library of the root script.
