+// flutter_hot_patcher B4: Load vmcode and configure Simulator link table.
+// Uses stdio for file I/O (dart::bin not available in dart_api_impl.cc).
+DART_EXPORT bool Dart_ShorebirdLoadVmcode(const char* vmcode_path) {
+// SetPendingVmcodeFile only exists on the arm64 Simulator. The guard is
+// SIMULATOR_AVAILABLE rather than DART_INCLUDE_SIMULATOR: the production configuration
+// compiles the Simulator in while keeping code generation native (C3a), and
+// this entry point has to work there -- it is how the engine populates the link
+// table. TARGET_ARCH_ARM64 is still required because e.g. a target-x64 build on
+// an arm64 host also sets DART_INCLUDE_SIMULATOR, and that Simulator has no such
+// member.
+#if defined(SIMULATOR_AVAILABLE) && defined(TARGET_ARCH_ARM64)
+  if (vmcode_path == nullptr) return false;
+  
+  FILE* f = fopen(vmcode_path, "rb");
+  if (f == nullptr) return false;
+  
+  uint32_t n_entries = 0;
+  if (fread(&n_entries, 4, 1, f) != 1) { fclose(f); return false; }
+  if (n_entries > 65536) { fclose(f); return false; }
+  
+  fclose(f);
+  // Store the vmcode path; the Simulator will read and apply it lazily
+  // when the first isolate creates its Simulator via Simulator::Current().
+  Simulator::SetPendingVmcodeFile(vmcode_path);
+  
+  return n_entries > 0;
+#else
+  return false;
+#endif
+}
+
 }  // namespace dart
