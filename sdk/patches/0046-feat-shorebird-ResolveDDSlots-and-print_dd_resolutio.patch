+// --- DD slot resolution ------------------------------------------------------
+//
+// Called twice from Precompiler::DoCompileAll(). The first call resolves; the
+// second recomputes but keeps the first call's decisions, which is what makes
+// slot ownership stable across the two passes.
+//
+// This does NOT depend on the DD IL subsystem: the slots come from the
+// DDSlotVoters file, not from IndirectStaticCallInstr or a DD table, so the
+// algorithm is drivable and checkable today. Recorded explicitly because this
+// was previously written off as blocked on nothing more than the "DD" in its
+// name -- the same mistake that was made about dd_function_identity.
+
+namespace {
+
+using KeyMap = std::unordered_map<FunctionKey,
+                                  std::vector<uword>,
+                                  FunctionKeyHash,
+                                  FunctionKeyEqual>;
+
+// Walks libraries -> classes -> functions, plus one synthetic ForAllocStub key
+// per class that still has an allocation stub. The owner recorded for a
+// function is a raw FunctionPtr; for an allocation stub it is a raw CodePtr.
+// That asymmetry is theirs (from the disassembly) -- do not unify it.
+void BuildKeyMap(Thread* thread, Zone* zone, KeyMap* out) {
+  const GrowableObjectArray& libraries = GrowableObjectArray::Handle(
+      zone, thread->isolate_group()->object_store()->libraries());
+
+  Library& library = Library::Handle(zone);
+  Class& cls = Class::Handle(zone);
+  Array& functions = Array::Handle(zone);
+  Function& function = Function::Handle(zone);
+  Code& code = Code::Handle(zone);
+
+  for (intptr_t i = 0; i < libraries.Length(); i++) {
+    library ^= libraries.At(i);
+    ClassDictionaryIterator it(library,
+                               ClassDictionaryIterator::kIteratePrivate);
+    while (it.HasNext()) {
+      cls = it.GetNextClass();
+      if (cls.IsNull()) continue;
+
+      functions = cls.current_functions();
+      if (!functions.IsNull()) {
+        for (intptr_t j = 0; j < functions.Length(); j++) {
+          function ^= functions.At(j);
+          if (function.IsNull()) continue;
+          (*out)[FunctionKey::FromFunction(function)].push_back(
+              static_cast<uword>(function.ptr()));
+        }
+      }
+
+      code = cls.allocation_stub();
+      if (!code.IsNull()) {
+        (*out)[FunctionKey::ForAllocStub(cls)].push_back(
+            static_cast<uword>(code.ptr()));
+      }
+    }
+  }
+}
+
+// Why votes were discarded. Their report breaks the drop count down by these,
+// so each has to be tracked separately rather than lumped into one counter.
+struct Tally {
+  intptr_t tgt_miss = 0;
+  intptr_t tgt_ambig = 0;
+  intptr_t caller_miss = 0;
+  intptr_t caller_ambig = 0;
+};
+
+// A vote counts only when BOTH keys resolve to exactly one owner. Returns the
+// target's owner on success and 0 otherwise, recording why on failure.
+uword ScoreVoter(const KeyMap& key_map, const SlotVoter& voter, Tally* tally) {
+  const auto caller = key_map.find(voter.caller_key);
+  if (caller == key_map.end()) {
+    tally->caller_miss++;
+    return 0;
+  }
+  if (caller->second.size() != 1) {
+    tally->caller_ambig++;
+    return 0;
+  }
+
+  const auto target = key_map.find(voter.target_key);
+  if (target == key_map.end()) {
+    tally->tgt_miss++;
+    return 0;
+  }
+  if (target->second.size() != 1) {
+    tally->tgt_ambig++;
+    return 0;
+  }
+  // The winner is the TARGET, not the caller. Established from the oracle: the
+  // synthesised voters pair (caller=real[2i], target=real[2i+1]) and slot i
+  // resolves to real[2i+1] in their own dd_resolution.tsv.
+  return target->second[0];
+}
+
+}  // namespace
+
+void ShorebirdLinker::ResolveDDSlots(Thread* thread, Zone* zone) {
+  if (dd_slot_voters_ == nullptr) return;
+
+  KeyMap key_map;
+  BuildKeyMap(thread, zone, &key_map);
+
+  DDSlotResolution* previous = resolution_;
+  auto* fresh = new DDSlotResolution();
+
+  intptr_t resolved = 0, preserved = 0, would_have_flipped = 0;
+  intptr_t carried = 0, refreshed = 0, dropped_stale = 0;
+  intptr_t dropped = 0, empty_tally = 0;
+  Tally tally;
+
+  for (const intptr_t slot : dd_slot_voters_->sorted_slot_ids()) {
+    const std::vector<size_t>* indices =
+        dd_slot_voters_->voters_for_slot(slot);
+    if (indices == nullptr) continue;
+
+    // Plurality -- not majority, not lowest id, not first.
+    //
+    // UNVERIFIED: every fixture we can build has exactly one voter per slot, so
+    // the oracle never exercises a tie. Their tie-break is libc++ __hash_table
+    // insertion order; ours is first-encountered. A passing oracle run does NOT
+    // confirm this branch.
+    std::unordered_map<uword, intptr_t> votes;
+    uword winner = 0;
+    intptr_t best = 0;
+    const SlotVoter* winning_voter = nullptr;
+    for (const size_t index : *indices) {
+      const SlotVoter& voter = dd_slot_voters_->voters()[index];
+      const uword owner = ScoreVoter(key_map, voter, &tally);
+      if (owner == 0) continue;
+      const intptr_t count = ++votes[owner];
+      if (count > best) {
+        best = count;
+        winner = owner;
+        winning_voter = &voter;
+      }
+    }
+
+    const bool had_previous = previous != nullptr && previous->HasSlot(slot);
+
+    if (winner != 0) {
+      if (had_previous) {
+        // Verify-only path: recompute, but the earlier decision stands. This is
+        // the mechanism that keeps slot ownership stable across the two
+        // DoCompileAll calls.
+        const uword old_owner = previous->OwnerForSlot(slot);
+        preserved++;
+        carried++;
+        if (old_owner != winner) {
+          would_have_flipped++;
+          OS::PrintErr("DD slot %" Pd
+                       " WOULD HAVE FLIPPED to a different owner "
+                       "(preserved by fix)\n",
+                       slot);
+        }
+        fresh->SetSlotOwner(slot, old_owner, previous->KeyForSlot(slot));
+      } else {
+        resolved++;
+        fresh->SetSlotOwner(slot, winner, winning_voter->target_key);
+      }
+      continue;
+    }
+
+    // No usable vote: rescue from the previous resolution if it had one.
+    if (had_previous) {
+      preserved++;
+      carried++;
+      fresh->SetSlotOwner(slot, previous->OwnerForSlot(slot),
+                          previous->KeyForSlot(slot));
+      continue;
+    }
+    dropped++;
+    empty_tally++;
+  }
+
+  OS::PrintErr(
+      "DD resolution: %" Pd " resolved, %" Pd " preserved (%" Pd
+      " would-have-flipped), %" Pd " carried (%" Pd " refreshed, %" Pd
+      " dropped-stale), %" Pd " dropped (empty_tally=%" Pd " [tgt_miss=%" Pd
+      " tgt_ambig=%" Pd " caller_miss=%" Pd " caller_ambig=%" Pd
+      "]) from %" Pd " functions in key map\n",
+      resolved, preserved, would_have_flipped, carried, refreshed,
+      dropped_stale, dropped, empty_tally, tally.tgt_miss, tally.tgt_ambig,
+      tally.caller_miss, tally.caller_ambig,
+      static_cast<intptr_t>(key_map.size()));
+
+  // Their ResolveDDSlots frees the old resolution and stores a new one, which
+  // is why resolution_ is a raw pointer rather than a unique_ptr.
+  delete previous;
+  resolution_ = fresh;
+
+  PrintDDResolutionIfRequested(thread, zone);
+}
+
+// --- --print_dd_resolution_to ------------------------------------------------
+
+namespace {
+
+// Their name format, read off their own TSV:
+//   <library url> '_' <class name> '_' <function name>
+// e.g. dart:core_::__objectEquals@0150898  (library dart:core, class "::",
+// function "_objectEquals@0150898") and
+// dart:core__FinalizerImpl@0150898__runFinalizers@0150898. Private names keep
+// their @<library key> mangling, so these are the raw names, not scrubbed ones.
+std::string OwnerName(Zone* zone, uword owner) {
+  if (owner == 0) return "-";
+
+  const Object& object = Object::Handle(zone, static_cast<ObjectPtr>(owner));
+  Class& cls = Class::Handle(zone);
+  String& name = String::Handle(zone);
+  std::string function_name;
+
+  if (object.IsFunction()) {
+    const Function& function = Function::Cast(object);
+    name = function.name();
+    if (!name.IsNull()) function_name = name.ToCString();
+    cls = function.Owner();
+  } else if (object.IsCode()) {
+    // Allocation stub: the owner is the Class itself.
+    const Object& stub_owner = Object::Handle(zone, Code::Cast(object).owner());
+    if (stub_owner.IsClass()) cls = Class::Cast(stub_owner).ptr();
+  }
+
+  std::string class_name;
+  std::string library_url;
+  if (!cls.IsNull()) {
+    name = cls.Name();
+    if (!name.IsNull()) class_name = name.ToCString();
+    const Library& library = Library::Handle(zone, cls.library());
+    if (!library.IsNull()) {
+      name = library.url();
+      if (!name.IsNull()) library_url = name.ToCString();
+    }
+  }
+
+  return library_url + "_" + class_name + "_" + function_name;
+}
+
+}  // namespace
+
+void ShorebirdLinker::PrintDDResolutionIfRequested(Thread* thread, Zone* zone) {
+  if (FLAG_print_dd_resolution_to == nullptr) return;
+  if (dd_slot_voters_ == nullptr || resolution_ == nullptr) return;
+
+  const std::vector<intptr_t> slots = dd_slot_voters_->sorted_slot_ids();
+  intptr_t retained = 0;
+  for (const intptr_t slot : slots) {
+    if (resolution_->HasSlot(slot)) retained++;
+  }
+
+  TextBuffer buffer(4 * KB);
+  buffer.Printf("# DD slot resolution outcome\n");
+  // rewritten and sentinel_filled describe the DD *table* rewrite, which needs
+  // the DD IL subsystem we do not have. They are reported as 0 rather than
+  // guessed; the slot/outcome/name columns are the part this build can produce.
+  buffer.Printf(
+      "# table_size=%" Pd " retained=%" Pd
+      " rewritten=0 sentinel_filled=%" Pd " rewritten_null=0\n",
+      static_cast<intptr_t>(slots.size()), retained,
+      static_cast<intptr_t>(slots.size()) - retained);
+  buffer.Printf("slot\toutcome\trewritten\tname\n");
+
+  for (const intptr_t slot : slots) {
+    const bool resolved = resolution_->HasSlot(slot);
+    const std::string name =
+        resolved ? OwnerName(zone, resolution_->OwnerForSlot(slot)) : "-";
+    buffer.Printf("%" Pd "\t%s\t0\t%s\n", slot,
+                  resolved ? "resolved" : "sentinel", name.c_str());
+  }
+
+  WriteThroughFileCallbacks(FLAG_print_dd_resolution_to, buffer.buffer(),
+                            static_cast<intptr_t>(strlen(buffer.buffer())));
+}
+
 }  // namespace dart
