+// The slot's winner is the voter's TARGET, not its caller. Established from
+// their own dd_resolution.tsv: the synthesised voters pair
+// (caller=real[2i], target=real[2i+1]) and slot i resolves to real[2i+1].
+//
+// This is worth a test of its own because swapping the two keeps every
+// structural property intact -- the stream still parses, the slot still
+// resolves, the counters still read "7 resolved" -- and only the identity of
+// the winning function changes. The end-to-end oracle that catches it needs
+// their gen_snapshot, so it cannot run here.
+ISOLATE_UNIT_TEST_CASE(ResolveDDSlots_WinnerIsTheTargetNotTheCaller) {
+  const Class& cls =
+      Class::Handle(thread->isolate_group()->object_store()->object_class());
+  const Array& functions = Array::Handle(cls.current_functions());
+  EXPECT(functions.Length() >= 2);
+
+  Function& caller = Function::Handle();
+  Function& target = Function::Handle();
+  caller ^= functions.At(0);
+  target ^= functions.At(1);
+  EXPECT(caller.ptr() != target.ptr());
+
+  auto voters = std::make_unique<DDSlotVoters>();
+  voters->AddVoter(0, FunctionKey::FromFunction(caller),
+                   FunctionKey::FromFunction(target));
+
+  ShorebirdLinker* linker = ShorebirdLinker::shared();
+  linker->InitializeWithDDSlotVoters(std::move(voters));
+  linker->ResolveDDSlots(thread, thread->zone());
+
+  const DDSlotResolution* resolution = linker->resolution();
+  EXPECT(resolution != nullptr);
+  EXPECT(resolution->HasSlot(0));
+  EXPECT_EQ(static_cast<uword>(target.ptr()), resolution->OwnerForSlot(0));
+  EXPECT(resolution->OwnerForSlot(0) != static_cast<uword>(caller.ptr()));
+}
