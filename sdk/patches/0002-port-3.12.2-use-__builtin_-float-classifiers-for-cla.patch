   //    dividend is a zero and divisor is nonzero finite,
   // then dividend is returned.
-  if (!(_finite(x) && (!_finite(y) && !isnan(y))) &&
+  if (!(_finite(x) && (!_finite(y) && !__builtin_isnan(y))) &&
