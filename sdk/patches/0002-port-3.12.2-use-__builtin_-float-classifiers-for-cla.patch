   if (f1 == f2) {
     // take care of (-0.0) < 0.0, (they are equal according to minss)
-    auto result = signbit(f1) ? f1 : f2;
+    auto result = __builtin_signbit(f1) ? f1 : f2;
     return result;
   }
   auto result = f1 > f2 ? f2 : f1;
