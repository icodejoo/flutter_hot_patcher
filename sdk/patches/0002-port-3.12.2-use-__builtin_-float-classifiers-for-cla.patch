From 6070f5396bf571b54048b08afa1407c2a8001b57 Mon Sep 17 00:00:00 2001
From: cruz <jelon@tbu.net>
Date: Wed, 19 Aug 2026 16:14:05 +0800
Subject: [PATCH 002/206] port(3.12.2): use __builtin_ float classifiers for
 clang18/iOS26.5

Redone on 3.12.2 rather than cherry-picked: upstream rewrote several of these
files heavily (simulator_riscv.cc alone is +526/-149), so replaying the
mechanical substitution is safer than resolving conflicts.

Verified against the 3.7 original at equal granularity -- changed-line counts
match exactly for every file, confirming the regex neither over-matches nor
misses a site. Upstream still uses bare isnan/isinf at 3.12.2, so this batch is
NOT obsolete as previously suspected.

Co-Authored-By: Claude <noreply@anthropic.com>

diff --git a/runtime/lib/double.cc b/runtime/lib/double.cc
index d602adb42c9..eefbe1f8aea 100644
--- a/runtime/lib/double.cc
+++ b/runtime/lib/double.cc
@@ -181,19 +181,19 @@ DEFINE_NATIVE_ENTRY(Double_toStringAsPrecision, 0, 2) {
 
 DEFINE_NATIVE_ENTRY(Double_getIsInfinite, 0, 1) {
   const Double& arg = Double::CheckedHandle(zone, arguments->NativeArgAt(0));
-  return Bool::Get(isinf(arg.value())).ptr();
+  return Bool::Get(__builtin_isinf(arg.value())).ptr();
 }
 
 DEFINE_NATIVE_ENTRY(Double_getIsNaN, 0, 1) {
   const Double& arg = Double::CheckedHandle(zone, arguments->NativeArgAt(0));
-  return Bool::Get(isnan(arg.value())).ptr();
+  return Bool::Get(__builtin_isnan(arg.value())).ptr();
 }
 
 DEFINE_NATIVE_ENTRY(Double_getIsNegative, 0, 1) {
   const Double& arg = Double::CheckedHandle(zone, arguments->NativeArgAt(0));
   // Include negative zero, infinity.
   double dval = arg.value();
-  return Bool::Get(signbit(dval) && !isnan(dval)).ptr();
+  return Bool::Get(__builtin_signbit(dval) && !__builtin_isnan(dval)).ptr();
 }
 
 DEFINE_NATIVE_ENTRY(Double_flipSignBit, 0, 1) {
