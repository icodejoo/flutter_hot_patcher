+// flutter_hot_patcher: Shorebird's GetObjectPoolLinkInfo(Thread*),
+// analyze_snapshot 0x10024cb9c. It is the producer behind BOTH
+// --dump_object_pool_link_data and --dump_object_pool; the format it fills in
+// has been decodable since ObjectPoolLinkInfo landed, and this is the half that
+// was missing.
+//
+// Three parts, in the order their function builds them:
+//
+//   1. `pairs`: their first loop (0x10024cc2c-0x10024cc40) walks the global
+//      object pool's entry_bits, masks the low two bits and keeps every index
+//      whose value is 1 -- kPairFirst. Nothing about the entry's contents is
+//      examined. See ObjectPoolBuilderEntry::PairPosition for where the mark
+//      comes from and why bits 0..1 is not a guess.
+//
+//   2. `codes`: one CodeInfo per instructions-table entry, in the same order
+//      the --shorebird functions array uses, carrying the two hashes and the
+//      two pool-reference lists the subgraph walk produces.
+//
+//   3. `num_pool_entries`: the pool's length.
+//
+// ⚠️ NOT reproduced, deliberately: their ObjectPoolBuilder also carries a
+// std::vector<PairEntry> (the only symbol it leaves is that vector's
+// __throw_length_error). Nothing in AddObject, NewFromBuilder or
+// GetObjectPoolLinkInfo touches it, and the pair marks alone account for every
+// index in `pairs` on their own fixture, so what it is for is not established
+// and it is not invented here.
+static std::unique_ptr<ObjectPoolLinkInfo> GetObjectPoolLinkInfo(
+    Thread* thread,
+    const Dart_SnapshotAnalyzerInformation& info) {
+  IsolateGroup* ig = thread->isolate_group();
+  Zone* zone = thread->zone();
+
+  const ObjectPool& pool =
+      ObjectPool::Handle(zone, ig->object_store()->global_object_pool());
+  const intptr_t num_pool_entries = pool.IsNull() ? 0 : pool.Length();
+
+  std::vector<int32_t> pairs;
+  for (intptr_t i = 0; i < num_pool_entries; i++) {
+    if (pool.PairPositionAt(i) ==
+        compiler::ObjectPoolBuilderEntry::kPairFirst) {
+      pairs.push_back(static_cast<int32_t>(i));
+    }
+  }
+
+  const uintptr_t isolate_instr_base =
+      reinterpret_cast<uintptr_t>(info.vm_isolate_instructions);
+  std::vector<CodeEntry> codes;
+  {
+    SafepointReadRwLocker ml(thread, ig->program_lock());
+    CollectAllCodes(ig, isolate_instr_base, codes);
+  }
+
+  std::vector<ShorebirdCodeFacts> facts;
+  facts.reserve(codes.size());
+  for (const auto& entry : codes) {
+    facts.push_back(ComputeShorebirdCodeFacts(entry.payload, entry.size));
+  }
+  const ShorebirdClassifiedHashes classified =
+      ShorebirdSelfAndOpHashes(codes, facts);
+
+  std::vector<CodeInfo> infos;
+  infos.reserve(codes.size());
+  for (intptr_t i = 0; i < static_cast<intptr_t>(codes.size()); i++) {
+    std::vector<uintptr_t> self_pp(classified.self_pp[i].begin(),
+                                   classified.self_pp[i].end());
+    std::vector<uintptr_t> subgraph_pp(classified.subgraph_pp[i].begin(),
+                                       classified.subgraph_pp[i].end());
+    infos.emplace_back(classified.self_hash[i], classified.op_subgraph_hash[i],
+                       std::move(self_pp), std::move(subgraph_pp));
+  }
+
+  return std::make_unique<ObjectPoolLinkInfo>(
+      std::move(infos), std::move(pairs), num_pool_entries);
+}
+
+void Dart_DumpObjectPool(const Dart_SnapshotAnalyzerInformation& info,
+                         char** out,
+                         intptr_t* out_len) {
+  Thread* thread = Thread::Current();
+  DARTSCOPE(thread);
+  const std::unique_ptr<ObjectPoolLinkInfo> link_info =
+      GetObjectPoolLinkInfo(thread, info);
+
+  MallocWriteStream stream(/*initial_size=*/64 * KB);
+  link_info->WriteToStream(&stream);
+  *out_len = stream.bytes_written();
+  *out = reinterpret_cast<char*>(malloc(*out_len));
+  memcpy(*out, stream.buffer(), *out_len);
+}
+
+// One pool slot as their --dump_object_pool renders it.
+//
+// This is upstream's ObjectPool::DebugPrint body with the two changes their
+// string table shows (analyze_snapshot 0x29aae8, a second copy of the upstream
+// block at 0x290024 with different contents):
+//
+//   * a "<%" Pd " len string> (obj)" case upstream does not have, taken when
+//     the object is a String whose Utf8 length would not fit the 256-byte
+//     buffer. The threshold is theirs: `cmp x0, #0xf9` after Utf8::Length at
+//     0x10024e178, and the String test just above it is a virtual call to
+//     vtable+0x10 -- Object::HandleTag() -- compared against 0x5d = kStringCid.
+//   * "0x%" Px " (unknown)" where upstream prints "(raw)". Both strings are in
+//     the binary; the upstream one belongs to the upstream copy of the block.
+// Their snprintf buffer is 256 bytes (`mov w1,#0x100` at 0x10024e198) and the
+// long-string cutoff is 249 (`cmp x0,#0xf9` at 0x10024e178).
+static constexpr intptr_t kPoolEntryBufferSize = 256;
+static constexpr intptr_t kPoolEntryStringCutoff = 249;
+
+static void AppendPoolEntryDescription(Zone* zone,
+                                       const ObjectPool& pool,
+                                       intptr_t i,
+                                       char* buffer,
+                                       intptr_t buffer_size) {
+  if (pool.TypeAt(i) == ObjectPool::EntryType::kTaggedObject) {
+    const Object& obj = Object::Handle(zone, pool.ObjectAt(i));
+    // ⚠️ Two different lengths, and mixing them up is invisible on short
+    // strings: the CUTOFF is measured in Utf8 bytes (0x10024e174 calls
+    // Utf8::Length before `cmp x0,#0xf9`) but the number PRINTED is the
+    // String's own length (0x10024e218-0x10024e220 loads length_ and shifts the
+    // Smi tag off instead). Using Utf8::Length for both put 2844 where their
+    // dump of the same string says 2112.
+    if (obj.IsString() &&
+        Utf8::Length(String::Cast(obj)) >= kPoolEntryStringCutoff) {
+      Utils::SNPrint(buffer, buffer_size, "<%" Pd " len string> (obj)",
+                     String::Cast(obj).Length());
+      return;
+    }
+    Utils::SNPrint(buffer, buffer_size, "%s (obj)", obj.ToCString());
+    return;
+  }
+  if (pool.TypeAt(i) == ObjectPool::EntryType::kNativeFunction) {
+    const uword pc = pool.RawValueAt(i);
+    uintptr_t start = 0;
+    const char* name = NativeSymbolResolver::LookupSymbolName(pc, &start);
+    if (name != nullptr) {
+      Utils::SNPrint(buffer, buffer_size, "%s (native function)", name);
+      NativeSymbolResolver::FreeSymbolName(name);
+      return;
+    }
+    const char* dso_name;
+    uword dso_base;
+    if (NativeSymbolResolver::LookupSharedObject(pc, &dso_base, &dso_name)) {
+      Utils::SNPrint(buffer, buffer_size, "%s+0x%" Px " (native function)",
+                     dso_name, pc - dso_base);
+      NativeSymbolResolver::FreeSymbolName(dso_name);
+      return;
+    }
+    Utils::SNPrint(buffer, buffer_size, "0x%" Px " (native function)", pc);
+    return;
+  }
+  Utils::SNPrint(buffer, buffer_size, "0x%" Px " (unknown)",
+                 pool.RawValueAt(i));
+}
+
+void Dart_DumpObjectPoolAsJson(const Dart_SnapshotAnalyzerInformation& info,
+                               char** out,
+                               intptr_t* out_len) {
+  Thread* thread = Thread::Current();
+  IsolateGroup* ig = thread->isolate_group();
+  DARTSCOPE(thread);
+  Zone* zone = thread->zone();
+
+  const std::unique_ptr<ObjectPoolLinkInfo> link_info =
+      GetObjectPoolLinkInfo(thread, info);
+
+  JSONWriter js;
+  js.OpenObject();
+  js.PrintProperty64("object_pool_size", link_info->num_pool_entries());
+
+  js.OpenArray("code_infos");
+  for (const CodeInfo& code : link_info->codes()) {
+    js.OpenObject();
+    js.PrintProperty("op_subgraph_hash", code.op_subgraph_hash_.c_str());
+    js.PrintProperty("self_hash", code.self_hash_.c_str());
+    js.OpenArray("self_pp_indices");
+    for (uintptr_t slot : code.self_pp_indices_) {
+      js.PrintValue64(static_cast<int64_t>(slot));
+    }
+    js.CloseArray();
+    js.OpenArray("subgraph_pp_indices");
+    for (uintptr_t slot : code.subgraph_pp_indices_) {
+      js.PrintValue64(static_cast<int64_t>(slot));
+    }
+    js.CloseArray();
+    js.CloseObject();
+  }
+  js.CloseArray();
+
+  js.OpenArray("pairs");
+  for (int32_t index : link_info->pair_constraints()) {
+    js.PrintValue64(index);
+  }
+  js.CloseArray();
+
+  js.OpenArray("entries");
+  const ObjectPool& pool =
+      ObjectPool::Handle(zone, ig->object_store()->global_object_pool());
+  const intptr_t length = pool.IsNull() ? 0 : pool.Length();
+  char buffer[kPoolEntryBufferSize];
+  for (intptr_t i = 0; i < length; i++) {
+    js.OpenObject();
+    js.PrintProperty64("index", i);
+    js.PrintProperty64("offset", ObjectPool::element_offset(i));
+    AppendPoolEntryDescription(zone, pool, i, buffer, kPoolEntryBufferSize);
+    js.PrintProperty("code", buffer);
+    js.CloseObject();
+  }
+  js.CloseArray();
+
+  js.CloseObject();
+  js.Steal(out, out_len);
+}
+
 void Dart_DumpSnapshotInformationShorebirdAsJson(
     const Dart_SnapshotAnalyzerInformation& info,
     char** out,
