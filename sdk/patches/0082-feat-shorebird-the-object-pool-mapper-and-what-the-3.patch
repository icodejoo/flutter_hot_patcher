 // three-stage report adds up to exactly it.
 //
-// What the 385 indices mean is NOT established, so they are carried under a
-// descriptive name rather than an interpretive one. Measured, not guessed:
-// they are ascending, identical between base and patch, a strict subset of the
-// 1126 indices the records reference, and they match none of "all minus
-// self", "all minus subgraph", or "all minus either". Naming them for a
-// hypothesis none of those tests support is the mistake `0xd8` already was.
+// The 385 indices are the mapper's pair-constraint list -- established
+// 2026-08-25 by disassembling InitializeWithObjectPoolLinkInfo, which reads
+// this very vector at 0x10019d7c0. Each entry `i` asserts that pool slots `i`
+// and `i + 1` must stay adjacent, so knowing where one of them landed in the
+// base fixes the other. 292 of the 385 had exactly one side already mapped,
+// which is the number their report prints.
+//
+// They were carried under a descriptive name while three hypotheses about them
+// stood refuted; the name is now interpretive because the interpretation was
+// read out of their code rather than guessed at. Their element type is int32_t,
+// from the `ldrsw ... lsl #2` that indexes it.
 class ObjectPoolLinkInfo {
  public:
   ObjectPoolLinkInfo(std::vector<CodeInfo> codes,
-                     std::vector<uintptr_t> indices,
+                     std::vector<int32_t> pair_constraints,
                      intptr_t num_pool_entries)
       : codes_(std::move(codes)),
-        indices_(std::move(indices)),
+        pair_constraints_(std::move(pair_constraints)),
         num_pool_entries_(num_pool_entries) {}
 
   const std::vector<CodeInfo>& codes() const { return codes_; }
-  const std::vector<uintptr_t>& indices() const { return indices_; }
+  const std::vector<int32_t>& pair_constraints() const {
+    return pair_constraints_;
+  }
   intptr_t num_pool_entries() const { return num_pool_entries_; }
 
   // Returns nullptr on any malformed input rather than aborting: the caller
@@ -265,7 +272,7 @@ class ObjectPoolLinkInfo {
 
  private:
   std::vector<CodeInfo> codes_;
-  std::vector<uintptr_t> indices_;
+  std::vector<int32_t> pair_constraints_;
   intptr_t num_pool_entries_;
 };
 
