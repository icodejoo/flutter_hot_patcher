diff --git a/runtime/vm/shorebird/linker.cc b/runtime/vm/shorebird/linker.cc
index 0d67d6a0fcc..af00324f22a 100644
--- a/runtime/vm/shorebird/linker.cc
+++ b/runtime/vm/shorebird/linker.cc
@@ -158,6 +158,130 @@ std::vector<intptr_t> ShorebirdLinker::ComputeClassTableMapping(
   return mapping;
 }
 
+// Shorebird's object pool mapper, transcribed from
+// InitializeWithObjectPoolLinkInfo. Same shape as the class table's, plus the
+// middle stage that one does not have.
+//
+//   0x10019d728  stage 1 reads LinkedValue<uword>: base @+0x00, patch @+0x08,
+//                stride 0x10
+//   0x10019d72c  cmp #8 / ccmp #8 -- a pair is skipped unless BOTH sides are
+//                at least 8. The pool's first eight slots are fixed.
+//   0x10019d7c0  stage 2 walks ObjectPoolLinkInfo's own index list, as int32
+//   0x10019d7cc  it loads mapping[i] AND mapping[i + 1] together
+//   0x10019d7d0  both unmapped -> nothing to derive, skip
+//   0x10019d7dc  both mapped   -> nothing to do, skip
+//   0x10019d7f0  mapping[i] known    -> mapping[i + 1] = mapping[i] + 1
+//   0x10019d80c  mapping[i+1] known  -> mapping[i]     = mapping[i + 1] - 1
+//   0x10019d888  stage 3 over entries still holding -1
+//   0x10019d894  ...but first, is this index part of a constrained pair?
+//   0x10019d930  if so, find two ADJACENT free slots and take both, count 2
+//   0x10019d8c0  otherwise the ordinary lowest-free search
+//
+// This is what the 385 trailing indices in their object pool link info are for,
+// and the count settles it: 292 of them had exactly one side already mapped
+// after stage 1, which is the number their report prints.
+std::vector<intptr_t> ShorebirdLinker::ComputeObjectPoolMapping(
+    const std::vector<PoolIndexPair>& link_results,
+    const std::vector<int32_t>& pair_constraints,
+    intptr_t num_pool_entries,
+    MappingCounts* counts) {
+  ASSERT(counts != nullptr);
+  ASSERT(num_pool_entries >= 0);
+
+  std::vector<intptr_t> mapping(static_cast<size_t>(num_pool_entries), -1);
+  std::vector<bool> taken;
+
+  // Claims `index`, growing the bitmap on demand as both of their sites do.
+  auto claim = [&taken](intptr_t index) {
+    if (index >= static_cast<intptr_t>(taken.size())) {
+      taken.resize(static_cast<size_t>(index) + 1, false);
+    }
+    taken[static_cast<size_t>(index)] = true;
+  };
+  auto is_taken = [&taken](intptr_t index) {
+    return index < static_cast<intptr_t>(taken.size()) &&
+           taken[static_cast<size_t>(index)];
+  };
+
+  counts->link_results = static_cast<intptr_t>(link_results.size());
+
+  // Stage 1.
+  for (const PoolIndexPair& pair : link_results) {
+    if (pair.base_index < kFirstMappablePoolIndex ||
+        pair.patch_index < kFirstMappablePoolIndex) {
+      continue;
+    }
+    if (pair.patch_index >= num_pool_entries) continue;
+    mapping[static_cast<size_t>(pair.patch_index)] = pair.base_index;
+    claim(pair.base_index);
+    counts->from_link_results++;
+  }
+
+  // Stage 2. Each constraint says slots i and i + 1 stay adjacent, so one
+  // known side fixes the other. Nothing is derivable when both are unknown,
+  // and nothing is needed when both are known.
+  for (int32_t raw : pair_constraints) {
+    const intptr_t i = static_cast<intptr_t>(raw);
+    if (i < 0 || i + 1 >= num_pool_entries) continue;
+
+    const intptr_t a = mapping[static_cast<size_t>(i)];
+    const intptr_t b = mapping[static_cast<size_t>(i) + 1];
+    if ((a == -1) == (b == -1)) continue;
+
+    if (a == -1) {
+      mapping[static_cast<size_t>(i)] = b - 1;
+      claim(b - 1);
+    } else {
+      mapping[static_cast<size_t>(i) + 1] = a + 1;
+      claim(a + 1);
+    }
+    counts->from_pair_constraints++;
+  }
+
+  // Which indices participate in a constraint, so stage 3 can tell whether an
+  // unmapped slot needs a neighbour reserved alongside it. Theirs rescans the
+  // list linearly per entry (0x10019d8a4); this is the same predicate.
+  std::vector<bool> constrained(static_cast<size_t>(num_pool_entries), false);
+  for (int32_t raw : pair_constraints) {
+    const intptr_t i = static_cast<intptr_t>(raw);
+    if (i < 0 || i + 1 >= num_pool_entries) continue;
+    constrained[static_cast<size_t>(i)] = true;
+    constrained[static_cast<size_t>(i) + 1] = true;
+  }
+
+  // Stage 3.
+  intptr_t cursor = -1;
+  for (size_t i = 0; i < mapping.size(); i++) {
+    if (mapping[i] != -1) continue;
+
+    if (constrained[i] && i + 1 < mapping.size() && mapping[i + 1] == -1) {
+      // Both halves are still unmapped, so they have to land adjacent. Search
+      // for the first index at or after the cursor whose successor is free too.
+      intptr_t first = cursor + 1;
+      while (is_taken(first) || is_taken(first + 1)) first++;
+      mapping[i] = first;
+      claim(first);
+      mapping[i + 1] = first + 1;
+      claim(first + 1);
+      cursor = first + 1;
+      // Their counter advances by two here (w21 = 2 at 0x10019da68) and the
+      // loop index skips the slot just filled.
+      counts->from_backfill += 2;
+      i++;
+      continue;
+    }
+
+    intptr_t index = cursor + 1;
+    while (is_taken(index)) index++;
+    mapping[i] = index;
+    claim(index);
+    cursor = index;
+    counts->from_backfill++;
+  }
+
+  return mapping;
+}
+
 void ShorebirdLinker::InitializeWithFieldTableLinkInfo(
     std::unique_ptr<FieldTableLinkInfo> base) {
   // ASSERT string from their binary: "base_field_table_ == nullptr"
diff --git a/runtime/vm/shorebird/linker.h b/runtime/vm/shorebird/linker.h
index b38123066dc..024e7b54d3a 100644
--- a/runtime/vm/shorebird/linker.h
+++ b/runtime/vm/shorebird/linker.h
@@ -132,6 +132,29 @@ class ShorebirdLinker {
       intptr_t num_patch_cids,
       MappingCounts* counts);
 
+  // Shorebird's object pool mapper, decoded from
+  // InitializeWithObjectPoolLinkInfo at 0x10019d6e8..0x10019da88. Unlike the
+  // class table's, this one has all three stages: its pair-constraint counter
+  // is written at 0x10019d828 and their report shows it reaching 292.
+  //
+  // `link_results` is their vector<LinkedValue<uword>> -- a base index then a
+  // patch index, 16 bytes -- and `pair_constraints` is ObjectPoolLinkInfo's own
+  // index list, which the mapper reads at 0x10019d7c0.
+  struct PoolIndexPair {
+    intptr_t base_index;
+    intptr_t patch_index;
+  };
+
+  static std::vector<intptr_t> ComputeObjectPoolMapping(
+      const std::vector<PoolIndexPair>& link_results,
+      const std::vector<int32_t>& pair_constraints,
+      intptr_t num_pool_entries,
+      MappingCounts* counts);
+
+  // Pool slots below this are never mapped: their stage 1 skips a pair unless
+  // both sides are >= 8 (0x10019d72c, a cmp/ccmp against 8).
+  static constexpr intptr_t kFirstMappablePoolIndex = 8;
+
   // Accessors for tests and diagnostics. Return raw pointers — ownership stays
   // with the linker.
   const ClassTableLinkInfo* base_class_table() const {
diff --git a/runtime/vm/shorebird/linker_test.cc b/runtime/vm/shorebird/linker_test.cc
index 9ed3482d279..12f9a4fb0ff 100644
--- a/runtime/vm/shorebird/linker_test.cc
+++ b/runtime/vm/shorebird/linker_test.cc
@@ -480,4 +480,114 @@ VM_UNIT_TEST_CASE(ClassTableMapping_NoPairsBackfillsEverything) {
   }
 }
 
+
+// The object pool mapper. Its middle stage is the one the class table mapper
+// does not have, and it is what the 385 trailing indices in their object pool
+// link info are for: each index i asserts that pool slots i and i + 1 stay
+// adjacent, so a known side fixes the unknown one.
+
+VM_UNIT_TEST_CASE(ObjectPoolMapping_PairConstraintDerivesTheMissingSide) {
+  // Slot 10 is paired with base 20 outright. The constraint on (10, 11) then
+  // forces slot 11 to base 21 without any link result mentioning it, and the
+  // constraint on (12, 13) works the other way: 13 is known, 12 follows.
+  const std::vector<ShorebirdLinker::PoolIndexPair> pairs = {
+      {20, 10}, {31, 13},
+  };
+  const std::vector<int32_t> constraints = {10, 12};
+  ShorebirdLinker::MappingCounts counts;
+  const std::vector<intptr_t> mapping = ShorebirdLinker::ComputeObjectPoolMapping(
+      pairs, constraints, 16, &counts);
+
+  EXPECT_EQ(static_cast<intptr_t>(2), counts.from_link_results);
+  EXPECT_EQ(static_cast<intptr_t>(2), counts.from_pair_constraints);
+
+  EXPECT_EQ(static_cast<intptr_t>(20), mapping[10]);
+  EXPECT_EQ(static_cast<intptr_t>(21), mapping[11]);  // derived forwards
+  EXPECT_EQ(static_cast<intptr_t>(30), mapping[12]);  // derived backwards
+  EXPECT_EQ(static_cast<intptr_t>(31), mapping[13]);
+}
+
+// A constraint with neither side known has nothing to derive, and a constraint
+// with both sides known has nothing to do. Both must be skipped without
+// touching the counter -- otherwise the reported 292 would be 385.
+VM_UNIT_TEST_CASE(ObjectPoolMapping_PairConstraintSkipsBothKnownAndBothUnknown) {
+  const std::vector<ShorebirdLinker::PoolIndexPair> pairs = {
+      {20, 10}, {21, 11},           // both sides of the (10, 11) constraint
+  };
+  const std::vector<int32_t> constraints = {10, 12};  // (12, 13) has neither
+  ShorebirdLinker::MappingCounts counts;
+  const std::vector<intptr_t> mapping = ShorebirdLinker::ComputeObjectPoolMapping(
+      pairs, constraints, 16, &counts);
+
+  EXPECT_EQ(static_cast<intptr_t>(0), counts.from_pair_constraints);
+  EXPECT_EQ(static_cast<intptr_t>(20), mapping[10]);
+  EXPECT_EQ(static_cast<intptr_t>(21), mapping[11]);
+}
+
+// Their stage 1 requires both sides to be at least 8 (cmp/ccmp against 8 at
+// 0x10019d72c). The pool's first eight slots are fixed, so a pair naming one
+// is not a mapping to record.
+VM_UNIT_TEST_CASE(ObjectPoolMapping_SkipsPairsBelowTheFixedSlots) {
+  const std::vector<ShorebirdLinker::PoolIndexPair> pairs = {
+      {7, 10},   // base below 8
+      {20, 3},   // patch below 8
+      {21, 11},  // both fine
+  };
+  ShorebirdLinker::MappingCounts counts;
+  const std::vector<intptr_t> mapping =
+      ShorebirdLinker::ComputeObjectPoolMapping(pairs, {}, 16, &counts);
+
+  EXPECT_EQ(static_cast<intptr_t>(3), counts.link_results);
+  EXPECT_EQ(static_cast<intptr_t>(1), counts.from_link_results);
+  EXPECT_EQ(static_cast<intptr_t>(21), mapping[11]);
+  // Slot 10 was not mapped by the skipped pair, so it backfilled instead.
+  EXPECT(mapping[10] != 7);
+}
+
+// When both halves of a constraint reach backfill unmapped they must land
+// adjacent, which needs two consecutive free slots rather than the lowest one.
+// Theirs counts two for that (w21 = 2 at 0x10019da68).
+VM_UNIT_TEST_CASE(ObjectPoolMapping_BackfillKeepsConstrainedPairsAdjacent) {
+  // Bases 9 and 11 are claimed, which leaves 8 and 10 free but neither with a
+  // free successor. A search for "the lowest free index" would take 8 and then
+  // have to break the pair; theirs looks for the first index whose successor is
+  // also free, which is 12.
+  const std::vector<ShorebirdLinker::PoolIndexPair> pairs = {{9, 8}, {11, 9}};
+  const std::vector<int32_t> constraints = {10};
+  ShorebirdLinker::MappingCounts counts;
+  const std::vector<intptr_t> mapping = ShorebirdLinker::ComputeObjectPoolMapping(
+      pairs, constraints, 13, &counts);
+
+  EXPECT_EQ(static_cast<intptr_t>(9), mapping[8]);
+  EXPECT_EQ(static_cast<intptr_t>(11), mapping[9]);
+  // Adjacent, and specifically past the two singleton gaps at 8 and 10.
+  EXPECT_EQ(static_cast<intptr_t>(12), mapping[10]);
+  EXPECT_EQ(static_cast<intptr_t>(13), mapping[11]);
+  // Two slots filled by one visit, counted as two.
+  EXPECT_EQ(static_cast<intptr_t>(11), counts.from_backfill);
+}
+
+// Nothing may be handed out twice, across all three stages at once. Every count
+// above can be satisfied by a mapper that aliases, so this is checked directly.
+VM_UNIT_TEST_CASE(ObjectPoolMapping_NoBaseIndexIsUsedTwice) {
+  const std::vector<ShorebirdLinker::PoolIndexPair> pairs = {
+      {20, 10}, {31, 13}, {9, 8},
+  };
+  const std::vector<int32_t> constraints = {10, 12, 14};
+  ShorebirdLinker::MappingCounts counts;
+  const std::vector<intptr_t> mapping = ShorebirdLinker::ComputeObjectPoolMapping(
+      pairs, constraints, 20, &counts);
+
+  std::vector<bool> seen;
+  for (intptr_t index : mapping) {
+    EXPECT(index >= 0);
+    if (static_cast<intptr_t>(seen.size()) <= index) seen.resize(index + 1, false);
+    EXPECT(!seen[index]);
+    seen[index] = true;
+  }
+  EXPECT_EQ(static_cast<intptr_t>(20), counts.from_link_results +
+                                           counts.from_pair_constraints +
+                                           counts.from_backfill);
+}
+
 }  // namespace dart
