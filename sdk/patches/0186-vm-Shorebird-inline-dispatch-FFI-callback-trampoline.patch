diff --git a/runtime/vm/runtime_entry.cc b/runtime/vm/runtime_entry.cc
index 342a3847b84..6a657caac99 100644
--- a/runtime/vm/runtime_entry.cc
+++ b/runtime/vm/runtime_entry.cc
@@ -5178,6 +5178,63 @@ extern "C" Thread* DLRT_GetFfiCallbackMetadata(
   return thread;
 }
 
+#if defined(TARGET_ARCH_ARM64) && !defined(DART_TARGET_OS_FUCHSIA)
+// See runtime_entry.h. The isolate/safepoint work is DLRT_GetFfiCallbackMetadata
+// unchanged; this only re-expresses its answer in the form the arm64 stub
+// dispatches on. The epilogue it picks identifies the case one-to-one.
+extern "C" Thread* DLRT_GetFfiCallbackMetadataForInlineDispatch(
+    uword trampoline,
+    uword* out_entry_point,
+    uword* out_trampoline_type,
+    uword* out_call_target) {
+  ASSERT(out_entry_point != nullptr);
+  ASSERT(out_trampoline_type != nullptr);
+  ASSERT(out_call_target != nullptr);
+
+  CallbackMetadata out = {};
+  Thread* const thread = DLRT_GetFfiCallbackMetadata(trampoline, &out);
+
+  using TT = FfiCallbackMetadata::TrampolineType;
+  uword type;
+  bool uses_call_target = false;
+  if (out.epilogue == reinterpret_cast<uword>(&DLRT_ExitTemporaryIsolate)) {
+    type = static_cast<uword>(TT::kAsync);
+    uses_call_target = true;
+  } else if (out.epilogue ==
+             reinterpret_cast<uword>(&DLRT_ExitIsolateGroupBoundIsolate)) {
+    type = static_cast<uword>(TT::kSyncIsolateGroupBound);
+  } else if (out.epilogue ==
+             reinterpret_cast<uword>(&DLRT_ExitSyncCallbackTargetIsolate)) {
+    type = static_cast<uword>(TT::kSync) |
+           FfiCallbackMetadata::kSyncCallbackIsolateOwnershipFlag;
+    uses_call_target = true;
+  } else {
+    RELEASE_ASSERT(out.epilogue ==
+                   reinterpret_cast<uword>(&DLRT_ExitSyncCallback));
+    // The stub re-enters the safepoint inline for this case, which is what
+    // DLRT_ExitSyncCallback would otherwise do.
+    type = static_cast<uword>(TT::kSync);
+    uses_call_target = true;
+  }
+
+  // Route into the simulator only when the target is patch code and the
+  // simulator entry the CallSimulatorFromFfiTrampoline stub calls through has
+  // been installed; otherwise call the entry point on the CPU, as upstream
+  // does. The isolate-group-bound path in the stub never consults this word.
+  uword call_target = 0;
+  if (uses_call_target && thread != nullptr &&
+      thread->simulator_call_from_ffi() != 0 &&
+      InPatchSnapshot(thread->isolate_group(), out.entry_point)) {
+    call_target = StubCode::CallSimulatorFromFfiTrampoline().EntryPoint();
+  }
+
+  *out_entry_point = out.entry_point;
+  *out_trampoline_type = type;
+  *out_call_target = call_target;
+  return thread;
+}
+#endif  // defined(TARGET_ARCH_ARM64) && !defined(DART_TARGET_OS_FUCHSIA)
