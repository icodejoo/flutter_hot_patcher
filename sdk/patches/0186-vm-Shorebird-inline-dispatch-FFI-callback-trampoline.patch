+#else   // !defined(DART_TARGET_OS_FUCHSIA)
+// Shorebird. The shared stub dispatches on the FfiCallbackKind itself and calls
+// each kind's exit function out of the trampoline page's runtime-function table
+// -- the shape upstream had before ec77e28f266 ("Shrink the FFI callback stub")
+// replaced it with a single runtime-selected function pointer. We restore that
+// shape on arm64 (from our own history at 4679c040c63) and layer three changes
+// on top, all of them forced by our fork:
+//   * the metadata call hands back a third word, out_call_target: when nonzero,
+//     the stub calls it with the Dart entry point left in R10 -- the contract of
+//     CallSimulatorFromFfiTrampoline -- so a patch callback runs on the
+//     simulator instead of the CPU;
+//   * the exit runtime functions take Thread* (our 3.12.2 ABI, from
+//     ec77e28f266) and return void, so we pass THR in R0 and drop the
+//     `THR = result` move;
+//   * the sync (already-entered) case re-enters the safepoint inline, reading
+//     the cached entry point Thread::enter_safepoint_entry_point_ instead of
+//     loading the enter-safepoint stub Code and dereferencing it.
+// The runtime-function table is filled in FfiCallbackMetadata (arm64 branch).
+void StubCodeCompiler::GenerateFfiCallbackTrampolineStub() {
+  Label body;
+
+  // R9 is volatile and not used for passing any arguments.
+  COMPILE_ASSERT(!IsCalleeSavedRegister(R9) && !IsArgumentRegister(R9));
+  for (intptr_t i = 0; i < FfiCallbackMetadata::NumCallbackTrampolinesPerPage();
+       ++i) {
+    __ adr(R9, Immediate(0));
+    __ b(&body);
+  }
+
+  ASSERT_EQUAL(__ CodeSize(),
+               FfiCallbackMetadata::kNativeCallbackTrampolineSize *
+                   FfiCallbackMetadata::NumCallbackTrampolinesPerPage());
+
+  __ Bind(&body);
+
+  const intptr_t shared_stub_start = __ CodeSize();
+
+  // Save THR (callee-saved) and LR on the real C stack (CSP). Keeps it aligned.
+  COMPILE_ASSERT(FfiCallbackMetadata::kNativeCallbackTrampolineStackDelta == 2);
+  SPILLS_LR_TO_FRAME(__ stp(
+      THR, LR, Address(CSP, -2 * target::kWordSize, Address::PairPreIndex)));
 
+  COMPILE_ASSERT(!IsArgumentRegister(THR));
+
+  RegisterSet all_registers;
+  all_registers.AddAllArgumentRegisters();
+  all_registers.Add(Location::RegisterLocation(
+      CallingConventions::kPointerToReturnStructRegisterCall));
+
+  // R10 = entry_point, R9 = trampoline type, R12 = call_target.
+  COMPILE_ASSERT(!IsCalleeSavedRegister(R10) && !IsArgumentRegister(R10));
+  COMPILE_ASSERT(!IsCalleeSavedRegister(R12) && !IsArgumentRegister(R12));
+
+  // Look up the thread, entry point, kind and (Shorebird) call target. The
+  // safepoint exit is done inside the runtime call to save stub code size.
+  {
+    __ SetupDartSP();
+
+    __ EnterFrame(0);
+    __ PushRegisters(all_registers);
+
+    __ mov(R0, R9);
+
+    // Three reserved stack slots for the by-pointer results, aimed at R1/R2/R3.
+    __ AddImmediate(SP, SP, -compiler::target::kWordSize);
+    __ mov(R1, SP);  // out_entry_point
+    __ AddImmediate(SP, SP, -compiler::target::kWordSize);
+    __ mov(R2, SP);  // out_trampoline_type
+    __ AddImmediate(SP, SP, -compiler::target::kWordSize);
+    __ mov(R3, SP);  // out_call_target (Shorebird)
+
+    __ EnterFrame(0);
+    __ ReserveAlignedFrameSpace(0);
+
+    GenerateLoadFfiCallbackMetadataRuntimeFunction(
+        FfiCallbackMetadata::kGetFfiCallbackMetadata, R4);
+
+    __ mov(CSP, SP);
+    __ blr(R4);  // DLRT_GetFfiCallbackMetadataForInlineDispatch
+    __ mov(SP, CSP);
+    __ mov(THR, R0);
+
+    __ LeaveFrame();
+
+    // Pop the three results in reverse reservation order: call_target
+    // (Shorebird), then trampoline type, then entry point.
+    __ Pop(R12);  // out_call_target
+    __ Pop(R9);   // out_trampoline_type
+    __ Pop(R10);  // out_entry_point
+
+    __ PopRegisters(all_registers);
+    __ LeaveFrame();
+
+    __ RestoreCSP();
+  }
+
+  Label async_callback;
+  Label sync_isolate_group_bound_callback;
+  Label sync_callback_isolate_ownership;
+  Label done;
+
+  // A null thread means an async callback was invoked after deletion.
+  __ cmp(THR, Operand(0));
+  __ b(&done, EQ);
+
+  // Dispatch on the callback kind.
+  __ cmp(
+      R9,
+      Operand(static_cast<uword>(FfiCallbackMetadata::TrampolineType::kAsync)));
+  __ b(&async_callback, EQ);
+
+  __ cmp(R9, Operand(static_cast<uword>(
+                 FfiCallbackMetadata::TrampolineType::kSyncIsolateGroupBound)));
+  __ b(&sync_isolate_group_bound_callback, EQ);
+
+  __ tsti(R9,
+          Immediate(FfiCallbackMetadata::kSyncCallbackIsolateOwnershipFlag));
+  __ b(&sync_callback_isolate_ownership, NOT_ZERO);
+
+  // Sync callback, thread already entered. Call the target -- on the simulator
+  // if out_call_target routed us there -- then re-enter the safepoint.
+  {
+    Label direct;
+    __ cmp(R12, Operand(0));
+    __ b(&direct, NE);
+    __ mov(R12, R10);
+    __ Bind(&direct);
+    __ blr(R12);
+  }
+
+  // Restore the Dart SP the target reset before re-entering the safepoint.
+  __ mov(SP, CSP);
+
+  // EnterFullSafepoint, inlined so the slow path uses the cached entry point
+  // (Thread::enter_safepoint_entry_point_) instead of the enter-safepoint stub
+  // Code object and a field dereference.
+  {
+    Label retry, slow_path, sp_done;
+    __ movz(R17, Immediate(target::Thread::safepoint_state_offset()), 0);
+    __ add(R17, THR, Operand(R17));
+    __ Bind(&retry);
+    __ ldxr(R9, R17);
+    __ cmp(R9, Operand(target::Thread::native_safepoint_state_unacquired()));
+    __ b(&slow_path, NE);
+    __ movz(R9, Immediate(target::Thread::native_safepoint_state_acquired()),
+            0);
+    __ stxr(R16, R9, R17);
+    __ cbz(&sp_done, R16);
+    __ b(&retry);
+    __ Bind(&slow_path);
+    __ ldr(R17,
+           Address(THR, dart::Thread::enter_safepoint_entry_point_offset()));
+    __ blr(R17);
+    __ Bind(&sp_done);
+  }
+
+  __ b(&done);
+
+  // Sync callback: this thread owns, but has not entered, the target isolate.
+  __ Bind(&sync_callback_isolate_ownership);
+  {
+    Label direct;
+    __ cmp(R12, Operand(0));
+    __ b(&direct, NE);
+    __ mov(R12, R10);
+    __ Bind(&direct);
+    __ blr(R12);
+  }
+  {
+    __ SetupDartSP();
+    __ EnterFrame(0);
+    __ ReserveAlignedFrameSpace(0);
+
+    const RegisterSet return_registers(
+        (1 << CallingConventions::kReturnReg) |
+            (1 << CallingConventions::kSecondReturnReg),
+        1 << CallingConventions::kReturnFpuReg);
+    __ PushRegisters(return_registers);
+
+    GenerateLoadFfiCallbackMetadataRuntimeFunction(
+        FfiCallbackMetadata::kExitSyncCallbackTargetIsolate, R4);
+    __ mov(R0, THR);  // Thread* argument (3.12.2 exit ABI).
+    __ mov(CSP, SP);
+    __ blr(R4);
+    __ mov(SP, CSP);
+
+    __ PopRegisters(return_registers);
+    __ LeaveFrame();
+    __ RestoreCSP();
+  }
+  __ b(&done);
+
+  // Sync callback bound to an isolate group. Never routed to the simulator, so
+  // no call_target select here.
+  __ Bind(&sync_isolate_group_bound_callback);
+  __ blr(R10);
+  {
+    __ SetupDartSP();
+    __ EnterFrame(0);
+    __ ReserveAlignedFrameSpace(0);
+
+    const RegisterSet return_registers(
+        (1 << CallingConventions::kReturnReg) |
+            (1 << CallingConventions::kSecondReturnReg),
+        1 << CallingConventions::kReturnFpuReg);
+    __ PushRegisters(return_registers);
+
+    GenerateLoadFfiCallbackMetadataRuntimeFunction(
+        FfiCallbackMetadata::kExitIsolateGroupBoundIsolate, R4);
+    __ mov(R0, THR);  // Thread* argument (3.12.2 exit ABI).
+    __ mov(CSP, SP);
+    __ blr(R4);
+    __ mov(SP, CSP);
+
+    __ PopRegisters(return_registers);
+    __ LeaveFrame();
+    __ RestoreCSP();
+  }
+  __ b(&done);
+
+  // Async callback: run the entrypoint (marshals + sends), then tail-call the
+  // temporary-isolate exit -- not safe to return to this stub afterwards.
+  __ Bind(&async_callback);
+  {
+    Label direct;
+    __ cmp(R12, Operand(0));
+    __ b(&direct, NE);
+    __ mov(R12, R10);
+    __ Bind(&direct);
+    __ blr(R12);
+  }
+  GenerateLoadFfiCallbackMetadataRuntimeFunction(
+      FfiCallbackMetadata::kExitTemporaryIsolate, R4);
+  __ mov(R0, THR);  // Thread* argument (3.12.2 exit ABI).
+  CLOBBERS_LR(__ ldp(
+      THR, LR, Address(CSP, 2 * target::kWordSize, Address::PairPostIndex)));
+  __ br(R4);  // DLRT_ExitTemporaryIsolate.
+  __ brk(0);
+
+  __ Bind(&done);
+  RESTORES_LR_FROM_FRAME(__ ldp(
+      THR, LR, Address(CSP, 2 * target::kWordSize, Address::PairPostIndex)));
+  __ ret();
+
+  ASSERT_LESS_OR_EQUAL(__ CodeSize() - shared_stub_start,
+                       FfiCallbackMetadata::kNativeCallbackSharedStubSize);
+  ASSERT_LESS_OR_EQUAL(__ CodeSize(), FfiCallbackMetadata::kPageSize);
+
+#if defined(DEBUG)
+  while (__ CodeSize() < FfiCallbackMetadata::kPageSize) {
+    __ Breakpoint();
+  }
+#endif
+}
+#endif  // defined(DART_TARGET_OS_FUCHSIA)
