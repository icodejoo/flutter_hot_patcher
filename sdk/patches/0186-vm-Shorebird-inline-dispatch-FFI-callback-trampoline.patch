+#if defined(TARGET_ARCH_ARM64) && !defined(DART_TARGET_OS_FUCHSIA)
+// Shorebird. The arm64 trampoline stub dispatches on the callback kind itself
+// (the pre-ec77e28f266 shape), so its metadata call hands back three words
+// through three out-pointers instead of one CallbackMetadata:
+//   out_entry_point      the Dart entry point (as CallbackMetadata)
+//   out_trampoline_type  FfiCallbackMetadata::TrampolineType, with
+//                        kSyncCallbackIsolateOwnershipFlag ORed in when the
+//                        call entered the target isolate
+//   out_call_target      nonzero: call this instead of the entry point, with
+//                        the entry point left in R10 (the contract of the
+//                        CallSimulatorFromFfiTrampoline stub); zero: call the
+//                        entry point directly
+// Installed in the kGetFfiCallbackMetadata slot of each trampoline page.
+extern "C" Thread* DLRT_GetFfiCallbackMetadataForInlineDispatch(
+    uword trampoline,
+    uword* out_entry_point,
+    uword* out_trampoline_type,
+    uword* out_call_target);
+#endif
