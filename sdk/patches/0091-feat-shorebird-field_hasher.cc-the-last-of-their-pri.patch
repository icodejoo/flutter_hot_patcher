diff --git a/runtime/vm/shorebird/link_info_test.cc b/runtime/vm/shorebird/link_info_test.cc
index 61406454bcd..1810ef4622b 100644
--- a/runtime/vm/shorebird/link_info_test.cc
+++ b/runtime/vm/shorebird/link_info_test.cc
@@ -8,6 +8,9 @@
 #include <vector>
 
 #include "vm/datastream.h"
+#include "vm/dart_api_impl.h"
+#include "vm/shorebird/field_hasher.h"
+#include "vm/symbols.h"
 #include "vm/unit_test.h"
 
 namespace dart {
@@ -177,4 +180,98 @@ VM_UNIT_TEST_CASE(IntervalInfo_LayoutMatchesTheirs) {
   EXPECT_EQ(static_cast<intptr_t>(9), interval.end_);
 }
 
+
+// Copied from profiler_test.cc, where these are file-local statics. The three
+// tests below need one real Field, and this is the shortest way to get one.
+static LibraryPtr LoadFieldTestScript(const char* script) {
+  Dart_Handle api_lib;
+  {
+    TransitionVMToNative transition(Thread::Current());
+    api_lib = TestCase::LoadTestScript(script, nullptr);
+    EXPECT_VALID(api_lib);
+  }
+  Library& lib = Library::Handle();
+  lib ^= Api::UnwrapHandle(api_lib);
+  return lib.ptr();
+}
+
+static FieldPtr LookupTestField(const Library& lib,
+                                const char* class_name,
+                                const char* field_name) {
+  Thread* thread = Thread::Current();
+  const Class& cls = Class::Handle(lib.LookupClassAllowPrivate(
+      String::Handle(Symbols::New(thread, class_name))));
+  EXPECT(!cls.IsNull());
+  const Field& field = Field::Handle(
+      cls.LookupField(String::Handle(String::New(field_name))));
+  EXPECT(!field.IsNull());
+  return field.ptr();
+}
+
+// One class, one field -- everything these tests need.
+static const char* kFieldHasherScript =
+    "class Holder {\n"
+    "  var alpha;\n"
+    "}\n"
+    "main() => Holder();\n";
+
+// ---------------------------------------------------------------------------
+// FieldHasher
+//
+// The producer's output is already checked against theirs entry by entry, so
+// what these pin is the one thing that check cannot see going wrong quietly:
+// the duplicate suffix. Their field table has 93 names that each appear twice,
+// and if the suffix incremented instead of repeating, or if the state were
+// per-call, the dump would still have the right number of entries.
+// ---------------------------------------------------------------------------
+
+// The suffix repeats " 1"; it does not count. Asking twice is the whole test,
+// because their DuplicateAwareHash takes a Field and nothing else -- the
+// occurrence count has to come from the hasher's own state, so the same field
+// asked twice must answer differently.
+TEST_CASE(FieldHasher_DuplicateSuffixRepeatsRatherThanCounts) {
+  const Library& lib = Library::Handle(LoadFieldTestScript(kFieldHasherScript));
+  const Field& alpha =
+      Field::Handle(LookupTestField(lib, "Holder", "alpha"));
+
+  FieldHasher hasher;
+  const std::string first = hasher.DuplicateAwareHash(alpha);
+  const std::string second = hasher.DuplicateAwareHash(alpha);
+  const std::string third = hasher.DuplicateAwareHash(alpha);
+
+  // "Holder.alpha <kind_bits>" then one " 1" per occurrence.
+  const std::string prefix = "Holder.alpha ";
+  EXPECT(first.compare(0, prefix.size(), prefix) == 0);
+  EXPECT_STREQ((first + " 1").c_str(), second.c_str());
+  EXPECT_STREQ((second + " 1").c_str(), third.c_str());
+  // Repeating, not counting: no occurrence index ever appears.
+  EXPECT(second.find(" 2") == std::string::npos);
+}
+
+// Two hashers do not share state. Their signature gives no way to reset, so if
+// the count lived in a function-local static instead of the object, a second
+// dump in the same process would inherit the first one's suffixes.
+TEST_CASE(FieldHasher_StateIsPerInstance) {
+  const Library& lib = Library::Handle(LoadFieldTestScript(kFieldHasherScript));
+  const Field& alpha =
+      Field::Handle(LookupTestField(lib, "Holder", "alpha"));
+
+  FieldHasher one;
+  FieldHasher two;
+  EXPECT_STREQ(one.DuplicateAwareHash(alpha).c_str(),
+               two.DuplicateAwareHash(alpha).c_str());
+}
+
+// The qualified name is the duplicate key and the hash's prefix, and the
+// producer also needs the bare field name for its FieldInfo entry. Deriving
+// both from one place is the point of exposing them.
+TEST_CASE(FieldHasher_QualifiedNameIsOwnerDotField) {
+  const Library& lib = Library::Handle(LoadFieldTestScript(kFieldHasherScript));
+  const Field& alpha =
+      Field::Handle(LookupTestField(lib, "Holder", "alpha"));
+
+  EXPECT_STREQ("Holder.alpha", FieldHasher::QualifiedName(alpha).c_str());
+  EXPECT_STREQ("alpha", FieldHasher::ScrubbedFieldName(alpha).c_str());
+}
+
 }  // namespace dart
