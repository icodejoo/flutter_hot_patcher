From 516d56e80ef5c0ad7057668320fb5db854a5d179 Mon Sep 17 00:00:00 2001
From: cruz <jelon@tbu.net>
Date: Mon, 24 Aug 2026 12:19:58 +0800
Subject: [PATCH 049/206] feat(shorebird): the CPU->Sim wrapper body, 60 of 68
 words byte-identical

The second of the two wrapper stubs now carries a real body instead of a
breakpoint, so both are the size theirs are: 16384 and 16380 bytes, which is
2014 pads + 272 and 2044 pads + 28.

Transcribed from their emitted stub, not their generator. Their gen_snapshot
writes every stub into the snapshot it produces and the ELF keeps the names, so
objdump prints <stub TransitionDartToSimulatorIfNeeded> in full. Their generator
reaches the same bytes through compiler::RunOnSimulator and four private
Assembler helpers -- 5084 bytes of generator whose entire contribution here is
272 bytes of output. We reproduce the output.

No displacement in it is a raw number: WRAPPER_STUBS.md sections 9 and 10 resolve
each one to a named field. That needed four new Thread fields --
dart_state_is_on_cpu_, simulator_csp_, simulator_async_resume_pc_,
simulator_execute_, simulator_call_from_ffi_ -- appended rather than placed where
theirs sit, for the reason in Thread::is_simulating(). The Simulator
displacements are upstream's layout, which theirs shares, so they are derived
rather than copied; the str x11,[x10,#0x310] nobody could explain is a store to
Simulator::pc_, handing the wrapper's target to the simulator as its next PC. It
is emitted twice, once by the stub generator and once inside RunOnSimulator --
their redundancy, reproduced.

Measured against their stub: 60 of 68 instructions identical in mnemonic and
operands. The other eight encode a Thread offset and differ only in the
displacement field, which is the same structural divergence that already leaves
word 4 of the Sim->CPU body non-identical and is not closable while our fields
are appended.

The new test pins the 60 as literals and re-derives the 8 from the offset
accessors, so a Thread field added later moves the expectation with the code
rather than breaking it. Negative control run: changing mov x0,x10 to mov x0,x11
-- a wrong register, the exact bug a size assertion cannot see -- makes it exit
255; reverting returns it to 0. ASSERT_EQUAL in the generator is compiled out of
a product build, so the 272 is pinned by the test, not by that assert.

All 81 shorebird cases pass, both builds link, and verify_reproduction.sh still
reports 24 artifacts with 0 failures.

Co-Authored-By: Claude <noreply@anthropic.com>

diff --git a/runtime/vm/compiler/stub_code_compiler_arm64.cc b/runtime/vm/compiler/stub_code_compiler_arm64.cc
index 32d5a28b2b1..275b8f657b9 100644
--- a/runtime/vm/compiler/stub_code_compiler_arm64.cc
+++ b/runtime/vm/compiler/stub_code_compiler_arm64.cc
@@ -652,12 +652,160 @@ void StubCodeCompiler::GenerateTransitionDartToSimulatorIfNeededStub() {
 
   Label body;
   GenerateShorebirdWrapperPads(assembler, layout, &body);
+  const intptr_t body_start = __ CodeSize();
 
-  // Placeholder. Their CPU->Sim body is 272 bytes and calls
-  // compiler::RunOnSimulator, and it has not been transcribed yet -- that is
-  // Phase D. Until then CPUToSimConfig::GetStubCodeRange reports an empty range,
-  // so no page is ever mapped from this stub and no pad can be entered.
-  __ Breakpoint();
+  // 68 instructions, transcribed from their *emitted* stub rather than from
+  // their generator: their gen_snapshot writes every stub into the snapshot it
+  // produces and the ELF keeps the names, so `objdump -d hello.so` prints
+  // `<stub TransitionDartToSimulatorIfNeeded>` in full. See
+  // spikes/shorebird_linkinfo_oracle/WRAPPER_STUBS.md sections 9 and 10, where
+  // every displacement below is resolved to a named field of Thread or
+  // Simulator -- nothing here is a raw number copied out of their binary.
+  //
+  // Their generator reaches these bytes through compiler::RunOnSimulator and
+  // four private Assembler helpers, 5084 bytes of generator in all. We
+  // reproduce the output, not that structure, and `cmp` against a freshly
+  // extracted stub is what judges it.
+  //
+  // The eight instructions that touch Thread cannot be byte-identical: their
+  // Shorebird block sits mid-struct at 0x8d8..0x900 while ours is appended, for
+  // the reason in Thread::is_simulating(). Everything else can be.
+  RELEASE_ASSERT(target::Thread::exit_through_ffi_offset() ==
+                 dart::Thread::exit_through_ffi_offset());
+
+  // Simulator field displacements. This is upstream's layout -- registers_ at
+  // 0, vregisters_ at 0x100, pc_ at 0x310 -- which their Simulator also has per
+  // its DWARF, so these are derived rather than copied. They are pinned only
+  // indirectly: StubCode_ShorebirdCpuToSimBodyMatchesTheirBytes compares the
+  // emitted encodings, so a wrong displacement here fails that test. There is
+  // no static_assert against the real Simulator, because this file is compiled
+  // for the target and cannot include simulator_arm64.h.
+  constexpr intptr_t kSimReg = 8;           // registers_[r]  == r * 8
+  constexpr intptr_t kSimVRegBase = 0x100;  // vregisters_[v] == 0x100 + v * 16
+  constexpr intptr_t kSimVReg = 16;
+  constexpr intptr_t kSimPc = 0x310;        // Simulator::pc_
+  // Their frame pointer lands 0xd0 above the simulator's C stack pointer.
+  constexpr intptr_t kSimCFrameSize = 0xd0;
+
+  // The pad left its own address in TMP; the metadata mapping sits one
+  // rx-mapping above it and holds the entry point this wrapper stands for.
+  __ LoadImmediate(TMP2, layout.rx_mapping_size);   // mov x17, #0x8000
+  __ add(TMP, TMP, Operand(TMP2));                  // add x16, x16, x17
+  __ ldr(R11, Address(TMP, 0), kEightBytes);        // ldr x11, [x16]
+
+  // Already simulating -> tail-jump to the target and do nothing else. Running
+  // on the CPU (flag clear) -> fall into the long path. This is the opposite
+  // sense to the Sim->CPU body's cbz under one and the same meaning of the
+  // flag, and that agreement is what makes the polarity trustworthy.
+  Label enter_simulator;
+  __ ldr(TMP2, Address(THR, dart::Thread::is_simulating_offset()),
+         kEightBytes);
+  __ cbz(&enter_simulator, TMP2, kEightBytes);
+  __ br(R11);
+  __ Bind(&enter_simulator);
+
+  // Thread::isolate_ -> the isolate's simulator, then hand it the target as the
+  // PC to resume at. They store it twice, once here and once inside
+  // RunOnSimulator; the redundancy is theirs and is reproduced.
+  __ ldr(R10, Address(THR, target::Thread::isolate_offset()), kEightBytes);
+  __ ldr(R10, Address(R10, 0x20), kEightBytes);
+  __ str(R11, Address(R10, kSimPc), kEightBytes);
+  __ str(R11, Address(R10, kSimPc), kEightBytes);
+
+  // Spill the callee-saved state into the simulator's register file so
+  // simulated code sees what the CPU was holding.
+  __ str(SPREG, Address(R10, 15 * kSimReg), kEightBytes);
+  __ stp(R19, R20, Address::Pair(R10, 19 * kSimReg));
+  __ stp(R21, R22, Address::Pair(R10, 21 * kSimReg));
+  __ stp(R23, R24, Address::Pair(R10, 23 * kSimReg));
+  __ stp(R25, R26, Address::Pair(R10, 25 * kSimReg));
+  __ stp(R27, R28, Address::Pair(R10, 27 * kSimReg));
+  __ stp(R29, R30, Address::Pair(R10, 29 * kSimReg));
+  __ mov(TMP, CSP);
+  __ str(TMP, Address(R10, 31 * kSimReg), kEightBytes);
+  __ fstp(V8, V9, Address::Pair(R10, kSimVRegBase + 8 * kSimVReg), kQWord);
+  __ fstp(V10, V11, Address::Pair(R10, kSimVRegBase + 10 * kSimVReg), kQWord);
+  __ fstp(V12, V13, Address::Pair(R10, kSimVRegBase + 12 * kSimVReg), kQWord);
+  __ fstp(V14, V15, Address::Pair(R10, kSimVRegBase + 14 * kSimVReg), kQWord);
+
+  // Assert we were on the CPU, then flip the flag. A stub entered in the wrong
+  // state traps here instead of corrupting the switch.
+  Label was_on_cpu;
+  __ ldr(TMP, Address(THR, dart::Thread::dart_state_is_on_cpu_offset()),
+         kEightBytes);
+  __ CompareImmediate(TMP, 1);
+  __ b(&was_on_cpu, EQ);
+  __ brk(0);
+  __ Bind(&was_on_cpu);
+  __ eori(TMP, TMP, Immediate(1));
+  __ str(TMP, Address(THR, dart::Thread::dart_state_is_on_cpu_offset()),
+         kEightBytes);
+
+  // Move onto the simulator's own C stack before calling into it.
+  __ ldr(TMP, Address(THR, dart::Thread::simulator_csp_offset()), kEightBytes);
+  __ mov(CSP, TMP);
+  __ AddImmediate(FP, CSP, kSimCFrameSize);
+
+  // Spill the argument and volatile registers too.
+  __ stp(R0, R1, Address::Pair(R10, 0 * kSimReg));
+  __ stp(R2, R3, Address::Pair(R10, 2 * kSimReg));
+  __ stp(R4, R5, Address::Pair(R10, 4 * kSimReg));
+  __ stp(R6, R7, Address::Pair(R10, 6 * kSimReg));
+  __ stp(R8, R9, Address::Pair(R10, 8 * kSimReg));
+  __ fstp(V0, V1, Address::Pair(R10, kSimVRegBase + 0 * kSimVReg), kQWord);
+  __ fstp(V2, V3, Address::Pair(R10, kSimVRegBase + 2 * kSimVReg), kQWord);
+  __ fstp(V4, V5, Address::Pair(R10, kSimVRegBase + 4 * kSimVReg), kQWord);
+  __ fstp(V6, V7, Address::Pair(R10, kSimVRegBase + 6 * kSimVReg), kQWord);
+
+  // Simulator::Execute(simulator, source), reached through the Thread so the
+  // stub needs no relocation. Source 0 is what their generator passes.
+  __ mov(R0, R10);
+  __ LoadImmediate(R1, 0);
+  __ ldr(TMP, Address(THR, dart::Thread::simulator_execute_offset()),
+         kEightBytes);
+  // The assembler tracks whether LR still holds a return address and refuses a
+  // blr while it does. Ours was spilled with x29/x30 into the register file a
+  // few instructions ago, so the call is safe; tell the tracker that, and tell
+  // it again once the reload below has put LR back, or the closing ret is
+  // rejected in turn.
+  __ set_lr_state(compiler::LRState::Clobbered());
+  __ blr(TMP);
+
+  // The simulator hands back its register file; reload the mirror image.
+  __ mov(R10, R0);
+  __ ldr(SPREG, Address(R10, 15 * kSimReg), kEightBytes);
+  __ ldp(R19, R20, Address::Pair(R10, 19 * kSimReg));
+  __ ldp(R21, R22, Address::Pair(R10, 21 * kSimReg));
+  __ ldp(R23, R24, Address::Pair(R10, 23 * kSimReg));
+  __ ldp(R25, R26, Address::Pair(R10, 25 * kSimReg));
+  __ ldp(R27, R28, Address::Pair(R10, 27 * kSimReg));
+  __ ldp(R29, R30, Address::Pair(R10, 29 * kSimReg));
+  __ set_lr_state(compiler::LRState::OnEntry());
+  __ ldr(TMP, Address(R10, 31 * kSimReg), kEightBytes);
+  __ mov(CSP, TMP);
+  __ fldp(V8, V9, Address::Pair(R10, kSimVRegBase + 8 * kSimVReg), kQWord);
+  __ fldp(V10, V11, Address::Pair(R10, kSimVRegBase + 10 * kSimVReg), kQWord);
+  __ fldp(V12, V13, Address::Pair(R10, kSimVRegBase + 12 * kSimVReg), kQWord);
+  __ fldp(V14, V15, Address::Pair(R10, kSimVRegBase + 14 * kSimVReg), kQWord);
+
+  // Mirror of the check above, with the opposite expected value.
+  Label was_on_simulator;
+  __ ldr(TMP, Address(THR, dart::Thread::dart_state_is_on_cpu_offset()),
+         kEightBytes);
+  __ CompareImmediate(TMP, 0);
+  __ b(&was_on_simulator, EQ);
+  __ brk(0);
+  __ Bind(&was_on_simulator);
+  __ eori(TMP, TMP, Immediate(1));
+  __ str(TMP, Address(THR, dart::Thread::dart_state_is_on_cpu_offset()),
+         kEightBytes);
+
+  // Only the return-value registers come back; the rest were restored above.
+  __ fldrq(V0, Address(R10, kSimVRegBase));
+  __ ldp(R0, R1, Address::Pair(R10, 0 * kSimReg));
+  __ ret();
+
+  ASSERT_EQUAL(__ CodeSize() - body_start, layout.shared_body_size);
 }
 
