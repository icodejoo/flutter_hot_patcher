From f147b32f87fee19d6e2551efc60450815c1fb8f4 Mon Sep 17 00:00:00 2001
From: cruz <cruz@tbu.net>
Date: Wed, 30 Sep 2026 11:55:47 +0800
Subject: [PATCH 185/206] [vm] Shorebird: CPU-shape native and runtime call
 stubs (F156, F157)

CallAutoScopeNative / CallBootstrapNative / CallNoScopeNative (384 B),
CallToRuntime (396 B) and CallNativeThroughSafepoint (408 B) take
Shorebird's shape in AOT stubs of simulator-including builds; JIT stubs and
builds without the simulator are unchanged. Thread::enter/exit_safepoint_
entry_point_ are now initialised (SimulatorEnter/ExitSafepoint) -- they
were never set before. Sizes after rebuild equal theirs on all three
fixtures; sdk_phase_checklist C1 7 -> 2.

RUNTIME NOT COMPLETE: the new shape relies on the runtime keeping the
on-CPU state Shorebird's runtime maintains, which ours does not yet do, so
a simulator-build AOT runtime executing these stubs traps on its first
runtime call. This branch is for size parity; do not ship from it.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/runtime/vm/compiler/stub_code_compiler_arm64.cc b/runtime/vm/compiler/stub_code_compiler_arm64.cc
index 4089a423d15..659238fbbae 100644
--- a/runtime/vm/compiler/stub_code_compiler_arm64.cc
+++ b/runtime/vm/compiler/stub_code_compiler_arm64.cc
@@ -176,6 +176,161 @@ static void WithExceptionCatchingTrampoline(Assembler* assembler,
 #endif  // !defined(DART_INCLUDE_SIMULATOR)
 }
 
+// Shorebird. Whether the CPU-side runtime-call stubs -- CallToRuntime, the
+// three Call*Native stubs and CallNativeThroughSafepoint -- take Shorebird's
+// shape: the C call wrapped in CallOnClangStack below, and (in
+// CallNativeThroughSafepoint) the safepoint slow paths going through the entry
+// points cached in the Thread rather than through the stub Code objects.
+//
+// That shape presupposes Shorebird's execution model: Dart running on the CPU
+// was entered through RunDartOnCPU, which set Thread::dart_state_is_on_cpu_ to
+// 1 and Thread::simulator_csp_ to the C stack, and Isolate::simulator_ is not
+// null. Nothing in our runtime establishes that yet. A stub of this shape run
+// without it traps on CallOnClangStack's brk #0 guard (or faults on a null
+// simulator), whether it runs on the CPU or is interpreted by our simulator.
+// So it is emitted only where it is measured -- AOT code generated by a
+// simulator-including gen_snapshot, which is how the parity snapshots are
+// produced -- and every JIT stub (run_vm_tests) and every build without the
+// simulator keeps upstream's shape.
+static bool UseShorebirdCpuRuntimeCallShape() {
+#if defined(DART_INCLUDE_SIMULATOR)
+  return FLAG_precompiled_mode && !FLAG_use_slow_path &&
+         !FLAG_target_thread_sanitizer;
+#else
+  return false;
+#endif
+}
+
+// Shorebird. Emit `call` -- a blr into C -- so that it runs on the thread's C
+// stack instead of the Dart stack, with the Dart callee-saved state parked in
+// the simulator's register file for the duration. This is their
+// compiler::CallOnClangStack(Assembler*, std::function<void()>), a file-static
+// helper whose only callers in their gen_snapshot are the generators of
+// CallToRuntime, CallNativeThroughSafepoint, CallNoScopeNative,
+// CallAutoScopeNative and CallBootstrapNative. It is built from their
+// Assembler::StoreRegistersToSim, RestoreClangRegisters, ShorebirdEnterCFrame,
+// a static CopyTopFrame(Assembler*, Register, Register, Register),
+// ShorebirdLeaveCFrame and LoadRegistersFromSim; the grouping below follows
+// those pieces. It adds 38 instructions before `call` and 22 after.
+//
+// The register-file layout (registers_[r] at r * 8, vregisters_[v] at
+// 0x100 + v * 16) and the 0xd0 distance from simulator_csp_ to the frame
+// record RunDartOnCPU leaves above it are the ones GenerateEnterSimulator and
+// GenerateRunDartOnCPUStub already use. Like them, the Shorebird Thread and
+// Isolate fields are addressed through the host offsets, which equal theirs on
+// arm64 without compressed pointers (see Thread::is_simulating()).
+//
+// Clobbers R10, R13, R14, TMP and TMP2; R0-R9 and V0-V7 reach `call` intact.
+static void CallOnClangStack(Assembler* assembler,
+                             const std::function<void()>& call) {
+  constexpr intptr_t kSimReg = 8;           // registers_[r]  == r * 8
+  constexpr intptr_t kSimVRegBase = 0x100;  // vregisters_[v] == 0x100 + v * 16
+  constexpr intptr_t kSimVReg = 16;
+  constexpr intptr_t kSimCFrameSize = 0xd0;
+  const Register kSim = R10;
+  const Register kSpanTop = R13;     // Dart FP: the copied span ends here.
+  const Register kSpanBottom = R14;  // Dart SP: ... and starts here.
+
+  // 4 instructions: find the register file, remember the Dart span.
+  __ ldr(TMP, Address(THR, target::Thread::isolate_offset()), kEightBytes);
+  __ ldr(kSim, Address(TMP, dart::Isolate::simulator_offset()), kEightBytes);
+  __ mov(kSpanTop, FP);
+  __ mov(kSpanBottom, SP);
+
+  // StoreRegistersToSim, 13 instructions: the Dart SP, the callee-saved
+  // registers, the C stack pointer and the callee-saved halves of q8-q15.
+  __ str(SPREG, Address(kSim, 15 * kSimReg), kEightBytes);
+  __ stp(R19, R20, Address::Pair(kSim, 19 * kSimReg));
+  __ stp(R21, R22, Address::Pair(kSim, 21 * kSimReg));
+  __ stp(R23, R24, Address::Pair(kSim, 23 * kSimReg));
+  __ stp(R25, R26, Address::Pair(kSim, 25 * kSimReg));
+  __ stp(R27, R28, Address::Pair(kSim, 27 * kSimReg));
+  __ stp(R29, R30, Address::Pair(kSim, 29 * kSimReg));
+  __ mov(TMP, CSP);
+  __ str(TMP, Address(kSim, 31 * kSimReg), kEightBytes);
+  __ fstp(V8, V9, Address::Pair(kSim, kSimVRegBase + 8 * kSimVReg), kQWord);
+  __ fstp(V10, V11, Address::Pair(kSim, kSimVRegBase + 10 * kSimVReg), kQWord);
+  __ fstp(V12, V13, Address::Pair(kSim, kSimVRegBase + 12 * kSimVReg), kQWord);
+  __ fstp(V14, V15, Address::Pair(kSim, kSimVRegBase + 14 * kSimVReg), kQWord);
+
+  // RestoreClangRegisters, 9 instructions: assert Dart is on the CPU and say
+  // it no longer is, then take the C stack and the frame record above it.
+  Label was_on_cpu;
+  __ ldr(TMP, Address(THR, dart::Thread::dart_state_is_on_cpu_offset()),
+         kEightBytes);
+  __ CompareImmediate(TMP, 1);
+  __ b(&was_on_cpu, EQ);
+  __ brk(0);
+  __ Bind(&was_on_cpu);
+  __ eori(TMP, TMP, Immediate(1));
+  __ str(TMP, Address(THR, dart::Thread::dart_state_is_on_cpu_offset()),
+         kEightBytes);
+  __ ldr(TMP, Address(THR, dart::Thread::simulator_csp_offset()), kEightBytes);
+  __ mov(CSP, TMP);
+  __ AddImmediate(FP, CSP, kSimCFrameSize);
+
+  // 1 instruction: keep the register file across the call.
+  __ str(kSim, Address(CSP, -16, Address::PreIndex), kEightBytes);
+
+  // ShorebirdEnterCFrame, 2 instructions.
+  __ stp(R29, R30, Address::Pair(CSP, -16, Address::PairPreIndex));
+  __ mov(R29, CSP);
+
+  // CopyTopFrame, 9 instructions: copy [Dart SP, Dart FP) onto the C stack in
+  // 16-byte pairs, top down, padding an odd-8 span by one slot so the C stack
+  // stays 16-aligned. The same loop as CallClangCodeWithSimulatorArgs.
+  Label copy, check;
+  __ sub(TMP, kSpanTop, Operand(kSpanBottom));
+  __ tsti(TMP, Immediate(0xf));
+  __ b(&check, EQ);
+  __ AddImmediate(kSpanTop, 8);
+  __ b(&check);
+  __ Bind(&copy);
+  __ ldp(TMP, TMP2, Address::Pair(kSpanTop, -16, Address::PairPreIndex));
+  __ stp(TMP, TMP2, Address::Pair(CSP, -16, Address::PairPreIndex));
+  __ Bind(&check);
+  __ cmp(kSpanTop, Operand(kSpanBottom));
+  __ b(&copy, GT);
+
+  call();
+
+  // ShorebirdLeaveCFrame, 2 instructions.
+  __ mov(CSP, R29);
+  __ ldp(R29, R30, Address::Pair(CSP, 16, Address::PairPostIndex));
+
+  // 1 instruction.
+  __ ldr(kSim, Address(CSP, 16, Address::PostIndex), kEightBytes);
+
+  // LoadRegistersFromSim, 13 instructions: the mirror image of the spill,
+  // which also puts back the Dart SP, FP and CSP.
+  __ ldr(SPREG, Address(kSim, 15 * kSimReg), kEightBytes);
+  __ ldp(R19, R20, Address::Pair(kSim, 19 * kSimReg));
+  __ ldp(R21, R22, Address::Pair(kSim, 21 * kSimReg));
+  __ ldp(R23, R24, Address::Pair(kSim, 23 * kSimReg));
+  __ ldp(R25, R26, Address::Pair(kSim, 25 * kSimReg));
+  __ ldp(R27, R28, Address::Pair(kSim, 27 * kSimReg));
+  __ ldp(R29, R30, Address::Pair(kSim, 29 * kSimReg));
+  __ ldr(TMP, Address(kSim, 31 * kSimReg), kEightBytes);
+  __ mov(CSP, TMP);
+  __ fldp(V8, V9, Address::Pair(kSim, kSimVRegBase + 8 * kSimVReg), kQWord);
+  __ fldp(V10, V11, Address::Pair(kSim, kSimVRegBase + 10 * kSimVReg), kQWord);
+  __ fldp(V12, V13, Address::Pair(kSim, kSimVRegBase + 12 * kSimVReg), kQWord);
+  __ fldp(V14, V15, Address::Pair(kSim, kSimVRegBase + 14 * kSimVReg), kQWord);
+
+  // 6 instructions: the mirror of the guard above, with the opposite
+  // expected value.
+  Label was_off_cpu;
+  __ ldr(TMP, Address(THR, dart::Thread::dart_state_is_on_cpu_offset()),
+         kEightBytes);
+  __ CompareImmediate(TMP, 0);
+  __ b(&was_off_cpu, EQ);
+  __ brk(0);
+  __ Bind(&was_off_cpu);
+  __ eori(TMP, TMP, Immediate(1));
+  __ str(TMP, Address(THR, dart::Thread::dart_state_is_on_cpu_offset()),
+         kEightBytes);
+}
+
 // Input parameters:
 //   LR : return address.
 //   SP : address of last argument in argument array.
@@ -257,7 +412,11 @@ void StubCodeCompiler::GenerateCallToRuntimeStub() {
     __ mov(R25, CSP);
     __ mov(CSP, SP);
 
-    __ blr(R5);
+    if (UseShorebirdCpuRuntimeCallShape()) {
+      CallOnClangStack(assembler, [&]() { __ blr(R5); });
+    } else {
+      __ blr(R5);
+    }
     __ Comment("CallToRuntimeStub return");
 
     // Restore SP and CSP.
@@ -407,13 +566,30 @@ void StubCodeCompiler::GenerateExitSafepointStub() {
 // On exit:
 //   R19: clobbered, although normally callee-saved
 //   Stack: preserved, CSP == SP
+static void GenerateSimulatorSafepointTransition(Assembler* assembler,
+                                                 bool entering,
+                                                 intptr_t entry_point_offset);
+
 void StubCodeCompiler::GenerateCallNativeThroughSafepointStub() {
   COMPILE_ASSERT(IsAbiPreservedRegister(R19));
+  // Shorebird's shape differs from upstream's in three places, all below:
+  // each safepoint slow path is one load of an entry point cached in the
+  // Thread instead of the stub Code plus a load of its entry point (one
+  // instruction fewer each), there is no simulator FFI redirect before the
+  // call, and the call runs through CallOnClangStack.
+  const bool shorebird = UseShorebirdCpuRuntimeCallShape();
 
   SPILLS_RETURN_ADDRESS_FROM_LR_TO_REGISTER(__ mov(R19, LR));
   __ LoadImmediate(R10, target::Thread::exit_through_ffi());
   __ TransitionGeneratedToNative(R9, FPREG, R10 /*volatile*/,
-                                 /*enter_safepoint=*/true);
+                                 /*enter_safepoint=*/!shorebird);
+  if (shorebird) {
+    // Same instructions as Assembler::EnterFullSafepoint(R10) with the fast
+    // path unforced, except the slow path's target.
+    GenerateSimulatorSafepointTransition(
+        assembler, /*entering=*/true,
+        dart::Thread::enter_safepoint_entry_point_offset());
+  }
   __ mov(R25, CSP);
   __ mov(CSP, SP);
 
@@ -428,17 +604,28 @@ void StubCodeCompiler::GenerateCallNativeThroughSafepointStub() {
   __ Bind(&done);
 #endif
 
+  if (shorebird) {
+    CallOnClangStack(assembler, [&]() { __ blr(R9); });
+  } else {
 #if defined(SIMULATOR_FFI)
-  if (FLAG_use_simulator) {
-    __ Emit(Instr::kSimulatorFfiRedirectInstruction);
-  }
+    if (FLAG_use_simulator) {
+      __ Emit(Instr::kSimulatorFfiRedirectInstruction);
+    }
 #endif
-  __ blr(R9);
+    __ blr(R9);
+  }
 
   __ mov(SP, CSP);
   __ mov(CSP, R25);
 
-  __ TransitionNativeToGenerated(R10, /*exit_safepoint=*/true);
+  if (shorebird) {
+    // Same instructions as Assembler::ExitFullSafepoint(R10), except the slow
+    // path's target; then the rest of TransitionNativeToGenerated.
+    GenerateSimulatorSafepointTransition(
+        assembler, /*entering=*/false,
+        dart::Thread::exit_safepoint_entry_point_offset());
+  }
+  __ TransitionNativeToGenerated(R10, /*exit_safepoint=*/!shorebird);
   __ ret(R19);
 }
 
@@ -1545,8 +1732,9 @@ void StubCodeCompiler::GenerateWriteError(bool with_fpu_regs) {
 //   R5 : address of the native function to call.
 //   R2 : address of first argument in argument array.
 //   R1 : argc_tag including number of arguments and function kind.
-static void GenerateCallNativeWithWrapperStub(Assembler* assembler,
-                                              Address wrapper) {
+static void GenerateCallNativeWithWrapperStub(
+    Assembler* assembler,
+    intptr_t wrapper_entry_point_offset) {
   const intptr_t thread_offset = target::NativeArguments::thread_offset();
   const intptr_t argc_tag_offset = target::NativeArguments::argc_tag_offset();
   const intptr_t argv_offset = target::NativeArguments::argv_offset();
@@ -1620,7 +1808,16 @@ static void GenerateCallNativeWithWrapperStub(Assembler* assembler,
     __ mov(R1, R5);  // Pass the function entrypoint to call.
 
     // Call native function invocation wrapper or redirection via simulator.
-    __ Call(wrapper);
+    if (UseShorebirdCpuRuntimeCallShape()) {
+      // Theirs copies THR to R7 before CallOnClangStack and loads the wrapper
+      // through the copy: one instruction more than the call alone.
+      __ mov(R7, THR);
+      CallOnClangStack(assembler, [&]() {
+        __ Call(Address(R7, wrapper_entry_point_offset));
+      });
+    } else {
+      __ Call(Address(THR, wrapper_entry_point_offset));
+    }
 
     // Restore SP and CSP.
     __ mov(SP, CSP);
@@ -1652,16 +1849,13 @@ static void GenerateCallNativeWithWrapperStub(Assembler* assembler,
 
 void StubCodeCompiler::GenerateCallNoScopeNativeStub() {
   GenerateCallNativeWithWrapperStub(
-      assembler,
-      Address(THR,
-              target::Thread::no_scope_native_wrapper_entry_point_offset()));
+      assembler, target::Thread::no_scope_native_wrapper_entry_point_offset());
 }
 
 void StubCodeCompiler::GenerateCallAutoScopeNativeStub() {
   GenerateCallNativeWithWrapperStub(
       assembler,
-      Address(THR,
-              target::Thread::auto_scope_native_wrapper_entry_point_offset()));
+      target::Thread::auto_scope_native_wrapper_entry_point_offset());
 }
 
 // Input parameters:
@@ -1673,8 +1867,7 @@ void StubCodeCompiler::GenerateCallAutoScopeNativeStub() {
 void StubCodeCompiler::GenerateCallBootstrapNativeStub() {
   GenerateCallNativeWithWrapperStub(
       assembler,
-      Address(THR,
-              target::Thread::bootstrap_native_wrapper_entry_point_offset()));
+      target::Thread::bootstrap_native_wrapper_entry_point_offset());
 }
 
 // Input parameters:
diff --git a/runtime/vm/thread.cc b/runtime/vm/thread.cc
index 820573be0fc..06f9df99bd5 100644
--- a/runtime/vm/thread.cc
+++ b/runtime/vm/thread.cc
@@ -241,6 +241,21 @@ void Thread::InitVMConstants() {
   call_auto_scope_native_entry_point_ =
       StubCode::CallAutoScopeNative().EntryPoint();
 
+  // Shorebird: Thread+0x920 / +0x928, the safepoint slow paths of
+  // CallNativeThroughSafepoint (Shorebird shape, see
+  // UseShorebirdCpuRuntimeCallShape) and SimulatorCallNativeThroughSafepoint.
+  // Their InitVMConstants fills both from its table of stub Code handles; the
+  // two slots it reads sit directly after ResumeOnCPU's and
+  // ResumeOnSimulator's, which in their stub declaration order (ours since
+  // F148) are SimulatorEnterSafepoint and SimulatorExitSafepoint. Until this
+  // change nothing wrote these fields, so SimulatorCallNativeThroughSafepoint's
+  // slow path called address 0.
+  ASSERT(enter_safepoint_entry_point_ == 0);
+  ASSERT(exit_safepoint_entry_point_ == 0);
+  enter_safepoint_entry_point_ =
+      StubCode::SimulatorEnterSafepoint().EntryPoint();
+  exit_safepoint_entry_point_ = StubCode::SimulatorExitSafepoint().EntryPoint();
+
 // Setup the thread specific reusable handles.
 #define REUSABLE_HANDLE_ALLOCATION(object)                                     \
   this->object##_handle_ = this->AllocateReusableHandle<object>();
