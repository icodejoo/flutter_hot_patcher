+// FlowGraphBuilderHelper's graph, but owned by a caller-supplied Function
+// instead of the synthetic "dummy" one.
+//
+// 🔴 Not a stylistic preference. The serializer encodes every Function as
+// (owner class id, index within owner) and asserts the index was found
+// (il_serializer.cc:843); a Function::New that was never added to its owner's
+// function array gives -1. FlowGraphBuilderHelper's function is exactly that
+// (il_test_helper.h:407), and BlockBuilder hangs an Environment carrying the
+// graph's function off the block entry unconditionally
+// (block_builder.h:29-32) -- so NO graph built by that helper can be
+// serialized, whatever instructions it holds. Copied from MakeDummyGraph rather
+// than shared with it because that one is private to the helper.
+static FlowGraph* MakeGraphOwnedBy(Thread* thread, const Function& function) {
+  Zone* const zone = thread->zone();
+  auto* const parsed_function = new (zone) ParsedFunction(thread, function);
+  parsed_function->set_scope(new LocalScope(nullptr, 0, 0));
+  auto* const graph_entry =
+      new GraphEntryInstr(*parsed_function, Compiler::kNoOSRDeoptId);
+  const intptr_t block_id = 1;  // 0 is GraphEntry.
+  graph_entry->set_normal_entry(
+      new FunctionEntryInstr(graph_entry, block_id, kInvalidTryIndex,
+                             CompilerState::Current().GetNextDeoptId()));
+  auto* const graph = new FlowGraph(
+      *parsed_function, graph_entry, block_id, PrologueInfo{-1, -1},
+      FlowGraph::CompilationModeFrom(/*is_optimizing=*/true));
+  graph->CreateCommonConstants();
+  return graph;
+}
+
