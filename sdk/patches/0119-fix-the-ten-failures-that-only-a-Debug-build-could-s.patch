+  // The bound is the image's end, not somewhere past it.
+  EXPECT(InPatchSnapshot(group, patch.end() - 1));
+  EXPECT(!InPatchSnapshot(group, patch.end()));
 
   // No base set, so nothing is in the base -- including a pc that really is in
   // the patch. The two queries are about different images, not about each
@@ -598,15 +659,20 @@ ISOLATE_UNIT_TEST_CASE(Shorebird_PcQueriesAnswerForTheRightImage) {
   EXPECT(!InBaseSnapshot(group, patch_pc));
 
   // Point the base at a different image and the answers separate.
-  Shorebird_SetBaseSnapshots(other_image, other_image, other_image,
-                             other_image);
-  EXPECT(InBaseSnapshot(group, reinterpret_cast<uword>(other_image)));
+  Shorebird_SetBaseSnapshots(base.base(), base.base(), base.base(),
