-                         H.flow_graph()->graph_entry()->normal_entry());
+    BlockBuilder builder(graph, graph->graph_entry()->normal_entry());
     InputsArray args(1);
-    args.Add(new Value(H.IntConstant(1)));
+    args.Add(new Value(graph->GetConstant(
+        Integer::Handle(Integer::NewCanonical(1)))));
