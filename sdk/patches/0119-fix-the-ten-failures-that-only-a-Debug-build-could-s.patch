 namespace dart {
@@ -185,6 +192,36 @@ void WrapperAllocator::EnsureStubPage() {
   offset_of_first_wrapper_in_page_ = code_start - page_start;
 }
 
+// Whether the mapping containing `address` is one the CPU may execute.
+//
+// This asks DuplicateRX's own documented precondition -- virtual_memory.h:122,
+// "Assumes `this` has RX protection and is codesigned" -- instead of assuming
+// it. vm_remap can only hand back the protection the source already has; it
+// reports it in current_protection, and upstream then asserts that it includes
+// VM_PROT_EXECUTE (virtual_memory_posix.cc:893). So "may we remap?" is exactly
+// "is the source executable?", which is a fact about the mapping and worth
+// reading rather than deriving from a flag: FLAG_use_simulator is the reason
+// the *generated* stub's page is not executable, but it says nothing about a
+// stub range that points into the host binary's own __TEXT, which is what
+// wrapper_test.cc's TestStubCodeRange does.
+#if defined(DART_HOST_OS_MACOS)
+static bool IsExecutableMapping(uword address) {
+  mach_vm_address_t region = static_cast<mach_vm_address_t>(address);
+  mach_vm_size_t region_size = 0;
+  vm_region_basic_info_data_64_t info;
+  mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+  mach_port_t object_name = MACH_PORT_NULL;
+  const kern_return_t status = mach_vm_region(
+      mach_task_self(), &region, &region_size, VM_REGION_BASIC_INFO_64,
+      reinterpret_cast<vm_region_info_t>(&info), &count, &object_name);
+  if (status != KERN_SUCCESS) return false;
+  // mach_vm_region answers with the first region at or *after* the address, so
+  // a hole below a mapping would otherwise read as that mapping.
+  if (region > static_cast<mach_vm_address_t>(address)) return false;
+  return (info.protection & VM_PROT_EXECUTE) != 0;
+}
+#endif  // defined(DART_HOST_OS_MACOS)
+
 VirtualMemory* WrapperAllocator::AllocateWrapperPage() {
   EnsureStubPage();
   if (stub_page_ == nullptr) {
@@ -204,10 +241,59 @@ VirtualMemory* WrapperAllocator::AllocateWrapperPage() {
 
   // Copy-on-write duplicate of the stub's code over the RX half. Divergence
   // stays local to this mapping; nothing writes instructions at runtime.
+  //
+  // ...but only when the source really is executable. When the stub range is a
+  // *generated* stub and the simulator is in charge, it is not: Page::Allocate
+  // (heap/page.cc:76) drops kExecutable whenever FLAG_use_simulator is on,
+  // because generated code is interpreted and never branched to. vm_remap then
+  // hands back current_protection == VM_PROT_READ and DuplicateRX's
+  // postcondition (ASSERT_EQUAL(current_protection & read_execute,
+  // read_execute), virtual_memory_posix.cc:893) is false. That ASSERT is
+  // compiled out of release, which is the only reason this went unseen -- the
+  // mapping it produced was never RX in any simulator build, silently.
+  //
+  // Nor is it a corner case: wrappers exist only to cross between host CPU code
+  // and simulated code, so the production caller
+  // (Deserializer::WrapperForRunTarget) runs in a simulating configuration
+  // every time, and the remap could never deliver there what it promised.
+  //
+  // Upstream meets the same wall and answers it by not remapping:
+  // FfiCallbackMetadata::AllocateTrampolinePage's should_remap_stub_page is
+  // false unless DART_HOST_OS_MACOS && DART_PRECOMPILED_RUNTIME, and its other
+  // branch copies the bytes. Copying is what is wanted here too -- the
+  // simulator *reads* the shared body's instructions out of this page, so the
+  // bytes must be present, but nothing executes them natively, so the page need
+  // not be executable, and it is already allocated non-executable just above.
+  //
+  // ⚠️ What this does NOT reproduce: upstream's simulator path avoids the whole
+  // problem by pointing its stub range at a host-native assembly trampoline
+  // (SimulatorFfiCallbackTrampoline, ffi_callback_metadata.cc:35) rather than at
+  // a generated stub, which keeps the source page RX. Shorebird presumably does
+  // something equivalent for the CPU->Sim direction, where host code must be
+  // able to branch to the wrapper. We have no evidence of what, so this does not
+  // invent one; it makes the page hold the right bytes and leaves that open.
+#if defined(DART_HOST_OS_MACOS)
+  const bool can_remap = IsExecutableMapping(stub_page_->start());
+#else
+  const bool can_remap = false;
+#endif
+
+  if (!can_remap) {
+    if (stub_page_->size() > page->size()) {
+      delete page;
+      return nullptr;
+    }
+    memcpy(page->address(), stub_page_->address(),  // NOLINT
+           stub_page_->size());
+    return page;
+  }
+
+#if defined(DART_HOST_OS_MACOS)
   if (!stub_page_->DuplicateRX(page)) {
     delete page;
     return nullptr;
   }
+#endif
   return page;
 }
 
