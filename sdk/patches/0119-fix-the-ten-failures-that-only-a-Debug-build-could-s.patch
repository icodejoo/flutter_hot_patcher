+// A real instructions image, built here.
+//
+// 🔴 The two tests further down used to reach for
+// dart::bin::vm_snapshot_instructions and call it "a real Image the reader can
+// measure rather than a fabricated buffer". It is neither real nor an Image in
+// this binary: gen/runtime/bin/vm_snapshot_instructions.bin is 0 bytes (JIT
+// snapshots carry no instructions image), so
+// `extern const uint8_t kDartVmSnapshotInstructions[]` is a zero-length array
+// and its address is whatever the linker put next. Measured in
+// xcodebuild/ReleaseARM64: _kDartVmSnapshotInstructions is 0x10003ec40, which
+// `otool -tV` names dart::bin::DFE::~DFE() -- the tests were reading
+// `stp x20, x19, [sp, #-0x20]!` as the image's ImageSize field. `end > start`
+// then held for a ~2.6 GB range beginning at a random function, and
+// InPatchSnapshot answered yes inside it. Both tests passed on that.
+// isolate_snapshot_instructions.bin is 0 bytes too, so the patch side was the
+// same accident.
+//
+// Image additionally requires kObjectStartAlignment (64) and
+// runtime/tools/bin_to_assembly.py emits only `.balign 32`, so even a non-empty
+// blob would meet the Image contract by luck. It did in ReleaseARM64
+// (64-aligned) and did not in the Debug simulator build (32 mod 64), which is
+// what finally made the ASSERT at image_snapshot.h:47 fire and exposed all of
+// the above.
+//
+// So: build one. The header is two words -- total size, then 0 for "no
+// InstructionsSection", which is what makes ExtraInfo() return nullptr --
+// followed by payload starting at Image::kHeaderSize == kObjectStartAlignment.
+// That is the whole of what BaseSnapshotInstructionsEnd() and PcInImage() read.
+class FakeInstructionsImage {
+ public:
+  static constexpr intptr_t kSize = 4 * kObjectStartAlignment;
+
+  FakeInstructionsImage()
+      : raw_(reinterpret_cast<uint8_t*>(
+            malloc(kSize + kObjectStartAlignment))) {
+    base_ = reinterpret_cast<uint8_t*>(
+        Utils::RoundUp(reinterpret_cast<uword>(raw_), kObjectStartAlignment));
+    memset(base_, 0, kSize);
+    uword* const header = reinterpret_cast<uword*>(base_);
+    header[0] = static_cast<uword>(kSize);  // HeaderField::ImageSize
+    header[1] = 0;  // HeaderField::InstructionsSectionOffset -- none.
+  }
+  ~FakeInstructionsImage() { free(raw_); }
+
+  const uint8_t* base() const { return base_; }
+  uword start() const { return reinterpret_cast<uword>(base_); }
+  // object_start() + object_size(), i.e. what the readers must arrive at.
+  uword end() const { return start() + kSize; }
+
+ private:
+  uint8_t* const raw_;
+  uint8_t* base_;
+
+  DISALLOW_COPY_AND_ASSIGN(FakeInstructionsImage);
+};
+
 VM_UNIT_TEST_CASE(LinkOracle_RunTargetOffsetLayoutMatchesTheirs) {
   // Their DWARF: RunTargetOffset is 0x10 bytes, offset @0x00, target @0x08,
   // and RunTarget is a 4-byte enum with cpu == 0 and sim == 1.
@@ -387,23 +443,21 @@ VM_UNIT_TEST_CASE(Shorebird_BaseInstructionRangeIsZeroWithoutABase) {
   EXPECT_EQ(static_cast<uword>(0), BaseSnapshotInstructionsEnd());
 }
 
-// With a base set, the start is the image itself and the end is past it. The
-// image here is the running process's own isolate instructions, which is a
-// real Image the reader can measure rather than a fabricated buffer.
+// With a base set, the start is the image itself and the end is past it, at
+// object_start() + object_size(). See FakeInstructionsImage for why this cannot
+// use the process's own snapshot blobs: they are zero-length in this binary.
 VM_UNIT_TEST_CASE(Shorebird_BaseInstructionRangeSpansTheImage) {
-  const uint8_t* const instructions =
-      dart::bin::vm_snapshot_instructions;
-  // Asserted rather than skipped: an early return here would pass without
-  // measuring anything, which is the same as not having the test.
-  EXPECT(instructions != nullptr);
-  if (instructions == nullptr) return;
+  FakeInstructionsImage image;
+  const uint8_t* const instructions = image.base();
   Shorebird_SetBaseSnapshots(instructions, instructions, instructions,
                              instructions);
 
   const uword start = BaseSnapshotInstructions();
   const uword end = BaseSnapshotInstructionsEnd();
-  EXPECT_EQ(reinterpret_cast<uword>(instructions), start);
-  EXPECT(end > start);
+  EXPECT_EQ(image.start(), start);
+  // Exactly one image away, not merely "greater". The old assertion was
+  // `end > start`, which a garbage ImageSize satisfies just as well.
+  EXPECT_EQ(image.end(), end);
 
   Shorebird_SetBaseSnapshots(nullptr, nullptr, nullptr, nullptr);
 }
@@ -582,14 +636,21 @@ ISOLATE_UNIT_TEST_CASE(Shorebird_BaseSnapshotHeaderRejectsGarbage) {
 // wrapper this group handed out.
