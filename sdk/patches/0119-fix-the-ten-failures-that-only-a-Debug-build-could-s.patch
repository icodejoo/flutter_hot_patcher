diff --git a/runtime/vm/shorebird/link_info.cc b/runtime/vm/shorebird/link_info.cc
index 798ed72bdaa..47159b412a9 100644
--- a/runtime/vm/shorebird/link_info.cc
+++ b/runtime/vm/shorebird/link_info.cc
@@ -374,28 +374,51 @@ namespace {
 // terminator markers are in play -- 0x80 for unsigned, 0xC0 for signed -- and
 // mixing them up decodes hex digits into five-figure numbers, which is how
 // this was got wrong the first time.
+// True iff a whole varint is still in the buffer.
+//
+// Every guard here used to be `PendingBytes() > 0`, which promises exactly ONE
+// byte -- and a varint is one to ten. ReadStream's decoder (datastream.h) keeps
+// consuming while the byte is <= kMaxUnsignedDataPerByte (127) and stops on the
+// first byte >= 128, identically for the signed and the unsigned form, so a
+// buffer that ends mid-varint has no terminator to stop on and ReadByte walks
+// off the end. Its own bound there is an ASSERT: Debug aborts, and Release --
+// where these readers actually run -- reads out of bounds in silence.
+//
+// linker.cc solves the same problem for its own readers by over-allocating and
+// filling the slack with 0xFF terminators, which it can do because it owns the
+// allocation. These readers are handed buffers by their callers, so the bound
+// has to be checked rather than arranged.
+bool HasWholeVarint(const ReadStream* stream) {
+  const uint8_t* const p = stream->AddressOfCurrentPosition();
+  const intptr_t pending = stream->PendingBytes();
+  for (intptr_t i = 0; i < pending; i++) {
+    if (p[i] > kMaxUnsignedDataPerByte) return true;
+  }
+  return false;
+}
+
 bool ReadString(ReadStream* stream, std::string* out) {
-  if (stream->PendingBytes() <= 0) return false;
+  if (!HasWholeVarint(stream)) return false;
   const intptr_t length = stream->ReadUnsigned<intptr_t>();
   // A length is bounded by what is left: one character costs at least one byte.
   if (length < 0 || length > stream->PendingBytes()) return false;
   out->clear();
   out->reserve(static_cast<size_t>(length));
   for (intptr_t i = 0; i < length; i++) {
-    if (stream->PendingBytes() <= 0) return false;
+    if (!HasWholeVarint(stream)) return false;
     out->push_back(static_cast<char>(stream->Read<int32_t>()));
   }
   return true;
 }
 
 bool ReadIndexVector(ReadStream* stream, std::vector<uintptr_t>* out) {
-  if (stream->PendingBytes() <= 0) return false;
+  if (!HasWholeVarint(stream)) return false;
   const intptr_t count = stream->ReadUnsigned<intptr_t>();
   if (count < 0 || count > stream->PendingBytes()) return false;
   out->clear();
   out->reserve(static_cast<size_t>(count));
   for (intptr_t i = 0; i < count; i++) {
-    if (stream->PendingBytes() <= 0) return false;
+    if (!HasWholeVarint(stream)) return false;
     out->push_back(stream->ReadUnsigned<uintptr_t>());
   }
   return true;
@@ -421,7 +444,7 @@ void Sha256Hash::WriteToStream(BaseWriteStream* stream) const {
 
 std::unique_ptr<ObjectPoolLinkInfo> ObjectPoolLinkInfo::ReadFromStream(
     ReadStream* stream) {
-  if (stream->PendingBytes() <= 0) return nullptr;
+  if (!HasWholeVarint(stream)) return nullptr;
   const intptr_t count = stream->ReadUnsigned<intptr_t>();
   // Each record costs at least four bytes (two empty strings, two empty
   // vectors), so anything past that is a malformed count and not a big file.
@@ -451,7 +474,7 @@ std::unique_ptr<ObjectPoolLinkInfo> ObjectPoolLinkInfo::ReadFromStream(
     pair_constraints.push_back(static_cast<int32_t>(v));
   }
 
-  if (stream->PendingBytes() <= 0) return nullptr;
+  if (!HasWholeVarint(stream)) return nullptr;
   const intptr_t num_pool_entries = stream->ReadUnsigned<intptr_t>();
   if (num_pool_entries < 0) return nullptr;
 
