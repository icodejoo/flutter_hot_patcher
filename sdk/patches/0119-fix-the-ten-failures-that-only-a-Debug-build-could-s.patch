@@ -4,6 +4,13 @@
 
 #include "vm/shorebird/wrapper.h"
 
+#include <string.h>
+
+#if defined(DART_HOST_OS_MACOS)
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
+#endif
+
