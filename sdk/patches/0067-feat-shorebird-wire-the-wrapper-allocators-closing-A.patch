 }
 
@@ -356,5 +384,71 @@ VM_UNIT_TEST_CASE(WrapperAllocator_FreesItsPagesOnDestruction) {
   EXPECT(!RegionStartsAt(page_b));
 }
 
+// The two allocators IsolateGroup hands out. Theirs are two separate pointers
+// at IsolateGroup+0x8d0 and +0x8d8 (engine dSYM, by name), and
+// Deserializer::WrapperForRunTarget picks between them by run target -- so the
+// thing that can go wrong here is not "does an allocator work", which the tests
+// above cover, but "did each accessor get the config it was supposed to".
+//
+// shared_body_size is the only field the two directions disagree on, which
+// makes it the whole discriminator: 272 for CPU->Sim, 28 for Sim->CPU.
+ISOLATE_UNIT_TEST_CASE(WrapperAllocator_IsolateGroupHandsOutBothDirections) {
+  auto* const group = thread->isolate_group();
+
+  WrapperAllocator* const cpu_to_sim = group->shorebird_cpu_to_sim_wrappers();
+  WrapperAllocator* const sim_to_cpu = group->shorebird_sim_to_cpu_wrappers();
+
+  EXPECT(cpu_to_sim != nullptr);
+  EXPECT(sim_to_cpu != nullptr);
+  EXPECT(cpu_to_sim != sim_to_cpu);
+
+  EXPECT_EQ(static_cast<intptr_t>(272), cpu_to_sim->layout().shared_body_size);
+  EXPECT_EQ(static_cast<intptr_t>(28), sim_to_cpu->layout().shared_body_size);
+
+  // Built once and kept, not rebuilt per call.
+  EXPECT(cpu_to_sim == group->shorebird_cpu_to_sim_wrappers());
+  EXPECT(sim_to_cpu == group->shorebird_sim_to_cpu_wrappers());
+}
+
+// What Deserializer::WrapperForRunTarget's lambdas do, in both directions:
+// allocate a metadata slot, store the target in it, and convert to the wrapper
+// entry point. ContainsEntryPoint is the inverse and is what makes this a
+// round trip rather than an assertion that a pointer is non-null.
+//
+// CPU->Sim is the direction that matters here. Its GetStubCodeRange used to
+// report an empty range -- a comment left over from before the 272-byte body
+// was transcribed -- which meant AllocateMetadata returned nullptr forever and
+// this direction could not hand out a single wrapper.
+ISOLATE_UNIT_TEST_CASE(WrapperAllocator_RoundTripsThroughBothDirections) {
+  auto* const group = thread->isolate_group();
+
+  WrapperAllocator* const allocators[] = {
+      group->shorebird_cpu_to_sim_wrappers(),
+      group->shorebird_sim_to_cpu_wrappers(),
+  };
+
+  for (WrapperAllocator* allocator : allocators) {
+    const uword target = reinterpret_cast<uword>(&testFunction);
+
+    void* const metadata = allocator->AllocateMetadata();
+    EXPECT(metadata != nullptr);
+    if (metadata == nullptr) continue;
+
+    static_cast<Metadata*>(metadata)->target_entry_point = target;
+    const uword wrapper = allocator->WrapperOfMetadata(metadata);
+
+    uword recovered = 0;
+    EXPECT(allocator->ContainsEntryPoint(wrapper, &recovered));
+    EXPECT_EQ(target, recovered);
+
+    // A distinct call gets a distinct pad, so two wrapped targets cannot
+    // collide.
+    void* const second = allocator->AllocateMetadata();
+    EXPECT(second != nullptr);
+    EXPECT(second != metadata);
+  }
+}
