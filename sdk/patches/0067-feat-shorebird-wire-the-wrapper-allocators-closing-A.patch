+// Shorebird. Built on first use rather than in the constructor: each allocator
+// reserves a stub page and an [RX][RW] mapping, and a group that never loads a
+// patch has nothing to wrap.
+shorebird::WrapperAllocator* IsolateGroup::shorebird_cpu_to_sim_wrappers() {
+  MutexLocker ml(&shorebird_wrappers_mutex_);
+  if (shorebird_cpu_to_sim_wrappers_ == nullptr) {
+    shorebird_cpu_to_sim_wrappers_.reset(new shorebird::WrapperAllocator(
+        shorebird::WrapperAllocator::Layout::fromTemplate<
+            shorebird::WrapperLayout<shorebird::CPUToSimConfig>>()));
+  }
+  return shorebird_cpu_to_sim_wrappers_.get();
+}
+
+shorebird::WrapperAllocator* IsolateGroup::shorebird_sim_to_cpu_wrappers() {
+  MutexLocker ml(&shorebird_wrappers_mutex_);
+  if (shorebird_sim_to_cpu_wrappers_ == nullptr) {
+    shorebird_sim_to_cpu_wrappers_.reset(new shorebird::WrapperAllocator(
+        shorebird::WrapperAllocator::Layout::fromTemplate<
+            shorebird::WrapperLayout<shorebird::SimToCPUConfig>>()));
+  }
+  return shorebird_sim_to_cpu_wrappers_.get();
+}
+
 IsolateGroup::~IsolateGroup() {
 #if !defined(PRODUCT) && !defined(DART_PRECOMPILED_RUNTIME)
   RELEASE_ASSERT(group_reload_context_ == nullptr);
