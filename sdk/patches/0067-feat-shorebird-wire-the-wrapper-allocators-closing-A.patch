@@ -972,6 +988,12 @@ class IsolateGroup : public IntrusiveDListEntry<IsolateGroup> {
   // neighbourhood is what makes the intent legible.
   std::unique_ptr<uword[]> indirect_static_call_table_;
   intptr_t indirect_static_call_table_size_ = 0;
+  // Guards the two allocators below, which are built on first use. The
