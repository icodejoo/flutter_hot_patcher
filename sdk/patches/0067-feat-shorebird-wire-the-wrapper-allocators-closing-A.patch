+// A layout whose stub range is empty by construction. The two tests below used
+// CPUToSimConfig for this, back when that config reported an empty range
+// because its 272-byte body had not been transcribed. It has been for a while,
+// and the range is real now -- so what those tests meant has to be said
+// directly rather than borrowed from a production config's unfinished state.
+static void EmptyStubCodeRange(uword& code_start, uword& code_end) {
+  code_start = 0;
+  code_end = 0;
+}
+
+static Layout EmptyStubLayout() {
+  Layout l = TestLayout();
+  return Layout{l.page_size,
+                l.rx_mapping_size,
+                l.rw_mapping_size,
+                l.num_wrappers_per_page,
+                l.metadata_size,
+                l.landing_pad_size,
+                l.shared_body_size,
+                "empty-stub wrappers",
+                EmptyStubCodeRange};
+}
+
 // Offset of the stub within its own OS page. This is what
 // offset_of_first_wrapper_in_page_ holds -- upstream's
 // offset_of_first_trampoline_in_page_, computed as code_start - page_start.
@@ -139,17 +163,21 @@ VM_UNIT_TEST_CASE(WrapperLayout_MappingSizeAndAlignment) {
 
 VM_UNIT_TEST_CASE(WrapperLayout_CodeSizeComesFromTheCallback) {
   EXPECT_EQ(static_cast<uword>(kTestStubSize), TestLayout().CodeSize());
-  // The production configs report an empty range until the stubs exist.
-  EXPECT_EQ(static_cast<uword>(0),
-            Layout::fromTemplate<WrapperLayout<CPUToSimConfig>>().CodeSize());
+  EXPECT_EQ(static_cast<uword>(0), EmptyStubLayout().CodeSize());
+
+  // Both production configs report a real stub. This used to assert the
+  // opposite for CPU->Sim, which is how a stale GetStubCodeRange survived: the
+  // test agreed with it. Asserting non-zero means the next config to lose its
+  // stub is a failure rather than an expectation.
+  EXPECT(Layout::fromTemplate<WrapperLayout<CPUToSimConfig>>().CodeSize() > 0);
+  EXPECT(Layout::fromTemplate<WrapperLayout<SimToCPUConfig>>().CodeSize() > 0);
 }
 
 // With no stub to duplicate there is nothing to hand out. Failing loudly here
 // rather than returning a pointer into an unmapped page is the whole reason
 // EnsureStubPage tolerates an empty range.
 VM_UNIT_TEST_CASE(WrapperAllocator_RejectsEmptyStubRange) {
-  const Layout l = Layout::fromTemplate<WrapperLayout<CPUToSimConfig>>();
-  WrapperAllocator allocator(l);
+  WrapperAllocator allocator(EmptyStubLayout());
