 static_assert(sizeof(WrapperAllocator) == 0x98,
               "WrapperAllocator must match Shorebird's 0x98 layout");
 
-// CPU->Sim stub body (272 B) is not yet transcribed from Shorebird's binary.
-// Stays empty until that work lands; the stub generator emits a breakpoint
-// placeholder, and nothing should call into it before it is real.
+// CPU->Sim. This reported an empty range, with a comment saying the 272-byte
+// body had not been transcribed yet. It has -- Generate\
+// TransitionDartToSimulatorIfNeededStub emits it, and compare_stubs.py checks
+// it against theirs. The comment outlived the work.
+//
+// An empty range is not inert: EnsureStubPage maps nothing, so AllocateMetadata
+// returns nullptr forever and this direction can never hand out a wrapper.
+// Nothing noticed because nothing asked it to; found by wiring
+// Deserializer::WrapperForRunTarget to it.
 void CPUToSimConfig::GetStubCodeRange(uword& code_start, uword& code_end) {
-  code_start = 0;
-  code_end = 0;
+  if (!StubCode::HasBeenInitialized()) {
+    // Consulted before StubCode::Init() -- politely report "no stub yet"
+    // rather than crashing on an uninitialized Code handle.
+    code_start = 0;
+    code_end = 0;
+    return;
+  }
+  const Code& stub = StubCode::TransitionDartToSimulatorIfNeeded();
+  if (stub.IsNull()) {
+    code_start = 0;
+    code_end = 0;
+    return;
+  }
+  code_start = stub.EntryPoint();
+  code_end = code_start + static_cast<uword>(stub.Size());
 }
 
 // Sim->CPU. The shared body is still a breakpoint placeholder, but reporting the
