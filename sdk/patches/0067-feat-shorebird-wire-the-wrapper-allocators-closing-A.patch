 //
-// ⚠️ Only the cpu arm is implemented. Their sim arm allocates a CPU->Sim
-// wrapper per entry point, and the machinery for that (WrapperAllocator) has
-// no loader wired to it yet; the shape of their lambda has not been read out
-// of the binary either, so writing one would be invention rather than
-// reproduction. Reaching this with sim is a hard failure rather than a quiet
-// identity, because a simulated entry point that is jumped to directly does
-// not fail where the mistake was made.
+//     ldr x19, [isolate_group, #0x8d0]   ; 'lambda'  -> cpu_to_sim
+//     bl  AllocateMetadata
+//     str x20, [x0]                      ; metadata->target_entry_point = ep
+//     ldr x8,  [x19, #0x40]              ; layout_.rx_mapping_size
+//     sub x0,  x0, x8                    ; == WrapperOfMetadata(metadata)
+//
+// Which arm takes which allocator is not inferred from the control flow: their
+// DWARF names IsolateGroup+0x8d0 shorebird_cpu_to_sim_wrappers_ and +0x8d8
+// shorebird_sim_to_cpu_wrappers_.
+//
+// Note that the cpu arm wraps too, rather than returning the address unchanged.
+// It has to: the wrapper is what lets simulated code reach a native target, and
+// a target being native says nothing about who calls it.
 std::function<uword(uword)> Deserializer::WrapperForRunTarget(
     LinkOracle::RunTarget target) const {
+  auto* const group = thread()->isolate_group();
+  shorebird::WrapperAllocator* allocator = nullptr;
   switch (target) {
-    case LinkOracle::RunTarget::cpu:
-      // Code that runs on the CPU is entered at its own address.
-      return [](uword entry_point) { return entry_point; };
     case LinkOracle::RunTarget::sim:
-      FATAL("Shorebird: no CPU->Sim wrapper is wired to the deserializer");
+      // A simulated target is entered by handing control to the simulator.
+      allocator = group->shorebird_cpu_to_sim_wrappers();
+      break;
+    case LinkOracle::RunTarget::cpu:
+      // A native target still needs a door a simulated caller can walk through.
+      allocator = group->shorebird_sim_to_cpu_wrappers();
+      break;
   }
-  UNREACHABLE();
+  ASSERT(allocator != nullptr);
+
+  return [allocator](uword entry_point) {
+    void* const metadata = allocator->AllocateMetadata();
+    // Out of address space for wrappers. Returning the bare entry point would
+    // hand simulated code a native address to jump to, so this stops here.
+    if (metadata == nullptr) {
+      FATAL("Shorebird: out of wrapper pages");
+    }
+    static_cast<shorebird::Metadata*>(metadata)->target_entry_point =
+        entry_point;
+    return allocator->WrapperOfMetadata(metadata);
+  };
 }
 
 void Deserializer::ReadIndirectStaticCallTable() {
@@ -9818,11 +9843,21 @@ void Deserializer::ReadInstructions(CodePtr code, bool deferred) {
   const uint32_t payload_info = ReadUnsigned();
 
   // Shorebird: the arithmetic upstream did inline lives in EntryPoints now, so
-  // that the addresses can be routed through WrapperForRunTarget on the way
-  // out. With the CPU target that function is the identity and the values are
-  // bit for bit what upstream computed.
+  // that the addresses can be routed through a wrapper on the way out.
+  //
+  // Nothing is wrapped unless a patch is loaded. Wrapping costs a landing pad
+  // per entry point and only buys anything when native and simulated code have
+  // to call each other, which cannot happen without a patch. Theirs gates this
+  // too -- WrapFunction takes a plain function pointer instead of either lambda
+  // when the field at Deserializer+0xc0 is not 1 -- but what that field is has
+  // not been established, so the gate here is the condition we can name rather
+  // than a guess at theirs.
   const EntryPoints entry_points(
-      payload_start, WrapperForRunTarget(LinkOracle::RunTarget::cpu),
+      payload_start,
+      LinkOracle::shared() != nullptr
+          ? WrapperForRunTarget(LinkOracle::RunTarget::cpu)
+          : std::function<uword(uword)>(
+                [](uword entry_point) { return entry_point; }),
       payload_info);
 
   instructions_table_.SetCodeAt(instructions_index_++, code);
