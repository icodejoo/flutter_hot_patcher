+// Shorebird. Build an InstructionsTable over the base snapshot -- the one the
+// running patch was linked against, handed in by Shorebird_SetBaseSnapshots.
+//
+// A patch replaces the app snapshot, so the base is present only as raw
+// mappings; nothing has deserialized it and there is no InstructionsTable for
+// it. Everything InstructionsTable::New needs is in the base's own header,
+// which is five unsigned values at the start of the clustered stream -- the
+// same five Deserialize reads:
+//
+//   num_base_objects, num_objects, num_clusters,
+//   instructions_table_len, instruction_table_data_offset
+//
+// That is what their cut-down Deserializer constructor is for: their DWARF has
+// a second one taking only (Thread*, buffer, size, data, instructions, offset),
+// with no Kind, no InstructionsType and no base-instruction parameters --
+// exactly a reader for a header and nothing else.
+//
+// Returns a null handle when there is no base, when its header does not verify,
+// or when it carries no instructions table. A null table is the signal that the
+// base cannot be linked against, not an error to propagate.
+InstructionsTablePtr ReadBaseInstructionsTable(Thread* thread) {
+#if defined(DART_PRECOMPILED_RUNTIME)
+  const uint8_t* const data = BaseSnapshotData();
+  const uint8_t* const instructions = BaseSnapshotInstructionsBuffer();
+  if (data == nullptr || instructions == nullptr) {
+    return InstructionsTable::null();
+  }
+
+  const Snapshot* const snapshot = Snapshot::SetupFromBuffer(data);
+  if (snapshot == nullptr) return InstructionsTable::null();
+
+  SnapshotHeaderReader header_reader(snapshot);
+  intptr_t offset = 0;
+  char* error =
+      header_reader.VerifyVersionAndFeatures(thread->isolate_group(), &offset);
+  if (error != nullptr) {
+    // The base is a different build than this VM. Refusing to link is the
+    // right outcome; the caller reports it as "no base instructions table".
+    free(error);
+    return InstructionsTable::null();
+  }
+
+  ReadStream stream(snapshot->Addr(), snapshot->length(), offset);
+  stream.ReadUnsigned();  // num_base_objects
+  stream.ReadUnsigned();  // num_objects
+  stream.ReadUnsigned();  // num_clusters
+  const intptr_t instructions_table_len = stream.ReadUnsigned();
+  const uint32_t instruction_table_data_offset = stream.ReadUnsigned();
+  if (instructions_table_len <= 0) return InstructionsTable::null();
+
+  ImageReader* const reader =
+      new (thread->zone()) ImageReader(snapshot->DataImage(), instructions);
+  const uword start_pc = reader->GetBareInstructionsAt(0);
+  const uword end_pc = reader->GetBareInstructionsEnd();
+
+  uword instruction_table_data = 0;
+  if (instruction_table_data_offset != 0) {
+    // Same NoSafepointScope reasoning as the main deserializer: the data lives
+    // in read-only memory and is immovable, so the pointer outlives the scope.
+    NoSafepointScope no_safepoint;
+    instruction_table_data = reinterpret_cast<uword>(
+        OneByteString::DataStart(String::Handle(static_cast<StringPtr>(
+            reader->GetObjectAt(instruction_table_data_offset)))));
+  }
+
+  return InstructionsTable::New(instructions_table_len, start_pc, end_pc,
+                                instruction_table_data);
+#else
+  return InstructionsTable::null();
+#endif  // defined(DART_PRECOMPILED_RUNTIME)
+}
+
 FullSnapshotReader::FullSnapshotReader(const Snapshot* snapshot,
                                        const uint8_t* instructions_buffer,
                                        Thread* thread)
@@ -10481,7 +10564,9 @@ ApiErrorPtr FullSnapshotReader::ReadVMSnapshot() {
 
   Deserializer deserializer(thread_, kind_, buffer_, size_, data_image_,
                             instructions_image_, /*is_non_root_unit=*/false,
-                            Deserializer::InstructionsType::vm, offset);
+                            Deserializer::InstructionsType::vm, offset,
+                            InstructionsTable::Handle(thread_->zone()),
+                            /*base_instructions_buffer=*/nullptr);
   ApiErrorPtr api_error = deserializer.VerifyImageAlignment();
   if (api_error != ApiError::null()) {
     return api_error;
@@ -10526,9 +10611,18 @@ ApiErrorPtr FullSnapshotReader::ReadProgramSnapshot() {
   // program lock is held.
   SafepointWriteRwLocker ml(thread_, isolate_group()->program_lock());
 
+  // Shorebird: the base the running patch was linked against, if there is one.
+  // A null table means nothing can be linked, which is every unpatched app.
+  const InstructionsTable& base_instructions_table =
+      InstructionsTable::Handle(thread_->zone(),
+                                ReadBaseInstructionsTable(thread_));
+  const uint8_t* const base_instructions_buffer =
+      BaseSnapshotInstructionsBuffer();
+
   Deserializer deserializer(thread_, kind_, buffer_, size_, data_image_,
                             instructions_image_, /*is_non_root_unit=*/false,
-                            Deserializer::InstructionsType::app, offset);
+                            Deserializer::InstructionsType::app, offset,
+                            base_instructions_table, base_instructions_buffer);
   ApiErrorPtr api_error = deserializer.VerifyImageAlignment();
   if (api_error != ApiError::null()) {
     return api_error;
@@ -10579,7 +10673,9 @@ ApiErrorPtr FullSnapshotReader::ReadUnitSnapshot(const LoadingUnit& unit) {
   Deserializer deserializer(
       thread_, kind_, buffer_, size_, data_image_, instructions_image_,
       /*is_non_root_unit=*/unit.id() != LoadingUnit::kRootId,
-      Deserializer::InstructionsType::app, offset);
+      Deserializer::InstructionsType::app, offset,
+      InstructionsTable::Handle(thread_->zone()),
+      /*base_instructions_buffer=*/nullptr);
   ApiErrorPtr api_error = deserializer.VerifyImageAlignment();
   if (api_error != ApiError::null()) {
     return api_error;
diff --git a/runtime/vm/shorebird.cc b/runtime/vm/shorebird.cc
