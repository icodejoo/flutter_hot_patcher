+// The raw mappings Shorebird_SetBaseSnapshots was handed. The isolate ones are
+// the pair a base instructions table has to be built over.
+const uint8_t* BaseSnapshotData() {
+  return base_app_snapshot_data;
+}
+const uint8_t* BaseSnapshotInstructionsBuffer() {
+  return base_app_snapshot_instructions;
+}
