+// The per-entry callee list the DD caller links and the DD slot mapping index
+// into -- NOT the sorted, deduplicated set above, which is what the --shorebird
+// JSON prints.
+//
+// Their AnalyzeFunctions (0x1002505a8) fills FunctionAnalysisData+0x70 from the
+// edge list SubgraphHasher records at +0x1d8: AccumulateRecursive pushes
+// {IndexOf(branch pc), IndexOf(target)} at 0x100196900 for every branch that
+// leaves the entry and lands inside one (both IndexOf calls must be != -1), at
+// every depth of the walk, then recurses. AnalyzeFunctions keeps the edges whose
+// source is the root (0x100250ee8: `cmp x8, x26`) and push_backs their targets
+// in recording order (0x100250f00). A source equals the root only for the
+// root's own instructions -- the per-root visited set admits it once -- so this
+// is one element per external branch of the entry, in instruction order,
+// duplicates kept.
+//
+// A DDCallerLink's third field is a position in THIS list, and the slot mapping
+// reads callees[caller][position] back out of it, so the list has to be the
+// same one or every vote lands on the wrong target.
+//
+// The branches come from `classified`'s kCall steps, the same ones the self
+// hash numbers as ExternalBranchTargetIndex -- so the skip window after a pool
+// load (F135) and the conditional forms (F143) apply here exactly as they do
+// there.
+std::vector<std::vector<intptr_t>> ShorebirdOrderedCallees(
+    const std::vector<CodeEntry>& codes,
+    const std::vector<ShorebirdCodeFacts>& facts) {
+  const intptr_t n = static_cast<intptr_t>(codes.size());
+  std::vector<std::vector<intptr_t>> callees(n);
+  for (intptr_t u = 0; u < n; u++) {
+    for (const ShorebirdClassifiedStep& step : facts[u].classified) {
+      if (step.tag != ShorebirdClassifiedStep::kCall) continue;
+      const intptr_t v =
+          ShorebirdEntryContaining(codes, codes[u].offset + step.value);
+      if (v >= 0) callees[u].push_back(v);
+    }
+  }
+  return callees;
+}
