+// function identity, and the DD table when it rides along with
+// --compute_dd_table, are read with it clear. On failure *out is null and *len
+// is 0, which is what their callers then pass on.
+static bool ReadFileFully(const char* path,
+                          const char* label,
+                          char** out,
+                          intptr_t* len,
+                          bool report) {
+  *out = nullptr;
+  *len = 0;
+  File* file = File::Open(nullptr, path, File::kRead);
+  if (file == nullptr) {
+    if (report) Syslog::PrintErr("Error: Unable to read %s: %s\n", label, path);
+    return false;
+  }
+  RefCntReleaseScope<File> rs(file);
+  const int64_t size = file->Length();
+  if (size < 0) {
+    if (report) Syslog::PrintErr("Error: Unable to read %s: %s\n", label, path);
+    return false;
+  }
+  char* buffer = reinterpret_cast<char*>(malloc(size > 0 ? size : 1));
+  if (buffer == nullptr || (size > 0 && !file->ReadFully(buffer, size))) {
+    free(buffer);
+    if (report) Syslog::PrintErr("Error: Unable to read %s: %s\n", label, path);
+    return false;
+  }
+  *out = buffer;
+  *len = static_cast<intptr_t>(size);
+  return true;
+}
