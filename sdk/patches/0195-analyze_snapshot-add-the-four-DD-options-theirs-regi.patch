+namespace {
+
+// A bounds-checked reader for the varint streams the DD inputs use. Dart's
+// ReadStream checks its bounds with ASSERT, which Release and Product compile
+// out, so a truncated input would read past the buffer -- the failure mode the
+// research tree already recorded for their own parser (a 4-byte file driving a
+// terabyte reserve). This one refuses instead.
+//
+// Encoding is Dart's datastream: data bytes are 0..127 little-endian groups of
+// seven bits, and the final byte is >= 128, carrying (b - 128) for unsigned
+// values and (b - 192) for signed ones (kEndUnsignedByteMarker /
+// kEndByteMarker).
+class DDInputReader {
+ public:
+  DDInputReader(const char* data, intptr_t len)
+      : cur_(reinterpret_cast<const uint8_t*>(data)),
+        end_(reinterpret_cast<const uint8_t*>(data) + (data ? len : 0)) {}
+
+  intptr_t pending() const { return end_ - cur_; }
+
+  bool Unsigned(int64_t* value) { return Varint(128, value); }
+
+  // A DD string: length, then one SIGNED varint per character.
+  bool String(std::string* s) {
+    int64_t len;
+    if (!Unsigned(&len) || len < 0 || len > pending()) return false;
+    s->clear();
+    s->reserve(static_cast<size_t>(len));
+    for (int64_t i = 0; i < len; i++) {
+      int64_t c;
+      if (!Varint(192, &c)) return false;
+      s->push_back(static_cast<char>(c));
+    }
+    return true;
+  }
+
+  // `count` rows, each at least `min_row_bytes` long, must fit in what is
+  // left. Checked before anything is allocated for them.
+  bool Plausible(int64_t count, intptr_t min_row_bytes) const {
+    return count >= 0 && count <= pending() / min_row_bytes;
+  }
+
+ private:
+  bool Varint(int end_marker, int64_t* value) {
+    uint64_t r = 0;
+    for (int shift = 0; shift < 64; shift += 7) {
+      if (cur_ >= end_) return false;
+      const uint8_t b = *cur_++;
+      if (b > 127) {
+        *value = static_cast<int64_t>(
+            r | (static_cast<uint64_t>(static_cast<int64_t>(b) - end_marker)
+                 << shift));
+        return true;
+      }
+      r |= static_cast<uint64_t>(b) << shift;
+    }
+    return false;
+  }
+
+  const uint8_t* cur_;
+  const uint8_t* end_;
+};
+
+struct DDCallerLinkRow {
+  std::string caller_hash;
+  int64_t dd_index;
+  int64_t callee_position;
+};
