+
+// Shorebird's --compute_dd_slot_mapping, 0x10025351c in theirs.
+//
+// ⚠️ The output is a DDSlotVoters stream, NOT a DDSlotMapping. Three pieces of
+// their code say so independently: the header is the DDSlotVoters magic and
+// version (0x10025502c stores 0xDDCA7E55, then kVersion -- a DDSlotMapping has
+// no header at all); each row's payload is written by two FunctionKey::
+// WriteToStream calls, 0x20 bytes apart (0x1002551d4 / 0x1002551e0), which is a
+// SlotVoter's caller_key and target_key; and the only vector-of-row type the
+// function instantiates is std::vector<dart::SlotVoter> (its
+// __throw_length_error at 0x100255534). gen_snapshot --dd_slot_mapping takes
+// either, by sniffing those four bytes.
+//
+// What it does, in their order:
+//
+//  1. Parse the table (DDTableLinkInfo::ReadFromStream). Only one number of it
+//     is used here: DDTableLinkInfo+0x68, which its constructor sets to
+//     max(entry.index) + 1 (0x1001947e0). Slots are 0 .. that - 1.
+//  2. Parse the caller links inline and index them by dd_index (0x100253988).
+//  3. AnalyzeFunctions(thread, nullptr) -- the parsed table is NOT passed
+//     (0x1002539c4 `mov x2, #0x0`) -- for every entry's self_hash and ordered
+//     callee list.
+//  4. If an identity buffer is present, parse it into index -> FunctionKey
+//     (a repeated index overwrites, 0x100253f5c) and expand it to one key per
+//     entry, zero where absent. With no identity every key is zero, every voter
+//     is dropped by step 6, and the output is the bare nine-byte header -- which
+//     is exactly what their binary emits when --dd_function_identity is omitted.
+//  5. Index entries by self_hash (unordered_map<string, vector<long>>, ascending
+//     entry index within a hash).
+//  6. For each slot in ascending order, for each link with that dd_index in
+//     link order, for each entry carrying the link's caller hash: target =
+//     callees[caller][link.callee_position]. Skip unless caller, position and
+//     target are all in range and neither key is all-zero (0x100254930-
+//     0x1002549f0). Each survivor is a SlotVoter{key(caller), key(target)}.
+//  7. A slot with at least one voter goes into an unordered_map keyed by slot,
+//     inserted in ascending slot order, and the stream is written in that map's
+//     iteration order. DDSlotVoters::AddVoter builds the same container the same
+//     way (operator[] on first voter, no reserve), so its WriteToStream emits the
+//     same order.
+//
+// ⚠️ DEVIATION, deliberate: theirs parses all three inputs with no bounds checks
+// (step 1 dereferences the parse result unconditionally). This returns false on
+// a truncated or malformed input instead of reading past it. Trailing bytes are
+// tolerated, as nothing in their reader can be seen to reject them.
+bool Dart_ComputeDDSlotMapping(const Dart_SnapshotAnalyzerInformation& info,
+                               const char* dd_table,
+                               intptr_t dd_table_len,
+                               const char* caller_links,
+                               intptr_t caller_links_len,
+                               const char* function_identity,
+                               intptr_t function_identity_len,
+                               char** out,
+                               intptr_t* out_len) {
+  *out = nullptr;
+  *out_len = 0;
+
+  // 1. The table: count, { hash:str, index:u, size:u } * count.
+  int64_t slot_count = 0;
+  {
+    DDInputReader r(dd_table, dd_table_len);
+    int64_t count;
+    if (!r.Unsigned(&count) || !r.Plausible(count, 3)) {
+      OS::PrintErr("Error: DD table: bad entry count\n");
+      return false;
+    }
+    std::string hash;
+    for (int64_t i = 0; i < count; i++) {
+      int64_t index, size;
+      if (!r.String(&hash) || !r.Unsigned(&index) || !r.Unsigned(&size)) {
+        OS::PrintErr("Error: DD table: truncated at entry %" Pd64 " of %" Pd64
+                     "\n",
+                     i, count);
+        return false;
+      }
+      if (index >= slot_count) slot_count = index + 1;
+    }
+  }
+
+  // 2. The caller links, and the dd_index -> link rows index.
+  std::vector<DDCallerLinkRow> links;
+  std::unordered_map<int64_t, std::vector<size_t>> links_for_slot;
+  {
+    DDInputReader r(caller_links, caller_links_len);
+    int64_t count;
+    if (!r.Unsigned(&count) || !r.Plausible(count, 3)) {
+      OS::PrintErr("Error: DD caller links: bad link count\n");
+      return false;
+    }
+    links.reserve(static_cast<size_t>(count));
+    for (int64_t i = 0; i < count; i++) {
+      DDCallerLinkRow row;
+      if (!r.String(&row.caller_hash) || !r.Unsigned(&row.dd_index) ||
+          !r.Unsigned(&row.callee_position)) {
+        OS::PrintErr("Error: DD caller links: truncated at link %" Pd64
+                     " of %" Pd64 "\n",
+                     i, count);
+        return false;
+      }
+      links_for_slot[row.dd_index].push_back(links.size());
+      links.push_back(std::move(row));
+    }
+  }
+
+  // 4 (parsed before 3 so a malformed file is refused before the analysis).
+  const bool have_identity =
+      function_identity != nullptr && function_identity_len >= 1;
+  std::unordered_map<int64_t, FunctionKey> identity;
+  if (have_identity) {
+    DDInputReader r(function_identity, function_identity_len);
+    int64_t count;
+    if (!r.Unsigned(&count) || !r.Plausible(count, 6)) {
+      OS::PrintErr("Error: DD function identity: bad row count\n");
+      return false;
+    }
+    for (int64_t i = 0; i < count; i++) {
+      int64_t index, lib, owner, offset, kind, sig;
+      if (!r.Unsigned(&index) || !r.Unsigned(&lib) || !r.Unsigned(&owner) ||
+          !r.Unsigned(&offset) || !r.Unsigned(&kind) || !r.Unsigned(&sig)) {
+        OS::PrintErr("Error: DD function identity: truncated at row %" Pd64
+                     " of %" Pd64 "\n",
+                     i, count);
+        return false;
+      }
+      FunctionKey key;
+      key.library_kernel_offset = static_cast<intptr_t>(lib);
+      key.owner_class_kernel_offset = static_cast<intptr_t>(owner);
+      key.kernel_offset = static_cast<intptr_t>(offset);
+      key.kind = static_cast<uint8_t>(kind);
+      key.signature_hash = static_cast<uint32_t>(sig);
+      identity[index] = key;
+    }
+  }
+
+  // 3. The analysis: self_hash and the ordered callee list per entry.
+  Thread* thread = Thread::Current();
+  IsolateGroup* ig = thread->isolate_group();
+  DARTSCOPE(thread);
+  const uintptr_t isolate_instr_base =
+      reinterpret_cast<uintptr_t>(info.vm_isolate_instructions);
+  std::vector<CodeEntry> codes;
+  {
+    SafepointReadRwLocker ml(thread, ig->program_lock());
+    CollectAllCodes(ig, isolate_instr_base, codes);
+  }
+  const intptr_t n = static_cast<intptr_t>(codes.size());
+  std::vector<ShorebirdCodeFacts> facts;
+  facts.reserve(n);
+  for (intptr_t i = 0; i < n; i++) {
+    facts.push_back(ComputeShorebirdCodeFacts(codes[i].payload, codes[i].size));
+  }
+  const ShorebirdClassifiedHashes classified =
+      ShorebirdSelfAndOpHashes(codes, facts);
+  const std::vector<std::vector<intptr_t>> callees =
+      ShorebirdOrderedCallees(codes, facts);
+
+  const FunctionKey kZeroKey = {0, 0, 0, 0, 0};
+  std::vector<FunctionKey> keys(n, kZeroKey);
+  for (intptr_t i = 0; i < n; i++) {
+    auto it = identity.find(i);
+    if (it != identity.end()) keys[i] = it->second;
+  }
+  auto is_zero = [](const FunctionKey& k) {
+    return k.library_kernel_offset == 0 && k.owner_class_kernel_offset == 0 &&
+           k.kernel_offset == 0 && k.kind == 0 && k.signature_hash == 0;
+  };
+
+  // 5.
+  std::unordered_map<std::string, std::vector<intptr_t>> entries_with_hash;
+  for (intptr_t i = 0; i < n; i++) {
+    if (classified.self_hash[i].empty()) continue;
+    entries_with_hash[classified.self_hash[i]].push_back(i);
+  }
+
+  // 6 and 7.
+  DDSlotVoters voters;
+  for (int64_t slot = 0; slot < slot_count; slot++) {
+    auto rows = links_for_slot.find(slot);
+    if (rows == links_for_slot.end()) continue;
+    for (size_t row_index : rows->second) {
+      const DDCallerLinkRow& link = links[row_index];
+      auto callers = entries_with_hash.find(link.caller_hash);
+      if (callers == entries_with_hash.end()) continue;
+      for (intptr_t caller : callers->second) {
+        if (caller < 0 || caller >= n) continue;
+        const int64_t pos = link.callee_position;
+        if (pos < 0 ||
+            pos >= static_cast<int64_t>(callees[caller].size())) {
+          continue;
+        }
+        const intptr_t target = callees[caller][pos];
+        if (target < 0 || target >= n) continue;
+        if (is_zero(keys[caller]) || is_zero(keys[target])) continue;
+        voters.AddVoter(static_cast<intptr_t>(slot), keys[caller],
+                        keys[target]);
+      }
+    }
+  }
+
+  MallocWriteStream stream(/*initial_size=*/1 * KB);
+  voters.WriteToStream(&stream);
+  *out_len = stream.bytes_written();
+  *out = reinterpret_cast<char*>(malloc(*out_len));
+  memcpy(*out, stream.buffer(), *out_len);
+  return true;
 }
 
