+#if defined(DART_PRECOMPILED_RUNTIME)
+// Shorebird. Their app_snapshot.cc:923.
+//
+// Recovered from the engine dSYM's inline records: every callee inlined into
+// this function carries a DW_AT_call_line, and line attribution survives
+// inlining by design, so the operation sequence below is read rather than
+// guessed. Four earlier attempts stalled because the body was being read as
+// 1588 bytes of undifferentiated machine code; the line map turns it into a
+// short list with an address range each.
+//
+//   :929  InstructionsTable::InstructionsLengthAt(index)
+//   :935  ASSERT(VirtualMemory::IsExecutable(...))
+//   :936  return EntryPoints::Code(payload_start, identity, payload_info)
+//   :941  IsLinkingEnabled()
+//   :942  ASSERT(...)
+//   :944  WrapperForRunTarget(...)      :945  return EntryPoints::Code(...)
+//   :950  RunTargetForPatchIndex(index) :951  WrapperForRunTarget(target)
+//   :952  Stats::Record(target, length)
+//   :955  InstructionsTable::EntryPointForOffset(offset)
+//   :958  AssertInstructionMatch(base_pc, patch_pc)
+//   :959  InstructionsTable::FindEntry(base_table, pc, ...)
+//   :967  rodata()                      :969  SetCodeAt(index, code)
+//   :970 / :972  return EntryPoints::Code(...)
+//
+// The linked path's payoff is visible at 0x73b078: the EntryPoints it returns
+// is built from x23, which 0x73af24 computed as base_start_pc + offset. So a
+// patch entry whose code matches the base resolves to the *base* image's
+// address, and its Code object is registered in the *base* table -- which is
+// what makes pc-to-Code lookups on unpatched addresses keep working.
+//
+// ⚠️ DELIBERATE DEVIATION, and the one thing here that is not evidence-backed.
+// Theirs takes two out-parameters, `uint32_t&` and `uword&`. Neither dSYM
+// names them -- WrapCode appears only as a declaration, its formal parameters
+// carry types and no names, and no artifact on this machine has an out-of-line
+// copy (checked across two Flutter revisions and six engine configurations).
+// After optimisation the writes are indistinguishable from ReadInstructions'
+// own locals. Rather than invent a meaning, they are omitted: our caller
+// computes what it needs itself. If behavioural differencing against a real
+// .vmcode ever becomes possible, this is the seam to revisit.
+Deserializer::EntryPoints Deserializer::WrapCode(CodePtr code,
+                                                 intptr_t index,
+                                                 uint32_t payload_info,
+                                                 uword payload_start) {
+  const std::function<uword(uword)> identity = [](uword ep) { return ep; };
+
+  // :936. A patch only ever replaces application code, so VM code is never
+  // wrapped and never linked. Theirs checks this first and takes a plain
+  // identity function pointer -- a bare `ret` at 0x733170.
+  if (instructions_type_ != InstructionsType::app) {
+    return EntryPoints(payload_start, identity, payload_info);
+  }
+
+  const intptr_t length = instructions_table_.InstructionsLengthAt(index);
+
+  // :941. Without a base to link against there is nothing to look up, so the
+  // code keeps its own address and is merely wrapped.
+  if (!IsLinkingEnabled()) {
+    stats_.Record(LinkOracle::RunTarget::cpu, length);
+    return EntryPoints(payload_start,
+                       WrapperForRunTarget(LinkOracle::RunTarget::cpu),
+                       payload_info);
+  }
+
+  // :950. One query answers both halves: which target this entry was linked
+  // for, and -- on a hit -- where in the base image its code lives. That is
+  // why their RunTargetOffset carries an offset alongside the enum.
+  const LinkOracle::RunTargetOffset resolved = RunTargetForPatchIndex(index);
+  const std::function<uword(uword)> wrapper =
+      WrapperForRunTarget(resolved.target);
+  stats_.Record(resolved.target, length);
+
+  // A miss means the linker could not prove this function unchanged, so the
+  // patch's own code stands and there is no base entry to point at.
+  if (resolved.is_sim()) {
+    return EntryPoints(payload_start, wrapper, payload_info);
+  }
+
+  // :955. start_pc plus the offset, nothing else.
+  const uword base_entry =
+      shorebird_base_instructions_table_.EntryPointForOffset(
+          static_cast<uint32_t>(resolved.offset));
+
+  // :958. Their check is exactly a first-instruction-word comparison
+  // (0x73af28: two `ldr w` and a `cmp`), so a mismatched link is caught before
+  // anything is rewritten rather than after.
+  AssertInstructionMatch(base_entry, payload_start);
+
+  // :959 / :967 / :969. Find which base entry contains that pc, convert to a
+  // code index, and register this Code there.
+  const intptr_t entry = InstructionsTable::FindEntry(
+      shorebird_base_instructions_table_.ptr(), base_entry, 0);
+  if (entry >= 0) {
+    const intptr_t code_index =
+        entry - shorebird_base_instructions_table_.FirstEntryWithCode();
+    shorebird_base_instructions_table_.SetCodeAt(code_index, code);
+  }
+
+  // :970. Built from the base address, not the patch's -- see above.
+  return EntryPoints(base_entry, wrapper, payload_info);
+}
+
+// Shorebird. Their :941. Linking needs both halves: a table saying which patch
+// offsets pair with which base offsets, and the base image those offsets are
+// into. Either one missing and every entry keeps its own address.
+bool Deserializer::IsLinkingEnabled() const {
+  return LinkOracle::shared() != nullptr &&
+         !shorebird_base_instructions_table_.IsNull();
+}
+
+// Shorebird. Their :950.
+//
+// The link table is keyed by offset into the instructions image, which is what
+// tools/linker.py writes, so the index has to be turned back into one first.
+LinkOracle::RunTargetOffset Deserializer::RunTargetForPatchIndex(
+    intptr_t index) const {
+  const auto* const data = instructions_table_.rodata();
+  const intptr_t entry =
+      static_cast<intptr_t>(data->first_entry_with_code) + index;
+  ASSERT(0 <= entry);
+  ASSERT(entry < static_cast<intptr_t>(data->length));
+  return LinkOracle::shared()->RunTargetFromPatchOffset(
+      static_cast<int64_t>(data->entries()[entry].pc_offset));
+}
+
+// Shorebird. Their :958, and the assert it fails is at :919.
+void Deserializer::AssertInstructionMatch(uword base_pc, uword patch_pc) const {
+  // One word, not the whole body. Theirs loads a single 32-bit word from each
+  // address and compares them; a full comparison would need a length they do
+  // not pass. It is a cheap guard against a link table that points somewhere
+  // unrelated, not a proof that the two functions are identical.
+  RELEASE_ASSERT(*reinterpret_cast<const uint32_t*>(base_pc) ==
+                 *reinterpret_cast<const uint32_t*>(patch_pc));
+}
+#endif  // defined(DART_PRECOMPILED_RUNTIME)
+
 void Deserializer::EndInstructions() {
 #if defined(DART_PRECOMPILED_RUNTIME)
   if (instructions_table_.IsNull()) {
diff --git a/runtime/vm/object.cc b/runtime/vm/object.cc
index 12d670dca6b..13db77f9c1c 100644
--- a/runtime/vm/object.cc
+++ b/runtime/vm/object.cc
@@ -16386,6 +16386,31 @@ uword InstructionsTable::EntryPointAt(intptr_t code_index) const {
          rodata()->entries()[code_index].pc_offset;
 }
 
+// Shorebird. See the declaration for where in their binary this comes from.
+intptr_t InstructionsTable::InstructionsLengthAt(intptr_t index) const {
+  const auto* const data = rodata();
+  const intptr_t entry =
+      static_cast<intptr_t>(data->first_entry_with_code) + index;
+  ASSERT(0 <= entry);
+  ASSERT(entry < static_cast<intptr_t>(data->length));
+
+  const uint32_t start = data->entries()[entry].pc_offset;
+  uint32_t end;
+  if (entry + 1 < static_cast<intptr_t>(data->length)) {
+    end = data->entries()[entry + 1].pc_offset;
+  } else {
+    const uword image_start = ptr()->untag()->start_pc_;
+    end = static_cast<uint32_t>(ptr()->untag()->end_pc_ - image_start);
+    // 0xd4200000 is `brk #0`, the word their loop compares against.
+    while (end > start &&
+           *reinterpret_cast<const uint32_t*>(image_start + end - 4) ==
+               0xd4200000) {
+      end -= 4;
+    }
+  }
+  return static_cast<intptr_t>(end - start);
+}
+
 const char* InstructionsTable::ToCString() const {
   return "InstructionsTable";
 }
diff --git a/runtime/vm/object.h b/runtime/vm/object.h
index 10e6a1b5f13..308f3679ca7 100644
--- a/runtime/vm/object.h
+++ b/runtime/vm/object.h
@@ -6163,6 +6163,27 @@ class InstructionsTable : public Object {
     return static_cast<intptr_t>(rodata()->first_entry_with_code);
   }
 
+  // Shorebird. Two additions to this upstream class, both recovered from the
+  // engine dSYM's inline records for Deserializer::WrapCode: theirs calls
+  // InstructionsLengthAt at app_snapshot.cc:929 and EntryPointForOffset at :955.
+
+  // The address an offset into this image denotes. Their code at 0x73af20 is
+  // exactly `ldur x9, [x8, #0x1f]` -- start_pc_ -- followed by `add x23, x9,
+  // x10`, so this is start_pc plus the offset and nothing else. Public because
+  // start_pc() is private and WrapCode needs this from outside.
+  uword EntryPointForOffset(uint32_t offset) const {
+    return start_pc() + offset;
+  }
+
+  // How many bytes of instructions the entry at `index` occupies, where index
+  // is relative to first_entry_with_code as everywhere else in this class.
+  //
+  // Every entry but the last measures to where the next one starts. The last
+  // has no next, so it measures to end_pc_ and then walks back over trailing
+  // `brk #0` -- the padding the image is filled out with -- which is why only
+  // that entry needs the trim: the others already stop where real code stops.
+  intptr_t InstructionsLengthAt(intptr_t index) const;
+
  private:
   uword start_pc() const { return InstructionsTable::start_pc(this->ptr()); }
   static uword start_pc(InstructionsTablePtr table) {
